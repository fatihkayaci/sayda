---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import Splash from '../components/Splash.astro';
import site from '../data/site.json';
// Preloaded so headings don't reflow when the font swaps in (latin-ext carries ş, ğ, İ, ı).
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import archivoLatinExt from '@fontsource-variable/archivo/files/archivo-latin-ext-wdth-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  organizationSchema?: boolean;
  ogImage?: string;
  hideCtaBanner?: boolean;
  jsonLd?: object[];
}

const { title, description, organizationSchema, ogImage, hideCtaBanner, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoLatinExt} as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} organizationSchema={organizationSchema} ogImage={ogImage} jsonLd={jsonLd} />
    <ClientRouter />
    {
      site.gaMeasurementId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${site.gaMeasurementId}');`}
          />
        </>
      )
    }
  </head>
  <body>
    <Splash />
    <Header transition:persist />
    <main>
      <slot />
    </main>
    {!hideCtaBanner && <CtaBanner />}
    <Footer transition:persist />

    <script>
      function initReveal() {
        const targets = document.querySelectorAll('.reveal:not(.in)');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 },
        );
        targets.forEach((el) => io.observe(el));
      }

      initReveal();
      document.addEventListener('astro:page-load', initReveal);

      // Sekme geçişlerinde (proje kategorisi) scroll konumunu koru (üste atlamasın, sayfa yenilenmiş gibi görünmesin).
      let preserveScrollY: number | null = null;

      document.addEventListener('click', (event) => {
        const link = (event.target as Element)?.closest?.('a.svc-hero__pill, a.projects-filters__btn');
        if (link) {
          preserveScrollY = window.scrollY;
        }
      });

      // Yeni doküman canlıya alınmadan ÖNCE hedef scroll konumunu üzerine yazıyoruz,
      // böylece geçiş animasyonu "sayfa başı" durumunu hiç yakalamıyor (üste zıplama görünmüyor).
      document.addEventListener('astro:before-swap', (event) => {
        if (preserveScrollY !== null) {
          const swapEvent = event as unknown as { newDocument: Document };
          swapEvent.newDocument.documentElement.scrollTop = preserveScrollY;
          swapEvent.newDocument.body.scrollTop = preserveScrollY;
        }
      });

      document.addEventListener('astro:after-swap', () => {
        if (preserveScrollY !== null) {
          window.scrollTo({ left: 0, top: preserveScrollY, behavior: 'instant' });
          preserveScrollY = null;
        }
      });
    </script>
  </body>
</html>
