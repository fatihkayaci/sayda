---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  organizationSchema?: boolean;
  ogImage?: string;
  hideCtaBanner?: boolean;
  jsonLd?: object[];
}

const { title, description, organizationSchema, ogImage, hideCtaBanner, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} organizationSchema={organizationSchema} ogImage={ogImage} jsonLd={jsonLd} />
    <ClientRouter />
  </head>
  <body>
    <Header transition:persist />
    <main>
      <slot />
    </main>
    {!hideCtaBanner && <CtaBanner />}
    <Footer transition:persist />

    <script>
      function initReveal() {
        const targets = document.querySelectorAll('.reveal:not(.in)');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 },
        );
        targets.forEach((el) => io.observe(el));
      }

      initReveal();
      document.addEventListener('astro:page-load', initReveal);

      // Sekme geçişlerinde (hizmet, proje kategorisi) scroll konumunu koru (üste atlamasın, sayfa yenilenmiş gibi görünmesin).
      let preserveScrollY: number | null = null;

      document.addEventListener('click', (event) => {
        const link = (event.target as Element)?.closest?.('a.svc-tab, a.svc-hero__pill, a.projects-filters__btn');
        if (link) {
          preserveScrollY = window.scrollY;
        }
      });

      // Yeni doküman canlıya alınmadan ÖNCE hedef scroll konumunu üzerine yazıyoruz,
      // böylece geçiş animasyonu "sayfa başı" durumunu hiç yakalamıyor (üste zıplama görünmüyor).
      document.addEventListener('astro:before-swap', (event) => {
        if (preserveScrollY !== null) {
          const swapEvent = event as unknown as { newDocument: Document };
          swapEvent.newDocument.documentElement.scrollTop = preserveScrollY;
          swapEvent.newDocument.body.scrollTop = preserveScrollY;
        }
      });

      document.addEventListener('astro:after-swap', () => {
        if (preserveScrollY !== null) {
          window.scrollTo({ left: 0, top: preserveScrollY, behavior: 'instant' });
          preserveScrollY = null;
        }
      });
    </script>
  </body>
</html>
