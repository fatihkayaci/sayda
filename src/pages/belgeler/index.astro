---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
---

<Layout title="Belgelerimiz | Sayda İnşaat" description="Sayda İnşaat'ın belgeleri, iş bitirme evrakları ve e-katalog." heading="Belgelerimiz">
  <section class="docs">
    <div class="docs__inner">
      <div class="docs__img">
        <img src="/img/legacy/belgeler.webp" alt="Sayda İnşaat belgeleri" width="400" height="400" loading="lazy" />
      </div>

      <div class="docs__col">
        <h2>Sertifikalarımız</h2>
        <ul class="docs__certs">
          {
            site.certifications.map((cert) => (
              <li>
                <a href={site.documents.certificate} target="_blank" rel="noopener noreferrer">
                  {cert.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="docs__col">
        <h2>Tanıtım Katalog</h2>
        <a href={site.documents.catalog} target="_blank" rel="noopener noreferrer">
          <img src="/img/legacy/pdfkat.png" alt="Tanıtım katalog (PDF)" width="80" height="80" loading="lazy" />
        </a>
        <h2 class="docs__second">İş Bitirme Belgelerimiz</h2>
        <a href="/projeler/is-bitirme-belgeleri">
          <img src="/img/legacy/isbitirme.png" alt="İş bitirme belgeleri" width="80" height="80" loading="lazy" />
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .docs {
    padding: 0 0 40px;
    background: #171e28;
    font-family: var(--font-body);
  }

  .docs__inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 30px;
    align-items: start;
    max-width: 1170px;
    margin-inline: auto;
    padding: 40px 15px 0;
  }

  .docs__img img {
    width: 100%;
    height: auto;
  }

  .docs h2 {
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 26px;
    text-transform: uppercase;
    color: #da9700;
  }

  .docs__second {
    margin-top: 40px !important;
  }

  .docs__col img {
    width: 80px;
    height: auto;
  }

  .docs__certs a {
    display: inline-block;
    margin-bottom: 8px;
    padding: 0 18px;
    font-size: 13px;
    font-weight: 700;
    line-height: 34px;
    color: #fff;
    background: #2e3191;
  }

  .docs__certs a:hover {
    background: #f69c00;
  }

  @media (max-width: 800px) {
    .docs__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
