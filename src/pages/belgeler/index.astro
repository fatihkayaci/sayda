---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';

const certMeta: Record<string, { subtitle: string; text: string; tone: string }> = {
  'ISO 9001': {
    subtitle: 'Kalite Yönetim Sistemi',
    text: 'Tüm süreçlerimizde kalite odaklı yönetim anlayışını benimsiyoruz.',
    tone: 'blue',
  },
  'ISO 14001': {
    subtitle: 'Çevre Yönetim Sistemi',
    text: 'Çevreye duyarlı, sürdürülebilir ve doğaya saygılı projeler gerçekleştiriyoruz.',
    tone: 'green',
  },
  'ISO 10002': {
    subtitle: 'Müşteri Memnuniyeti Yönetim Sistemi',
    text: 'Müşteri memnuniyetini temel alarak kalıcı değerler üretmek için çalışıyoruz.',
    tone: 'red',
  },
};

const certs = site.certifications.map((cert) => ({
  ...cert,
  number: cert.name.replace('ISO ', ''),
  ...(certMeta[cert.name] ?? { subtitle: '', text: '', tone: 'blue' }),
}));

const facts = [
  { title: 'Müteahhitlik Yetki Belgesi Grubu', text: 'Yetki Belgesi Grubu', value: site.contractorLicenseGroup },
  { title: 'İş Bitirme Belgesi Sayısı', text: 'Tamamlanan proje sayısı', value: String(site.completionCertificatesCount) },
];

const downloads = [
  { title: 'E-Katalog (PDF)', text: 'Şirket tanıtım kataloğumuzu inceleyin.', href: site.documents.catalog },
  { title: 'Sertifika (PDF)', text: 'Tüm sertifikalarımızı içeren dosya.', href: site.documents.certificate },
];
---

<Layout
  title="Belgelerimiz | Sayda İnşaat"
  description="Sayda İnşaat'ın belgeleri, iş bitirme evrakları ve e-katalog."
  hideCtaBanner
>
  <section class="bg-hero">
    <div class="bg-hero__media" aria-hidden="true">
      <img src="/img/sayda-insaat-hero01.webp" alt="" fetchpriority="high" />
    </div>

    <div class="container bg-hero__inner">
      <nav class="bg-hero__breadcrumb" aria-label="Konum">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <a href="/kurumsal">Kurumsal</a>
        <span>/</span>
        <span aria-current="page">Belgelerimiz</span>
      </nav>

      <div class="bg-hero__row">
        <div class="bg-hero__content">
          <div class="eyebrow eyebrow--light">
            <span class="eyebrow__bar"></span>
            <span>Kurumsal</span>
          </div>
          <h1>Belgelerimiz</h1>
          <p class="bg-hero__lead">
            Kalite, çevre, müşteri memnuniyeti ve iş güvenliği konularında uluslararası standartlara uygun şekilde
            çalışıyoruz.
          </p>
        </div>

        <p class="bg-hero__quote" aria-hidden="true">Güvenli yapılar,<br />daha iyi yarınlar.</p>
      </div>
    </div>
  </section>

  <section class="bg-certs-section">
    <div class="container">
      <div class="bg-head">
        <div>
          <div class="eyebrow">
            <span class="eyebrow__bar"></span>
            <span>Sertifikalarımız</span>
          </div>
          <h2>Uluslararası standartlarda çalışıyoruz</h2>
        </div>
        <p>Sektörümüzdeki en iyi uygulamaları benimseyerek, sürdürülebilir ve kaliteli projeler üretmeye devam ediyoruz.</p>
      </div>

      <ul class="bg-certs">
        {
          certs.map((cert, index) => (
            <li class={`cert cert--${cert.tone} reveal reveal-d${index}`}>
              <div class="cert__top">
                <div class="cert__code">
                  <span class="cert__code-label">ISO</span>
                  <span class="cert__code-number">{cert.number}</span>
                </div>
                <span class="cert__badge">{cert.verified ? 'Doğrulandı' : 'Geçerli'}</span>
              </div>

              <div class="cert__body">
                <h3>{cert.subtitle || cert.name}</h3>
                <p>{cert.text}</p>
              </div>

              <div class="cert__meta">
                <span>Geçerlilik Tarihi</span>
                <strong>{cert.validUntil}</strong>
              </div>

              <a class="cert__link" href={site.documents.certificate} target="_blank" rel="noopener noreferrer">
                Sertifikayı Görüntüle <Icon name="external" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-band">
    <div class="container bg-band__inner">
      {
        facts.map((fact) => (
          <div class="bg-band__item">
            <span class="bg-band__value">{fact.value}</span>
            <div class="bg-band__text">
              <span class="bg-band__label">{fact.text}</span>
              <span class="bg-band__title">{fact.title}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-docs-section">
    <div class="container">
      <div class="bg-head bg-head--docs">
        <div>
          <div class="eyebrow">
            <span class="eyebrow__bar"></span>
            <span>Diğer Dokümanlar</span>
          </div>
          <h2>İndirilebilir dosyalar</h2>
        </div>
      </div>

      <ul class="bg-docs">
        {
          downloads.map((doc) => (
            <li class="doc reveal">
              <a href={doc.href} target="_blank" rel="noopener noreferrer">
                <span class="doc__badge">
                  <Icon name="document" size={26} />
                </span>
                <span class="doc__text">
                  <strong>{doc.title}</strong>
                  <span>{doc.text}</span>
                </span>
                <span class="doc__download">
                  İndir <Icon name="download" size={18} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-cta">
    <img class="bg-cta__bg" src="/img/projects/varyap-meridien-konut/varyap-meridien-konut.webp" alt="" loading="lazy" />
    <div class="container bg-cta__inner reveal">
      <div>
        <div class="eyebrow eyebrow--light">
          <span class="eyebrow__bar"></span>
          <span>Birlikte Daha Güçlü Yapılar</span>
        </div>
        <h2>Yeni projeniz için bizimle çalışın.</h2>
        <p>Uzman kadromuzla projenizi planlamadan teslimata kadar yönetiyoruz.</p>
      </div>
      <a class="btn-white" href="/iletisim#quote-form">
        Teklif Al <Icon name="arrow" size={21} />
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Tam genişlik: bu sayfada içerik 1200px ile sınırlanmaz */
  .container {
    max-width: none;
    padding-inline: clamp(var(--edge-mobile), 4vw, 81px);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .eyebrow__bar {
    display: block;
    width: 36px;
    height: 2px;
    background: currentColor;
  }

  .eyebrow--light {
    color: var(--color-on-dark-muted);
  }

  .btn-white {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 16px;
    padding: 18px 34px;
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-navy-deep);
    font-size: calc(var(--fs-small) * 1.12);
    font-weight: 700;
    transition: background var(--transition);
  }

  .btn-white:hover {
    background: #e8e9f5;
  }

  /* Hero */
  .bg-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .bg-hero__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 55%;
  }

  .bg-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% top;
  }

  .bg-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      var(--color-navy-deep) 0%,
      rgba(25, 27, 74, 0.4) 45%,
      rgba(25, 27, 74, 0.15) 100%
    );
  }

  .bg-hero__inner {
    position: relative;
    z-index: 1;
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: 63px 81px;
  }

  .bg-hero__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr));
    gap: var(--space-xl);
    align-items: end;
  }

  .bg-hero__content {
    max-width: 560px;
  }

  .bg-hero__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 48px;
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .bg-hero__breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    transition: color var(--transition);
  }

  .bg-hero__breadcrumb a:hover {
    color: #fff;
  }

  .bg-hero__breadcrumb span[aria-current] {
    color: #fff;
  }

  .bg-hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(2.8rem, 5.5vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
  }

  .bg-hero__lead {
    max-width: 46ch;
    margin-top: 24px;
    font-size: clamp(1.05rem, 1.2vw + 0.6rem, 1.26rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  .bg-hero__quote {
    justify-self: end;
    max-width: 340px;
    margin: 0;
    padding: 4px 0 4px 24px;
    border-left: 2px solid var(--color-on-dark-muted);
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 600;
    font-size: clamp(1.26rem, 1.6vw, 1.68rem);
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: #fff;
  }

  /* Certificates */
  .bg-certs-section {
    padding-block: 72px 63px;
    background: #fff;
  }

  .bg-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-l);
    margin-bottom: 40px;
  }

  .bg-head h2 {
    max-width: 20ch;
    font-size: clamp(1.68rem, 2.24vw + 0.56rem, 2.45rem);
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    color: var(--color-text);
  }

  .bg-head p {
    max-width: 42ch;
    font-size: calc(var(--fs-small) * 1.12);
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .bg-head--docs {
    margin-bottom: 32px;
  }

  .bg-certs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }

  .cert {
    --tone: var(--color-navy);
    display: flex;
    flex-direction: column;
    background: var(--color-bg-light);
    border: 1px solid var(--color-border);
  }

  .cert--green {
    --tone: #1f7a4d;
  }

  .cert--red {
    --tone: #a3232e;
  }

  .cert__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 27px 27px 0;
  }

  .cert__code {
    display: flex;
    flex-direction: column;
  }

  .cert__code-label {
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--tone);
  }

  .cert__code-number {
    margin-top: 2px;
    font-family: var(--font-heading);
    font-size: 3rem;
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--tone);
  }

  .cert__badge {
    flex: none;
    padding: 6px 12px;
    background: var(--tone);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cert__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 27px 24px;
    flex: 1;
  }

  .cert__body h3 {
    font-size: 1.19rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .cert__body p {
    font-size: 0.91rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .cert__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 27px;
    padding: 16px 0;
    border-top: 1px solid var(--color-border);
    font-size: 0.84rem;
    color: var(--color-text-muted);
  }

  .cert__meta strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .cert__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 54px;
    padding: 0 27px;
    border-top: 1px solid var(--color-border);
    background: #fff;
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-navy);
    transition: background var(--transition);
  }

  .cert__link:hover {
    background: var(--color-bg-light);
  }

  /* Yetki belgesi band */
  .bg-band {
    background: var(--color-navy);
    color: #fff;
  }

  .bg-band__inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .bg-band__item {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 54px 40px;
  }

  .bg-band__item + .bg-band__item {
    border-left: 1px solid rgba(255, 255, 255, 0.2);
  }

  .bg-band__value {
    flex: none;
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 7vw, 5.6rem);
    line-height: 0.85;
    color: #fff;
  }

  .bg-band__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bg-band__label {
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
  }

  .bg-band__title {
    font-size: 1.19rem;
    font-weight: 700;
    line-height: 1.25;
  }

  /* Downloads */
  .bg-docs-section {
    padding-block: 63px 81px;
    background: var(--color-bg-light);
  }

  .bg-docs {
    display: grid;
    gap: 14px;
  }

  .doc a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    padding: 22px 27px;
    background: #fff;
    border: 1px solid var(--color-border);
    transition: border-color var(--transition);
  }

  .doc a:hover {
    border-color: var(--color-navy);
  }

  .doc__badge {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    background: var(--color-navy);
    color: #fff;
  }

  .doc__text {
    display: grid;
    gap: 4px;
    min-width: 0;
    font-size: 0.91rem;
    color: var(--color-text-muted);
  }

  .doc__text strong {
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .doc__download {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-navy);
    white-space: nowrap;
  }

  /* CTA */
  .bg-cta {
    position: relative;
    overflow: hidden;
    padding-block: 63px;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .bg-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
    mix-blend-mode: luminosity;
  }

  .bg-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(25, 27, 74, 0.9), rgba(25, 27, 74, 0.55));
  }

  .bg-cta__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .bg-cta h2 {
    font-size: clamp(1.68rem, 2.24vw + 0.84rem, 2.52rem);
    color: #fff;
  }

  .bg-cta p {
    margin-top: 12px;
    font-size: 1.12rem;
    color: rgba(255, 255, 255, 0.9);
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .bg-certs {
      grid-template-columns: 1fr;
    }

    .bg-hero__media {
      width: 100%;
      opacity: 0.55;
    }

    .bg-hero__media::after {
      background: linear-gradient(
        to right,
        var(--color-navy-deep) 0%,
        rgba(25, 27, 74, 0.55) 55%,
        rgba(25, 27, 74, 0.25) 100%
      );
    }

    .bg-hero__quote {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .bg-band__inner {
      grid-template-columns: 1fr;
    }

    .bg-band__item + .bg-band__item {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
    }

    .bg-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-s);
    }
  }

  @media (max-width: 640px) {
    .doc a {
      grid-template-columns: auto 1fr;
    }

    .doc__download {
      grid-column: 2;
    }

    .bg-band__item {
      padding: 40px 27px;
      gap: 20px;
    }

    .bg-cta__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
