---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
---

<Layout title="Belgelerimiz | Sayda İnşaat" description="Sayda İnşaat'ın belgeleri, iş bitirme evrakları ve e-katalog.">
  <section class="belgeler">
    <div class="container">
      <h1>Belgelerimiz</h1>

      <ul class="belgeler__certs">
        {
          site.certifications.map((cert: { name: string; validUntil: string }) => (
            <li>
              <span class="belgeler__cert-name">{cert.name}</span>
              <span class="belgeler__cert-date">Geçerlilik: {cert.validUntil}</span>
            </li>
          ))
        }
      </ul>

      <dl class="belgeler__info">
        <dt>Müteahhitlik Yetki Belgesi Grubu</dt>
        <dd>{site.contractorLicenseGroup}</dd>
        <dt>İş Bitirme Belgesi Sayısı</dt>
        <dd>{site.completionCertificatesCount}</dd>
      </dl>

      <ul class="belgeler__list">
        <li><a href={site.documents.catalog} target="_blank" rel="noopener noreferrer">E-Katalog (PDF)</a></li>
        <li><a href={site.documents.certificate} target="_blank" rel="noopener noreferrer">Sertifika (PDF)</a></li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .belgeler {
    padding-top: calc(var(--header-h) + var(--space-l));
    padding-bottom: var(--space-xxl);
    min-height: 40vh;
  }

  .belgeler .container {
    max-width: 760px;
  }

  .belgeler h1 {
    font-size: var(--fs-h1);
  }

  .belgeler__certs {
    margin-top: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .belgeler__certs li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .belgeler__cert-name {
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .belgeler__certs li {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }

  .belgeler__info {
    margin-top: var(--space-l);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs) var(--space-m);
  }

  .belgeler__info dt {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--color-text-faint);
  }

  .belgeler__info dd {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .belgeler__list {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .belgeler__list a {
    font-weight: 700;
    color: var(--color-navy);
  }

  .belgeler__list a:hover {
    text-decoration: underline;
  }
</style>
