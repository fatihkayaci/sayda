---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import site from '../../data/site.json';
import { srcset } from '../../utils/image';

const certs = site.certifications;
const validUntil = certs[0]?.validUntil;

const downloads = [
  {
    title: 'Tanıtım Kataloğu',
    text: 'Şirket tanıtımı, projelerimiz ve iş bitirme belgelerimiz.',
    meta: '162 sayfa · PDF · 25 MB',
    href: site.documents.catalog,
    image: '/img/belgeler/katalog-kapak.webp',
    file: true,
  },
  {
    title: 'Tüm Sertifikalar',
    text: 'Sekiz sertifikamız tek dosyada.',
    meta: '8 sayfa · PDF · 4,7 MB',
    href: site.documents.certificate,
    image: '/img/belgeler/iso-9001-360.webp',
    file: true,
  },
  {
    title: 'İş Bitirme Belgeleri',
    text: 'İşverenlerimizden aldığımız iş bitirme belgeleri.',
    meta: 'Belge galerisi',
    href: '/projeler/is-bitirme-belgeleri',
    image: '/img/home/belge3.webp',
    file: false,
  },
];
---

<Layout
  title="Belgelerimiz | Sayda İnşaat"
  description="Sayda İnşaat'ın ISO sertifikaları, iş bitirme belgeleri ve tanıtım kataloğu."
>
  <PageHero
    eyebrow="Belgelerimiz"
    breadcrumbs={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Kurumsal', href: '/kurumsal' }, { label: 'Belgelerimiz' }]}
    image="/img/projects/varyap-meridien-konut/varyap-meridien-konut.webp"
    imagePosition="50% center"
    size="compact"
  >
    Uluslararası <em>standartlarda</em> çalışıyoruz.
  </PageHero>

  <!-- Certificates: real scans, each opens its own PDF -->
  <section class="bl-certs">
    <div class="container">
      <div class="bl-certs__head">
        <div class="bl-head">
          <p class="bl-label">Sertifikalarımız</p>
          <p class="bl-head__text">
            Sertifikalarımız BELCERT Uluslararası Belgelendirme tarafından verilmiştir ve {validUntil} tarihine kadar
            geçerlidir.
          </p>
        </div>
        <a class="bl-certs__all" href={site.documents.certificate} target="_blank" rel="noopener noreferrer">
          Tümünü İndir <Icon name="download" size={18} />
        </a>
      </div>

      <ul class="bl-certs__grid">
        {
          certs.map((cert) => (
            <li>
              <a class="bl-cert" href={cert.file} target="_blank" rel="noopener noreferrer">
                <span class="bl-cert__paper">
                  <img
                    src={cert.image}
                    srcset={srcset(cert.image, 360, 720)}
                    sizes="(max-width: 800px) 45vw, 280px"
                    alt={`${cert.name} sertifikası - Sayda İnşaat`}
                    width="720"
                    height="1017"
                    loading="lazy"
                  />
                </span>
                <span class="bl-cert__name">{cert.name}</span>
                <span class="bl-cert__title">{cert.title}</span>
                <span class="bl-cert__meta">
                  No {cert.number} <Icon name="external" size={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Catalogue and other documents -->
  <section class="bl-docs">
    <div class="container">
      <div class="bl-head">
        <p class="bl-label">Diğer Dokümanlar</p>
        <h2>Katalog ve belgeler</h2>
      </div>

      <ul class="bl-docs__list">
        {
          downloads.map((doc) => (
            <li>
              <a class="bl-doc" href={doc.href} {...(doc.file ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                <img class="bl-doc__thumb" src={doc.image} alt="" width="72" height="102" loading="lazy" />
                <span class="bl-doc__text">
                  <span class="bl-doc__title">{doc.title}</span>
                  <span class="bl-doc__desc">{doc.text}</span>
                </span>
                <span class="bl-doc__type">{doc.meta}</span>
                <span class="bl-doc__btn">
                  {doc.file ? 'İndir' : 'Görüntüle'} <Icon name={doc.file ? 'download' : 'arrow'} size={18} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .bl-label {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .bl-label::before {
    content: '';
    width: 40px;
    height: 3px;
    background: var(--color-orange);
  }

  .bl-head {
    display: grid;
    gap: 20px;
    margin-bottom: 56px;
  }

  .bl-head h2 {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(2.25rem, 3vw + 1rem, 4rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-navy-deep);
  }

  .bl-head__text {
    max-width: 52ch;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* Certificates */
  .bl-certs {
    padding-block: clamp(80px, 9vw, 140px);
    background: var(--color-bg);
  }

  .bl-certs__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .bl-certs__all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 56px;
    padding: 14px 24px;
    border: 1.5px solid var(--color-navy-deep);
    border-radius: var(--radius);
    font-weight: 700;
    white-space: nowrap;
    color: var(--color-navy-deep);
    transition:
      background var(--transition),
      color var(--transition);
  }

  .bl-certs__all:hover {
    background: var(--color-navy-deep);
    color: #fff;
  }

  .bl-certs__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 48px clamp(20px, 2.5vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bl-cert {
    display: grid;
    gap: 6px;
    color: var(--color-navy-deep);
  }

  .bl-cert__paper {
    display: block;
    margin-bottom: 14px;
    padding: 10px;
    background: #fff;
    border: 1px solid var(--color-border);
    box-shadow: 0 24px 50px -28px rgba(28, 29, 46, 0.4);
    transition:
      transform 400ms ease,
      box-shadow 400ms ease;
  }

  .bl-cert__paper img {
    width: 100%;
    height: auto;
    aspect-ratio: 595 / 842;
    object-fit: cover;
  }

  .bl-cert:hover .bl-cert__paper {
    transform: translateY(-8px);
    box-shadow: 0 36px 60px -28px rgba(28, 29, 46, 0.5);
  }

  .bl-cert__name {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: 1.375rem;
    line-height: 1.1;
  }

  .bl-cert__title {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .bl-cert__meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-navy);
  }

  /* Downloads */
  .bl-docs {
    padding-block: clamp(80px, 9vw, 140px);
    background: var(--color-bg-light);
  }

  .bl-docs__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--color-navy-deep);
  }

  .bl-doc {
    display: grid;
    grid-template-columns: 72px 1fr auto auto;
    align-items: center;
    gap: 28px;
    padding: 28px 8px;
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-navy-deep);
  }

  .bl-doc__thumb {
    width: 72px;
    aspect-ratio: 595 / 842;
    object-fit: cover;
    background: #fff;
    box-shadow: 0 10px 24px -14px rgba(28, 29, 46, 0.5);
  }

  .bl-doc__text {
    display: grid;
    gap: 6px;
  }

  .bl-doc__title {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(1.5rem, 1.6vw + 0.75rem, 2.5rem);
    line-height: 1;
  }

  .bl-doc__desc {
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .bl-doc__type {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .bl-doc__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 152px;
    padding: 14px 24px;
    border-radius: var(--radius);
    background: var(--color-navy-deep);
    font-weight: 700;
    color: #fff;
    transition: background var(--transition);
  }

  .bl-doc:hover .bl-doc__btn {
    background: var(--color-navy);
  }

  @media (max-width: 1100px) {
    .bl-certs__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {
    .bl-certs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bl-certs__head {
      display: block;
    }

    .bl-certs__all {
      margin: -24px 0 40px;
    }
  }

  @media (max-width: 640px) {
    .bl-doc {
      grid-template-columns: 56px 1fr;
      gap: 16px 20px;
      padding: 24px 0;
    }

    .bl-doc__thumb {
      width: 56px;
    }

    .bl-doc__type {
      display: none;
    }

    .bl-doc__btn {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 420px) {
    .bl-certs__grid {
      gap: 32px 16px;
    }

    .bl-cert__name {
      font-size: 0.9375rem;
      white-space: nowrap;
    }
  }
</style>
