---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import ServiceSidebar from '../../components/service/ServiceSidebar.astro';
import ServicePanel from '../../components/service/ServicePanel.astro';
import ProcessSteps from '../../components/service/ProcessSteps.astro';
import ChecklistBox from '../../components/service/ChecklistBox.astro';
import Callout from '../../components/service/Callout.astro';

const steps = [
  { title: 'Arsa / Bina Değerleme', description: 'Arsanın imar durumu, tapu analizi ve piyasa değeri incelenir; fizibilite raporu hazırlanır.' },
  { title: 'Kat Karşılığı Sözleşmesi', description: 'Noterde resmi sözleşme imzalanır; paylaşım oranları ve teslim tarihleri netleştirilir.' },
  { title: 'Proje & Ruhsat', description: 'Mimari ve statik proje, belediye ruhsatı ve tüm izinler Sayda tarafından alınır.' },
  { title: 'İnşaat & İnce İşler', description: 'Kaba yapıdan ince işlere, iç mekân bitimine kadar tüm inşaat Sayda ekibiyle yürütülür.' },
  { title: 'Teslim & İskan', description: 'İskan belgesi ve anahtarlar, belirlenen paylaşım planına göre sahiplerine teslim edilir.' },
];

const kapsam = [
  'Arsa analizi ve fizibilite',
  'Mimari & statik proje',
  'Belediye ruhsat işlemleri',
  'Kaba yapı',
  'İnce işler (sıva, şap, seramik)',
  'Boya & duvar kağıdı',
  'Elektro-mekanik altyapı',
  'İskan belgesi temini',
];
---

<Layout
  title="Kat Karşılığı İnşaat | Sayda İnşaat"
  description="Arsa veya bina sahipleriyle kat karşılığı anlaşma; tasarımdan teslim aşamasına kadar tüm süreç."
>
  <ServiceHero />

  <section class="svc-main">
    <div class="container svc-main__layout">
      <ServiceSidebar active={0} />

      <ServicePanel
        number="01"
        title="Kat Karşılığı İnşaat"
        lead="Arsa veya bina sahipleriyle kat karşılığı anlaşma yaparak, projenin tamamını üstleniyoruz. Tasarım, ruhsat, inşaat ve teslim süreçlerini eksiksiz yönetiyoruz — siz sadece anahtarınızı teslim alıyorsunuz."
      >
        <ProcessSteps heading="Çalışma Süreci" steps={steps} />
        <ChecklistBox heading="Kapsama Dahil İşler" items={kapsam} />
        <Callout
          title="Neden Sayda İnşaat?"
          text="30 yıllık deneyim, 33 iş bitirme belgesi ve G grubu yüklenici yetki belgesiyle güven veren tek adres."
        />
      </ServicePanel>
    </div>
  </section>
</Layout>

