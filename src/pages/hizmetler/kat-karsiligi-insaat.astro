---
import Layout from '../../layouts/Layout.astro';

const steps = [
  { number: '01', title: 'Teknik Değerlendirme ve Fizibilite', description: 'Arsa veya bina üzerinde teknik değerlendirme ve fizibilite çalışması yapılır.' },
  { number: '02', title: 'Şartname ve Sözleşme', description: 'Kat karşılığı anlaşmasının şartname ve sözleşmesi hazırlanır.' },
  { number: '03', title: 'Projelendirme', description: 'Yeni yapının projesi hazırlanır.' },
  { number: '04', title: 'Ruhsat ve Yasal İzinler', description: 'Gerekli ruhsat ve yasal izin süreçleri yürütülür.' },
  { number: '05', title: 'İnşaat Süreci', description: 'Saha ekiplerimiz projeyi zaman planına göre yürütür, süreç düzenli raporlanır.' },
  { number: '06', title: 'İskan Süreci', description: 'İş bitirme belgeleri ile birlikte iskan alınır ve anahtar teslimi yapılır.' },
];
---

<Layout
  title="Kat Karşılığı İnşaat | Sayda İnşaat"
  description="Arsa veya bina sahipleriyle kat karşılığı anlaşma; tasarımdan teslim aşamasına kadar tüm süreç."
>
  <section class="intro">
    <div class="container">
      <h1>Kat Karşılığı İnşaat</h1>
      <p class="intro__lead">
        Sayda İnşaat, arsa veya bina sahipleriyle kat karşılığı anlaşma yaparak tasarımdan teslim aşamasına
        kadar tüm süreci yönetir.
      </p>
    </div>
  </section>

  <section class="process">
    <div class="container">
      <h2>Süreç Nasıl İşliyor?</h2>

      <ol class="process__grid">
        {
          steps.map((step) => (
            <li class="process-step">
              <span class="process-step__number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<style>
  .intro {
    padding-block: var(--space-block-compact) 0;
  }

  .intro .container {
    max-width: 760px;
  }

  .intro h1 {
    font-size: var(--fs-h1);
  }

  .intro__lead {
    margin-top: var(--space-m);
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .process {
    padding-block: var(--space-block);
  }

  .process h2 {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-l);
  }

  .process__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }

  .process-step {
    position: relative;
    padding-top: var(--space-m);
    border-top: 2px solid var(--color-navy);
  }

  .process-step__number {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-text-faint);
  }

  .process-step h3 {
    margin-top: var(--space-xs);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.0625rem;
  }

  .process-step p {
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .process h2 {
      text-align: center;
    }

    .process__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .process__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
