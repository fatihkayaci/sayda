---
import Layout from '../../layouts/Layout.astro';
import SvcHero from '../../components/service/SvcHero.astro';
import SvcScope from '../../components/service/SvcScope.astro';
import SvcPartners from '../../components/service/SvcPartners.astro';
import SvcMore from '../../components/service/SvcMore.astro';
import company from '../../data/company.json';

// Legacy subcontractor list → project pages that exist for them.
const projectSlugs: Record<string, string> = {
  'Samsun AVM Otel': 'piazza-avm-anamon-otel',
  'Akbatı AVM Yaşam Merkezi': 'akbati-avm-konut',
  'Varyap Meridian': 'varyap-meridien-konut',
  Oyakkent: 'oyakkent-konut',
  'İstanbul-İstanbul': 'istanbul-projesi',
  Acarkent: 'acarlar-acar-kent',
  Kasaba: 'kasaba-konut-residance',
};
---

<Layout
  title="Alt Müteahhitlik | Sayda İnşaat"
  description="Ana yüklenicilerin projelerinde kaba yapı, ince işler, cephe ve dekorasyon işlerinde uzman ekip hizmeti."
>
  <SvcHero
    eyebrow="Hizmet 03"
    name="Alt Müteahhitlik"
    text="1996'dan bu yana birçok büyük projede alt müteahhit olarak “uzman ekip” hizmetleri yüklendik ve başarıyla teslim ettik. Kaba yapı, ince işler, cephe ve dekorasyon işlerinde ana yüklenicilerin yanındayız."
    points={['Kaba yapı', 'İnce işler', 'Cephe', 'Dekorasyon']}
    image="/img/home/sayda-hq.webp"
  >
    Alt <em>Müteahhitlik</em>
  </SvcHero>

  <SvcScope label="Uygulama Alanlarımız" title="Kaba yapıdan dekorasyona." items={company.workItems} />

  <SvcPartners
    label="Alt Müteahhit Olarak"
    items={company.subcontractorProjects.map((item) => ({
      title: item.project,
      employer: item.employer,
      slug: projectSlugs[item.project],
    }))}
  />

  <SvcMore current="/hizmetler/alt-muteahhitlik" />
</Layout>
