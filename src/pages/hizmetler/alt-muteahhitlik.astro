---
import Layout from '../../layouts/Layout.astro';

const altHizmetler = [
  'KABA YAPI İMALATLARI',
  'İLERİ KABA VE İNCE YAPI İMALATLARI',
  'ÇATI İMALATLARI',
  'ASMATAVAN & BÖLME DUVAR İMALATLARI',
  'CEPHE MANTOLAMA & SERAMİK, METAL & CAM GİYDİRME İMALATLARI',
  'DEKORASYON UYGULAMALARI',
];

const tesisTurleri = [
  'AVM, İŞMERKEZİ',
  'HASTANE, SOSYAL TESİSLER',
  'OTEL, TATİL KÖYÜ',
  'KONUT, VİLLA',
  'FABRİKA, DEPO, ENDÜSTRİYEL TESİSLER',
  'OFİS, PLAZA, İDARE BİNA',
  'SATIŞ OFİSİ, SHOWROOM',
];

const ortaklar = [
  { title: 'GAZ BETON ve TUĞLA', logos: ['yutong', 'kilsan'] },
  { title: 'ALÇI ve ÇİMENTO ESASLI SIVA ve LEVHALAR', logos: ['lafarge', 'knf', 'rgbs', 'entegre', 'abs'] },
  { title: 'BOYA ve MANTOLAMA', logos: ['juton', 'pol', 'dyo', 'bum', 'fil'] },
  { title: 'YAPI KİMYASALLARI', logos: ['weber', 'basf', 'bostik', 'hrnkrl', 'koster', 'conica'] },
  { title: 'DEMİR PROFİL', logos: ['yucel', 'tos'] },
  { title: 'ISI YALITIM LEVHA', logos: ['mar', 'iz', 'ozs', 'assan', 'bras', 'ondu', 'yal', 'stan'] },
];
---

<Layout
  title="Alt Müteahhitlik | Sayda İnşaat"
  description="Kısmi yüklenici / uzman ekip olarak, ana yükleniciye bağlı kaba veya ince yapı işlerinin taşeronluğu."
  heading="Müteahhitlik ve Alt Müteahhitlik"
>
  <section class="page">
    <div class="container page__split">
      <div>
        <h2>MÜTEAHHİTLİK</h2>
        <p>
          SAYDA her türlü bina ve üst yapıların proje, şartname ve sözleşmeler doğrultusunda Uzman Ekip, Zamanında
          Teslim, Yüksek Kalite, Düşük Maliyet, Çevre ve Doğaya saygı anlayışıyla ANAHTAR TESLİM MÜTEAHHİTLİK
          yapmaktadır.
        </p>
        <p>
          Yasmin-Bodrum Hotel, Çırağan Palace Hotel Kempinski, Enternasyonal Turizm Yatırım A.Ş., Visa İnternational
          EU, Nestle Gıda Sanayi A.Ş., gibi kuruluşların taahhüt işlerinde müteahhit olarak hizmet vermiştir. Ayrıca
          birçok otel, ofis, villa ve konutun inşaat, dekorasyon, renovasyon gibi taahhütleri anahtar teslimi olarak
          yapmış ve teslim etmiştir.
        </p>

        <h2>ALT MÜTEAHHİTLİK (UZMAN EKİP)</h2>
        <p>
          SAYDA seçkin ve prestijli projelere aşağıdaki konularda ALT MÜTEAHHİTLİK ve UZMAN EKİP hizmetleri
          vermektedir.
        </p>
        <ul class="list">
          {altHizmetler.map((item) => <li>{item}</li>)}
        </ul>

        <div class="faaliyet">
          {tesisTurleri.map((item) => <a class="faaliyet__link" href="/projeler">{item}</a>)}
        </div>

        <h2>ÇÖZÜM ORTAKLARIMIZ</h2>
        {
          ortaklar.map((grup) => (
            <div class="ortak">
              <h3>{grup.title}</h3>
              <div class="ortak__logos">
                {grup.logos.map((logo) => (
                  <img src={`/img/partners/${logo}.webp`} alt={`${grup.title} çözüm ortağı`} height="60" loading="lazy" />
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <div class="page__aside">
        <img src="/img/legacy/hizmet.webp" alt="Sayda İnşaat müteahhitlik ve alt müteahhitlik" loading="lazy" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .faaliyet {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 10px;
    margin: 20px 0 30px;
  }

  .faaliyet__link {
    display: block;
    padding: 0 15px;
    font-size: 13px;
    font-weight: 700;
    line-height: 32px;
    text-transform: uppercase;
    color: #fff !important;
    background: #36abfc;
  }

  .faaliyet__link:hover {
    background: #f69c00;
  }

  .ortak h3 {
    margin: 18px 0 8px;
    font-size: 13px;
    text-transform: uppercase;
  }

  .ortak__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px dotted #ccc;
  }

  .ortak__logos img {
    height: 60px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
  }
</style>
