---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import ServiceSidebar from '../../components/service/ServiceSidebar.astro';
import ServicePanel from '../../components/service/ServicePanel.astro';
import ChecklistBox from '../../components/service/ChecklistBox.astro';
import Callout from '../../components/service/Callout.astro';

const partners = [
  'Kiler GYO',
  'Biskon Yapı A.Ş.',
  'Özak İnşaat',
  'CCN Altyapı',
  'Artaş İnvest',
  'Rönesans Teknik',
  'Akiş GYO',
  'Varyap İnşaat',
  'Oyak İnşaat',
];

const uzmanlik = [
  'Tuğla & gazbeton duvar',
  'Sıva & şap',
  'Seramik & mermer döşeme',
  'Alçı levha asma tavan',
  'Boya & kaplama',
  'Alçı & kartonpiyer',
  'Mantolama',
  'Teras & çatı şap',
];

---

<Layout
  title="Alt Müteahhitlik | Sayda İnşaat"
  description="Ana yükleniciye bağlı olarak kaba veya ince yapı işlerinin taşeronluğu."
>
  <ServiceHero />

  <section class="svc-main">
    <div class="container svc-main__layout">
      <ServiceSidebar active={1} />

      <ServicePanel
        number="02"
        title="Alt Müteahhitlik"
        lead="Ana yükleniciye bağlı olarak kaba yapı veya ince işlerin profesyonel taşeronluğunu üstleniyoruz. Büyük ölçekli projelerde uzun soluklu iş ortaklıkları kuruyoruz."
      >
        <h3 class="partners__heading">Referans İş Ortaklarımız</h3>
        <div class="partners__grid">
          {partners.map((p) => <div class="partners__item">{p}</div>)}
        </div>

        <ChecklistBox heading="Uzmanlık Alanları" items={uzmanlik} />

        <div class="stats-cards">
          <div class="stats-card">
            <span class="stats-card__value">4,25M+</span>
            <span class="stats-card__label">M² TAMAMLANAN ALAN</span>
          </div>
          <div class="stats-card">
            <span class="stats-card__value">14+</span>
            <span class="stats-card__label">BÜYÜK PROJE</span>
          </div>
          <div class="stats-card">
            <span class="stats-card__value">30+</span>
            <span class="stats-card__label">YIL DENEYİM</span>
          </div>
        </div>

        <Callout
          title="Avantajımız"
          text="Kiler GYO, Biskon Yapı, CCN ve Özak gibi Türkiye'nin en büyük inşaat gruplarıyla uzun vadeli iş ortaklığı deneyimi."
        />
      </ServicePanel>
    </div>
  </section>
</Layout>

<style>
  .svc-main {
    background: var(--color-bg-light);
    padding-block: 64px 112px;
  }

  .svc-main__layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 32px;
    align-items: start;
  }

  .partners__heading {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 28px;
  }

  .partners__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 40px;
  }

  .partners__item {
    padding: 16px 20px;
    background: var(--color-bg-light);
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    text-align: center;
  }

  .stats-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  .stats-card {
    text-align: center;
    padding: 28px 16px;
    background: #191b4a;
    border-radius: 6px;
  }

  .stats-card__value {
    font-family: 'Archivo Black', sans-serif;
    font-size: 36px;
    color: #fff;
    display: block;
    line-height: 1;
  }

  .stats-card__label {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 1024px) {
    .svc-main__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .partners__grid {
      grid-template-columns: 1fr 1fr;
    }

    .stats-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
