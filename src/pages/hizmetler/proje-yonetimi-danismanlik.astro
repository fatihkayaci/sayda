---
import Layout from '../../layouts/Layout.astro';
import SvcHero from '../../components/service/SvcHero.astro';
import SvcScope from '../../components/service/SvcScope.astro';
import SvcPartners from '../../components/service/SvcPartners.astro';
import SvcMore from '../../components/service/SvcMore.astro';
import company from '../../data/company.json';
---

<Layout
  title="Proje Yönetimi & Danışmanlık | Sayda İnşaat"
  description="Bütçe, ihale, maliyet ve kalite kontrol süreçlerinde proje yönetimi ve danışmanlık."
>
  <SvcHero
    eyebrow="Hizmet 05"
    name="Proje Yönetimi & Danışmanlık"
    text="Bina ve üst yapıların anahtar teslim müteahhitliğinin yanı sıra proje yönetimi işleri yapıyoruz. Bütçe, ihale, maliyet ve kalite kontrol süreçlerinde danışmanlık veriyoruz."
    points={['Bütçe', 'İhale', 'Maliyet', 'Kalite kontrol']}
    image="/img/home/twin-towers.webp"
  >
    Proje Yönetimi &amp; <em>Danışmanlık</em>
  </SvcHero>

  <SvcScope
    label="Faaliyet Alanlarımız"
    title="Yapı türleri."
    items={company.buildingTypes}
    aside={{ title: 'İlkelerimiz', items: company.philosophy }}
  />

  <SvcPartners
    label="Projelerimiz"
    items={[
      { title: 'Gaziantep Şehir Hastanesi', slug: 'gaziantep-sehir-hastanesi' },
      { title: 'Gaziantep Entegre Sağlık Kampüsü', slug: 'gaziantep-entegre-saglik-kampusu' },
      { title: 'Vadistanbul 3. Etap', slug: 'vadistanbul' },
      { title: 'Torun Tower Ofis', slug: 'torun-tower-ofis' },
      { title: 'Capital Tower Ofisleri', slug: 'capital-tower-ofis' },
      { title: 'M1 Real AVM Genişletme', slug: 'm1-real-avm' },
    ]}
  />

  <SvcMore current="/hizmetler/proje-yonetimi-danismanlik" />
</Layout>
