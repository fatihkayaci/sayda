---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import ServiceSidebar from '../../components/service/ServiceSidebar.astro';
import ServicePanel from '../../components/service/ServicePanel.astro';
import Callout from '../../components/service/Callout.astro';

const projeYonetimi = [
  'Takvim & milestone takibi',
  'Kaynak ve iş gücü planlaması',
  'Saha denetimi ve raporlama',
  'Tedarikçi koordinasyonu',
  'Risk yönetimi',
];

const teknikDanismanlik = [
  'Bütçe analizi ve maliyet kontrolü',
  'Teknik şartname hazırlama',
  'İhale dosyası & teklif analizi',
  'Yapı denetim koordinasyonu',
  'Teslim & hakediş kontrolü',
];
---

<Layout
  title="Proje Yönetimi & Danışmanlık | Sayda İnşaat"
  description="Bağımsız proje yönetimi, maliyet kontrolü ve teknik danışmanlık hizmetleri."
>
  <ServiceHero />

  <section class="svc-main">
    <div class="container svc-main__layout">
      <ServiceSidebar active={3} />

      <ServicePanel
        number="04"
        title="Proje Yönetimi & Danışmanlık"
        lead={`Kendi müteahhidiniz olsa bile uzman gözetimi istiyorsanız; bütçe kontrolü, takvim takibi ve teknik danışmanlık için yanınızdayız.`}
      >
        <div class="svc-cards">
          <div class="svc-card svc-card--navy">
            <h4>Proje Yönetimi</h4>
            <ul>
              {projeYonetimi.map((item) => <li><span class="svc-card__dot" />{item}</li>)}
            </ul>
          </div>
          <div class="svc-card svc-card--deep">
            <h4>Teknik Danışmanlık</h4>
            <ul>
              {teknikDanismanlik.map((item) => <li><span class="svc-card__dot svc-card__dot--deep" />{item}</li>)}
            </ul>
          </div>
        </div>

        <div class="stats-panel">
          <div class="stats-panel__item">
            <span class="stats-panel__value">%15</span>
            <span class="stats-panel__label">ORTALAMA MALİYET TASARRUFU</span>
          </div>
          <div class="stats-panel__item stats-panel__item--bordered">
            <span class="stats-panel__value">30+</span>
            <span class="stats-panel__label">YIL SAHA DENEYİMİ</span>
          </div>
          <div class="stats-panel__item">
            <span class="stats-panel__value">ISO</span>
            <span class="stats-panel__label">9001 · 14001 · 10002</span>
          </div>
        </div>

        <Callout
          title="Bağımsız Bakış Açısı"
          text="Müteahhidinizden bağımsız teknik gözetim; hak kayıplarınızı önler, takvim ve bütçeyi korur."
        />
      </ServicePanel>
    </div>
  </section>
</Layout>

<style>
  .svc-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 48px;
  }

  .svc-card {
    padding: 28px;
    background: var(--color-bg-light);
    border-radius: 6px;
    border-top: 3px solid var(--color-navy);
  }

  .svc-card--deep {
    border-top-color: #191b4a;
  }

  .svc-card h4 {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .svc-card ul {
    display: grid;
    gap: 10px;
  }

  .svc-card li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .svc-card__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-navy);
    flex-shrink: 0;
  }

  .svc-card__dot--deep {
    background: #191b4a;
  }

  .stats-panel {
    background: #191b4a;
    border-radius: 6px;
    padding: 36px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
    text-align: center;
    margin-bottom: 40px;
  }

  .stats-panel__item--bordered {
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stats-panel__value {
    font-family: 'Archivo Black', sans-serif;
    font-size: 32px;
    color: #fff;
    display: block;
    line-height: 1;
  }

  .stats-panel__label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.1em;
  }

  @media (max-width: 1024px) {
    .stats-panel {
      grid-template-columns: 1fr 1fr;
      padding: 28px 20px;
    }

    .stats-panel__item:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .svc-cards {
      grid-template-columns: 1fr;
      margin-bottom: 28px;
    }

    .svc-card {
      padding: 20px;
    }

    .stats-panel {
      grid-template-columns: 1fr;
      padding: 24px 16px;
    }

    .stats-panel__value {
      font-size: 28px;
    }

    .stats-panel__item--bordered {
      border-left: none;
      border-right: none;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-block: 16px;
    }
  }
</style>
