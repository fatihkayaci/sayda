---
import Layout from '../../layouts/Layout.astro';

const kapsam = [
  'TEKNİK DEĞERLENDİRME VE FİZİBİLİTE ÇALIŞMASI',
  'BÜTÇE VE MALİYET BELİRLEME',
  'ŞARTNAME VE SÖZLEŞME HAZIRLAMA',
  'MASTER İŞ PROGRAMI',
  'İHALE YÖNETİMİ',
  'SATIN ALMA VE LOJİSTİK KOORDİNASYONU',
  'KALİTE GÜVENCE TAKİBİ',
  'RAPORLAMA SİSTEMİ VE İLERLEME TAKİBİ',
  'DENETİM VE SAHA KONTROLÜ',
  'GEÇİCİ KABUL VE KESİN KABUL',
];
---

<Layout
  title="Proje Yönetimi & Danışmanlık | Sayda İnşaat"
  description="Bağımsız proje yönetimi, maliyet kontrolü ve teknik danışmanlık hizmetleri."
  heading="Proje Yönetimi ve Danışmanlık"
>
  <section class="page">
    <div class="container page__split">
      <div>
        <h2>PROJE YÖNETİMİ VE DANIŞMANLIK</h2>
        <p>
          SAYDA projelerdeki “Yüksek Kalite, Zamanında Teslim, Düşük Maliyet” temel felsefesiyle; yatırımcı ve
          finansör kuruluşlara, inşaat, yatırım ve geliştirme projelerinde proje yönetimi, danışmanlık hizmetleri
          sunmaktadır.
        </p>
        <ul class="list">
          {kapsam.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="page__aside">
        <img src="/img/legacy/hizmet.webp" alt="Proje yönetimi ve danışmanlık" loading="lazy" />
      </div>
    </div>
  </section>
</Layout>
