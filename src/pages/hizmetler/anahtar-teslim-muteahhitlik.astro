---
import Layout from '../../layouts/Layout.astro';
import ServiceSidebar from '../../components/service/ServiceSidebar.astro';
import ServiceFeatures from '../../components/service/ServiceFeatures.astro';

const ozellikler = [
  { icon: 'shield', title: 'Tek Sorumluluk', text: 'Tüm süreci tek elden yönetiyoruz.' },
  { icon: 'gear', title: 'Zamanında Teslim', text: 'Planlı ve disiplinli ilerliyoruz.' },
  { icon: 'database', title: 'Maliyet Kontrolü', text: 'Bütçenizi koruyoruz.' },
  { icon: 'leaf', title: 'Sürdürülebilir Çözümler', text: 'Geleceğe değer katıyoruz.' },
];

const steps = [
  { title: 'Ön Fizibilite & Briefing', description: 'İhtiyaç analizi, bütçe planlaması ve proje kapsamı belirlenir.' },
  { title: 'Mimari & Mühendislik', description: 'Mimari, statik, mekanik ve elektrik projeleri hazırlanır.' },
  { title: 'Ruhsat & İzinler', description: 'Tüm belediye ve resmi izinler Sayda tarafından takip edilir.' },
  { title: 'İnşaat & Kalite Kontrol', description: 'Süreç yönetimi ve sahada günlük denetim yapılır.' },
  { title: 'Teslim & Garanti', description: 'İskan belgesiyle birlikte teslim ve bakım desteği sağlanır.' },
];

const projeTurleri = [
  { icon: 'home', label: 'Konut & rezidans projeleri' },
  { icon: 'building', label: 'Ticari yapılar & AVM' },
  { icon: 'building', label: 'Ofis & kuleleri' },
  { icon: 'shield', label: 'Sağlık kampüsleri & hastaneler' },
  { icon: 'key', label: 'Otel & turizm yapıları' },
  { icon: 'area', label: 'Lojistik & depo tesisleri' },
];
---

<Layout
  title="Anahtar Teslim Müteahhitlik | Sayda İnşaat"
  description="Ana yüklenici olarak, projelendirmeden teslime kadar tüm inşaat sürecinin tek elden yürütülmesi."
  heading="Anahtar Teslim Müteahhitlik"
>
  <section class="page">
    <div class="container svc-layout">
      <ServiceSidebar active={2} />

      <div>
        <p><small>HİZMET 03</small></p>
        <p>
          <strong>
            Ana yüklenici olarak, projelerinizin tüm süreçlerini tasarımdan teslimata kadar tek bir sorumluluk
            altında, planlı ve güvenilir bir şekilde yönetiyoruz. İhtiyaçlarınıza uygun, modern ve
            sürdürülebilir yapılar üretiyoruz.
          </strong>
        </p>
        <p><em>“Fikirden gerçeğe, aynı sorumlulukla.”</em></p>
        <img src="/img/projects/varyap-meridien-konut/varyap-meridien-konut.webp" alt="Sayda İnşaat anahtar teslim proje" loading="lazy" width="600" height="400" />

        <ServiceFeatures items={ozellikler} />

        <h2>Çalışma Sürecimiz</h2>
        <p>Projenizin her aşamasında şeffaf, planlı ve koordineli bir çalışma modeliyle ilerliyoruz.</p>
        <ol class="list">
          {steps.map((step, i) => <li><strong>{String(i + 1).padStart(2, '0')} · {step.title}:</strong> {step.description}</li>)}
        </ol>

        <h2>Proje Türleri</h2>
        <ul class="list">
          {projeTurleri.map((item) => <li>{item.label}</li>)}
        </ul>

        <h2>Tek muhatap, tam güven.</h2>
        <p>
          Tasarımdan teslimata tek sözleşme, tek iletişim noktası. Koordinasyon sorunu yok, zaman ve maliyet
          kontrolü Sayda'da.
        </p>
        <p><a class="btn" href="/iletisim#quote-form">Teklif Al</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .svc-layout {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 40px;
    align-items: start;
  }

  @media (max-width: 800px) {
    .svc-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
