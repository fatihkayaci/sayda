---
import Layout from '../../layouts/Layout.astro';

const principles = ['Uzman Ekip', 'Zamanında Teslim', 'Yüksek Kalite', 'Düşük Maliyet', 'Çevre ve Doğaya Saygı'];

const references = [
  'Yasmin Bodrum Hotel',
  'Çırağan Palace Hotel Kempinski',
  'Enternasyonal Turizm Yatırım A.Ş.',
  'Visa International EU',
  'Nestle Gıda Sanayi A.Ş.',
];
---

<Layout
  title="Anahtar Teslim Müteahhitlik | Sayda İnşaat"
  description="Projelendirmeden teslime kadar tüm inşaat sürecinin tek elden yürütülmesi."
>
  <section class="intro">
    <div class="container">
      <h1>Anahtar Teslim Müteahhitlik</h1>
      <p class="intro__lead">
        Sayda İnşaat, her türlü bina ve üst yapıyı proje, şartname ve sözleşmeler doğrultusunda uzman ekip,
        zamanında teslim, yüksek kalite, düşük maliyet, çevre ve doğaya saygı anlayışıyla anahtar teslim
        müteahhitlik ile hayata geçirir.
      </p>

      <ul class="principles">
        {principles.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="refs">
    <div class="container">
      <h2>Referanslarımızdan Bazıları</h2>
      <ul class="refs__list">
        {references.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .intro {
    padding-block: var(--space-block-compact) 0;
  }

  .intro .container {
    max-width: 760px;
  }

  .intro h1 {
    font-size: var(--fs-h1);
  }

  .intro__lead {
    margin-top: var(--space-m);
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .principles {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .principles li {
    padding: 8px 16px;
    border-radius: var(--radius);
    background: var(--color-bg-light);
    color: var(--color-navy);
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .refs {
    padding-block: var(--space-xl) var(--space-xxl);
  }

  .refs .container {
    max-width: 760px;
  }

  .refs h2 {
    font-size: var(--fs-h3);
    color: var(--color-navy);
  }

  .refs__list {
    margin-top: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .refs__list li {
    padding: var(--space-s) 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--fs-body);
  }
</style>
