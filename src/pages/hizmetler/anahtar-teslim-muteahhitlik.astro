---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import ServiceSidebar from '../../components/service/ServiceSidebar.astro';
import ServicePanel from '../../components/service/ServicePanel.astro';
import ProcessSteps from '../../components/service/ProcessSteps.astro';
import ChecklistBox from '../../components/service/ChecklistBox.astro';
import Callout from '../../components/service/Callout.astro';

const steps = [
  { title: 'Ön Fizibilite & Brifing', description: 'İhtiyaç analizi, bütçe planlaması ve proje kapsamı belirlenir.' },
  { title: 'Mimari & Mühendislik Projesi', description: 'Mimari, statik, mekanik ve elektrik projeleri koordineli hazırlanır.' },
  { title: 'Ruhsat & İzinler', description: 'Tüm belediye ve resmi izinler Sayda tarafından takip edilir.' },
  { title: 'İnşaat & Kalite Kontrol', description: 'ISO 9001 standartlarında süreç yönetimi ve sahada günlük denetim.' },
  { title: 'Teslim & Garanti', description: 'İskan belgesiyle birlikte teslim; garanti ve bakım desteği devam eder.' },
];

const projeTurleri = [
  'Konut & rezidans projeleri',
  'Ticari yapılar & AVM',
  'Ofis & kuleleri',
  'Sağlık kampüsleri & hastaneler',
  'Otel & turizm yapıları',
  'Lojistik & depo tesisleri',
];
---

<Layout
  title="Anahtar Teslim Müteahhitlik | Sayda İnşaat"
  description="Projelendirmeden teslime kadar tüm inşaat sürecinin tek elden yürütülmesi."
>
  <ServiceHero />

  <section class="svc-main">
    <div class="container svc-main__layout">
      <ServiceSidebar active={2} />

      <ServicePanel
        number="03"
        title="Anahtar Teslim Müteahhitlik"
        lead="Projelendirmeden teslime kadar tüm inşaat sürecini tek elden yönetiyoruz. Tek muhatap, tek sorumluluk."
      >
        <ProcessSteps heading="Çalışma Süreci" steps={steps} />
        <ChecklistBox heading="Proje Türleri" items={projeTurleri} />
        <Callout
          title="Tek Muhatap Avantajı"
          text="Tasarımdan teslime tek sözleşme, tek iletişim noktası. Koordinasyon sorunu yok, zaman ve maliyet kontrolü Sayda'da."
        />
      </ServicePanel>
    </div>
  </section>
</Layout>

<style>
  .svc-main {
    background: var(--color-bg-light);
    padding-block: 64px 112px;
  }

  .svc-main__layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 32px;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .svc-main__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
