---
import Layout from '../../layouts/Layout.astro';
import SvcHero from '../../components/service/SvcHero.astro';
import services from '../../data/services.json';
import { serviceLd } from '../../utils/schema';
import SvcScope from '../../components/service/SvcScope.astro';
import SvcPartners from '../../components/service/SvcPartners.astro';
import SvcField from '../../components/service/SvcField.astro';
import SvcMore from '../../components/service/SvcMore.astro';
import company from '../../data/company.json';

const service = services.find((s) => s.href === '/hizmetler/anahtar-teslim-muteahhitlik')!;
const schema = [
  serviceLd({ name: service.title, description: service.description, path: service.href, image: service.image }),
];
---

<Layout
  title="Anahtar Teslim Müteahhitlik | Sayda İnşaat"
  description="Otel, ofis, villa ve konut projelerinde inşaat, dekorasyon ve renovasyon taahhütlerinin anahtar teslim yapılması."
  ogImage={service.image}
  jsonLd={schema}
>
  <SvcHero
    eyebrow="Hizmet 04"
    name="Anahtar Teslim Müteahhitlik"
    text="Çırağan Palace Hotel Kempinski, Enternasyonal Turizm Yatırım A.Ş., Visa International EU, Nestle Gıda Sanayi A.Ş., Isısan-Buderus ve Yasmin-Bodrum Hotel gibi kuruluşların taahhüt işlerinde müteahhit olarak hizmet verdik. Otel, ofis, villa ve konut projelerinin inşaat, dekorasyon ve renovasyon taahhütlerini anahtar teslim yapıyoruz."
    points={['Otel', 'Ofis', 'Villa', 'Konut']}
    project="capital-tower-ofis"
  >
    Anahtar Teslim <em>Müteahhitlik</em>
  </SvcHero>

  <SvcScope
    label="Faaliyet Alanlarımız"
    title="Yapı türleri."
    items={company.buildingTypes}
    aside={{ title: 'Müteahhit olarak hizmet verdiğimiz kuruluşlar', items: company.contractorClients }}
  />

  <SvcPartners
    label="Projelerimiz"
    items={[
      { title: 'Çırağan Otel Renovasyonu', slug: 'ciragan-otel-renovasyonu' },
      { title: 'Yasmin Resort Hotel', slug: 'yasmin-resort-hotel' },
      { title: 'Mis Süt Dudullu Üretim Tesisleri', slug: 'mis-sut-dudullu-uretim-tesisleri' },
      { title: 'Isısan-Buderus Bursa Bölge Binası', slug: 'isisan-buderus-bursa' },
      { title: 'Omsan Tuzla Lojistik Merkezi', slug: 'omsan-depo-lojistik-merkezi' },
      { title: 'Süzer Plaza Ofis', slug: 'suzer-plaza-ofis' },
    ]}
  />

  <SvcField />

  <SvcMore current="/hizmetler/anahtar-teslim-muteahhitlik" />
</Layout>
