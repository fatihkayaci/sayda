---
import '../../styles/services.css';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ServiceTopbar from '../../components/service/ServiceTopbar.astro';
import ServiceSidebar from '../../components/service/ServiceSidebar.astro';
import ServiceFeatures from '../../components/service/ServiceFeatures.astro';
import ServiceCta from '../../components/service/ServiceCta.astro';

const ozellikler = [
  { icon: 'shield', title: 'Tek Sorumluluk', text: 'Tüm süreci tek elden yönetiyoruz.' },
  { icon: 'gear', title: 'Zamanında Teslim', text: 'Planlı ve disiplinli ilerliyoruz.' },
  { icon: 'database', title: 'Maliyet Kontrolü', text: 'Bütçenizi koruyoruz.' },
  { icon: 'leaf', title: 'Sürdürülebilir Çözümler', text: 'Geleceğe değer katıyoruz.' },
];

const steps = [
  { title: 'Ön Fizibilite & Briefing', description: 'İhtiyaç analizi, bütçe planlaması ve proje kapsamı belirlenir.' },
  { title: 'Mimari & Mühendislik', description: 'Mimari, statik, mekanik ve elektrik projeleri hazırlanır.' },
  { title: 'Ruhsat & İzinler', description: 'Tüm belediye ve resmi izinler Sayda tarafından takip edilir.' },
  { title: 'İnşaat & Kalite Kontrol', description: 'Süreç yönetimi ve sahada günlük denetim yapılır.' },
  { title: 'Teslim & Garanti', description: 'İskan belgesiyle birlikte teslim ve bakım desteği sağlanır.' },
];

const projeTurleri = [
  { icon: 'home', label: 'Konut & rezidans projeleri' },
  { icon: 'building', label: 'Ticari yapılar & AVM' },
  { icon: 'building', label: 'Ofis & kuleleri' },
  { icon: 'shield', label: 'Sağlık kampüsleri & hastaneler' },
  { icon: 'key', label: 'Otel & turizm yapıları' },
  { icon: 'area', label: 'Lojistik & depo tesisleri' },
];
---

<Layout
  title="Anahtar Teslim Müteahhitlik | Sayda İnşaat"
  description="Projelendirmeden teslime kadar tüm inşaat sürecinin tek elden yürütülmesi."
  hideCtaBanner
>
  <section class="svc-main svc-main--flat at-page">
    <ServiceTopbar />

    <div class="container svc-main__layout">
      <ServiceSidebar
        active={2}
        cards
        ctaEyebrow="PROJENİZ İÇİN"
        ctaTitle="Uzman ekibimiz yanınızda."
        ctaText="Projenizin ihtiyaçlarını birlikte değerlendirelim, en uygun çözümü sunalım."
        ctaImage="/img/sayda-insaat-hero01.webp"
        caption="GÜVENLİ YAPILAR, DAHA İYİ YARINLAR."
      />

      <div class="at-content">
        <header class="at-head">
          <div class="at-head__text">
            <div class="at-eyebrow">
              <span></span>
              HİZMET 03
            </div>
            <h1>Anahtar Teslim Müteahhitlik</h1>
            <p>
              Projelerinizin tüm süreçlerini, tasarımdan teslimata kadar tek bir sorumluluk altında, planlı ve
              güvenilir bir şekilde yönetiyoruz. İhtiyaçlarınıza uygun, modern ve sürdürülebilir yapılar
              üretiyoruz.
            </p>
          </div>
          <figure class="at-head__media" aria-hidden="true">
            <img src="/img/projects/varyap-meridien-konut/varyap-meridien-konut.webp" alt="" loading="lazy" />
            <figcaption>
              “Fikirden<br />gerçeğe,<br />aynı sorumlulukla.”
              <span></span>
            </figcaption>
          </figure>
        </header>

        <ServiceFeatures items={ozellikler} />

        <section class="at-process">
          <div class="at-process__head">
            <div>
              <div class="at-eyebrow at-eyebrow--small">
                <span></span>
                SÜREÇ NASIL İLERLİYOR?
              </div>
              <h2>Çalışma Sürecimiz</h2>
            </div>
            <p>Projenizin her aşamasında şeffaf, planlı ve koordineli bir çalışma modeliyle ilerliyoruz.</p>
          </div>

          <ol class="at-steps">
            {
              steps.map((step, index) => (
                <li>
                  <div class="at-step__top">
                    <span class="at-step__num">{String(index + 1).padStart(2, '0')}</span>
                    {index < steps.length - 1 && (
                      <span class="at-step__connector">
                        <span />
                        <Icon name="arrow" size={18} />
                      </span>
                    )}
                  </div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <div class="at-bottom">
          <section class="at-types">
            <h2>Proje Türleri</h2>
            <ul>
              {
                projeTurleri.map((item) => (
                  <li>
                    <Icon name={item.icon} size={34} />
                    {item.label}
                  </li>
                ))
              }
            </ul>
          </section>

          <aside class="at-why">
            <img src="/img/projects/varyap-meridien-konut/varyap-meridien-konut.webp" alt="" loading="lazy" />
            <div class="at-why__body">
              <div class="at-why__eyebrow">
                <span></span>
                NEDEN SAYDA?
              </div>
              <h2>Tek muhatap,<br />tam güven.</h2>
              <p>
                Tasarımdan teslimata tek sözleşme, tek iletişim noktası. Koordinasyon sorunu yok, zaman ve maliyet
                kontrolü Sayda'da.
              </p>
              <a href="/iletisim#quote-form">Teklif Al →</a>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <ServiceCta
    eyebrow="BİRLİKTE DAHA GÜÇLÜ YAPILAR"
    title="Geleceğin yaşam alanlarını inşa ediyoruz."
    text="Uzman kadromuzla projelerinizi planlamadan teslimata kadar yönetiyoruz."
    label="İletişime Geç"
    href="/iletisim"
  />
</Layout>

<style>
  .at-page {
    padding-top: 0;
    padding-bottom: 0;
  }

  .at-content {
    display: grid;
    gap: 0;
    min-width: 0;
  }

  .at-eyebrow {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 16px;
    font-size: 0.77rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--color-navy);
  }

  .at-eyebrow span {
    display: block;
    width: 45px;
    height: 2px;
    background: currentColor;
  }

  .at-eyebrow--small {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
  }

  /* Head */
  .at-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 38%);
    overflow: hidden;
    border-radius: 6px 6px 0 0;
    background: #fff;
    box-shadow: 0 4px 30px rgba(43, 46, 131, 0.06);
  }

  .at-head__text {
    padding: 40px 45px 45px;
  }

  .at-head h1 {
    margin-bottom: 22px;
    font-size: clamp(1.96rem, 3.584vw, 3.08rem);
    line-height: 1.1;
    color: var(--color-navy-deep);
  }

  .at-head__text p {
    max-width: 58ch;
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .at-head__media {
    position: relative;
    margin: 0;
    min-height: 224px;
  }

  .at-head__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.6) brightness(1.1);
  }

  .at-head__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.8) 55%, rgba(255, 255, 255, 0.92) 100%);
  }

  .at-head__media figcaption {
    position: absolute;
    top: 50%;
    right: 24px;
    z-index: 1;
    padding-left: 25px;
    border-left: 1px solid rgba(43, 46, 131, 0.5);
    font-size: 1.26rem;
    line-height: 1.5;
    color: var(--color-navy-deep);
    transform: translateY(-50%);
  }

  .at-head__media figcaption span {
    display: block;
    width: 45px;
    height: 2px;
    margin-top: 16px;
    background: var(--color-navy);
  }

  /* Process */
  .at-process {
    padding: 36px 36px 9px;
  }

  .at-process__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-l);
    margin-bottom: 31px;
  }

  .at-process h2,
  .at-types h2 {
    font-size: clamp(1.68rem, 2.464vw, 2.24rem);
    color: var(--color-navy-deep);
  }

  .at-process__head p {
    max-width: 36ch;
    padding-top: 25px;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .at-steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 22px;
    margin-bottom: 36px;
  }

  .at-step__top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .at-step__num {
    display: grid;
    place-items: center;
    flex: none;
    width: 47px;
    height: 47px;
    border-radius: 50%;
    background: var(--color-navy-deep);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1.05rem;
  }

  .at-step__connector {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 9px;
    min-width: 0;
    color: var(--color-navy);
  }

  .at-step__connector span {
    flex: 1;
    height: 1px;
    background: var(--color-navy);
    opacity: 0.6;
  }

  .at-steps h3 {
    margin-bottom: 7px;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-navy-deep);
  }

  .at-steps p {
    font-size: 0.91rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  /* Bottom */
  .at-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 31px;
    padding: 0 36px 36px;
  }

  .at-types {
    padding: 31px 36px;
    border-radius: 4px;
    background: #f6f7fc;
  }

  .at-types h2 {
    margin-bottom: 25px;
    font-family: var(--font-body);
    font-size: 1.4rem;
    font-weight: 700;
  }

  .at-types ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px 22px;
  }

  .at-types li {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }

  .at-types li :global(svg) {
    flex: none;
    color: var(--color-navy);
  }

  .at-why {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .at-why img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
    mix-blend-mode: luminosity;
  }

  .at-why__body {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: 31px 36px;
  }

  .at-why__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.85);
  }

  .at-why__eyebrow span {
    width: 36px;
    height: 2px;
    background: rgba(255, 255, 255, 0.85);
  }

  .at-why h2 {
    font-size: clamp(1.68rem, 2.464vw, 2.24rem);
    line-height: 1.1;
    color: #fff;
  }

  .at-why p {
    max-width: 34ch;
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
  }

  .at-why a {
    padding: 13px 27px;
    border-radius: 3px;
    background: #fff;
    color: var(--color-navy-deep);
    font-size: 0.91rem;
    font-weight: 700;
    transition: background var(--transition);
  }

  .at-why a:hover {
    background: #e8e9f5;
  }

  @media (max-width: 1200px) {
    .at-steps {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 31px;
    }

    .at-bottom {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .at-head {
      grid-template-columns: 1fr;
    }

    .at-head__media {
      display: none;
    }

    .at-head__text {
      padding: 31px 25px;
    }

    .at-process {
      padding-inline: 22px;
    }

    .at-process__head {
      flex-direction: column;
      gap: var(--space-s);
    }

    .at-process__head p {
      padding-top: 0;
    }

    .at-bottom {
      padding-inline: 22px;
    }
  }

  @media (max-width: 640px) {
    .at-steps {
      grid-template-columns: 1fr 1fr;
    }

    .at-step__connector {
      display: none;
    }

    .at-types ul {
      grid-template-columns: 1fr;
    }
  }
</style>
