---
import Layout from '../../layouts/Layout.astro';
import SvcHero from '../../components/service/SvcHero.astro';
import SvcScope from '../../components/service/SvcScope.astro';
import SvcPartners from '../../components/service/SvcPartners.astro';
import SvcMore from '../../components/service/SvcMore.astro';
import company from '../../data/company.json';

const interiorWork = company.workItems.filter((item) =>
  ['İnce yapı', 'Asma tavan & bölme duvar', 'Cephe, metal & cam', 'Dekorasyon'].includes(item.title)
);
---

<Layout
  title="Tesis Renovasyonu | Sayda İnşaat"
  description="Otel, ofis, villa ve konut projelerinde renovasyon ve dekorasyon taahhütleri."
>
  <SvcHero
    eyebrow="Hizmet 06"
    name="Tesis Renovasyonu"
    text="Otel, ofis, villa ve konut projelerinde renovasyon ve dekorasyon taahhütlerini anahtar teslim yapıyoruz. Çırağan Palace Hotel Kempinski'nin otel binası renovasyonu bu işlerden biridir."
    points={['Renovasyon', 'Dekorasyon', 'Anahtar teslim']}
    image="/img/projects/ciragan-otel-renovasyonu/ciragan-otel-renovasyonu.webp"
  >
    Tesis <em>Renovasyonu</em>
  </SvcHero>

  <SvcScope label="Uygulama Alanlarımız" title="İç mekândan cepheye." items={interiorWork} />

  <SvcPartners
    label="Projelerimiz"
    items={[
      { title: 'Çırağan Otel Renovasyonu', slug: 'ciragan-otel-renovasyonu' },
      { title: 'Executive Hall', slug: 'executive-hall' },
      { title: 'Caviar Bar & Restaurant', slug: 'caviar-bar-restaurant' },
      { title: 'Yasmin Resort Hotel', slug: 'yasmin-resort-hotel' },
      { title: 'Samsun Piazza AVM Otel', slug: 'piazza-avm-anamon-otel' },
      { title: 'Atik Ali Paşa Oteli', slug: 'genel-mudurluk-kum-koy-atik-ali-pasa' },
    ]}
  />

  <SvcMore current="/hizmetler/otel-renovasyonu" />
</Layout>
