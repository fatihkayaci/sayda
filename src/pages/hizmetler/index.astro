---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceSelector from '../../components/service/ServiceSelector.astro';
---

<Layout
  title="Hizmetlerimiz | Sayda İnşaat"
  description="Kentsel dönüşüm, kat karşılığı inşaat, alt müteahhitlik, anahtar teslim müteahhitlik, proje yönetimi ve tesis renovasyonu hizmetleri."
>
  <PageHero
    eyebrow="Hizmetlerimiz"
    breadcrumbs={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Hizmetler' }]}
    image="/img/home/gold-towers-wide.webp"
    imagePosition="35% center"
    size="short"
  >
    Anahtar teslim müteahhitlik ve <em>uzman ekip.</em>
  </PageHero>

  <section class="hz">
    <div class="container">
      <ServiceSelector />
    </div>
  </section>
</Layout>

<style>
  .hz {
    padding-block: clamp(48px, 5vw, 80px) clamp(80px, 9vw, 140px);
    background: var(--color-bg);
  }
</style>
