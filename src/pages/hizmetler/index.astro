---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import services from '../../data/services.json';

const hizmetler = services.filter((service) => service.href.startsWith('/hizmetler/'));
---

<Layout title="Hizmetler | Sayda İnşaat" description="Sayda İnşaat'ın müteahhitlik ve inşaat hizmetleri.">
  <section class="hizmetler-hub">
    <div class="container">
      <h1>Hizmetler</h1>
      <p class="hizmetler-hub__lead">İçerik hazırlanıyor.</p>

      <div class="hizmetler-hub__grid">
        {
          hizmetler.map((service) => (
            <a class="hizmetler-hub__card" href={service.href}>
              <Icon name={service.icon} size={28} />
              <h2>{service.title}</h2>
              <p>{service.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .hizmetler-hub {
    padding-block: var(--space-xxl);
  }

  .hizmetler-hub h1 {
    font-size: var(--fs-h1);
  }

  .hizmetler-hub__lead {
    margin-top: var(--space-m);
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .hizmetler-hub__grid {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }

  .hizmetler-hub__card {
    display: block;
    padding: var(--space-l);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-navy);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .hizmetler-hub__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .hizmetler-hub__card h2 {
    margin-top: var(--space-s);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.125rem;
    color: var(--color-text);
  }

  .hizmetler-hub__card p {
    margin-top: var(--space-xs);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .hizmetler-hub__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .hizmetler-hub__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
