---
import Layout from '../../layouts/Layout.astro';
import ProjectHero from '../../components/project/ProjectHero.astro';
import ProjectGallery from '../../components/project/ProjectGallery.astro';
import ProjectOverview from '../../components/project/ProjectOverview.astro';
import ProjectSidebar from '../../components/project/ProjectSidebar.astro';
import ProjectFeatures from '../../components/project/ProjectFeatures.astro';
import ProjectNavigation from '../../components/project/ProjectNavigation.astro';
import projects from '../../data/projects.json';
import site from '../../data/site.json';
import { pageUrl } from '../../utils/schema';
import { shortProjectTitle, projectDisplayName, projectSeoTitle, projectSeoDescription, pickRelatedProjects } from '../../utils/project';

export function getStaticPaths() {
  return projects.map((project) => {
    const related = pickRelatedProjects(projects, project.slug).map(({ href, name, location, area, image }) => ({
      href,
      name,
      location,
      area,
      image,
    }));

    return {
      params: { slug: project.slug },
      props: { project, related },
    };
  });
}

const { project, related } = Astro.props;
const title = shortProjectTitle(project.name);
const seoTitle = projectSeoTitle(project);
const seoDescription = projectSeoDescription(project);
const canonical = pageUrl(project.href);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: pageUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Projeler', item: pageUrl('/projeler') },
    { '@type': 'ListItem', position: 3, name: projectDisplayName(project.name), item: canonical },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: projectDisplayName(project.name),
  serviceType: project.works?.length ? project.works.join(', ') : 'İnce İşler',
  description: seoDescription,
  url: canonical,
  provider: { '@type': 'Organization', '@id': `${site.url}/#organization`, name: site.name, url: site.url },
  ...(project.location || project.district
    ? {
        areaServed: {
          '@type': 'Place',
          ...(project.location ? { name: project.location } : {}),
          ...(project.district
            ? { address: { '@type': 'PostalAddress', addressLocality: project.district, addressCountry: 'TR' } }
            : {}),
        },
      }
    : {}),
  ...(project.image ? { image: new URL(project.image, site.url).toString() } : {}),
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  ogImage={project.image}
  jsonLd={[breadcrumbLd, serviceLd]}
>
  <article class="proje-detail">
    <ProjectHero project={project} />

    <section class="proje-detail__main">
      <div class="container">
        <div class="proje-detail__grid">
          <div class="proje-detail__content">
            <ProjectOverview description={project.description} works={project.works} />
            <ProjectGallery
              title={title}
              images={project.gallery}
              project={project}
              credits={'galleryCredits' in project ? project.galleryCredits : undefined}
            />
          </div>
          <ProjectSidebar project={project} />
        </div>

        <ProjectFeatures features={project.features} />
        <ProjectNavigation projects={related} />
      </div>
    </section>
  </article>
</Layout>

<style>

  .proje-detail__main {
    padding-block: 36px 81px;
    background: var(--color-bg-light);
  }

  .proje-detail__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 426px;
    gap: 36px;
    align-items: start;
  }

  .proje-detail__content {
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .proje-detail__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .proje-detail__main {
      padding-block: var(--space-l) var(--space-xl);
    }
  }
</style>
