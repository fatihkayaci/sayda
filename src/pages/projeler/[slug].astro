---
import Layout from '../../layouts/Layout.astro';
import ProjectHero from '../../components/project/ProjectHero.astro';
import ProjectGallery from '../../components/project/ProjectGallery.astro';
import ProjectOverview from '../../components/project/ProjectOverview.astro';
import ProjectSidebar from '../../components/project/ProjectSidebar.astro';
import ProjectNavigation from '../../components/project/ProjectNavigation.astro';
import projects from '../../data/projects.json';
import site from '../../data/site.json';
import { shortProjectTitle, projectSeoTitle, projectSeoDescription, pickRelatedProjects } from '../../utils/project';

export function getStaticPaths() {
  return projects.map((project) => {
    const related = pickRelatedProjects(projects, project.slug).map(({ href, name, location, area, image }) => ({
      href,
      name,
      location,
      area,
      image,
    }));

    return {
      params: { slug: project.slug },
      props: { project, related },
    };
  });
}

const { project, related } = Astro.props;
const title = shortProjectTitle(project.name);
const seoTitle = projectSeoTitle(project);
const seoDescription = projectSeoDescription(project);
const canonical = new URL(project.href, site.url).toString();

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Projeler', item: new URL('/projeler', site.url).toString() },
    { '@type': 'ListItem', position: 3, name: project.name, item: canonical },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: project.name,
  serviceType: project.works?.length ? project.works.join(', ') : 'İnce İşler',
  description: seoDescription,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  areaServed: {
    '@type': 'Place',
    name: project.location,
    ...(project.district
      ? { address: { '@type': 'PostalAddress', addressLocality: project.district, addressCountry: 'TR' } }
      : {}),
  },
  ...(project.image ? { image: new URL(project.image, site.url).toString() } : {}),
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  ogImage={project.image}
  jsonLd={[breadcrumbLd, serviceLd]}
  hideCtaBanner
>
  <article class="proje-detail">
    <ProjectHero project={project} />

    <section class="proje-detail__main">
      <div class="container">
        <div class="proje-detail__grid">
          <div class="proje-detail__content">
            <ProjectGallery title={title} images={project.gallery} project={project} />
            <ProjectOverview description={project.description} works={project.works} />
          </div>
          <ProjectSidebar project={project} />
        </div>

        <ProjectNavigation projects={related} />
      </div>
    </section>
  </article>
</Layout>

<style>
  .proje-detail__main {
    padding-block: 72px 96px;
    background: var(--color-bg-light);
  }

  .proje-detail__grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-l);
    align-items: start;
  }

  .proje-detail__content {
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .proje-detail__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .proje-detail__main {
      padding-block: var(--space-l) var(--space-xl);
    }
  }
</style>
