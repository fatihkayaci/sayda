---
import Layout from '../../layouts/Layout.astro';
import projects from '../../data/projects.json';
import site from '../../data/site.json';
import { shortProjectTitle, projectSeoTitle, projectSeoDescription, pickRelatedProjects, projectImageAlt } from '../../utils/project';

export function getStaticPaths() {
  return projects.map((project) => {
    const related = pickRelatedProjects(projects, project.slug).map(({ href, name, location, area, image }) => ({
      href,
      name,
      location,
      area,
      image,
    }));

    return {
      params: { slug: project.slug },
      props: { project, related },
    };
  });
}

const { project, related } = Astro.props;
const title = shortProjectTitle(project.name);
const seoTitle = projectSeoTitle(project);
const seoDescription = projectSeoDescription(project);
const canonical = new URL(project.href, site.url).toString();

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Projeler', item: new URL('/projeler', site.url).toString() },
    { '@type': 'ListItem', position: 3, name: project.name, item: canonical },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: project.name,
  serviceType: project.works?.length ? project.works.join(', ') : 'İnce İşler',
  description: seoDescription,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  areaServed: {
    '@type': 'Place',
    name: project.location,
    ...(project.district
      ? { address: { '@type': 'PostalAddress', addressLocality: project.district, addressCountry: 'TR' } }
      : {}),
  },
  ...(project.image ? { image: new URL(project.image, site.url).toString() } : {}),
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  ogImage={project.image}
  jsonLd={[breadcrumbLd, serviceLd]}
  heading={project.name}
>
  <article class="page">
    <div class="container">
      <p class="facts">
        {
          [
            project.employer && `İşveren: ${project.employer}`,
            project.location && `Lokasyon: ${project.location}`,
            project.area && `Alan: ${project.area}`,
            project.startDate && `Başlangıç: ${project.startDate}`,
            project.endDate ? `Bitiş: ${project.endDate}` : project.status === 'devam-eden' ? 'Durum: Devam Ediyor' : '',
          ]
            .filter(Boolean)
            .join(' · ')
        }
      </p>
      {project.description.map((paragraph) => <p>{paragraph}</p>)}
      {project.works.length > 0 && <p><strong>İş Kapsamı:</strong> {project.works.join(', ')}</p>}

      <div class="gallery">
        {
          project.gallery.map((src, i) => (
            <a href={src} target="_blank" rel="noopener noreferrer">
              <img
                src={src}
                alt={projectImageAlt(project, i)}
                width="360"
                height="260"
                loading={i < 3 ? undefined : 'lazy'}
              />
            </a>
          ))
        }
      </div>
    </div>
  </article>
</Layout>

<style>
  .facts {
    color: #8e8d8d;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 30px;
  }

  .gallery img {
    width: 100%;
    height: auto;
    aspect-ratio: 360 / 260;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .gallery a:hover img {
    opacity: 0.5;
  }

  @media (max-width: 800px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
