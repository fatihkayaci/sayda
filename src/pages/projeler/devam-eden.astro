---
import Layout from '../../layouts/Layout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import allProjects from '../../data/projects.json';

const projects = allProjects.filter((project) => project.status === 'devam-eden');
---

<Layout
  title="Devam Eden Projeler | Sayda İnşaat"
  description="Sayda İnşaat'ın devam eden projeleri."
  heading="Devam Eden Projeler"
>
  <section class="page">
    <div class="container">
      {projects.length > 0 ? <ProjectGrid projects={projects} /> : <p>İçerik hazırlanıyor.</p>}
    </div>
  </section>
</Layout>

