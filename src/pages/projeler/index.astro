---
import Layout from '../../layouts/Layout.astro';
import ProjectsHero from '../../components/project/ProjectsHero.astro';
import ProjectFeatured from '../../components/project/ProjectFeatured.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import allProjects from '../../data/projects.json';

const devamEden = allProjects.filter((project) => project.status === 'devam-eden');
const tamamlanan = allProjects.filter((project) => project.status === 'tamamlanan');
---

<Layout
  title="Projeler | Sayda İnşaat"
  description="Sayda İnşaat'ın devam eden ve tamamlanan projeleri."
  heading="Geçmişten Bugüne Hayata Geçirdiğimiz Projeler"
>
  <section class="page">
    <div class="container">
      <p>1996'dan bu yana İstanbul ve Türkiye genelinde tamamladığımız ve devam eden projeleri keşfedin.</p>
      <ProjectsHero active="all" />
      <ProjectFeatured projects={devamEden} />
      {
        tamamlanan.length > 0 && (
          <section>
            <h2>Tamamlanan İşler ({tamamlanan.length} proje)</h2>
            <ProjectGrid projects={tamamlanan} />
          </section>
        )
      }
    </div>
  </section>
</Layout>
