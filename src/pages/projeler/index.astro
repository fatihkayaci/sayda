---
import Layout from '../../layouts/Layout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import projects from '../../data/projects.json';
---

<Layout title="Projeler | Sayda İnşaat" description="Sayda İnşaat'ın devam eden ve tamamlanan projeleri.">
  <section class="projeler-page">
    <div class="container">
      <h1>Projeler</h1>

      <nav class="projeler-page__filters" aria-label="Proje durumu">
        <a href="/projeler/devam-eden">Devam Eden</a>
        <a href="/projeler/tamamlanan">Tamamlanan</a>
      </nav>

      <ProjectGrid projects={projects} />
    </div>
  </section>
</Layout>

<style>
  .projeler-page {
    padding-block: var(--space-xl);
  }

  .projeler-page h1 {
    font-size: var(--fs-h1);
  }

  .projeler-page__filters {
    display: flex;
    gap: var(--space-m);
    margin-top: var(--space-m);
    margin-bottom: var(--space-l);
  }

  .projeler-page__filters a {
    padding: 10px 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 700;
    transition:
      border-color var(--transition),
      color var(--transition);
  }

  .projeler-page__filters a:hover {
    border-color: var(--color-navy);
    color: var(--color-navy);
  }
</style>
