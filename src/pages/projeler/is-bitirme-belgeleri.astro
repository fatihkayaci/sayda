---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import projects from '../../data/projects.json';
import certificates from '../../data/certificates.json';
import { projectDisplayName } from '../../utils/project';

const hero = projects.find((p) => p.slug === 'varyap-meridien-konut')!;

// Scans from the client's reference folder (old site's order, new ones last); a certificate
// without a project on the site (Visa, Seba) has project: null.
const items = certificates.map((c) => {
  const project = c.project ? projects.find((p) => p.slug === c.project) : undefined;
  return { ...c, projectName: project ? projectDisplayName(project.name) : '', projectHref: project?.href };
});
---

<Layout
  title="İş Bitirme Belgelerimiz | Sayda İnşaat"
  description="Sayda İnşaat'ın tamamlanan projeleri için işverenlerinden aldığı iş bitirme belgeleri; proje, işveren ve yapılan işlerle birlikte."
  ogImage={hero.image}
>
  <PageHero
    eyebrow="Belgelerimiz"
    breadcrumbs={[
      { label: 'Ana Sayfa', href: '/' },
      { label: 'Projeler', href: '/projeler' },
      { label: 'İş Bitirme Belgeleri' },
    ]}
    variant="photo"
    image={hero.image}
    imagePosition="center"
    size="short"
    credit={'imageCredit' in hero ? hero.imageCredit : undefined}
  >
    İş Bitirme <em>Belgeleri</em>
  </PageHero>

  <section class="ib">
    <div class="container">
      <ul class="ib__grid">
        {
          items.map((c, i) => (
            <li class="ib__card">
              <a class="ib__doc" href={c.large} target="_blank" rel="noopener noreferrer">
                <img
                  src={c.image}
                  alt={`${c.issuer} tarafından verilen belge: ${c.title}`}
                  width="480"
                  height="640"
                  loading={i < 4 ? undefined : 'lazy'}
                />
              </a>
              <div class="ib__info">
                <p class="ib__meta">
                  {c.issuer}
                  {c.date && <> · {c.date}</>}
                </p>
                <h2>{c.title}</h2>
                {c.projectHref && (
                  <a class="ib__project" href={c.projectHref}>
                    {c.projectName}
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .ib {
    padding-block: clamp(48px, 5vw, 80px) clamp(80px, 9vw, 140px);
    background: var(--color-bg-light);
  }

  .ib__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ib__card {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius);
    background: #fff;
    overflow: hidden;
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .ib__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .ib__doc {
    display: block;
    padding: 12px 12px 0;
  }

  .ib__doc img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--color-border);
  }

  .ib__info {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 14px 16px 18px;
  }

  .ib__meta {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-orange-text);
  }

  .ib__info h2 {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-navy-deep);
  }

  .ib__project {
    justify-self: start;
    margin-top: 4px;
    padding-bottom: 2px;
    border-bottom: 1.5px solid var(--color-orange);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-navy);
  }

  @media (max-width: 1024px) {
    .ib__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .ib__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }
</style>
