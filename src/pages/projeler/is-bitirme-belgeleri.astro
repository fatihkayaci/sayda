---
import Layout from '../../layouts/Layout.astro';

// Canlı sitedeki iş bitirme belgesi görselleri (25 adet), sırası canlıdaki gibi.
const belgeler = Array.from({ length: 25 }, (_, i) => String(i + 1).padStart(2, '0'));
---

<Layout
  title="İş Bitirme Belgeleri | Sayda İnşaat"
  description="Sayda İnşaat'ın tamamlanan projelerine ait iş bitirme belgeleri."
  heading="İş Bitirme Belgeleri"
>
  <section class="intro">
    <div class="container">
      <p class="intro__title">İŞ BİTİRME BELGELERİ</p>
    </div>
  </section>

  <section class="gallery-section">
    <div class="container">
      <div class="gallery">
        {
          belgeler.map((n, i) => (
            <a class="gallery__item" href={`/img/is-bitirme/is-bitirme-${n}-buyuk.webp`} target="_blank" rel="noopener noreferrer">
              <img
                src={`/img/is-bitirme/is-bitirme-${n}.webp`}
                alt={`Sayda İnşaat iş bitirme belgesi ${i + 1}`}
                width="360"
                height="480"
                loading={i < 3 ? undefined : 'lazy'}
              />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .intro {
    padding: 50px 0 40px;
    background: #fff;
  }

  .container {
    max-width: 1170px;
    margin-inline: auto;
    padding-inline: 15px;
  }

  .intro__title {
    position: relative;
    margin: 0;
    padding-bottom: 14px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    color: #333;
  }

  .intro__title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 35px;
    height: 2px;
    background: #f69c00;
  }

  .gallery-section {
    padding: 60px 0 80px;
    background: #f6f6f6;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .gallery__item {
    position: relative;
    display: block;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.08);
  }

  .gallery__item img {
    width: 100%;
    height: auto;
    transition: opacity 0.3s ease;
  }

  .gallery__item:hover img {
    opacity: 0.45;
  }

  @media (max-width: 800px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
