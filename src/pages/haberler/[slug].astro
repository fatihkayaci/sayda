---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import NewsletterBand from '../../components/NewsletterBand.astro';
import haberlerData from '../../data/haberler.json';
import projects from '../../data/projects.json';
import site from '../../data/site.json';
import { articleLd as buildArticleLd, breadcrumbLd as buildBreadcrumbLd } from '../../utils/schema';
import { formatNewsDate, newsCategoryLabel } from '../../utils/news';
import { shortProjectTitle, hasCoverVariants } from '../../utils/project';
import { variant } from '../../utils/image';
import { imageSize } from '../../utils/image-size';

export function getStaticPaths() {
  return haberlerData.map((haber) => ({
    params: { slug: haber.slug },
    props: { haber },
  }));
}

const { haber } = Astro.props;

const sorted = [...haberlerData].sort((a, b) => (a.date < b.date ? 1 : -1));
const index = sorted.findIndex((item) => item.slug === haber.slug);
const newer = sorted[index - 1];
const older = sorted[index + 1];

const others = sorted.filter((item) => item.slug !== haber.slug);
const more = [
  ...others.filter((item) => item.category === haber.category),
  ...others.filter((item) => item.category !== haber.category),
].slice(0, 3);

const paragraphs = haber.content
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
const [lead, ...rest] = paragraphs;

const words = haber.content.split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(words / 200));

const related = 'relatedProject' in haber ? projects.find((p) => p.slug === haber.relatedProject) : undefined;

// Sharp photos of the related project, shown under the article.
const projectPhotos = related
  ? [related.image, ...related.gallery]
      .filter((src, i, all) => all.indexOf(src) === i && src !== haber.image && (imageSize(src)?.width ?? 0) >= 700)
      .slice(0, 6)
  : [];

const url = new URL(`/haberler/${haber.slug}/`, site.url).toString();
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(haber.title);
const shares = [
  { name: 'LinkedIn', icon: 'linkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
  { name: 'X', icon: 'x', href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}` },
  { name: 'Facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
  { name: 'WhatsApp', icon: 'whatsapp', href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}` },
];

const pagePath = `/haberler/${haber.slug}`;
const articleLd = buildArticleLd({
  type: 'NewsArticle',
  headline: haber.title,
  description: 'seoDescription' in haber && haber.seoDescription ? haber.seoDescription : haber.excerpt,
  image: haber.image,
  datePublished: haber.date,
  path: pagePath,
});
const breadcrumbLd = buildBreadcrumbLd(
  [
    { label: 'Ana Sayfa', href: '/' },
    { label: 'Kurumsal', href: '/kurumsal' },
    { label: 'Haberler', href: '/haberler' },
    { label: haber.title },
  ],
  pagePath
);
---

<Layout
  title={'seoTitle' in haber && haber.seoTitle ? haber.seoTitle : `${haber.title} | Sayda İnşaat`}
  description={'seoDescription' in haber && haber.seoDescription ? haber.seoDescription : haber.excerpt}
  ogImage={haber.image}
  publishedTime={haber.date}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article>
    <header class="nd-head">
      <div class="container">
        <nav class="nd-head__breadcrumb" aria-label="Konum">
          <a href="/">Ana Sayfa</a>
          <span aria-hidden="true">/</span>
          <a href="/kurumsal">Kurumsal</a>
          <span aria-hidden="true">/</span>
          <a href="/haberler">Haberler</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{haber.title}</span>
        </nav>

        <a class="nd-head__category" href={`/haberler?kategori=${haber.category}`}>
          <span></span>{newsCategoryLabel[haber.category]}
        </a>
        <h1>{haber.title}</h1>

        <ul class="nd-head__meta">
          <li>
            <Icon name="calendar" size={18} />
            <time datetime={haber.date}>{formatNewsDate(haber.date)}</time>
          </li>
          <li>
            <Icon name="clock" size={18} />
            {readMinutes} dk okuma
          </li>
        </ul>
      </div>
    </header>

    <div class="nd-figure">
      <div class="container">
        <img src={haber.image} alt={haber.title} fetchpriority="high" />
      </div>
    </div>

    <section class="nd-body">
      <div class="container nd-body__inner">
        <aside class="nd-share" aria-label="Paylaş">
          <p>Paylaş</p>
          <div class="nd-share__list">
            {
              shares.map((share) => (
                <a href={share.href} target="_blank" rel="noopener noreferrer" aria-label={`${share.name} ile paylaş`}>
                  <Icon name={share.icon} size={18} />
                </a>
              ))
            }
            <button type="button" data-copy-link={url} aria-label="Bağlantıyı kopyala">
              <Icon name="link" size={18} />
            </button>
          </div>
          <p class="nd-share__status" data-copy-status role="status" aria-live="polite"></p>
        </aside>

        <div class="nd-content">
          {lead && <p class="nd-content__lead">{lead}</p>}
          {rest.map((paragraph) => <p>{paragraph}</p>)}

          {
            related && (
              <a class="nd-related" href={related.href}>
                <img src={hasCoverVariants(related.image) ? variant(related.image, 640) : related.image} alt="" loading="lazy" />
                <span class="nd-related__text">
                  <small>İlgili Proje</small>
                  <strong>{shortProjectTitle(related.name)}</strong>
                  <span>{[related.location.replace(' - ', ' · '), related.area].filter(Boolean).join(' · ')}</span>
                </span>
                <span class="nd-related__arrow" aria-hidden="true">
                  <Icon name="arrow" size={20} />
                </span>
              </a>
            )
          }

          {
            projectPhotos.length >= 3 && related && (
              <div class="nd-photos">
                <p class="nd-photos__label">Projeden Fotoğraflar</p>
                <ul>
                  {projectPhotos.map((src) => (
                    <li>
                      <a href={related.href}>
                        <img src={hasCoverVariants(src) ? variant(src, 640) : src} alt={`${shortProjectTitle(related.name)} projesi`} loading="lazy" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <nav class="nd-pager" aria-label="Haberler arasında gezin">
            {
              older ? (
                <a href={`/haberler/${older.slug}`} class="nd-pager__link">
                  <small>
                    <Icon name="arrowLeft" size={16} /> Önceki Haber
                  </small>
                  <strong>{older.title}</strong>
                </a>
              ) : (
                <span />
              )
            }
            {
              newer && (
                <a href={`/haberler/${newer.slug}`} class="nd-pager__link nd-pager__link--next">
                  <small>
                    Sonraki Haber <Icon name="arrow" size={16} />
                  </small>
                  <strong>{newer.title}</strong>
                </a>
              )
            }
          </nav>
        </div>
      </div>
    </section>
  </article>

  <section class="nd-more">
    <div class="container">
      <div class="nd-more__head">
        <SectionHead label="Diğer Haberler" title="Sahadan daha fazlası." />
        <a href="/haberler">
          Tüm Haberler <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="nd-more__grid">
        {
          more.map((item) => (
            <a class="nd-card" href={`/haberler/${item.slug}`}>
              <span class="nd-card__media">
                <img src={variant(item.image, 640)} alt="" loading="lazy" />
              </span>
              <span class="nd-card__meta">
                {formatNewsDate(item.date)} · {newsCategoryLabel[item.category]}
              </span>
              <span class="nd-card__title">{item.title}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <NewsletterBand />
</Layout>

<script>
  function initCopyLink() {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-link]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    if (!button || !status || button.dataset.ready) return;
    button.dataset.ready = 'true';

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyLink ?? location.href);
        status.textContent = 'Bağlantı kopyalandı.';
      } catch {
        status.textContent = 'Bağlantı kopyalanamadı.';
      }
    });
  }

  initCopyLink();
  document.addEventListener('astro:page-load', initCopyLink);
</script>

<style>
  /* Header */
  .nd-head {
    padding-block: 40px 160px;
    background: var(--color-bg-light);
  }

  .nd-head__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(48px, 6vw, 80px);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .nd-head__breadcrumb a:hover {
    color: var(--color-navy);
  }

  .nd-head__breadcrumb [aria-current] {
    max-width: 40ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
    color: var(--color-navy-deep);
  }

  .nd-head__category {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .nd-head__category span {
    width: 40px;
    height: 3px;
    background: var(--color-orange);
  }

  .nd-head h1 {
    max-width: 22ch;
    margin-top: 28px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(2.25rem, 3.6vw + 1rem, 5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-navy-deep);
  }

  .nd-head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .nd-head__meta li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nd-head__meta :global(svg) {
    color: var(--color-orange-dark);
  }

  /* Figure */
  .nd-figure {
    margin-top: -120px;
  }

  .nd-figure img {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* Body */
  .nd-body {
    padding-block: clamp(56px, 6vw, 96px) clamp(80px, 9vw, 140px);
  }

  .nd-body__inner {
    display: grid;
    grid-template-columns: 200px minmax(0, 760px);
    gap: clamp(32px, 6vw, 96px);
  }

  .nd-share {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
  }

  .nd-share > p:first-child {
    margin-bottom: 16px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .nd-share__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .nd-share__list a,
  .nd-share__list button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--color-navy-deep);
    cursor: pointer;
    transition:
      background var(--transition),
      border-color var(--transition),
      color var(--transition);
  }

  .nd-share__list a:hover,
  .nd-share__list button:hover {
    border-color: var(--color-navy-deep);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .nd-share__status {
    margin-top: 12px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .nd-content p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .nd-content p + p {
    margin-top: 24px;
  }

  .nd-content .nd-content__lead {
    font-size: clamp(1.25rem, 0.6vw + 1rem, 1.625rem);
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-navy-deep);
  }

  .nd-related {
    display: grid;
    grid-template-columns: 160px 1fr auto;
    align-items: center;
    gap: 24px;
    margin-top: 56px;
    padding: 16px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius);
    transition: border-color var(--transition);
  }

  .nd-related:hover {
    border-color: var(--color-navy-deep);
  }

  .nd-photos {
    margin-top: 40px;
  }

  .nd-photos__label {
    margin-bottom: 14px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .nd-photos ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nd-photos a {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
  }

  .nd-photos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .nd-photos a:hover img {
    transform: scale(1.06);
  }

  @media (max-width: 520px) {
    .nd-photos ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .nd-related img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
  }

  .nd-related__text {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .nd-related__text small {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-orange-dark);
  }

  .nd-related__text strong {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 800;
    font-size: 1.375rem;
    line-height: 1.15;
    color: var(--color-navy-deep);
  }

  .nd-related__text span {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .nd-related__arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--color-orange);
    color: var(--color-navy-deep);
  }

  .nd-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 2px solid var(--color-navy-deep);
  }

  .nd-pager__link {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .nd-pager__link--next {
    text-align: right;
  }

  .nd-pager__link small {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .nd-pager__link--next small {
    justify-content: flex-end;
  }

  .nd-pager__link strong {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 800;
    font-size: 1.125rem;
    line-height: 1.25;
    color: var(--color-navy-deep);
    transition: color var(--transition);
  }

  .nd-pager__link:hover strong {
    color: var(--color-navy);
  }

  /* More */
  .nd-more {
    padding-block: clamp(80px, 9vw, 140px);
    background: var(--color-bg-light);
  }

  .nd-more__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .nd-more__head > a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(40px, 5vw, 64px);
    padding-bottom: 6px;
    border-bottom: 2px solid var(--color-orange);
    font-weight: 700;
    white-space: nowrap;
    color: var(--color-navy-deep);
  }

  .nd-more__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .nd-card {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .nd-card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .nd-card__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 5px;
    background: var(--color-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms ease;
  }

  .nd-card:hover .nd-card__media::after {
    transform: none;
  }

  .nd-card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .nd-card:hover img {
    transform: scale(1.05);
  }

  .nd-card__meta {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .nd-card__title {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 800;
    font-size: clamp(1.25rem, 0.6vw + 1rem, 1.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-navy-deep);
    transition: color var(--transition);
  }

  .nd-card:hover .nd-card__title {
    color: var(--color-navy);
  }

  @media (max-width: 1024px) {
    .nd-body__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .nd-share {
      position: static;
      order: 2;
    }

    .nd-more__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .nd-head {
      padding-bottom: 96px;
    }

    .nd-figure {
      margin-top: -64px;
    }

    .nd-figure img {
      aspect-ratio: 4 / 3;
    }

    .nd-related {
      grid-template-columns: 96px minmax(0, 1fr);
    }

    .nd-related__text strong {
      font-size: 1.125rem;
      overflow-wrap: anywhere;
    }

    .nd-related__arrow {
      display: none;
    }

    .nd-pager {
      grid-template-columns: 1fr;
    }

    .nd-pager__link--next,
    .nd-pager__link--next small {
      text-align: left;
      justify-content: flex-start;
    }

    .nd-more__head > a {
      display: none;
    }
  }
</style>
