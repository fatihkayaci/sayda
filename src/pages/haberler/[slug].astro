---
import Layout from '../../layouts/Layout.astro';
import haberlerData from '../../data/haberler.json';

export function getStaticPaths() {
  return haberlerData.map((haber) => ({
    params: { slug: haber.slug },
    props: { haber },
  }));
}

const { haber } = Astro.props;
const formatter = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={`${haber.title} | Sayda İnşaat`} description={haber.excerpt}>
  <article class="haber-detail">
    <div class="container">
      <a class="haber-detail__back" href="/haberler">← Tüm haberler</a>
      <span class="haber-detail__date">{formatter.format(new Date(haber.date))}</span>
      <h1>{haber.title}</h1>
      <img src={haber.image} alt={haber.title} />
      <p class="haber-detail__content">{haber.content}</p>
    </div>
  </article>
</Layout>

<style>
  .haber-detail {
    padding-top: calc(var(--header-h) + var(--space-l));
    padding-bottom: var(--space-xl);
  }

  .haber-detail .container {
    max-width: 760px;
  }

  .haber-detail__back {
    display: inline-block;
    margin-bottom: var(--space-m);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--color-navy);
  }

  .haber-detail__date {
    display: block;
    font-size: var(--fs-small);
    color: var(--color-text-faint);
  }

  .haber-detail h1 {
    margin-top: var(--space-xs);
    font-size: var(--fs-h1);
  }

  .haber-detail img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-top: var(--space-l);
  }

  .haber-detail__content {
    margin-top: var(--space-l);
    color: var(--color-text-muted);
    max-width: 65ch;
  }
</style>
