---
import Layout from '../../layouts/Layout.astro';
import NewsSidebar from '../../components/NewsSidebar.astro';
import haberlerData from '../../data/haberler.json';

export function getStaticPaths() {
  return haberlerData.map((haber) => ({
    params: { slug: haber.slug },
    props: { haber },
  }));
}

const { haber } = Astro.props;
const [y, m, d] = haber.date.split('-').map(Number);
const date = `${d}.${m}.${y}`;

const paragraphs = haber.content
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<Layout title={`${haber.title} | Sayda İnşaat`} description={haber.excerpt} ogImage={haber.image} heading={haber.title}>
  <section class="page">
    <div class="container news-layout">
      <article>
        <p>{haber.title}</p>
        <div class="news-item__img">
          <img src={haber.image} alt={haber.title} width="630" height="430" fetchpriority="high" />
          <span class="news-item__date">{date}</span>
        </div>
        <h2>{haber.title}</h2>
        {paragraphs.map((paragraph) => <p class="body">{paragraph}</p>)}
        <p><a href="/haberler">← Tüm Haberler</a></p>
      </article>
      <NewsSidebar />
    </div>
  </section>
</Layout>

<style>
  .news-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .news-item__img {
    position: relative;
    margin-bottom: 26px;
  }

  .news-item__img img {
    width: 100%;
    height: auto;
    aspect-ratio: 630 / 430;
    object-fit: cover;
  }

  .news-item__date {
    position: absolute;
    top: 0;
    left: 0;
    padding: 28px 14px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    background: #f69c00;
  }

  article h2 {
    padding: 0;
    font-size: 18px;
    color: #000;
  }

  article h2::after {
    display: none;
  }

  .body {
    color: #8e8d8d;
  }

  @media (max-width: 800px) {
    .news-layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
