---
import Layout from '../../layouts/Layout.astro';
import NewsSidebar from '../../components/NewsSidebar.astro';
import haberlerData from '../../data/haberler.json';

const sorted = [...haberlerData].sort((a, b) => (a.date < b.date ? 1 : -1));
const fmt = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${d}.${m}.${y}`;
};
---

<Layout title="Haberler | Sayda İnşaat" description="Sayda İnşaat'tan güncel haberler ve duyurular." heading="Haberler">
  <section class="page">
    <div class="container news-layout">
      <div>
        <p>Bizden Haberler</p>
        {
          sorted.map((haber) => (
            <article class="news-item">
              <a class="news-item__img" href={`/haberler/${haber.slug}`}>
                <img src={haber.image} alt={haber.title} width="630" height="430" loading="lazy" />
                <span class="news-item__date">{fmt(haber.date)}</span>
              </a>
              <h2>
                <a href={`/haberler/${haber.slug}`}>{haber.title}</a>
              </h2>
              <p>{haber.excerpt}</p>
              <a class="news-item__more" href={`/haberler/${haber.slug}`}>
                Devamı.. <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
      <NewsSidebar />
    </div>
  </section>
</Layout>

<style>
  .news-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .news-item {
    margin-bottom: 50px;
    padding-bottom: 40px;
    border-bottom: 1px solid #f0f0f0;
  }

  .news-item__img {
    position: relative;
    display: block;
    margin-bottom: 26px;
  }

  .news-item__img img {
    width: 100%;
    height: auto;
    aspect-ratio: 630 / 430;
    object-fit: cover;
  }

  .news-item__date {
    position: absolute;
    top: 0;
    left: 0;
    padding: 28px 14px 28px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    background: #f69c00;
  }

  .news-item h2 {
    margin: 0 0 10px;
    padding: 0;
    font-size: 18px;
    font-weight: 700;
  }

  .news-item h2::after {
    display: none;
  }

  .news-item h2 a {
    color: #000 !important;
  }

  .news-item p {
    color: #8e8d8d;
  }

  .news-item__more {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #000 !important;
  }

  .news-item__more span {
    color: #f69c00;
  }

  @media (max-width: 800px) {
    .news-layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
