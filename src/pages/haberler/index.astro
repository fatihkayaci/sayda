---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import NewsletterBand from '../../components/NewsletterBand.astro';
import haberlerData from '../../data/haberler.json';
import projects from '../../data/projects.json';
import { variant } from '../../utils/image';
import { formatNewsDate, newsCategories, newsCategoryLabel } from '../../utils/news';

const hero = projects.find((p) => p.slug === 'referans-kartal-loca-2')!;
const sorted = [...haberlerData].sort((a, b) => (a.date < b.date ? 1 : -1));
const [featured] = sorted;

const years = [...new Set(sorted.map((h) => h.date.slice(0, 4)))];
const groups = years.map((year) => ({ year, items: sorted.filter((h) => h.date.startsWith(year)) }));

const chips = [
  { key: 'all', label: 'Tümü', count: sorted.length },
  ...newsCategories
    .map((c) => ({ ...c, count: sorted.filter((h) => h.category === c.key).length }))
    .filter((c) => c.count > 0),
];
---

<Layout ogImage={hero.image} title="Haberler: Projelerimizden Son Gelişmeler | Sayda İnşaat" description="Sayda İnşaat'tan güncel haberler: başlayan ve teslim edilen projeler, ince işler uygulamaları ve şirket duyuruları.">
  <PageHero
    eyebrow="Haberler"
    breadcrumbs={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Haberler' }]}
    variant="photo"
    image={hero.image}
    imagePosition="center"
    credit={'imageCredit' in hero ? hero.imageCredit : undefined}
    backdrop={years[0]}
    facts={[
      { value: String(sorted.length), label: 'Haber' },
      { value: String(chips.length - 1), label: 'Kategori' },
      { value: `${years[years.length - 1]} – ${years[0]}`, label: 'Arşiv' },
    ]}
    size="compact"
  >
    Sahadan <em>haberler.</em>
  </PageHero>

  {
    featured && (
      <section class="nw-featured">
        <div class="container nw-featured__inner">
          <a class="nw-featured__media" href={`/haberler/${featured.slug}`} tabindex="-1" aria-hidden="true">
            <img src={featured.image} alt="" loading="lazy" />
          </a>
          <div class="nw-featured__text">
            <p class="nw-label">Son Haber</p>
            <p class="nw-featured__meta">
              {formatNewsDate(featured.date)} <span>·</span> {newsCategoryLabel[featured.category]}
            </p>
            <h2>
              <a href={`/haberler/${featured.slug}`}>{featured.title}</a>
            </h2>
            <p class="nw-featured__excerpt">{featured.excerpt}</p>
            <a class="nw-featured__link" href={`/haberler/${featured.slug}`}>
              Haberi Oku <Icon name="arrow" size={20} />
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="nw-archive" data-news>
    <div class="container">
      <SectionHead label="Arşiv" title="Tüm haberler." />

      <div class="nw-toolbar">
        <div class="nw-chips" role="group" aria-label="Haber kategorisi">
          {
            chips.map((chip) => (
              <button type="button" class="nw-chip" data-category-chip={chip.key} aria-pressed={chip.key === 'all' ? 'true' : 'false'}>
                {chip.label} <span>{chip.count}</span>
              </button>
            ))
          }
        </div>
        <label class="nw-search">
          <span class="sr-only">Haberlerde ara</span>
          <Icon name="search" size={20} />
          <input type="search" placeholder="Haberlerde ara" data-news-search autocomplete="off" />
        </label>
      </div>

      {
        groups.map((group) => (
          <div class="nw-year" data-year-group>
            <p class="nw-year__label" aria-hidden="true">
              {group.year}
            </p>
            <ol class="nw-list">
              {group.items.map((item) => (
                <li data-news-item data-category={item.category} data-search={`${item.title} ${item.excerpt}`}>
                  <a class="nw-row" href={`/haberler/${item.slug}`}>
                    <img src={variant(item.image, 640)} alt="" loading="lazy" />
                    <span class="nw-row__body">
                      <span class="nw-row__meta">
                        <time datetime={item.date}>{formatNewsDate(item.date)}</time>
                        <span>{newsCategoryLabel[item.category]}</span>
                      </span>
                      <span class="nw-row__title">{item.title}</span>
                      <span class="nw-row__excerpt">{item.excerpt}</span>
                    </span>
                    <span class="nw-row__arrow" aria-hidden="true">
                      <Icon name="arrow" size={22} />
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }

      <p class="nw-empty" data-news-empty hidden>Aramanıza uygun haber bulunamadı.</p>
    </div>
  </section>

  <NewsletterBand />
</Layout>

<script>
  function initNews() {
    const root = document.querySelector<HTMLElement>('[data-news]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const chips = root.querySelectorAll<HTMLButtonElement>('[data-category-chip]');
    const search = root.querySelector<HTMLInputElement>('[data-news-search]')!;
    const items = root.querySelectorAll<HTMLElement>('[data-news-item]');
    const groups = root.querySelectorAll<HTMLElement>('[data-year-group]');
    const empty = root.querySelector<HTMLElement>('[data-news-empty]')!;
    const normalize = (value: string) => value.toLocaleLowerCase('tr').trim();
    let category = 'all';

    const apply = () => {
      const query = normalize(search.value);
      let visible = 0;
      items.forEach((item) => {
        const show =
          (category === 'all' || item.dataset.category === category) &&
          (!query || normalize(item.dataset.search ?? '').includes(query));
        item.hidden = !show;
        if (show) visible++;
      });
      groups.forEach((group) => (group.hidden = !group.querySelector('[data-news-item]:not([hidden])')));
      empty.hidden = visible > 0;
    };

    const select = (key: string) => {
      category = key;
      chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.categoryChip === key)));
      apply();
    };

    chips.forEach((chip) => chip.addEventListener('click', () => select(chip.dataset.categoryChip ?? 'all')));
    search.value = '';
    search.addEventListener('input', apply);

    const requested = new URLSearchParams(location.search).get('kategori');
    const known = [...chips].some((chip) => chip.dataset.categoryChip === requested);
    select(requested && known ? requested : 'all');
    if (requested && known) root.scrollIntoView();
  }

  initNews();
  document.addEventListener('astro:page-load', initNews);
</script>

<style>
  .nw-label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .nw-label::before {
    content: '';
    width: 40px;
    height: 3px;
    background: var(--color-orange);
  }

  /* Featured */
  .nw-featured {
    padding-block: clamp(80px, 9vw, 140px);
    background: var(--color-bg);
  }

  .nw-featured__inner {
    display: grid;
    grid-template-columns: 7fr 5fr;
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .nw-featured__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .nw-featured__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 6px;
    background: var(--color-orange);
  }

  .nw-featured__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .nw-featured__media:hover img {
    transform: scale(1.05);
  }

  .nw-featured__text {
    display: grid;
    justify-items: start;
    gap: 24px;
  }

  .nw-featured__meta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .nw-featured__meta span {
    margin-inline: 6px;
    color: var(--color-orange);
  }

  .nw-featured h2 {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(2rem, 2.4vw + 1rem, 3.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-navy-deep);
  }

  .nw-featured h2 a:hover {
    color: var(--color-navy);
  }

  .nw-featured__excerpt {
    max-width: 46ch;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .nw-featured__link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--color-orange);
    font-weight: 700;
    color: var(--color-navy-deep);
  }

  .nw-featured__link:hover {
    color: var(--color-navy);
  }

  /* Archive */
  .nw-archive {
    padding-block: clamp(80px, 9vw, 140px);
    background: var(--color-bg-light);
  }

  .nw-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: 56px;
    padding-block: 24px;
    border-block: 1px solid var(--color-border-strong);
  }

  .nw-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .nw-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-navy-deep);
    cursor: pointer;
    transition:
      background var(--transition),
      border-color var(--transition),
      color var(--transition);
  }

  .nw-chip span {
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }

  .nw-chip:hover {
    border-color: var(--color-navy);
  }

  .nw-chip[aria-pressed='true'] {
    border-color: var(--color-navy-deep);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .nw-chip[aria-pressed='true'] span {
    color: var(--color-orange);
  }

  .nw-search {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(320px, 100%);
    padding: 0 16px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 999px;
    background: #fff;
    color: var(--color-navy);
  }

  .nw-search:focus-within {
    border-color: var(--color-navy);
  }

  .nw-search input {
    flex: 1;
    min-width: 0;
    height: 44px;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 0.875rem;
    outline: none;
  }

  .nw-year {
    display: grid;
    grid-template-columns: minmax(0, 240px) 1fr;
    gap: 40px;
    align-items: start;
  }

  .nw-year + .nw-year {
    margin-top: 72px;
  }

  .nw-year[hidden],
  [data-news-item][hidden] {
    display: none;
  }

  .nw-year__label {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 900;
    font-size: clamp(3.5rem, 3vw + 1.5rem, 5.5rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-navy);
  }

  .nw-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--color-navy-deep);
  }

  .nw-row {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    align-items: center;
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-navy-deep);
  }

  .nw-row img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    filter: grayscale(0.35);
    transition: filter 400ms ease;
  }

  .nw-row:hover img {
    filter: none;
  }

  .nw-row__body {
    display: grid;
    gap: 10px;
  }

  .nw-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .nw-row__meta span {
    color: var(--color-navy);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nw-row__title {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 800;
    font-size: clamp(1.25rem, 0.8vw + 1rem, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    transition: color var(--transition);
  }

  .nw-row:hover .nw-row__title {
    color: var(--color-navy);
  }

  .nw-row__excerpt {
    max-width: 70ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .nw-row__arrow {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 50%;
    transition:
      background 300ms ease,
      border-color 300ms ease,
      transform 300ms ease;
  }

  .nw-row:hover .nw-row__arrow {
    border-color: var(--color-orange);
    background: var(--color-orange);
    transform: rotate(-45deg);
  }

  .nw-empty {
    padding-block: 48px;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1024px) {
    .nw-featured__inner {
      grid-template-columns: 1fr;
    }

    .nw-year {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .nw-year__label {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .nw-row {
      grid-template-columns: 120px 1fr;
      gap: 20px;
      align-items: start;
    }

    .nw-row__arrow,
    .nw-row__excerpt {
      display: none;
    }
  }
</style>
