---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import SvcSteps from '../../components/service/SvcSteps.astro';
import site from '../../data/site.json';

const perks = [
  { title: 'Büyük ölçekli projeler', description: 'Vadistanbul, Büyükyalı, şehir hastaneleri gibi prestijli işler.' },
  { title: 'Güçlü iş ortakları', description: "Türkiye'nin önde gelen yatırımcı ve yüklenicileriyle çalışma." },
  { title: 'Süreklilik', description: '30 yıla yakın geçmiş ve uzun soluklu iş birlikleri.' },
  { title: 'İş güvenliği', description: 'ISO standartlarında, güvenliği önceleyen şantiyeler.' },
];

const flow = [
  { title: 'Başvuru', description: 'Formu doldurup gönderin.' },
  { title: 'Ön değerlendirme', description: 'İK ekibimiz başvurunuzu inceler.' },
  { title: 'Görüşme', description: 'Uygun adaylarla ofiste veya şantiyede görüşülür.' },
];
---

<Layout
  title="İnsan Kaynakları | Sayda İnşaat"
  description="Sayda İnşaat ekibine katılın: Beyaz Yaka ve Kalfa (Ekipli) pozisyonları için başvuru formu."
  hideCtaBanner
>
  <PageHero
    eyebrow="İnsan Kaynakları"
    breadcrumbs={[
      { label: 'Ana Sayfa', href: '/' },
      { label: 'İnsan Kaynakları' },
    ]}
    image="/img/projects/buyukyali/buyukyali.webp"
    size="short"
  >
    Ekibimize <em>katılın.</em>
  </PageHero>

  <section class="ik-apply" id="basvuru">
    <div class="container">
      <SectionHead label="Başvuru Formu" title="Hangi pozisyon için başvuruyorsunuz?" />

      <div class="ik-tabs">
        <button type="button" class="ik-tab" data-tab="beyaz">
          <span class="ik-tab__num">01</span>
          <span class="ik-tab__mark" aria-hidden="true"><Icon name="check" size={22} /></span>
          <span class="ik-tab__title">Beyaz Yaka</span>
          <span class="ik-tab__desc">Mühendis, mimar, şantiye şefi, teknik ofis ve idari pozisyonlar.</span>
        </button>
        <button type="button" class="ik-tab" data-tab="kalfa">
          <span class="ik-tab__num">02</span>
          <span class="ik-tab__mark" aria-hidden="true"><Icon name="check" size={22} /></span>
          <span class="ik-tab__title">Kalfa (Ekipli)</span>
          <span class="ik-tab__desc">Sıva, şap, seramik, alçı, boya ve ince işlerde ekibiyle çalışan ustalar.</span>
        </button>
      </div>

      <div class="ik-layout">
        <div class="ik-form-card">
          <form id="ikForm">
            <input type="hidden" name="form_type" value="career" />
            <input type="hidden" name="subject" value="İK Başvurusu" />
            <input type="hidden" name="position_type" id="ikPositionType" value="Beyaz Yaka" />
            <input type="checkbox" name="botcheck" class="ik-honeypot" tabindex="-1" autocomplete="off" />

            <div class="ik-section-label">01 · KİŞİSEL BİLGİLER</div>
            <div class="ik-grid">
              <label>
                <span>Ad Soyad *</span>
                <input type="text" name="name" required />
              </label>
              <label data-tab-only="kalfa" hidden>
                <span>Doğum Yeri / Tarihi *</span>
                <input type="text" name="birth_info" placeholder="Örn. İstanbul / 01.01.1985" />
              </label>
              <label>
                <span>Telefon *</span>
                <input type="tel" name="phone" placeholder="05xx xxx xx xx" required />
              </label>
              <label>
                <span>E-posta *</span>
                <input type="email" name="email" placeholder="ornek@mail.com" required />
              </label>
              <label data-tab-only="kalfa" hidden class="ik-grid__full">
                <span>Adres *</span>
                <input type="text" name="address" />
              </label>
              <label data-tab-only="beyaz">
                <span>Başvurulan pozisyon</span>
                <input type="text" name="position" placeholder="Örn. Şantiye Mühendisi" />
              </label>
            </div>

            <div data-tab-only="beyaz">
              <div class="ik-section-label ik-section-label--spaced">02 · ÖZGEÇMİŞ</div>
              <label class="ik-upload">
                <input type="file" name="cv" accept=".pdf,.doc,.docx" required />
                <span class="ik-upload__icon" aria-hidden="true"><Icon name="download" size={22} /></span>
                <span class="ik-upload__text">
                  <b id="ikCvLabel">CV yükleyin *</b>
                  <span>PDF veya Word · en fazla 5 MB</span>
                </span>
              </label>
            </div>

            <div data-tab-only="kalfa" hidden>
              <div class="ik-section-label ik-section-label--spaced">02 · İŞ TECRÜBELERİ</div>
              <div class="ik-experiences">
                {
                  [1, 2, 3].map((i) => (
                    <div class="ik-experience">
                      <div class="ik-experience__head">
                        <span class="ik-experience__num">{`0${i}`}</span>
                        Proje {i}
                      </div>
                      <div class="ik-experience__grid">
                        <label>
                          <span>Proje adı / yapılan iş</span>
                          <input type="text" name={`exp${i}_project`} placeholder="Örn. Vadistanbul — seramik & şap" />
                        </label>
                        <label>
                          <span>İşveren temsilcisi</span>
                          <input type="text" name={`exp${i}_contact`} placeholder="Ad Soyad" />
                        </label>
                        <label>
                          <span>Temsilci telefonu</span>
                          <input type="tel" name={`exp${i}_contact_phone`} placeholder="05xx xxx xx xx" />
                        </label>
                      </div>
                    </div>
                  ))
                }
              </div>
              <label class="ik-team">
                <span>Ekip bilgisi</span>
                <input type="text" name="team_info" placeholder="Ekip büyüklüğü ve uzmanlık (örn. 6 kişi · sıva & alçı)" />
              </label>
            </div>

            <label class="ik-consent">
              <input type="checkbox" name="kvkk" required />
              <span>
                Yukarıdaki bilgilerin şahsıma ait olduğunu onaylıyorum; <a href="/kvkk-aydinlatma-metni" target="_blank" rel="noopener noreferrer">KVKK Aydınlatma Metni</a>'ni okudum.
              </span>
            </label>

            <button type="submit" class="ik-submit">
              Başvuruyu Gönder <Icon name="arrow" size={18} />
            </button>
            <p class="ik-status" id="ikStatus" role="status" aria-live="polite"></p>
          </form>

          <div class="ik-success" id="ikSuccess" hidden>
            <span class="ik-success__icon" aria-hidden="true"><Icon name="check" size={28} /></span>
            <h3>Başvurunuz alındı.</h3>
            <p>İnsan kaynakları ekibimiz başvurunuzu inceleyip sizinle iletişime geçecek.</p>
            <button type="button" class="ik-reset" id="ikReset">Yeni Başvuru</button>
          </div>
        </div>

        <aside class="ik-sidebar">
          <div class="ik-flow">
            <div class="ik-flow__label">BAŞVURU SÜRECİ</div>
            {
              flow.map((f, i) => (
                <div class="ik-flow__item">
                  <span class="ik-flow__num">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <div class="ik-flow__title">{f.title}</div>
                    <div class="ik-flow__text">{f.description}</div>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="ik-contact-card">
            <div class="ik-contact-card__label">SORULARINIZ İÇİN</div>
            <a href={`mailto:${site.email}`} class="ik-contact-card__email">{site.email}</a>
            <a href={site.phoneHref} class="ik-contact-card__phone">{site.phone}</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <SvcSteps
    label="Neden Sayda?"
    title="Büyük işlerde, güçlü bir ekip."
    text={`${site.foundedYear}'dan bu yana İstanbul'un en büyük projelerinde birlikte çalıştığımız ekibimizi büyütüyoruz.`}
    steps={perks}
  />
</Layout>

<script>
  const LABELS: Record<string, string> = { beyaz: 'Beyaz Yaka', kalfa: 'Kalfa (Ekipli)' };
  const HASHES: Record<string, string> = { beyaz: 'beyaz-yaka', kalfa: 'kalfa-ekipli' };

  function initCareerTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.ik-tab');
    const tabOnlyEls = document.querySelectorAll<HTMLElement>('[data-tab-only]');
    const tabLabelEl = document.getElementById('ikTabLabel');
    const positionTypeInput = document.getElementById('ikPositionType') as HTMLInputElement | null;
    const cvInput = document.querySelector<HTMLInputElement>('input[name="cv"]');
    const cvLabel = document.getElementById('ikCvLabel');
    if (!tabButtons.length) return;

    const setTab = (tab: string) => {
      tabButtons.forEach((btn) => {
        const active = btn.dataset.tab === tab;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
      tabOnlyEls.forEach((el) => {
        el.hidden = el.dataset.tabOnly !== tab;
      });
      if (tabLabelEl) tabLabelEl.textContent = LABELS[tab];
      if (positionTypeInput) positionTypeInput.value = LABELS[tab];
      if (cvInput) cvInput.required = tab === 'beyaz';
      try {
        const url = tab === 'beyaz' ? location.pathname + location.search : '#' + HASHES[tab];
        history.replaceState(null, '', url);
      } catch {
        /* noop */
      }
    };

    tabButtons.forEach((btn) => btn.addEventListener('click', () => setTab(btn.dataset.tab ?? 'beyaz')));

    const applyHash = () => {
      const h = (location.hash || '').slice(1);
      setTab(h === 'kalfa-ekipli' ? 'kalfa' : 'beyaz');
    };
    applyHash();
    window.addEventListener('hashchange', applyHash);

    if (cvInput && cvLabel) {
      cvInput.addEventListener('change', () => {
        const file = cvInput.files?.[0];
        cvLabel.textContent = file ? file.name : 'CV yükleyin *';
      });
    }
  }

  function initCareerForm() {
    const form = document.getElementById('ikForm') as HTMLFormElement | null;
    const status = document.getElementById('ikStatus');
    const success = document.getElementById('ikSuccess');
    const resetBtn = document.getElementById('ikReset');
    if (!form || !status || !success) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitButton.disabled = true;
      status.textContent = 'Gönderiliyor...';
      status.removeAttribute('data-state');

      try {
        const res = await fetch('/form.php', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await res.json();
        if (!result.success) throw new Error(result.message ?? 'Unknown error');
        form.hidden = true;
        success.hidden = false;
        status.textContent = '';
      } catch {
        status.textContent = 'Gönderilemedi, lütfen telefonla ulaşın.';
        status.setAttribute('data-state', 'error');
      } finally {
        submitButton.disabled = false;
      }
    });

    resetBtn?.addEventListener('click', () => {
      form.reset();
      form.hidden = false;
      success.hidden = true;
      status.textContent = '';
      initCareerTabs();
    });
  }

  function init() {
    initCareerTabs();
    initCareerForm();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* Apply */
  .ik-apply {
    padding-block: clamp(48px, 5vw, 80px) clamp(80px, 9vw, 140px);
    background: var(--color-bg-light);
    scroll-margin-top: var(--header-h);
  }

  .ik-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .ik-tab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 10px 20px;
    padding: 32px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: #fff;
    text-align: left;
    font-family: inherit;
    color: var(--color-navy-deep);
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s,
      border-color 0.25s;
  }

  .ik-tab:hover {
    border-color: var(--color-navy-deep);
  }

  .ik-tab.is-active {
    border-color: var(--color-navy-deep);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .ik-tab__num {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 2.5rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-navy);
  }

  .ik-tab.is-active .ik-tab__num {
    -webkit-text-stroke-color: var(--color-orange);
  }

  .ik-tab__mark {
    grid-row: span 3;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 50%;
    color: transparent;
    transition:
      background 0.25s,
      border-color 0.25s,
      color 0.25s;
  }

  .ik-tab.is-active .ik-tab__mark {
    border-color: var(--color-orange);
    background: var(--color-orange);
    color: var(--color-navy-deep);
  }

  .ik-tab__title {
    margin-top: 8px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(1.5rem, 1vw + 1rem, 2rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .ik-tab__desc {
    font-size: 0.9375rem;
    line-height: 1.55;
    opacity: 0.75;
  }

  .ik-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 40px;
    align-items: start;
  }

  .ik-form-card {
    min-width: 0;
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius);
    background: #fff;
  }

  .ik-section-label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--color-navy);
  }

  .ik-section-label::before {
    content: '';
    width: 28px;
    height: 3px;
    background: var(--color-orange);
  }

  .ik-section-label--spaced {
    margin-top: 44px;
  }

  .ik-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .ik-grid__full {
    grid-column: 1 / -1;
  }

  .ik-form-card [hidden] {
    display: none !important;
  }

  .ik-form-card label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-navy-deep);
  }

  .ik-form-card input[type='text'],
  .ik-form-card input[type='tel'],
  .ik-form-card input[type='email'] {
    width: 100%;
    height: 54px;
    padding: 0 16px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: #fff;
    font-family: inherit;
    font-size: 0.9375rem;
    color: var(--color-text);
    transition: border-color var(--transition);
  }

  .ik-form-card input:focus {
    outline: none;
    border-color: var(--color-navy);
  }

  .ik-upload {
    flex-direction: row !important;
    align-items: center;
    gap: 20px !important;
    margin-top: 20px;
    padding: 26px 24px;
    border: 1.5px dashed var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg-light);
    cursor: pointer;
    transition: border-color var(--transition);
  }

  .ik-upload:hover {
    border-color: var(--color-navy);
  }

  .ik-upload input[type='file'] {
    display: none;
  }

  .ik-upload__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--color-navy-deep);
    color: #fff;
    transform: rotate(180deg);
  }

  .ik-upload__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .ik-upload__text b {
    overflow: hidden;
    font-size: 1rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-navy-deep);
  }

  .ik-upload__text > span {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .ik-experiences {
    display: flex;
    flex-direction: column;
    margin-top: 20px;
    border-top: 2px solid var(--color-navy-deep);
  }

  .ik-experience {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .ik-experience__head {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-navy-deep);
  }

  .ik-experience__num {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    color: var(--color-orange-dark);
  }

  .ik-experience__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 14px;
  }

  .ik-team {
    margin-top: 20px;
  }

  .ik-consent {
    flex-direction: row !important;
    align-items: flex-start;
    gap: 12px !important;
    margin-top: 32px;
    font-size: 0.875rem !important;
    font-weight: 400 !important;
    line-height: 1.5;
    color: var(--color-text-muted) !important;
    cursor: pointer;
  }

  .ik-consent input {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--color-navy);
  }

  .ik-consent a {
    font-weight: 700;
    color: var(--color-navy);
  }

  .ik-submit {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 58px;
    margin-top: 28px;
    padding: 0 32px;
    border: none;
    border-radius: var(--radius);
    background: var(--color-orange);
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-navy-deep);
    cursor: pointer;
    transition: background var(--transition);
  }

  .ik-submit:hover {
    background: var(--color-orange-dark);
  }

  .ik-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ik-status {
    margin: 16px 0 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .ik-status[data-state='error'] {
    color: var(--color-error);
  }

  .ik-honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .ik-success {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 40px 0;
  }

  .ik-success[hidden] {
    display: none;
  }

  .ik-success__icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-orange);
    color: var(--color-navy-deep);
  }

  .ik-success h3 {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(1.75rem, 1.5vw + 1rem, 2.5rem);
    color: var(--color-navy-deep);
  }

  .ik-success p {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .ik-reset {
    height: 50px;
    margin-top: 8px;
    padding: 0 24px;
    border: 1.5px solid var(--color-navy-deep);
    border-radius: var(--radius);
    background: transparent;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-navy-deep);
    cursor: pointer;
    transition:
      background var(--transition),
      color var(--transition);
  }

  .ik-reset:hover {
    background: var(--color-navy-deep);
    color: #fff;
  }

  /* Sidebar */
  .ik-sidebar {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ik-flow {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px 30px;
    border-radius: var(--radius);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .ik-flow__label,
  .ik-contact-card__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.6);
  }

  .ik-flow__item {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .ik-flow__num {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.2px var(--color-orange);
  }

  .ik-flow__title {
    font-weight: 700;
  }

  .ik-flow__text {
    margin-top: 4px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
  }

  .ik-contact-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 30px;
    border-radius: var(--radius);
    background: #fff;
  }

  .ik-contact-card__label {
    color: var(--color-text-muted);
  }

  .ik-contact-card__email {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--color-navy);
    overflow-wrap: anywhere;
