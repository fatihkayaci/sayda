---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import SvcSteps from '../../components/service/SvcSteps.astro';
import CareerForm from '../../components/CareerForm.astro';
import site from '../../data/site.json';

const perks = [
  { title: 'Büyük ölçekli projeler', description: 'Vadistanbul, Büyükyalı, şehir hastaneleri gibi prestijli işler.' },
  { title: 'Güçlü iş ortakları', description: "Türkiye'nin önde gelen yatırımcı ve yüklenicileriyle çalışma." },
  { title: 'Süreklilik', description: '30 yıla yakın geçmiş ve uzun soluklu iş birlikleri.' },
  { title: 'İş güvenliği', description: 'ISO standartlarında, güvenliği önceleyen şantiyeler.' },
];

const flow = [
  { title: 'Başvuru', description: 'Formu doldurup gönderin.' },
  { title: 'Ön değerlendirme', description: 'İK ekibimiz başvurunuzu inceler.' },
  { title: 'Görüşme', description: 'Uygun adaylarla ofiste veya şantiyede görüşülür.' },
];
---

<Layout ogImage="/img/projects/buyukyali/buyukyali-cover.webp"
  title="İnsan Kaynakları ve Kariyer | Sayda İnşaat"
  description="Sayda İnşaat ekibine katılın: Beyaz Yaka ve Kalfa (Ekipli) pozisyonları için başvuru formu."
  hideCtaBanner
>
  <PageHero
    eyebrow="İnsan Kaynakları"
    breadcrumbs={[
      { label: 'Ana Sayfa', href: '/' },
      { label: 'İletişim', href: '/iletisim' },
      { label: 'İnsan Kaynakları' },
    ]}
    image="/img/projects/buyukyali/buyukyali.webp"
    size="short"
  >
    Ekibimize <em>katılın.</em>
  </PageHero>

  <section class="ik-apply" id="basvuru">
    <div class="container">
      <SectionHead label="Başvuru Formu" title="Hangi pozisyon için başvuruyorsunuz?" />

      <div class="ik-tabs">
        <button type="button" class="ik-tab" data-tab="beyaz">
          <span class="ik-tab__num">01</span>
          <span class="ik-tab__mark" aria-hidden="true"><Icon name="check" size={22} /></span>
          <span class="ik-tab__title">Beyaz Yaka</span>
          <span class="ik-tab__desc">Mühendis, mimar, şantiye şefi, teknik ofis ve idari pozisyonlar.</span>
        </button>
        <button type="button" class="ik-tab" data-tab="kalfa">
          <span class="ik-tab__num">02</span>
          <span class="ik-tab__mark" aria-hidden="true"><Icon name="check" size={22} /></span>
          <span class="ik-tab__title">Kalfa (Ekipli)</span>
          <span class="ik-tab__desc">Sıva, şap, seramik, alçı, boya ve ince işlerde ekibiyle çalışan ustalar.</span>
        </button>
      </div>

      <div class="ik-layout">
        <CareerForm syncHash />

        <aside class="ik-sidebar">
          <div class="ik-flow">
            <div class="ik-flow__label">BAŞVURU SÜRECİ</div>
            {
              flow.map((f, i) => (
                <div class="ik-flow__item">
                  <span class="ik-flow__num">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <div class="ik-flow__title">{f.title}</div>
                    <div class="ik-flow__text">{f.description}</div>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="ik-contact-card">
            <div class="ik-contact-card__label">SORULARINIZ İÇİN</div>
            <a href={`mailto:${site.email}`} class="ik-contact-card__email">{site.email}</a>
            <a href={site.phoneHref} class="ik-contact-card__phone">{site.phone}</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <SvcSteps
    label="Neden Sayda?"
    title="Büyük işlerde, güçlü bir ekip."
    text={`${site.foundedYear}'dan bu yana İstanbul'un en büyük projelerinde birlikte çalıştığımız ekibimizi büyütüyoruz.`}
    steps={perks}
  />
</Layout>

<style>
  /* Apply */
  .ik-apply {
    padding-block: clamp(48px, 5vw, 80px) clamp(80px, 9vw, 140px);
    background: var(--color-bg-light);
    scroll-margin-top: var(--header-h);
  }

  .ik-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .ik-tab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 10px 20px;
    padding: 32px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: #fff;
    text-align: left;
    font-family: inherit;
    color: var(--color-navy-deep);
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s,
      border-color 0.25s;
  }

  .ik-tab:hover {
    border-color: var(--color-navy-deep);
  }

  .ik-tab.is-active {
    border-color: var(--color-navy-deep);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .ik-tab__num {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 2.5rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-navy);
  }

  .ik-tab.is-active .ik-tab__num {
    -webkit-text-stroke-color: var(--color-orange);
  }

  .ik-tab__mark {
    grid-row: span 3;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 50%;
    color: transparent;
    transition:
      background 0.25s,
      border-color 0.25s,
      color 0.25s;
  }

  .ik-tab.is-active .ik-tab__mark {
    border-color: var(--color-orange);
    background: var(--color-orange);
    color: var(--color-navy-deep);
  }

  .ik-tab__title {
    margin-top: 8px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(1.5rem, 1vw + 1rem, 2rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .ik-tab__desc {
    font-size: 0.9375rem;
    line-height: 1.55;
    opacity: 0.75;
  }

  .ik-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 40px;
    align-items: start;
  }

  /* Sidebar */
  .ik-sidebar {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ik-flow {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px 30px;
    border-radius: var(--radius);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .ik-flow__label,
  .ik-contact-card__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.6);
  }

  .ik-flow__item {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .ik-flow__num {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.2px var(--color-orange);
  }

  .ik-flow__title {
    font-weight: 700;
  }

  .ik-flow__text {
    margin-top: 4px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
  }

  .ik-contact-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 30px;
    border-radius: var(--radius);
    background: #fff;
  }

  .ik-contact-card__label {
    color: var(--color-text-muted);
  }

  .ik-contact-card__email {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--color-navy);
    overflow-wrap: anywhere;
  }

  .ik-contact-card__phone {
    font-weight: 600;
    color: var(--color-navy-deep);
  }

  @media (max-width: 1024px) {
    .ik-layout {
      grid-template-columns: 1fr;
    }

    .ik-sidebar {
      position: static;
    }
  }

  @media (max-width: 720px) {
    .ik-tabs {
      grid-template-columns: 1fr;
    }

    .ik-tab {
      padding: 24px;
    }
  }
</style>
