---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
---

<Layout
  title="İnsan Kaynakları | Sayda İnşaat"
  description="Sayda İnşaat ekibine katılın: Beyaz Yaka ve Kalfa (Ekipli) pozisyonları için başvuru formu."
  hideCtaBanner
  heading="İnsan Kaynakları"
>
  <section class="page">
    <div class="container">
      <form id="ikForm" class="ik" enctype="multipart/form-data">
        <input type="hidden" name="access_key" value={site.web3formsAccessKey} />
        <input type="hidden" name="subject" value="İK Başvurusu" />
        <input type="hidden" name="position_type" id="ikPositionType" value="Beyaz Yakalı" />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

        <h2 id="ikTitle">Beyaz Yakalı Başvuru Formu</h2>

        <div class="ik__row">
          <label>
            Ad Soyad <span>*</span>
            <input type="text" name="name" placeholder="Ad Soyad" required />
          </label>
          <label data-tab-only="kalfa" hidden>
            D.Yeri/D.Tarihi <span>*</span>
            <input type="text" name="birth_info" placeholder="D.Yeri/D.Tarihi" />
          </label>
          <label>
            Telefon <span>*</span>
            <input type="tel" name="phone" placeholder="Telefon" required />
          </label>
          <label>
            E-mail <span>*</span>
            <input type="email" name="email" placeholder="E-mail" required />
          </label>
          <label data-tab-only="kalfa" hidden>
            Adres <span>*</span>
            <input type="text" name="address" placeholder="Adres" />
          </label>
          <label data-tab-only="beyaz">
            CV Ekle <span>*</span>
            <input type="file" name="cv" accept=".pdf,.doc,.docx" required />
          </label>
        </div>

        <div data-tab-only="kalfa" hidden>
          <p class="ik__sub"><strong>İş Tecrübeleri</strong></p>
          {
            [1, 2, 3].map((i) => (
              <fieldset class="ik__exp">
                <legend>Proje {i}</legend>
                <div class="ik__row">
                  <input type="text" name={`exp${i}_project`} placeholder="Proje Adı" aria-label={`Proje ${i} adı`} />
                  <input type="text" name={`exp${i}_employer`} placeholder="İşveren" aria-label={`Proje ${i} işveren`} />
                  <input type="text" name={`exp${i}_work`} placeholder="Yapılan İş" aria-label={`Proje ${i} yapılan iş`} />
                  <input type="text" name={`exp${i}_dates`} placeholder="Başlama - Bitiş Tarihleri" aria-label={`Proje ${i} tarihleri`} />
                  <input type="text" name={`exp${i}_workers`} placeholder="Çalışan Usta İşçi Sayısı" aria-label={`Proje ${i} işçi sayısı`} />
                </div>
                <p class="ik__sub"><strong>İşveren Temsilcisi</strong></p>
                <div class="ik__row">
                  <input type="text" name={`exp${i}_contact`} placeholder="Adı - Soyadı" aria-label={`Proje ${i} temsilci adı`} />
                  <input type="tel" name={`exp${i}_contact_phone`} placeholder="Telefon" aria-label={`Proje ${i} temsilci telefonu`} />
                </div>
              </fieldset>
            ))
          }
        </div>

        <label class="ik__consent">
          <input type="checkbox" name="kvkk" required />
          <span>
            Yukarıdaki bilgilerin şahsıma ait olduğunu onaylıyorum;
            <a href="/kvkk-aydinlatma-metni" target="_blank" rel="noopener noreferrer">KVKK Aydınlatma Metni</a>'ni okudum.
          </span>
        </label>

        <button type="submit" class="ik__send">Yükle</button>
        <p id="ikStatus" class="ik__status" role="status" aria-live="polite"></p>
      </form>

      <p id="ikSuccess" class="ik__done" hidden>Başvurunuz alındı. İnsan kaynakları ekibimiz sizinle iletişime geçecek.</p>
    </div>
  </section>
</Layout>

<script>
  const TITLES: Record<string, string> = { beyaz: 'Beyaz Yakalı Başvuru Formu', kalfa: 'Kalfa ( Ekipli ) Başvuru Formu' };
  const TYPES: Record<string, string> = { beyaz: 'Beyaz Yakalı', kalfa: 'Kalfa (Ekipli)' };

  const form = document.getElementById('ikForm') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('ikStatus')!;
    const success = document.getElementById('ikSuccess')!;
    const cv = form.querySelector<HTMLInputElement>('input[name="cv"]');

    const setTab = (tab: string) => {
      form.querySelectorAll<HTMLElement>('[data-tab-only]').forEach((el) => {
        el.hidden = el.dataset.tabOnly !== tab;
      });
      document.getElementById('ikTitle')!.textContent = TITLES[tab];
      (document.getElementById('ikPositionType') as HTMLInputElement).value = TYPES[tab];
      if (cv) cv.required = tab === 'beyaz';
    };
    const applyHash = () => setTab(location.hash === '#kalfa-ekipli' ? 'kalfa' : 'beyaz');
    applyHash();
    window.addEventListener('hashchange', applyHash);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const accessKey = (form.elements.namedItem('access_key') as HTMLInputElement)?.value;
      if (!accessKey) {
        status.textContent = 'Form şu an gönderime kapalı, lütfen telefonla ulaşın.';
        status.setAttribute('data-state', 'error');
        return;
      }
      const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submit.disabled = true;
      status.textContent = 'Gönderiliyor...';
      status.removeAttribute('data-state');
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await res.json();
        if (!result.success) throw new Error(result.message ?? 'Unknown error');
        form.hidden = true;
        success.hidden = false;
      } catch {
        status.textContent = 'Gönderilemedi, lütfen telefonla ulaşın.';
        status.setAttribute('data-state', 'error');
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .ik [hidden],
  .ik__done[hidden] {
    display: none !important;
  }

  .ik h2 {
    margin-bottom: 30px;
  }

  .ik__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 30px;
    margin-bottom: 14px;
  }

  .ik label {
    display: block;
    font-size: 13px;
    color: #333;
  }

  .ik label span {
    color: #f69c00;
  }

  .ik input[type='text'],
  .ik input[type='tel'],
  .ik input[type='email'],
  .ik input[type='file'] {
    margin-top: 4px;
    background: #f6f6f6;
    border: 1px solid #ececec;
  }

  .ik__sub {
    margin: 22px 0 10px;
  }

  .ik__exp {
    margin: 0 0 20px;
    padding: 0 0 10px;
    border: 0;
    border-top: 1px solid #ddd;
  }

  .ik__exp legend {
    padding-right: 10px;
    font-weight: 700;
    color: #333;
  }

  .ik__consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 26px 0 18px;
  }

  .ik__consent span {
    color: #333;
  }

  .ik__consent input {
    width: auto;
    margin-top: 3px;
  }

  .ik__send {
    padding: 0 30px;
    font: inherit;
    font-weight: 700;
    line-height: 40px;
    color: #fff;
    background: #36abfc;
    border: 0;
    cursor: pointer;
  }

  .ik__send:hover {
    background: #f69c00;
  }

  .ik__status[data-state='error'] {
    color: #c0392b;
  }

  .ik__done {
    padding: 20px 0;
    color: #2e7d32;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  @media (max-width: 800px) {
    .ik__row {
      grid-template-columns: 1fr;
    }
  }
</style>
