---
import Layout from '../../layouts/Layout.astro';

const pillars = [
  { title: 'Güvenli Yapılar', text: 'Depreme dayanıklı, uzun ömürlü' },
  { title: 'Uzman Kadro', text: 'Deneyimli mühendis ve mimarlar' },
  { title: 'Yasal Uyum', text: 'Tüm süreçlerde mevzuata uygunluk' },
];

const perks = [
  { num: '01', title: 'Modern Yaşam Alanları', text: 'Konforlu ve estetik projeler' },
  { num: '02', title: 'Şeffaf Süreç', text: 'Arsa ve bina sahiplerine tüm adımlarda bilgilendirme' },
  { num: '03', title: 'Kira ve Kredi Desteği', text: 'Devlet destekleriyle güçlü çözümler' },
  { num: '04', title: 'Deneyim ve Güven', text: 'İstanbul ve çevresinde başarılı projeler' },
];

const steps = [
  ['Risk Tespiti ve Ön Değerlendirme', 'İmar durumu, yapı analizi, risk analizi ve fizibilite çalışması yapılır.'],
  ['Şartname ve Sözleşme', 'Kat karşılığı veya sözleşme koşulları netleştirilir.'],
  ['Projelendirme', 'Mimari, statik, mekanik ve elektrik projeleri hazırlanır.'],
  ['Ruhsat ve Yasal İzinler', 'Gerekli tüm ruhsat ve yasal izin süreçleri yürütülür.'],
  ['İnşaat Süreci', 'Saha ekibimiz projeyi zaman planına göre yürütür.'],
  ['Teslim & İskan', 'İskan belgesi alınır ve anahtar teslimi yapılır.'],
].map(([title, text], index) => ({ num: String(index + 1).padStart(2, '0'), title, text }));

const legal = [
  { title: 'Arsa ve Bina Sahiplerine Özel Çözümler', text: 'Her proje için yerinde analiz ve en uygun dönüşüm modeli.' },
  { title: 'Finansman ve Destek Yönetimi', text: 'Kira yardımı, kredi desteği ve teşvik süreçlerinde danışmanlık.' },
  { title: 'Tek Muhatap, Tüm Süreç', text: 'Projelendirmeden iskan alımına kadar tek ekiple koordinasyon.' },
  { title: 'Şeffaf ve Güvenilir Yaklaşım', text: 'Düzenli bilgilendirme, raporlama ve açık iletişim.' },
];

const faqs = [
  {
    question: 'Kat karşılığı oranı nasıl belirlenir?',
    answer:
      'Arsanın/binanın bulunduğu bölgenin emsal değerleri, imar durumu ve inşaat maliyeti birlikte değerlendirilerek hak sahipleri ile müteahhit arasında karşılıklı olarak belirlenir. Bölgeden bölgeye oran değişebilir.',
  },
  {
    question: 'Süreç ortalama ne kadar sürer?',
    answer:
      'Risk raporu alımından iskana kadar geçen süre binanın büyüklüğüne, kat maliklerinin anlaşma hızına ve ruhsat sürecine bağlıdır. Teknik değerlendirme ve anlaşma aşaması genellikle birkaç ay, inşaat süreci ise proje ölçeğine göre 1–2 yıl sürer.',
  },
  {
    question: 'Kira yardımından kim, nasıl yararlanır?',
    answer:
      "6306 sayılı kanun kapsamında risk raporu alınan binalardaki hak sahipleri, Çevre, Şehircilik ve İklim Değişikliği Bakanlığı'na başvurarak kira yardımı veya kredi desteğinden yararlanabilir. Başvuru için risk raporu, tapu ve hak sahipliğini gösteren belgeler gereklidir.",
  },
  {
    question: 'Kat maliklerinin tamamı anlaşmak zorunda mı?',
    answer: 'Hayır. 6306 sayılı kanun gereği kat maliklerinin en az 2/3 çoğunluğunun kararı yeterlidir; azınlıkta kalanlar bu karara uymak zorundadır.',
  },
  {
    question: 'Müteahhit seçerken nelere dikkat edilmeli?',
    answer:
      'İş bitirme belgesi geçmişi, müteahhitlik yetki belgesi grubu, tamamlanan proje referansları ve sözleşme şartlarının netliği (teslim tarihi, malzeme kalitesi, kat karşılığı oranı) en önemli kriterlerdir.',
  },
  {
    question: 'Riskli yapı tespiti nasıl yapılır?',
    answer:
      'Binanın deprem güvenliği, lisanslı kuruluşlar tarafından yapılan inceleme ve analizlerle belirlenir; sonuç risk raporu olarak düzenlenir. Ayrıntılar için Rehber sayfamızdaki yazıya göz atabilirsiniz.',
  },
];
---

<Layout
  title="Kentsel Dönüşüm | Sayda İnşaat"
  description="Riskli yapı tespiti sonrası süreç yönetimi, kat karşılığı anlaşma ve inşaatın anahtar teslim tamamlanması."
  ctaEyebrow="BİRLİKTE DAHA GÜVENLİ YARINLAR"
  ctaHeading="Kentsel dönüşüm projenizi birlikte hayata geçirelim."
>
  <section class="kd-hero">
    <img class="kd-hero__bg" src="/img/sayda-insaat-hero01.webp" alt="Kentsel dönüşüm şantiyesi" fetchpriority="high" />
    <div class="kd-hero__overlay" aria-hidden="true"></div>

    <div class="container kd-hero__inner">
      <nav class="kd-hero__breadcrumb" aria-label="Konum">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <span aria-current="page">Kentsel Dönüşüm</span>
      </nav>

      <div class="kd-hero__content">
        <div class="eyebrow eyebrow--light">
          <span class="eyebrow__bar"></span>
          <span>Kentsel Dönüşüm</span>
        </div>
        <h1>
          Daha güvenli,<br />daha yaşanabilir<br />
          <span class="kd-hero__accent">bir gelecek için</span>
        </h1>
        <p class="kd-hero__lead">
          Riskli yapı tespitinden anahtar teslimine kadar kentsel dönüşüm sürecinin tamamında bina ve arsa
          sahiplerinin yanındayız. Yasal süreçler, finansman destekleri ve teknik uzmanlığımızla güvenli yaşam
          alanları üretiyoruz.
        </p>
        <div class="kd-hero__buttons">
          <a class="btn btn--fill" href="/iletisim#quote-form">
            Ücretsiz Ön Değerlendirme <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn--outline" href="/rehber">Süreç Hakkında Bilgi Al</a>
        </div>
      </div>

      <ul class="kd-hero__pillars">
        {
          pillars.map((p) => (
            <li>
              <span class="kd-hero__marker" aria-hidden="true"></span>
              <div>
                <div class="kd-hero__pillar-title">{p.title}</div>
                <div class="kd-hero__pillar-text">{p.text}</div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="kd-perks">
    <ul class="container kd-perks__grid">
      {
        perks.map((p) => (
          <li>
            <span class="kd-perks__num">{p.num}</span>
            <div class="kd-perks__title">{p.title}</div>
            <div class="kd-perks__text">{p.text}</div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="kd-process">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">
            <span class="eyebrow__bar"></span>
            <span>Süreç</span>
          </div>
          <h2>Kentsel dönüşüm süreci nasıl işliyor?</h2>
        </div>
        <p>Projenizin her aşamasında şeffaf, planlı ve koordineli bir çalışma modeliyle ilerliyoruz.</p>
      </div>

      <ol class="kd-steps">
        {
          steps.map((step) => (
            <li>
              <div class="kd-steps__top">
                <span class="kd-steps__num">{step.num}</span>
                <span class="kd-steps__badge">ADIM</span>
              </div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="kd-legal">
    <div class="container kd-legal__grid">
      <div class="kd-legal__media">
        <img src="/img/projects/oyakkent-konut/oyakkent-konut.webp" alt="Sayda İnşaat konut projesi" loading="lazy" />
        <div class="kd-legal__badge">
          <span>KANUN</span>
          <strong>6306</strong>
        </div>
      </div>

      <div class="kd-legal__content">
        <div class="eyebrow eyebrow--light">
          <span class="eyebrow__bar"></span>
          <span>Yasal Güvence</span>
        </div>
        <h2>6306 sayılı kanun kapsamında güvenli dönüşüm</h2>
        <p>Kira ve kredi desteği süreçlerinden hak sahiplerinin başvurularına kadar tüm yasal adımlarda sizinleyiz.</p>

        <ul class="kd-legal__list">
          {
            legal.map((item) => (
              <li>
                <span class="kd-legal__marker" aria-hidden="true"></span>
                <div>
                  <div class="kd-legal__item-title">{item.title}</div>
                  <div class="kd-legal__item-text">{item.text}</div>
                </div>
              </li>
            ))
          }
        </ul>

        <a class="kd-legal__link" href="/rehber/6306-sayili-kentsel-donusum-kanunu-nedir">
          Detaylı Bilgi <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="kd-faq">
    <div class="container kd-faq__grid">
      <div class="kd-faq__intro">
        <div class="eyebrow">
          <span class="eyebrow__bar"></span>
          <span>Merak Edilenler</span>
        </div>
        <h2>Sıkça sorulan sorular</h2>
        <p>Aklınıza takılan başka bir soru varsa ekibimiz size yardımcı olmaktan memnuniyet duyar.</p>
        <div class="kd-faq__actions">
          <a class="btn btn--navy-sm" href="/rehber">
            Tüm Soruları Gör <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn--outline-navy" href="tel:+902122238812">+90 212 223 88 12</a>
        </div>
      </div>

      <div class="kd-faq__list">
        {
          faqs.map((faq) => (
            <details class="kd-faq__item" name="kd-faq">
              <summary>
                <span class="kd-faq__question">{faq.question}</span>
                <span class="kd-faq__icon" aria-hidden="true"></span>
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .eyebrow__bar {
    display: block;
    width: 36px;
    height: 2px;
    background: currentColor;
  }

  .eyebrow--light {
    color: #8589e6;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-l);
    margin-bottom: 56px;
  }

  .section-head > div {
    max-width: 640px;
  }

  .section-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: 2.75rem;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-text);
  }

  .section-head p {
    margin: 0;
    max-width: 26ch;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding: 0 28px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background var(--transition),
      color var(--transition),
      border-color var(--transition);
  }

  .btn--fill {
    background: #3e43b8;
    color: #fff;
  }

  .btn--fill:hover {
    background: #4e53d0;
  }

  .btn--outline {
    background: none;
    border: 1.5px solid #8589e6;
    color: #f6f7fb;
  }

  .btn--outline:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .btn--navy-sm {
    height: 50px;
    padding: 0 24px;
    background: var(--color-navy);
    color: #fff;
    font-size: 0.8125rem;
  }

  .btn--navy-sm:hover {
    background: var(--color-navy-dark);
  }

  .btn--outline-navy {
    height: 50px;
    padding: 0 20px;
    border: 1.5px solid rgba(47, 48, 145, 0.3);
    color: var(--color-navy);
    text-transform: none;
    letter-spacing: normal;
  }

  .btn--outline-navy:hover {
    border-color: var(--color-navy);
  }

  /* Hero */
  .kd-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .kd-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kd-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(13, 21, 51, 0.94) 0%, rgba(13, 21, 51, 0.7) 50%, rgba(13, 21, 51, 0.3) 100%);
  }

  .kd-hero__inner {
    position: relative;
    z-index: 1;
    min-height: 720px;
    display: flex;
    flex-direction: column;
    padding-block: 56px 0;
  }

  .kd-hero__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.55);
  }

  .kd-hero__breadcrumb a:hover {
    color: #fff;
  }

  .kd-hero__breadcrumb span[aria-current] {
    color: #fff;
  }

  .kd-hero__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 820px;
    padding-block: 64px;
  }

  .kd-hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 122%;
    font-weight: 800;
    font-size: clamp(2.5rem, 5.4vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
  }

  .kd-hero__accent {
    font-weight: 300;
    color: #8589e6;
  }

  .kd-hero__lead {
    margin-top: 28px;
    max-width: 600px;
    font-size: 1.125rem;
    line-height: 1.65;
    color: rgba(246, 247, 251, 0.82);
  }

  .kd-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .kd-hero__pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .kd-hero__pillars li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 28px 24px 32px 0;
  }

  .kd-hero__marker {
    display: block;
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin-top: 7px;
    background: #8589e6;
    transform: rotate(45deg);
  }

  .kd-hero__pillar-title {
    font-size: 1.0625rem;
    font-weight: 700;
    font-stretch: 108%;
  }

  .kd-hero__pillar-text {
    margin-top: 4px;
    font-size: 0.875rem;
    color: rgba(246, 247, 251, 0.7);
  }

  /* Perks */
  .kd-perks {
    background: var(--color-navy);
    color: #fff;
  }

  .kd-perks__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .kd-perks__grid li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 40px 28px;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
  }

  .kd-perks__num {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #8589e6;
  }

  .kd-perks__title {
    font-size: 1.1875rem;
    font-weight: 700;
    font-stretch: 108%;
    line-height: 1.25;
  }

  .kd-perks__text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.75);
  }

  /* Process */
  .kd-process {
    padding-block: 120px;
    background: #fff;
  }

  .kd-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: rgba(20, 22, 58, 0.1);
    border: 1px solid rgba(20, 22, 58, 0.1);
  }

  .kd-steps li {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 240px;
    padding: 40px 36px 44px;
    background: #fff;
  }

  .kd-steps__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .kd-steps__num {
    font-family: var(--font-display);
    font-stretch: 120%;
    font-weight: 800;
    font-size: 3.5rem;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }

  .kd-steps__badge {
    padding: 6px 10px;
    background: var(--color-bg-light);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }

  .kd-steps h3 {
    margin: auto 0 0;
    font-family: var(--font-display);
    font-stretch: 108%;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .kd-steps p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* Legal */
  .kd-legal {
    padding-block: 120px;
    background: #172052;
    color: #fff;
  }

  .kd-legal__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr));
    gap: 72px;
    align-items: center;
  }

  .kd-legal__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-navy-deep);
  }

  .kd-legal__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .kd-legal__badge {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 22px 28px;
    background: var(--color-navy);
  }

  .kd-legal__badge span {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #8589e6;
  }

  .kd-legal__badge strong {
    display: block;
    margin-top: 2px;
    font-family: var(--font-display);
    font-stretch: 120%;
    font-weight: 800;
    font-size: 3rem;
    line-height: 1;
  }

  .kd-legal__content h2 {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: 2.75rem;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #fff;
  }

  .kd-legal__content > p {
    margin: 24px 0 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
  }

  .kd-legal__list {
    display: flex;
    flex-direction: column;
    margin-top: 32px;
  }

  .kd-legal__list li {
    display: flex;
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .kd-legal__marker {
    display: block;
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin-top: 8px;
    background: #8589e6;
    transform: rotate(45deg);
  }

  .kd-legal__item-title {
    font-size: 1.125rem;
    font-weight: 700;
    font-stretch: 108%;
  }

  .kd-legal__item-text {
    margin-top: 6px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  .kd-legal__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding-bottom: 6px;
    border-bottom: 2px solid #8589e6;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    transition: color var(--transition);
  }

  .kd-legal__link:hover {
    color: #8589e6;
  }

  /* FAQ */
  .kd-faq {
    padding-block: 120px;
    background: var(--color-bg-light);
  }

  .kd-faq__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 64px;
    align-items: start;
  }

  .kd-faq__intro p {
    margin: 22px 0 0;
    max-width: 380px;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .kd-faq__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .kd-faq__list {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
