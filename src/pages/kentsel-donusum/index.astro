---
import Layout from '../../layouts/Layout.astro';

const steps = [
  {
    number: '01',
    title: 'Teknik Değerlendirme ve Fizibilite',
    description: 'Riskli yapı tespiti sonrası teknik değerlendirme ve fizibilite çalışması yapılır.',
  },
  {
    number: '02',
    title: 'Şartname ve Sözleşme',
    description: 'Kat karşılığı veya sözleşme koşulları netleşir.',
  },
  {
    number: '03',
    title: 'Projelendirme',
    description: 'Yeni yapının projesi hazırlanır.',
  },
  {
    number: '04',
    title: 'Ruhsat ve Yasal İzinler',
    description: 'Gerekli ruhsat ve yasal izin süreçleri yürütülür.',
  },
  {
    number: '05',
    title: 'İnşaat Süreci',
    description: 'Saha ekiplerimiz projeyi zaman planına göre yürütür, süreç düzenli raporlanır.',
  },
  {
    number: '06',
    title: 'Kat İttifakı Süreci',
    description: 'Kat maliklerinin ittifak süreci yönetilir.',
  },
  {
    number: '07',
    title: 'İskan Süreci',
    description: 'İş bitirme belgeleri ile birlikte iskan alınır ve anahtar teslimi yapılır.',
  },
];

const whySayda = [
  "1996'dan bu yana İstanbul'da müteahhitlik ve alt müteahhitlik alanında faaliyet",
  'G grubu müteahhitlik yetki belgesi',
  '33 iş bitirme belgesi ile kanıtlanmış saha deneyimi',
  'Rönesans, Kiler GYO, Oyak, Varyap, Torunlar gibi kurumsal yapılarla tamamlanan projeler',
  'Süreç boyunca tek muhatap: teknik değerlendirmeden iskana kadar aynı ekip',
];

const faqs = [
  {
    question: 'Kat karşılığı oranı nasıl belirlenir?',
    answer:
      'Arsanın/binanın bulunduğu bölgenin emsal değerleri, imar durumu ve inşaat maliyeti birlikte değerlendirilerek hak sahipleri ile müteahhit arasında karşılıklı olarak belirlenir. Bölgeden bölgeye oran değişebilir.',
  },
  {
    question: 'Süreç ortalama ne kadar sürer?',
    answer:
      'Risk raporu alımından iskana kadar geçen süre binanın büyüklüğüne, kat maliklerinin anlaşma hızına ve ruhsat sürecine bağlı olarak değişir; genellikle teknik değerlendirme ve anlaşma aşaması birkaç ay, inşaat süreci ise proje ölçeğine göre 1-2 yıl arasında tamamlanır.',
  },
  {
    question: 'Kira yardımından kim, nasıl yararlanır?',
    answer:
      "6306 sayılı kanun kapsamında risk raporu alınan binalardaki hak sahipleri, Çevre, Şehircilik ve İklim Değişikliği Bakanlığı'na başvurarak kira yardımı veya kredi desteğinden yararlanabilir. Başvuru için risk raporu, tapu ve hak sahipliğini gösteren belgeler gereklidir.",
  },
  {
    question: 'Kat maliklerinin tamamı anlaşmak zorunda mı?',
    answer:
      'Hayır. 6306 sayılı kanun gereği kat maliklerinin en az 2/3 çoğunluğunun kararı yeterlidir; azınlıkta kalanlar bu karara uymak zorundadır.',
  },
  {
    question: 'Müteahhit seçerken nelere dikkat edilmeli?',
    answer:
      'İş bitirme belgesi geçmişi, müteahhitlik yetki belgesi grubu, tamamlanan proje referansları ve sözleşme şartlarının netliği (teslim tarihi, malzeme kalitesi, kat karşılığı oranı) en önemli kriterlerdir.',
  },
];
---

<Layout
  title="Kentsel Dönüşüm | Sayda İnşaat"
  description="Riskli yapı tespiti sonrası süreç yönetimi, kat karşılığı anlaşma ve inşaatın anahtar teslim tamamlanması."
>
  <section class="intro">
    <div class="container">
      <h1>Kentsel Dönüşüm</h1>
      <p class="intro__lead">
        Riskli yapı tespitinden anahtar teslime kadar kentsel dönüşüm sürecinin tamamında bina ve arsa
        sahiplerinin yanındayız.
      </p>
      <p class="intro__body">
        Sayda İnşaat, riskli yapıları 6306 sayılı Kentsel Dönüşüm Kanunu çerçevesinde kent dokusuna uygun,
        sağlam, konforlu, sağlıklı ve güvenli yapılara dönüştürür. Kira ve kredi desteği süreçlerinden kat
        karşılığı inşaat organizasyonuna kadar tüm adımları bina ve arsa sahipleri adına yönetiyoruz.
      </p>
    </div>
  </section>

  <section class="process">
    <div class="container">
      <h2>Süreç Nasıl İşliyor?</h2>

      <ol class="process__grid">
        {
          steps.map((step) => (
            <li class="process-step">
              <span class="process-step__number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="why-sayda">
    <div class="container">
      <h2>Neden Sayda?</h2>

      <ul class="why-sayda__list">
        {
          whySayda.map((item) => (
            <li>
              <span class="why-sayda__marker" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <h2>Sıkça Sorulan Sorular</h2>

      <dl class="faq__list">
        {
          faqs.map((faq) => (
            <div class="faq__item">
              <dt>{faq.question}</dt>
              <dd>{faq.answer}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Layout>

<style>
  .intro {
    padding-top: calc(var(--header-h) + var(--space-l));
    padding-bottom: 0;
  }

  .intro .container {
    max-width: 760px;
  }

  .intro h1 {
    font-size: var(--fs-h1);
  }

  .intro__lead {
    margin-top: var(--space-m);
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .intro__body {
    margin-top: var(--space-m);
    font-size: var(--fs-body);
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .process {
    padding-block: var(--space-block);
  }

  .process h2 {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-l);
  }

  .process__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
    list-style: none;
  }

  .process-step {
    position: relative;
    padding-top: var(--space-m);
    border-top: 2px solid var(--color-navy);
  }

  .process-step__number {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-text-faint);
  }

  .process-step h3 {
    margin-top: var(--space-xs);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.0625rem;
  }

  .process-step p {
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .process h2 {
      text-align: center;
    }

    .process__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .process__grid {
      grid-template-columns: 1fr;
    }
  }

  .why-sayda {
    padding-block: var(--space-block);
    background: var(--color-bg-light);
  }

  .why-sayda .container {
    max-width: 760px;
  }

  .why-sayda h2 {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-l);
  }

  .why-sayda__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .why-sayda__list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .why-sayda__marker {
    flex-shrink: 0;
    margin-top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-navy);
  }

  .faq {
    padding-block: var(--space-block);
  }

  .faq .container {
    max-width: 760px;
  }

  .faq h2 {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-l);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .faq__item {
    padding-top: var(--space-m);
    border-top: 2px solid var(--color-navy);
  }

  .faq__item dt {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.0625rem;
    color: var(--color-text);
  }

  .faq__item dd {
    margin-top: var(--space-xs);
    font-size: var(--fs-body);
    line-height: 1.8;
    color: var(--color-text-muted);
  }
</style>
