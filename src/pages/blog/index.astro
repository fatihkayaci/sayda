---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import NewsletterBand from '../../components/NewsletterBand.astro';
import posts from '../../data/blog.json';
import { blogCategories, blogCategoryLabel, readMinutes } from '../../utils/blog';
import { formatNewsDate } from '../../utils/news';

const PAGE_SIZE = 9;

const sorted = [...posts].sort((a, b) => (a.date < b.date ? 1 : -1));

const chips = [
  { key: 'all', label: 'Tümü', count: sorted.length },
  ...blogCategories
    .map((c) => ({ ...c, count: sorted.filter((p) => p.category === c.key).length }))
    .filter((c) => c.count > 0),
];
---

<Layout ogImage="/img/projects/vadistanbul/vadistanbul-cover.webp" title="Kentsel Dönüşüm ve İnşaat Rehberi | Sayda İnşaat Blog" description="Kentsel dönüşüm, kat karşılığı inşaat ve riskli yapı tespiti gibi konularda Sayda İnşaat'tan bilgilendirici yazılar.">
  <PageHero
    eyebrow="Blog"
    breadcrumbs={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Blog' }]}
    image="/img/projects/vadistanbul/vadistanbul.webp"
    size="short"
  >
    Doğru bilgi, güvenli <em>karar.</em>
  </PageHero>

  <section class="bl" data-blog data-page-size={PAGE_SIZE}>
    <div class="container">
      <div class="bl-toolbar">
        <div class="bl-chips" role="group" aria-label="Kategori">
          {
            chips.map((chip) => (
              <button type="button" class="bl-chip" data-category-chip={chip.key} aria-pressed={chip.key === 'all' ? 'true' : 'false'}>
                {chip.label} <span>{chip.count}</span>
              </button>
            ))
          }
        </div>
        <label class="bl-search">
          <span class="sr-only">Yazılarda ara</span>
          <Icon name="search" size={20} />
          <input type="search" placeholder="Yazılarda ara" data-blog-search autocomplete="off" />
        </label>
      </div>

      <div class="bl-grid">
        {
          sorted.map((post, i) => (
            <a
              class="bl-card"
              href={`/blog/${post.slug}`}
              data-post
              data-category={post.category}
              data-search={`${post.title} ${post.excerpt}`}
              hidden={i >= PAGE_SIZE}
            >
              <span class="bl-card__media">
                <img src={post.image} alt="" loading="lazy" />
                <span class="bl-card__tag">{blogCategoryLabel[post.category]}</span>
              </span>
              <span class="bl-card__meta">
                <time datetime={post.date}>{formatNewsDate(post.date)}</time>
                <span>{readMinutes(post)} dk okuma</span>
              </span>
              <span class="bl-card__title">{post.title}</span>
              <span class="bl-card__excerpt">{post.excerpt}</span>
              <span class="bl-card__more">
                Devamını Oku <Icon name="arrow" size={16} />
              </span>
            </a>
          ))
        }
      </div>

      <p class="bl-empty" data-blog-empty hidden>Aramanıza uygun yazı bulunamadı.</p>

      <div class="bl-more" data-blog-more hidden={sorted.length <= PAGE_SIZE}>
        <button type="button">Daha Fazla Yazı</button>
      </div>
    </div>
  </section>

  <NewsletterBand
    eyebrow="Blog Bülteni"
    title="Yeni yazıları kaçırmayın."
    text="Kentsel dönüşüm, inşaat süreçleri ve güncel düzenlemeler hakkındaki yeni yazılar gelen kutunuza gelsin."
    subject="Blog bülteni aboneliği"
  />
</Layout>

<script>
  function initBlog() {
    const root = document.querySelector<HTMLElement>('[data-blog]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const pageSize = Number(root.dataset.pageSize) || 9;
    const chips = root.querySelectorAll<HTMLButtonElement>('[data-category-chip]');
    const search = root.querySelector<HTMLInputElement>('[data-blog-search]')!;
    const posts = [...root.querySelectorAll<HTMLElement>('[data-post]')];
    const empty = root.querySelector<HTMLElement>('[data-blog-empty]')!;
    const more = root.querySelector<HTMLElement>('[data-blog-more]')!;
    const normalize = (value: string) => value.toLocaleLowerCase('tr').trim();
    let category = 'all';
    let limit = pageSize;

    const apply = () => {
      const query = normalize(search.value);
      const matches = posts.filter(
        (post) =>
          (category === 'all' || post.dataset.category === category) &&
          (!query || normalize(post.dataset.search ?? '').includes(query))
      );
      const visible = new Set(matches.slice(0, limit));
      posts.forEach((post) => (post.hidden = !visible.has(post)));
      empty.hidden = matches.length > 0;
      more.hidden = matches.length <= limit;
    };

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        category = chip.dataset.categoryChip ?? 'all';
        limit = pageSize;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        apply();
      })
    );

    search.value = '';
    search.addEventListener('input', () => {
      limit = pageSize;
      apply();
    });

    more.querySelector('button')!.addEventListener('click', () => {
      limit += pageSize;
      apply();
    });

    apply();
  }

  initBlog();
  document.addEventListener('astro:page-load', initBlog);
</script>

<style>
  .bl {
    padding-block: clamp(48px, 5vw, 80px) clamp(80px, 9vw, 140px);
    background: var(--color-bg);
  }

  .bl-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: 48px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .bl-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .bl-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-navy-deep);
    cursor: pointer;
    transition:
      background var(--transition),
      border-color var(--transition),
      color var(--transition);
  }

  .bl-chip span {
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }

  .bl-chip:hover {
    border-color: var(--color-navy);
  }

  .bl-chip[aria-pressed='true'] {
    border-color: var(--color-navy-deep);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .bl-chip[aria-pressed='true'] span {
    color: var(--color-orange);
  }

  .bl-search {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(320px, 100%);
    padding: 0 16px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 999px;
    background: #fff;
    color: var(--color-navy);
  }

  .bl-search:focus-within {
    border-color: var(--color-navy);
  }

  .bl-search input {
    flex: 1;
    min-width: 0;
    height: 44px;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 0.875rem;
    outline: none;
  }

  .bl-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 32px;
  }

  .bl-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--color-navy-deep);
  }

  .bl-card[hidden] {
    display: none;
  }

  .bl-card__media {
    position: relative;
    display: block;
    margin-bottom: 6px;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .bl-card__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 5px;
    background: var(--color-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms ease;
  }

  .bl-card:hover .bl-card__media::after {
    transform: none;
  }

  .bl-card__media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .bl-card:hover .bl-card__media img {
    transform: scale(1.05);
  }

  .bl-card__tag {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-navy-deep);
  }

  .bl-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .bl-card__meta span::before {
    content: '·';
    margin-right: 16px;
    color: var(--color-orange-dark);
  }

  .bl-card__title {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 800;
    font-size: clamp(1.25rem, 0.6vw + 1rem, 1.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    transition: color var(--transition);
  }

  .bl-card:hover .bl-card__title {
    color: var(--color-navy);
  }

  .bl-card__excerpt {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bl-card__more {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    margin-top: auto;
    padding-bottom: 4px;
    border-bottom: 2px solid var(--color-orange);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .bl-empty {
    padding-block: 48px;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .bl-more {
    display: flex;
    justify-content: center;
    margin-top: 64px;
  }

  .bl-more[hidden] {
    display: none;
  }

  .bl-more button {
    height: 56px;
    padding: 0 32px;
    border: 1.5px solid var(--color-navy-deep);
    border-radius: var(--radius);
    background: transparent;
    font: inherit;
    font-weight: 700;
    color: var(--color-navy-deep);
    cursor: pointer;
    transition:
      background var(--transition),
      color var(--transition);
  }

  .bl-more button:hover {
    background: var(--color-navy-deep);
    color: #fff;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1024px) {
    .bl-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .bl-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
