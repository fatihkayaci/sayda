---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import Intro from '../../components/home/Intro.astro';
import site from '../../data/site.json';
import projects from '../../data/projects.json';
import { variant } from '../../utils/image';
import { hasCoverVariants } from '../../utils/project';

const projectBySlug = (slug: string) => projects.find((p) => p.slug === slug)!;
const coverOf = (slug: string) => {
  const project = projectBySlug(slug);
  const image = hasCoverVariants(project.image) ? variant(project.image, 960) : project.image;
  return { image, href: project.href, credit: 'imageCredit' in project ? project.imageCredit : undefined };
};

const values = [
  { icon: 'shield', title: 'Güven', text: 'Söz verdiğimiz gibi, zamanında ve kaliteli işler teslim ederiz.' },
  { icon: 'team', title: 'İnsan Odaklılık', text: 'Çalışanlarımız, iş ortaklarımız ve müşterilerimiz bizim için değerlidir.' },
  { icon: 'leaf', title: 'Sürdürülebilirlik', text: 'Gelecek nesiller için daha iyi yaşam alanları inşa ederiz.' },
  { icon: 'diamond', title: 'Kalite', text: 'Her projede en yüksek standartları hedefleriz.' },
];

// Every milestone is sourced: founding year, project records (projects.json) and the old site's news
// (haberler.json). No invented "phases" — add new entries only from a real date.
const timeline = [
  {
    year: String(site.foundedYear),
    title: 'Kuruluş',
    text: `${site.legalName} İstanbul'da kuruldu.`,
  },
  {
    year: '2013',
    title: 'Torun Tower',
    text: '40 katlık Torun Tower ofis kulesinin shell & core ince işlerini üstlendik.',
    ...coverOf('torun-tower-ofis'),
  },
  {
    year: '2018',
    title: 'Büyükyalı, Vadistanbul ve Gaziantep',
    text: 'Büyükyalı, Vadistanbul 3. etap ve Gaziantep Entegre Sağlık Kampüsü projelerinin ince işlerine başladık.',
    ...coverOf('vadistanbul'),
  },
  {
    year: '2021',
    title: 'Referans Kartal Loca',
    text: 'Kiler GYO’nun Referans Kartal Loca projesinin ince işlerini üstlendik; 2. etap 2022’de eklendi.',
    ...coverOf('referans-kartal-loca-2'),
  },
  {
    year: '2022',
    title: 'Süslü Karakol',
    text: '1866 tarihli Aziziye Karakolu’nun satış ofisine dönüşümünde renovasyon ve ince işleri yaptık.',
    ...coverOf('kiler-besiktas-abbasaga-satis-ofisi'),
  },
  {
    year: '2024',
    title: 'Referans Beşiktaş',
    text: 'Referans Loca 1’i teslim ettik; Referans Beşiktaş projesinin ince işlerine başladık.',
    ...coverOf('referans-besiktas-abbasaga'),
  },
  {
    year: '2025',
    title: `${site.certifications.length} ISO sertifikası`,
    text: 'Kalite, çevre, iş sağlığı ve güvenliği başta olmak üzere yönetim sistemlerimizi belgelendirdik.',
    image: site.certifications[0].image,
    href: '/belgeler',
    certificate: true,
  },
];

const expertise = [
  { title: 'Konut Projeleri', text: 'Konut ve rezidans projelerinde taahhüt ve ince işler.', slug: 'terrace-bahce-konut', href: '/projeler?tur=Konut' },
  { title: 'Ticari Yapılar', text: 'AVM, ofis ve iş merkezlerinde uçtan uca uygulama.', slug: 'atlas-park-avm-ofis', href: '/projeler?tur=Ticari' },
  { title: 'Sağlık Kampüsleri', text: 'Hastane ve sağlık kampüslerinde ince işler.', slug: 'gaziantep-sehir-hastanesi', href: '/projeler?tur=Sağlık' },
  { title: 'Otel Projeleri', text: 'Otel ve tatil köylerinde yapım ve renovasyon.', slug: 'yasmin-resort-hotel', href: '/projeler?tur=Otel' },
].map((item) => ({ ...item, image: coverOf(item.slug).image }));

// "Who we are" photo collage
const collage = ['atlas-park-avm-ofis', 'buyukyali', 'yasmin-resort-hotel'].map(coverOf);
const hero = coverOf('ciragan-otel-renovasyonu');
const heroImage = projectBySlug('ciragan-otel-renovasyonu').image;

// Logos live in /img/refs; a ref without a logo falls back to its name.
const refs = [
  ['Çırağan Palace Kempinski', 'Otel taahhüt', 'kempinski.svg'],
  ['Nestlé Gıda San. A.Ş.', 'Taahhüt işleri', 'nestle.svg'],
  ['Visa International EU', 'Taahhüt işleri', 'visa.svg'],
  ['Isısan – Buderus', 'Bölge binası & showroom', 'buderus.svg'],
  ['Rönesans İnşaat', 'Samsun AVM & Otel', 'ronesans.svg'],
  ['Akkök – Akiş GYO', 'Akbatı AVM & Yaşam Merkezi', 'akkok.png'],
  ['Varyap İnşaat', 'Varyap Meridian', 'varyap.svg'],
  ['Oyak İnşaat', 'Oyakkent', 'oyak.svg'],
  ['Yapı Kredi – Koray GYO', 'İstanbul-İstanbul', 'yapikredi.png'],
  ['Süzer Grubu', 'The Ritz-Carlton İstanbul', 'suzer.png'],
  ['Acarlar Şirketler Grubu', 'Acarkent', 'acarlar.png'],
  ['Sinpaş Yapı', 'Aqua Manors', ''],
].map(([name, project, logo]) => ({ name, project, logo: logo ? `/img/refs/${logo}` : '' }));

const refRows = [refs.slice(0, 6), refs.slice(6)];

const sectors = [
  { icon: 'home', title: 'Konut' },
  { icon: 'building', title: 'Ticari Yapılar' },
  { icon: 'shield', title: 'Sağlık Kampüsleri' },
  { icon: 'star', title: 'Otel' },
];

const yearsOfExperience = new Date().getFullYear() - site.foundedYear;
---

<Layout
  title="Hakkımızda: 1996'dan Beri Taahhüt ve İnce İşler | Sayda"
  description="1996'da kurulan Sayda İnşaat'ın hikayesi, uzmanlık alanları ve birlikte çalıştığımız kurumlar: konut, ticari, otel ve sağlık projeleri."
  ogImage={heroImage}
  organizationSchema
>
  <PageHero
    variant="photo"
    eyebrow="Hakkımızda"
    breadcrumbs={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Kurumsal', href: '/kurumsal' }, { label: 'Hakkımızda' }]}
    image={heroImage}
    imagePosition="center"
    size="compact"
    credit={hero.credit}
    backdrop={String(site.foundedYear)}
    facts={[
      { value: String(site.foundedYear), label: 'Kuruluş' },
      { value: 'İstanbul', label: 'Merkez' },
      { value: 'Taahhüt & İnce İşler', label: 'Uzmanlık' },
    ]}
  >
    Yapının her aşamasında <em>deneyim</em> ve güven.
  </PageHero>

  <Intro />

  <!-- 2. Who we are: statement + sectors beside a large photo -->
  <section class="ab-who">
    <div class="container ab-who__inner">
      <div class="ab-who__content">
        <p class="ab-label ab-label--light">Biz Kimiz?</p>
        <h2>Konuttan otele, dört alanda <span>taahhüt ve ince işler.</span></h2>
        <p class="ab-who__text">
          {site.legalName}, {site.foundedYear} yılında kurulmuş olup, İstanbul ve Türkiye genelinde farklı ölçeklerde
          birçok projeye imza atmıştır. Edindiğimiz deneyimi her yeni projede müşterilerimizin yanında kullanmaya
          devam ediyoruz.
        </p>

        <ul class="ab-who__sectors">
          {
            sectors.map((sector) => (
              <li>
                <Icon name={sector.icon} size={26} />
                {sector.title}
              </li>
            ))
          }
        </ul>

        <div class="ab-who__founder">
          <span class="ab-who__avatar">AO</span>
          <div>
            <p class="ab-who__name">Ali Orhan Onur</p>
            <p class="ab-who__role">Kurucu &amp; Genel Müdür · İTÜ İnşaat Fakültesi, 1990</p>
          </div>
        </div>
      </div>

      <figure class="ab-who__media">
        <div class="ab-who__collage">
          {
            collage.map((item, i) => (
              <a href={item.href} class={`ab-who__shot ab-who__shot--${i + 1}`}>
                <img src={item.image} alt="Sayda İnşaat'ın ince işlerini yaptığı bir proje" loading="lazy" />
              </a>
            ))
          }
        </div>
        <figcaption class="ab-who__badge">
          <b>{yearsOfExperience}+</b>
          <span>Yıllık<br />deneyim</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 3. Journey: sticky giant year + milestones -->
  <section class="ab-journey">
    <div class="container ab-journey__inner">
      <div class="ab-journey__aside">
        <p class="ab-label">Yolculuğumuz</p>
        <div class="ab-journey__sticky">
          <span class="ab-journey__current" data-journey-year>{timeline[0].year}</span>
          <span class="ab-journey__caption">{site.foundedYear}'dan bugüne</span>
        </div>
      </div>

      <ol class="ab-journey__list">
        {
          timeline.map((item, i) => (
            <li class:list={['ab-journey__item', { 'is-active': i === 0 }]} data-year={item.year}>
              <span class="ab-journey__item-year">{item.year}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              {item.image && (
                <a
                  href={item.href}
                  class:list={['ab-journey__photo', { 'ab-journey__photo--cert': 'certificate' in item }]}
                >
                  <img src={item.image} alt="" loading="lazy" />
                  <span>
                    {'certificate' in item ? 'Belgelerimiz' : 'Projeyi incele'} <Icon name="arrow" size={14} />
                  </span>
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. Values: full-width rows -->
  <section class="ab-values">
    <div class="container">
      <div class="ab-head">
        <p class="ab-label">Değerlerimiz</p>
        <h2>Yaşam alanlarına değer katmak için çalışıyoruz.</h2>
      </div>
      <ol class="ab-values__list">
        {
          values.map((value, i) => (
            <li class={`ab-values__card reveal reveal-d${i + 1}`}>
              <span class="ab-values__icon">
                <Icon name={value.icon} size={28} />
              </span>
              <span class="ab-values__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{value.title}</h3>
              <p>{value.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. Expertise: expanding image panels -->
  <section class="ab-expertise">
    <div class="container">
      <div class="ab-head ab-head--split">
        <div>
          <p class="ab-label ab-label--light">Uzmanlık Alanlarımız</p>
          <h2>Güçlü yapılar, güvenli yarınlar.</h2>
        </div>
        <a class="ab-link" href="/projeler">Tüm Projeler <Icon name="arrow" size={18} /></a>
      </div>

      <ul class="ab-panels">
        {
          expertise.map((item, i) => (
            <li class:list={['ab-panel', { 'is-open': i === 0 }]}>
              <a href={item.href}>
                <img src={item.image} alt="" loading="lazy" />
                <span class="ab-panel__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="ab-panel__tab">{item.title}</span>
                <span class="ab-panel__body">
                  <span class="ab-panel__title">{item.title}</span>
                  <span class="ab-panel__text">{item.text}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6. References: marquee -->
  <section class="ab-refs" aria-labelledby="ab-refs-title">
    <div class="container">
      <div class="ab-head">
        <p class="ab-label">Çalıştığımız Kurumlar</p>
        <h2 id="ab-refs-title">Müteahhit ve alt müteahhit olarak yer aldığımız projeler.</h2>
      </div>
    </div>

    {
      refRows.map((row, r) => (
        <div class:list={['ab-marquee', { 'ab-marquee--reverse': r === 1 }]}>
          {[0, 1].map((copy) => (
            <ul class="ab-marquee__track" aria-hidden={copy === 1 ? 'true' : undefined}>
              {row.map((ref) => (
                <li>
                  <span class="ab-marquee__logo">
                    {ref.logo ? (
                      <img src={ref.logo} alt={ref.name} loading="lazy" />
                    ) : (
                      <span class="ab-marquee__name">{ref.name}</span>
                    )}
                  </span>
                  <span class="ab-marquee__project">{ref.project}</span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))
    }
  </section>

</Layout>

<script>
  function initAbout() {
    // Journey: the sticky year follows whichever milestone is in the middle of the viewport.
    const yearEl = document.querySelector<HTMLElement>('[data-journey-year]');
    const items = document.querySelectorAll<HTMLElement>('.ab-journey__item');
    if (yearEl && items.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            items.forEach((el) => el.classList.toggle('is-active', el === entry.target));
            const year = (entry.target as HTMLElement).dataset.year ?? '';
            if (yearEl.textContent !== year) {
              yearEl.classList.remove('is-swap');
              void yearEl.offsetWidth;
              yearEl.textContent = year;
              yearEl.classList.add('is-swap');
            }
          });
        },
        { rootMargin: '-45% 0px -45% 0px' }
      );
      items.forEach((el) => observer.observe(el));
    }

    // Expertise: the hovered/focused panel opens.
    const panels = document.querySelectorAll<HTMLElement>('.ab-panel');
    panels.forEach((panel) => {
      const open = () => panels.forEach((p) => p.classList.toggle('is-open', p === panel));
      panel.addEventListener('mouseenter', open);
      panel.addEventListener('focusin', open);
    });
  }

  initAbout();
  document.addEventListener('astro:page-load', initAbout);
</script>

<style>
  /* Shared */
  .ab-label {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .ab-label::before {
    content: '';
    width: 40px;
    height: 3px;
    background: var(--color-orange);
  }

  .ab-label--light {
    color: rgba(255, 255, 255, 0.85);
  }

  .ab-head {
    display: grid;
    gap: 20px;
    margin-bottom: 64px;
  }

  .ab-head h2 {
    max-width: 22ch;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(2.25rem, 3vw + 1rem, 4rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-navy-deep);
  }

  .ab-head--split {
    grid-template-columns: 1fr auto;
    align-items: end;
  }

  .ab-head--split > div {
    display: grid;
    gap: 20px;
  }

  .ab-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--color-orange);
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
  }

  /* 2. Who we are */
  .ab-who {
    padding-block: clamp(80px, 9vw, 140px);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .ab-who__inner {
    display: grid;
    grid-template-columns: 5fr 6fr;
    align-items: center;
    gap: clamp(48px, 6vw, 112px);
  }

  .ab-who__content {
    display: grid;
    gap: 28px;
    justify-items: start;
  }

  .ab-who h2 {
    max-width: 18ch;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(2.25rem, 2.8vw + 1rem, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .ab-who h2 span {
    color: var(--color-orange);
  }

  .ab-who__text {
    max-width: 54ch;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
  }

  .ab-who__sectors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 560px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .ab-who__sectors li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-left: 3px solid var(--color-orange);
    background: rgba(255, 255, 255, 0.04);
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .ab-who__sectors :global(svg) {
    flex: none;
    color: var(--color-orange);
  }

  .ab-who__founder {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 12px;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    width: 100%;
    max-width: 560px;
  }

  .ab-who__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-orange);
    color: var(--color-navy-deep);
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: 1.125rem;
  }

  .ab-who__name {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 800;
    font-size: 1.125rem;
  }

  .ab-who__role {
    margin-top: 4px;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* image sits on the left, text on the right */
  .ab-who__media {
    position: relative;
    order: -1;
    margin: 0 auto 0 0;
    width: 100%;
  }

  /* one tall photo with two stacked beside it */
  .ab-who__collage {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 12px;
    aspect-ratio: 5 / 5.2;
  }

  .ab-who__shot {
    overflow: hidden;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.06);
  }

  .ab-who__shot--1 {
    grid-row: 1 / 3;
  }

  .ab-who__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .ab-who__shot:hover img {
    transform: scale(1.06);
  }

  .ab-who__badge {
    position: absolute;
    right: -40px;
    bottom: 48px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px 28px;
    background: var(--color-orange);
    color: var(--color-navy-deep);
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.45);
  }

  .ab-who__badge b {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    font-size: 3.25rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .ab-who__badge span {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* 3. Journey */
  .ab-journey {
    padding-block: clamp(80px, 9vw, 140px);
    background: var(--color-bg);
  }

  /* minmax(0, …) keeps the columns fixed so a wider year ("2000+") can't push the timeline line */
  .ab-journey__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 80px;
  }

  .ab-journey__sticky {
    position: sticky;
    top: calc(var(--header-h) + 80px);
    display: grid;
    gap: 16px;
    margin-top: 40px;
  }

  .ab-journey__current {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(4rem, 8vw, 9rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: var(--color-navy);
  }

  .ab-journey__current.is-swap {
    animation: ab-year-in 500ms ease;
  }

  @keyframes ab-year-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .ab-journey__caption {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .ab-journey__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 2px solid var(--color-border);
  }

  .ab-journey__item {
    position: relative;
    display: grid;
    align-content: center;
    gap: 12px;
    min-height: 44vh;
    padding: 56px 0 56px 48px;
    opacity: 0.35;
    transition: opacity 400ms ease;
  }

  .ab-journey__item::before {
    content: '';
    position: absolute;
    left: -9px;
    top: 50%;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 3px solid var(--color-border-strong);
    transform: translateY(-50%);
    transition:
      background 300ms,
      border-color 300ms;
  }

  .ab-journey__item.is-active {
    opacity: 1;
  }

  .ab-journey__item.is-active::before {
    background: var(--color-orange);
    border-color: var(--color-orange);
  }

  .ab-journey__item-year {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-orange-text);
  }

  .ab-journey__item h3 {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(1.75rem, 1.8vw + 1rem, 2.75rem);
    line-height: 1.05;
    color: var(--color-navy-deep);
