---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';

const [areaValue, areaUnit] = site.stats.totalCompletedArea.split(' ');

const stats = [
  { icon: 'calendar', value: String(site.foundedYear), unit: '', label: 'Kuruluş Yılı' },
  { icon: 'team', value: String(site.stats.employeeCount), unit: '', label: 'Çalışan' },
  { icon: 'chart', value: String(site.stats.avgAnnualProjects), unit: '', label: 'Yıllık Ortalama Proje' },
  { icon: 'building', value: areaValue, unit: areaUnit, label: 'Tamamlanan Alan' },
];

const values = [
  { icon: 'shield', title: 'Güven', text: 'Söz verdiğimiz gibi, zamanında ve kaliteli işler teslim ederiz.' },
  {
    icon: 'user',
    title: 'İnsan Odaklılık',
    text: 'Çalışanlarımız, iş ortaklarımız ve müşterilerimiz bizim için değerlidir.',
  },
  { icon: 'gear', title: 'Sürdürülebilirlik', text: 'Gelecek nesiller için daha iyi yaşam alanları inşa ederiz.' },
  { icon: 'diamond', title: 'Kalite', text: 'Her projede en yüksek standartları hedefleriz.' },
];

const timeline = [
  { year: String(site.foundedYear), text: 'Sayda İnşaat kuruldu.' },
  { year: '2000+', text: 'İlk büyük ölçekli projeler.' },
  { year: '2010+', text: 'Farklı proje tiplerinde faaliyet alanı genişletildi.' },
  { year: '2020+', text: 'Türkiye genelinde projeler.' },
  { year: '2026', text: 'Bugün, yeni hedeflerle yolumuza devam ediyoruz.' },
];

const expertise = [
  { title: 'Konut Projeleri', image: '/img/projects/terrace-bahce-konut/terrace-bahce-konut.webp' },
  { title: 'Ticari Yapılar', image: '/img/projects/atlas-park-avm-ofis/atlas-park-avm-ofis.webp' },
  { title: 'Sağlık Kampüsleri', image: '/img/projects/capital-tower-ofis/capital-tower-ofis.webp' },
  { title: 'Otel Projeleri', image: '/img/projects/yasmin-resort-hotel/yasmin-resort-hotel.webp' },
];

const certificates = [
  { icon: 'globe', title: 'ISO 9001', text: 'Kalite Yönetim Sistemi' },
  { icon: 'leaf', title: 'ISO 14001', text: 'Çevre Yönetim Sistemi' },
  { icon: 'team', title: 'ISO 10002', text: 'Müşteri Memnuniyeti' },
  { icon: 'document', title: `${site.contractorLicenseGroup} Grubu`, text: 'Yüklenici Yetki Belgesi' },
];
---

<Layout
  title="Hakkımızda | Sayda İnşaat"
  description="Sayda İnşaat'ın hikayesi, deneyimi ve çalışma prensipleri."
  organizationSchema
  hideCtaBanner
>
  <section class="about-hero">
    <div class="about-hero__media" aria-hidden="true">
      <img src="/img/sayda-insaat-hero01.webp" alt="" fetchpriority="high" />
    </div>

    <div class="container about-hero__inner">
      <nav class="about-hero__breadcrumb" aria-label="Konum">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <a href="/kurumsal">Kurumsal</a>
        <span>/</span>
        <span aria-current="page">Hakkımızda</span>
      </nav>

      <div class="about-hero__row">
        <div class="about-hero__content">
          <div class="eyebrow eyebrow--light">
            <span class="eyebrow__bar"></span>
            <span>KURUMSAL</span>
          </div>
          <h1>
            Hakkımızda
            <span class="about-hero__since">Since {site.foundedYear}</span>
          </h1>
          <p class="about-hero__lead">{site.foundedYear}’dan bugüne, daha iyi yaşam alanları için çalışıyoruz.</p>
          <p class="about-hero__text">
            Sayda İnşaat; konut, ticari yapılar, sağlık kampüsleri ve otel projelerinde taahhüt ve ince işler
            hizmetleri sunan, deneyimi ve uzman ekibiyle sektörde güvenilir bir çözüm ortağıdır.
          </p>
          <a class="btn btn--white" href="/hakkimizda/vizyon-misyon">
            Vizyonumuzla Tanışın <Icon name="arrow" size={16} />
          </a>
        </div>

        <p class="about-hero__quote" aria-hidden="true">
          “Daha iyi yarınlar için sağlam yapılar”
          <span></span>
        </p>
      </div>
    </div>
  </section>

  <section class="about-stats">
    <div class="container">
      <ul class="about-stats__grid">
        {
          stats.map((stat) => (
            <li class="about-stat">
              <span class="about-stat__value">
                {stat.value}
                {stat.unit && <span class="about-stat__unit">{stat.unit}</span>}
              </span>
              <span class="about-stat__label">{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="about-who">
    <div class="container about-who__inner">
      <div class="about-who__content reveal">
        <div class="eyebrow">
          <span class="eyebrow__bar"></span>
          <span>BİZ KİMİZ?</span>
        </div>
        <h2>Yapının Her Aşamasında Deneyim ve Güven</h2>
        <p>
          {site.legalName}, {site.foundedYear} yılında kurulmuş olup, İstanbul ve Türkiye genelinde farklı
          ölçeklerde birçok projeye imza atmıştır.
        </p>
        <p>
          Konut, ticari yapılar, sağlık kampüsleri ve otel projelerinde uzman ekibimizle taahhüt ve ince işler
          hizmetleri sunuyor, edindiğimiz deneyimi her yeni projede müşterilerimizin yanında kullanmaya devam
          ediyoruz.
        </p>
        <a class="btn btn--navy" href="/projeler">
          Daha Fazla Bilgi <Icon name="arrow" size={16} />
        </a>
      </div>

      <div class="about-who__media reveal reveal-d1">
        <img src="/img/projects/oyakkent-konut/oyakkent-konut.webp" alt="Sayda İnşaat projelerinden bir konut yapısı" loading="lazy" />
        <div class="about-who__since">
          <span class="about-who__since-label">Since</span>
          <span class="about-who__since-value">{site.foundedYear}</span>
        </div>
        <div class="about-who__quote">
          <span class="about-who__quote-mark" aria-hidden="true">“</span>
          <p>Yaşam alanlarına değer katmak için çalışıyoruz.</p>
          <span class="about-who__quote-line"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="about-values">
    <div class="container">
      <div class="eyebrow about-values__eyebrow">
        <span class="eyebrow__bar"></span>
        <span>DEĞERLERİMİZ</span>
      </div>
      <ul class="about-values__grid">
        {
          values.map((value, index) => (
            <li class="about-value reveal">
              <div class="about-value__head">
                <span class="about-value__marker" aria-hidden="true"></span>
                <span class="about-value__num">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <span class="about-value__icon">
                <Icon name={value.icon} size={26} />
              </span>
              <h3>{value.title}</h3>
              <p>{value.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="about-journey">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow eyebrow--light">
            <span class="eyebrow__bar"></span>
            <span>YOLCULUĞUMUZ</span>
          </div>
          <h2>{site.foundedYear}’dan Bugüne</h2>
        </div>
        <p>Her projede daha iyisini hedefleyerek, sektörde kalıcı ve sürdürülebilir değerler üretmeye devam ediyoruz.</p>
      </div>

      <ol class="timeline reveal">
        {
          timeline.map((item, index) => (
            <li class:list={['timeline__item', { 'timeline__item--first': index === 0 }]}>
              <span class="timeline__marker" aria-hidden="true"></span>
              <span class="timeline__year">{item.year}</span>
              <span class="timeline__text">{item.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="about-expertise">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">
            <span class="eyebrow__bar"></span>
            <span>UZMANLIK ALANLARIMIZ</span>
          </div>
          <h2>Güçlü Yapılar, Güvenli Yarınlar</h2>
        </div>
        <p>Farklı sektörlerde edindiğimiz deneyimle, yaşam alanlarına değer katıyoruz.</p>
      </div>

      <ul class="about-expertise__grid">
        {
          expertise.map((item, index) => (
            <li class={`reveal reveal-d${index}`}>
              <a class="expertise-card" href="/projeler">
                <img src={item.image} alt="" loading="lazy" />
                <span class="expertise-card__num">{String(index + 1).padStart(2, '0')}</span>
                <span class="expertise-card__title">{item.title}</span>
                <span class="expertise-card__arrow">
                  <Icon name="arrow" size={20} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="about-certs">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">
            <span class="eyebrow__bar"></span>
            <span>BELGELERİMİZ</span>
          </div>
          <h2>Kaliteyi Belgeliyoruz</h2>
        </div>
        <p>
          ISO standartları ve {site.contractorLicenseGroup} grubu yüklenici yetki belgemiz ile kalite ve
          sürdürülebilirlik ilkelerimizi taahhüt ediyoruz.
        </p>
      </div>

      <ul class="about-certs__grid">
        {
          certificates.map((cert, index) => (
            <li class={`cert-card reveal reveal-d${index}`}>
              <span class="cert-card__icon">
                <Icon name={cert.icon} size={30} />
              </span>
              <div>
                <h3>{cert.title}</h3>
                <p>{cert.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="about-cta">
    <img class="about-cta__bg" src="/img/sayda-insaat-hero02.webp" alt="" loading="lazy" />
    <div class="container about-cta__inner reveal">
      <div>
        <div class="eyebrow eyebrow--light">
          <span class="eyebrow__bar"></span>
          <span>DAHA GÜÇLÜ YARINLAR İÇİN</span>
        </div>
        <h2>Yeni projenizi birlikte hayata geçirelim.</h2>
      </div>
      <div class="about-cta__side">
        <p>Deneyimimiz, uzman ekibimiz ve çözüm odaklı yaklaşımımızla yanınızdayız.</p>
        <a class="btn btn--white" href="/iletisim#quote-form">
          Teklif Al <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Tam genişlik: bu sayfada içerik 1200px ile sınırlanmaz */
  .container {
    max-width: none;
    padding-inline: clamp(var(--edge-mobile), 4vw, 72px);
  }

  /* Shared bits */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .eyebrow__bar {
    display: block;
    width: 32px;
    height: 2px;
    background: currentColor;
  }

  .eyebrow--light {
    color: var(--color-on-dark-muted);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 28px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      background var(--transition),
      color var(--transition);
  }

  .btn--navy {
    background: var(--color-navy-deep);
    color: #fff;
  }

  .btn--navy:hover {
    background: var(--color-navy);
  }

  .btn--white {
    background: #fff;
    color: var(--color-navy-deep);
  }

  .btn--white:hover {
    background: #e8e9f5;
  }

  h1,
  h2 {
    font-family: var(--font-display);
    font-stretch: 112%;
  }

  h2 {
    font-size: clamp(1.875rem, 2.4vw + 1rem, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--color-navy-deep);
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-l);
    margin-bottom: 48px;
  }

  .section-head p {
    max-width: 34ch;
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .about-journey .section-head p {
    color: var(--color-on-dark-muted);
  }

  .section-head .eyebrow {
    margin-bottom: 14px;
  }

  /* Hero */
  .about-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-navy-deep);
  }

  .about-hero__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 58%;
  }

  .about-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% center;
  }

  .about-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--color-navy-deep) 0%, rgba(25, 27, 74, 0.15) 50%, rgba(25, 27, 74, 0) 100%),
      linear-gradient(to top, var(--color-navy-deep) 0%, rgba(25, 27, 74, 0) 30%);
  }

  .about-hero__inner {
    position: relative;
    z-index: 1;
    min-height: 560px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: 40px 64px;
  }

  .about-hero__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 56px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.55);
  }

  .about-hero__breadcrumb a:hover {
    color: #fff;
  }

  .about-hero__breadcrumb span[aria-current] {
    color: #fff;
  }

  .about-hero__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xl);
    align-items: end;
  }

  .about-hero__content {
    max-width: 560px;
  }

  .about-hero h1 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(2.5rem, 5.2vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
  }

  .about-hero__since {
    display: block;
    font-weight: 300;
    color: var(--color-on-dark-muted);
  }

  .about-hero__lead {
    margin-top: 22px;
    font-size: clamp(1.125rem, 1.4vw, 1.375rem);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.92);
  }

  .about-hero__text {
    margin-top: 18px;
    max-width: 48ch;
    font-size: var(--fs-small);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.7);
  }

  .about-hero .btn {
    margin-top: 30px;
  }

  .about-hero__quote {
    max-width: 300px;
    margin: 0;
    padding: 4px 0 4px 26px;
    border-left: 2px solid var(--color-on-dark-muted);
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 600;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #fff;
  }

  /* Stats */
  .about-stats {
    background: var(--color-navy);
    color: #fff;
  }

  .about-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .about-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 44px var(--space-m);
    border-left: 1px solid rgba(255, 255, 255, 0.18);
  }

  .about-stat:first-child {
    border-left: 0;
  }

  .about-stat__value {
    font-family: var(--font-display);
    font-stretch: 118%;
    font-weight: 700;
    font-size: clamp(1.875rem, 2.2vw + 0.5rem, 2.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .about-stat__unit {
    margin-left: 4px;
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .about-stat__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  /* Who we are */
  .about-who {
    padding-block: 96px;
    background: var(--color-bg);
  }

  .about-who__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 88px;
    align-items: center;
  }

  .about-who__content {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .about-who__content h2 {
    max-width: 16ch;
  }

  .about-who__content p {
    font-size: var(--fs-body);
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  .about-who__content .btn {
    margin-top: 8px;
  }

  .about-who__media {
    position: relative;
    margin-left: 28px;
    padding-bottom: 24px;
  }

  .about-who__media img {
    width: 100%;
    height: 380px;
    object-fit: cover;
  }

  .about-who__since {
    position: absolute;
    left: -28px;
    top: 32px;
    display: grid;
    gap: 2px;
    padding: 22px 26px;
    background: var(--color-navy);
    color: #fff;
    box-shadow: var(--shadow);
  }

  .about-who__since-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .about-who__since-value {
    font-family: var(--font-display);
    font-stretch: 120%;
    font-weight: 800;
    font-size: 2.5rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .about-who__quote {
    position: absolute;
    right: -24px;
    bottom: 0;
    width: 220px;
    padding: 24px;
    background: var(--color-navy-deep);
    color: #fff;
    box-shadow: var(--shadow);
  }

  .about-who__quote-mark {
    display: block;
    font-family: var(--font-heading);
    font-size: 2rem;
    line-height: 0.8;
  }

  .about-who__quote p {
    margin-top: 10px;
    font-size: 1rem;
    line-height: 1.5;
    color: #fff;
  }

  .about-who__quote-line {
    display: block;
    width: 28px;
    height: 2px;
    margin-top: 18px;
    background: #fff;
  }

  /* Values */
  .about-values {
    padding-block: 88px;
    background: var(--color-bg-light);
  }

  .about-values__eyebrow {
    margin-bottom: 40px;
  }

  .about-values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
  }

  .about-value {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px 28px 34px;
    background: #fff;
    border: 1px solid var(--color-border);
  }

  .about-value__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .about-value__marker {
    display: block;
    width: 9px;
    height: 9px;
    background: var(--color-navy);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .about-value__num {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-navy);
  }

  .about-value__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-top: 4px;
    border-radius: 50%;
    background: var(--color-bg-light);
    color: var(--color-navy-deep);
  }

  .about-value h3 {
    margin-top: 4px;
    font-family: var(--font-display);
    font-stretch: 108%;
    font-size: 1.25rem;
    color: var(--color-navy-deep);
  }

  .about-value p {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  /* Journey */
  .about-journey {
    padding-block: 96px;
    background: var(--color-navy-dark);
    color: #fff;
  }

  .about-journey h2 {
    color: #fff;
  }

  .timeline {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-m);
  }

  .timeline__item {
    position: relative;
    display: grid;
    gap: 16px;
    align-content: start;
    padding-top: 32px;
    border-top: 2px solid rgba(255, 255, 255, 0.2);
  }

  .timeline__marker {
    position: absolute;
    top: -7px;
    left: 0;
    width: 12px;
    height: 12px;
    background: var(--color-on-dark-muted);
    transform: rotate(45deg);
  }

  .timeline__item--first .timeline__marker {
    background: #fff;
  }

  .timeline__year {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 700;
    font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .timeline__text {
    max-width: 22ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Expertise */
  .about-expertise {
