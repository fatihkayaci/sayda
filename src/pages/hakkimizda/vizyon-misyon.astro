---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';

const items = [
  {
    id: 'misyon',
    icon: 'target',
    title: 'Misyon',
    text: 'Toplum ve çevre bilincinde, ahlaki değerler doğrultusunda, müşteri ve çalışanlarımızın memnuniyetini temel alarak, en yüksek verim ve kaliteyle hizmet ve ürünleri sunmaktır.',
    image: '/img/projects/varyap-meridien-konut/varyap-meridien-konut.webp',
    caption: 'Değer üretmek için çalışıyoruz',
  },
  {
    id: 'vizyon',
    icon: 'binoculars',
    title: 'Vizyon',
    text: 'Araştırmacı ve teknolojik gelişimlerin takipçisi olarak daha verimli sistemler oluşturmak, sektörde yenilikçi ve güvenilir bir marka olarak tercih edilmektir.',
    image: '/img/projects/vadistanbul/vadistanbul.webp',
    caption: 'Daima daha iyisi için gelişiyoruz',
  },
  {
    id: 'hedef',
    icon: 'chart',
    title: 'Hedef',
    text: 'Türkiye ve uluslararası platformda sektöründe öne gelen şirketlerden biri olmak, sürdürülebilir projelerle yaşam alanlarına kalıcı değerler kazandırmaktır.',
    image: '/img/sayda-insaat-hero02.webp',
    caption: 'Daha güçlü yarınlar için',
  },
];
---

<Layout
  title="Vizyon & Misyon | Sayda İnşaat"
  description="Sayda İnşaat'ın misyonu, vizyonu ve hedefi: müşteri memnuniyetini temel almak, teknolojik gelişmeleri takip etmek ve sektörün öne çıkan şirketlerinden biri olmak."
>
  <PageHero
    eyebrow="Vizyon & Misyon"
    breadcrumbs={[
      { label: 'Ana Sayfa', href: '/' },
      { label: 'Kurumsal', href: '/kurumsal' },
      { label: 'Vizyon & Misyon' },
    ]}
    image="/img/projects/vadistanbul/vadistanbul-03.webp"
    imagePosition="35% center"
    size="compact"
  >
    Bugünün ihtiyaçları, geleceğin <em>değerleri.</em>
  </PageHero>

  <nav class="vm-jump" aria-label="Bölümler">
    <div class="container vm-jump__inner">
      {
        items.map((item, i) => (
          <a href={`#${item.id}`}>
            <span>{String(i + 1).padStart(2, '0')}</span>
            {item.title}
          </a>
        ))
      }
    </div>
  </nav>

  {
    items.map((item, i) => (
      <section class:list={['vm-chapter', `vm-chapter--${i % 3}`]} id={item.id}>
        <div class="vm-chapter__media">
          <img src={item.image} alt="" loading="lazy" />
        </div>
        <div class="vm-chapter__body">
          <span class="vm-chapter__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <p class="vm-chapter__label">
            <Icon name={item.icon} size={22} />
            {item.caption}
          </p>
          <h2 class="vm-chapter__title">{item.title}</h2>
          <p class="vm-chapter__text">{item.text}</p>
        </div>
      </section>
    ))
  }
</Layout>

<style>
  /* Jump nav */
  .vm-jump {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .vm-jump__inner {
    display: flex;
    gap: clamp(24px, 4vw, 64px);
    overflow-x: auto;
  }

  .vm-jump a {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding-block: 22px;
    border-bottom: 3px solid transparent;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: 1.125rem;
    white-space: nowrap;
    color: var(--color-navy-deep);
    transition: border-color var(--transition);
  }

  .vm-jump a span {
    font-size: 0.8125rem;
    color: var(--color-orange);
  }

  .vm-jump a:hover {
    border-color: var(--color-orange);
  }

  /* Chapters */
  .vm-chapter {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: min(88vh, 820px);
    scroll-margin-top: var(--header-h);
  }

  .vm-chapter--0 {
    background: var(--color-bg);
  }

  .vm-chapter--1 {
    background: var(--color-navy-deep);
    color: #fff;
  }

  .vm-chapter--2 {
    background: var(--color-bg-light);
  }

  .vm-chapter:nth-of-type(even) .vm-chapter__media {
    order: 2;
  }

  .vm-chapter__media {
    position: relative;
    overflow: hidden;
  }

  .vm-chapter__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vm-chapter__body {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    padding: clamp(56px, 7vw, 120px) clamp(28px, 6vw, 112px);
    overflow: hidden;
  }

  .vm-chapter__num {
    position: absolute;
    right: clamp(16px, 3vw, 48px);
    top: clamp(16px, 3vw, 40px);
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(6rem, 12vw, 13rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(47, 48, 145, 0.14);
    pointer-events: none;
  }

  .vm-chapter--1 .vm-chapter__num {
    -webkit-text-stroke-color: rgba(255, 255, 255, 0.12);
  }

  .vm-chapter__label {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .vm-chapter__label :global(svg) {
    color: var(--color-orange);
  }

  .vm-chapter--1 .vm-chapter__label {
    color: rgba(255, 255, 255, 0.85);
  }

  .vm-chapter__title {
    position: relative;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(3.5rem, 6.5vw + 0.5rem, 8rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-navy-deep);
  }

  .vm-chapter__title::after {
    content: '.';
    color: var(--color-orange);
  }

  .vm-chapter--1 .vm-chapter__title {
    color: #fff;
  }

  .vm-chapter__text {
    position: relative;
    max-width: 34ch;
    padding-left: 24px;
    border-left: 4px solid var(--color-orange);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 0.8vw + 1rem, 1.75rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
  }

  .vm-chapter--1 .vm-chapter__text {
    color: rgba(255, 255, 255, 0.82);
  }

  @media (max-width: 900px) {
    .vm-chapter {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .vm-chapter:nth-of-type(even) .vm-chapter__media {
      order: 0;
    }

    .vm-chapter__media {
      height: 320px;
    }
  }

  @media (max-width: 480px) {
    .vm-chapter__title {
      font-stretch: 100%;
      font-size: clamp(2.75rem, 13vw, 3.5rem);
    }
  }
</style>
