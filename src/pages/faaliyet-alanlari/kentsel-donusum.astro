---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import SvcHero from '../../components/service/SvcHero.astro';
import services from '../../data/services.json';
import { serviceLd, faqLd } from '../../utils/schema';
import SvcScope from '../../components/service/SvcScope.astro';
import SvcPartners from '../../components/service/SvcPartners.astro';
import SvcField from '../../components/service/SvcField.astro';
import SvcMore from '../../components/service/SvcMore.astro';
import site from '../../data/site.json';
import company from '../../data/company.json';

const points = company.philosophy;

const faqs = [
  {
    question: 'Kat karşılığı oranı nasıl belirlenir?',
    answer:
      'Arsanın/binanın bulunduğu bölgenin emsal değerleri, imar durumu ve inşaat maliyeti birlikte değerlendirilerek hak sahipleri ile müteahhit arasında karşılıklı olarak belirlenir. Bölgeden bölgeye oran değişebilir.',
  },
  {
    question: 'Süreç ortalama ne kadar sürer?',
    answer:
      'Risk raporu alımından iskana kadar geçen süre binanın büyüklüğüne, kat maliklerinin anlaşma hızına ve ruhsat sürecine bağlıdır. Teknik değerlendirme ve anlaşma aşaması genellikle birkaç ay, inşaat süreci ise proje ölçeğine göre 1–2 yıl sürer.',
  },
  {
    question: 'Kira yardımından kim, nasıl yararlanır?',
    answer:
      "6306 sayılı kanun kapsamında risk raporu alınan binalardaki hak sahipleri, Çevre, Şehircilik ve İklim Değişikliği Bakanlığı'na başvurarak kira yardımı veya kredi desteğinden yararlanabilir. Başvuru için risk raporu, tapu ve hak sahipliğini gösteren belgeler gereklidir.",
  },
  {
    question: 'Kat maliklerinin tamamı anlaşmak zorunda mı?',
    answer: 'Hayır. 6306 sayılı kanun gereği kat maliklerinin en az 2/3 çoğunluğunun kararı yeterlidir; azınlıkta kalanlar bu karara uymak zorundadır.',
  },
  {
    question: 'Müteahhit seçerken nelere dikkat edilmeli?',
    answer:
      'İş bitirme belgesi geçmişi, müteahhitlik yetki belgesi grubu, tamamlanan proje referansları ve sözleşme şartlarının netliği (teslim tarihi, malzeme kalitesi, kat karşılığı oranı) en önemli kriterlerdir.',
  },
  {
    question: 'Riskli yapı tespiti nasıl yapılır?',
    answer:
      'Binanın deprem güvenliği, lisanslı kuruluşlar tarafından yapılan inceleme ve analizlerle belirlenir; sonuç risk raporu olarak düzenlenir. Ayrıntılar için blogumuzdaki yazıya göz atabilirsiniz.',
  },
];

const service = services.find((s) => s.href === '/faaliyet-alanlari/kentsel-donusum')!;
const schema = [
  serviceLd({ name: service.title, description: service.description, path: service.href, image: service.image }),
  faqLd(faqs),
];
---

<Layout
  title="Kentsel Dönüşüm Müteahhidi İstanbul | Sayda İnşaat"
  description="6306 sayılı kanun çerçevesinde riskli yapıların yenilenmesi: kentsel dönüşüm süreci, sık sorulan sorular ve Sayda İnşaat deneyimi."
  ogImage={service.image}
  jsonLd={schema}
>
  <SvcHero
    eyebrow="Faaliyet Alanı 01"
    name="Kentsel Dönüşüm"
    text="6306 sayılı kanun çerçevesinde riskli yapıların yenilenmesinde, 1996'dan bu yana müteahhit ve alt müteahhit olarak edindiğimiz deneyimle hizmet veriyoruz."
    points={points}
    project="referans-besiktas-abbasaga"
  >
    Kentsel <em>Dönüşüm</em>
  </SvcHero>

  <SvcScope label="Uygulama Alanlarımız" title="Kaba yapıdan dekorasyona." items={company.workItems} />

  <section class="kd-faq">
    <div class="container kd-faq__inner">
      <div class="kd-faq__intro">
        <SectionHead
          label="Merak Edilenler"
          title="Sıkça sorulan sorular."
          text="Aklınıza takılan başka bir soru varsa ekibimiz size yardımcı olmaktan memnuniyet duyar."
        />
        <div class="kd-faq__actions">
          <a class="kd-faq__link" href="/blog/6306-sayili-kentsel-donusum-kanunu-nedir">
            6306 sayılı kanun yazımız <Icon name="arrow" size={18} />
          </a>
          <a class="kd-faq__link" href="/blog">
            Tüm blog yazıları <Icon name="arrow" size={18} />
          </a>
          <a class="kd-faq__phone" href={site.phoneHref}>
            <Icon name="phone" size={20} />
            {site.phone}
          </a>
        </div>
      </div>

      <div class="kd-faq__list">
        {
          faqs.map((faq, i) => (
            <details class="kd-faq__item" name="kd-faq" open={i === 0}>
              <summary>
                <span class="kd-faq__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="kd-faq__question">{faq.question}</span>
                <span class="kd-faq__icon" aria-hidden="true" />
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <SvcPartners
    label="Projelerimiz"
    items={[
      { title: 'Referans Kartal Loca 1. Etap', slug: 'referans-kartal-loca-1' },
      { title: 'Referans Kartal Loca 2. Etap', slug: 'referans-kartal-loca-2' },
      { title: 'Referans Beşiktaş', slug: 'referans-besiktas-abbasaga' },
      { title: 'Terrace Bahçe', slug: 'terrace-bahce-konut' },
      { title: 'İstanbul Projesi', slug: 'istanbul-projesi' },
      { title: 'Büyükyalı', slug: 'buyukyali' },
    ]}
  />

  <SvcField />

  <SvcMore current="/faaliyet-alanlari/kentsel-donusum" />
</Layout>

<style>
  .kd-faq {
    padding-block: clamp(80px, 9vw, 140px);
    background: var(--color-bg-light);
  }

  .kd-faq__inner {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .kd-faq__intro {
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .kd-faq__intro :global(.section-head) {
    grid-template-columns: 1fr;
    margin-bottom: 32px;
  }

  .kd-faq__actions {
    display: grid;
    justify-items: start;
    gap: 14px;
  }

  .kd-faq__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 4px;
    border-bottom: 2px solid var(--color-orange);
    font-weight: 700;
    color: var(--color-navy-deep);
    transition: color var(--transition);
  }

  .kd-faq__link:hover {
    color: var(--color-navy);
  }

  .kd-faq__phone {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(1.5rem, 1vw + 1rem, 2rem);
    color: var(--color-navy-deep);
  }

  .kd-faq__phone :global(svg) {
    color: var(--color-orange);
  }

  .kd-faq__list {
    border-top: 2px solid var(--color-navy-deep);
  }

  .kd-faq__item {
    border-bottom: 1px solid var(--color-border-strong);
  }

  .kd-faq__item summary {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 20px;
    padding: 28px 0;
    cursor: pointer;
    list-style: none;
  }

  .kd-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .kd-faq__num {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    color: var(--color-orange);
  }

  .kd-faq__question {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 800;
    font-size: clamp(1.125rem, 0.6vw + 0.9rem, 1.5rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-navy-deep);
  }

  .kd-faq__icon {
    position: relative;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 50%;
    transition:
      background 300ms ease,
      border-color 300ms ease,
      transform 300ms ease;
  }

  .kd-faq__icon::before,
  .kd-faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 2px;
    background: var(--color-navy-deep);
    transform: translate(-50%, -50%);
  }

  .kd-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .kd-faq__item summary:hover .kd-faq__icon {
    border-color: var(--color-navy-deep);
  }

  .kd-faq__item[open] .kd-faq__icon {
    border-color: var(--color-orange);
    background: var(--color-orange);
    transform: rotate(45deg);
  }

  .kd-faq__item p {
    max-width: 62ch;
    margin: 0;
    padding: 0 68px 32px;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .kd-faq__inner {
      grid-template-columns: 1fr;
    }

    .kd-faq__intro {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .kd-faq__item summary {
      grid-template-columns: 1fr auto;
    }

    .kd-faq__num {
      display: none;
    }

    .kd-faq__item p {
      padding-inline: 0;
    }
  }
</style>
