---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceSelector from '../../components/service/ServiceSelector.astro';
import SvcField from '../../components/service/SvcField.astro';
import projects from '../../data/projects.json';

const hero = projects.find((p) => p.slug === 'capital-tower-spor-kompleksi')!;
---

<Layout
  title="İnşaat ve Müteahhitlik Hizmetleri | Sayda İnşaat"
  description="Kentsel dönüşüm, kat karşılığı inşaat, alt müteahhitlik, anahtar teslim müteahhitlik, proje yönetimi ile bina ve tesis tadilat ve renovasyonu hizmetleri."
  ogImage={hero.image}
>
  <PageHero
    eyebrow="Faaliyet Alanlarımız"
    breadcrumbs={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Faaliyet Alanları' }]}
    variant="photo"
    image={hero.image}
    imagePosition="center"
    size="compact"
    credit={'imageCredit' in hero ? hero.imageCredit : undefined}
  >
    Anahtar teslim müteahhitlik ve <em>uzman ekip.</em>
  </PageHero>

  <section class="hz">
    <div class="container">
      <ServiceSelector />
    </div>
  </section>

  <SvcField />
</Layout>

<style>
  .hz {
    padding-block: clamp(48px, 5vw, 80px) clamp(80px, 9vw, 140px);
    background: var(--color-bg);
  }
</style>
