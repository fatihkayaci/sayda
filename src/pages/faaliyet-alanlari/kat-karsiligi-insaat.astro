---
import Layout from '../../layouts/Layout.astro';
import SvcHero from '../../components/service/SvcHero.astro';
import services from '../../data/services.json';
import { serviceLd } from '../../utils/schema';
import SvcScope from '../../components/service/SvcScope.astro';
import SvcPartners from '../../components/service/SvcPartners.astro';
import SvcField from '../../components/service/SvcField.astro';
import SvcMore from '../../components/service/SvcMore.astro';
import company from '../../data/company.json';

const service = services.find((s) => s.href === '/faaliyet-alanlari/kat-karsiligi-insaat')!;
const schema = [
  serviceLd({ name: service.title, description: service.description, path: service.href, image: service.image }),
];
---

<Layout
  title="Kat Karşılığı İnşaat İstanbul | Sayda İnşaat"
  description="Arsa ve bina sahipleriyle iş birliği içinde kat karşılığı inşaat: 1996'dan bu yana konut projelerindeki deneyimimizle Sayda İnşaat."
  ogImage={service.image}
  jsonLd={schema}
>
  <SvcHero
    eyebrow="Faaliyet Alanı 02"
    name="Kat Karşılığı İnşaat"
    text="Arsa ve bina sahipleriyle iş birliği yaparak kat karşılığı inşaat projelerini üstleniyoruz. 1996'dan bu yana otel, ofis, villa ve konut projelerinde edindiğimiz müteahhitlik deneyimini arsanıza taşıyoruz."
    points={company.philosophy}
    project="buyukyali"
  >
    Kat Karşılığı <em>İnşaat</em>
  </SvcHero>

  <SvcScope label="Uygulama Alanlarımız" title="Kaba yapıdan dekorasyona." items={company.workItems} />

  <SvcPartners
    label="Konut Deneyimimiz"
    items={[
      { title: 'Büyükyalı', slug: 'buyukyali' },
      { title: 'Oyakkent', slug: 'oyakkent-konut' },
      { title: 'Varyap Meridian', slug: 'varyap-meridien-konut' },
      { title: 'Referans Güneşli', slug: 'referans-gunesli' },
      { title: 'Acarkent', slug: 'acarlar-acar-kent' },
      { title: 'Kasaba Konut & Residance', slug: 'kasaba-konut-residance' },
    ]}
  />

  <SvcField />

  <SvcMore current="/faaliyet-alanlari/kat-karsiligi-insaat" />
</Layout>
