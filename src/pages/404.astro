---
import Layout from '../layouts/Layout.astro';

const links = [
  { title: 'Projelerimiz', description: 'Devam eden ve tamamlanan projelerimizi inceleyin.', href: '/projeler' },
  { title: 'Haberler', description: 'Güncel gelişmeleri takip edin.', href: '/haberler' },
  { title: 'Blog', description: 'Kentsel dönüşüm hakkında faydalı içerikler.', href: '/blog' },
  { title: 'İletişim', description: 'Bizimle iletişime geçin, sorularınızı yanıtlayalım.', href: '/iletisim' },
];
---

<Layout
  title="Sayfa Bulunamadı | Sayda İnşaat"
  description="Aradığınız sayfa bulunamadı. Sayda İnşaat ana sayfasına dönebilir, projelerimizi inceleyebilir veya bizimle iletişime geçebilirsiniz."
  hideCtaBanner
>
  <section class="page">
    <div class="container">
      <p class="code">404</p>
      <h1>Sayfa bulunamadı</h1>
      <p>
        Aradığınız sayfa taşınmış, silinmiş ya da adres yanlış yazılmış olabilir. Size yardımcı olabilecek bağlantılar
        aşağıda.
      </p>
      <p>
        <a class="btn" href="/">Ana Sayfaya Dön</a>
        <a class="btn btn--dark" href="/iletisim">Bize Ulaşın</a>
      </p>

      <div class="page__grid">
        {
          links.map((link) => (
            <a class="page__box" href={link.href}>
              <h3>{link.title}</h3>
              <p>{link.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .code {
    margin: 0;
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    color: #f69c00;
  }

  h1 {
    margin: 8px 0 14px;
    font-size: 26px;
    color: #333;
  }
</style>
