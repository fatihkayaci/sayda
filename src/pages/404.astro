---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const links = [
  { title: 'Faaliyet Alanlarımız', description: 'Kentsel dönüşümden anahtar teslime tüm faaliyet alanlarımız.', href: '/faaliyet-alanlari' },
  { title: 'Projelerimiz', description: 'Devam eden ve tamamlanan projelerimiz.', href: '/projeler' },
  { title: 'Haberler', description: 'Sahadan güncel gelişmeler.', href: '/haberler' },
  { title: 'Blog', description: 'Kentsel dönüşüm hakkında faydalı içerikler.', href: '/blog' },
];
---

<Layout
  title="Sayfa Bulunamadı | Sayda İnşaat"
  description="Aradığınız sayfa bulunamadı. Sayda İnşaat ana sayfasına dönebilir, projelerimizi inceleyebilir veya bizimle iletişime geçebilirsiniz."
  hideCtaBanner
>
  <section class="nf">
    <span class="nf__code" aria-hidden="true">404</span>

    <div class="container nf__inner">
      <div class="nf__text">
        <p class="nf__eyebrow"><span></span>Sayfa Bulunamadı</p>
        <h1 data-words>Bu adreste henüz <em>bir yapı yok.</em></h1>
        <p class="nf__lead">
          Aradığınız sayfa taşınmış, silinmiş ya da adres yanlış yazılmış olabilir. Aşağıdaki bağlantılar size
          yardımcı olabilir.
        </p>
        <div class="nf__actions">
          <a class="nf__btn nf__btn--primary" href="/">
            Ana Sayfaya Dön <Icon name="arrow" size={18} />
          </a>
          <a class="nf__btn" href="/iletisim">Bize Ulaşın</a>
        </div>
      </div>

      <ol class="nf__links">
        {
          links.map((link, i) => (
            <li>
              <a href={link.href}>
                <span class="nf__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="nf__body">
                  <strong>{link.title}</strong>
                  <span>{link.description}</span>
                </span>
                <span class="nf__arrow" aria-hidden="true">
                  <Icon name="arrow" size={20} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    padding-block: clamp(80px, 9vw, 140px);
    background: var(--color-bg-light);
  }

  .nf__code {
    position: absolute;
    right: -0.04em;
    bottom: -0.12em;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(12rem, 34vw, 36rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(47, 48, 145, 0.12);
    pointer-events: none;
    user-select: none;
  }

  .nf__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(48px, 6vw, 96px);
    align-items: center;
  }

  .nf__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .nf__eyebrow span {
    width: 40px;
    height: 3px;
    background: var(--color-orange);
  }

  .nf h1 {
    max-width: 14ch;
    margin-top: 28px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(2.5rem, 4.4vw + 0.5rem, 5.75rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--color-navy-deep);
  }

  .nf h1 em {
    font-style: normal;
    color: var(--color-navy);
    box-shadow: inset 0 -0.18em 0 rgba(245, 162, 27, 0.55);
  }

  .nf__lead {
    max-width: 50ch;
    margin-top: 28px;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .nf__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    padding: 0 28px;
    border: 1.5px solid var(--color-navy-deep);
    border-radius: var(--radius);
    font-weight: 700;
    color: var(--color-navy-deep);
    transition:
      background var(--transition),
      color var(--transition);
  }

  .nf__btn:hover {
    background: var(--color-navy-deep);
    color: #fff;
  }

  .nf__btn--primary {
    border-color: var(--color-orange);
    background: var(--color-orange);
  }

  .nf__btn--primary:hover {
    border-color: var(--color-orange-dark);
    background: var(--color-orange-dark);
    color: var(--color-navy-deep);
  }

  .nf__links {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--color-navy-deep);
  }

  .nf__links a {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-navy-deep);
  }

  .nf__num {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    color: var(--color-orange-dark);
  }

  .nf__body {
    display: grid;
    gap: 4px;
  }

  .nf__body strong {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 800;
    font-size: 1.375rem;
    line-height: 1.1;
    transition: color var(--transition);
  }

  .nf__body span {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .nf__arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 50%;
    transition:
      background 300ms ease,
      border-color 300ms ease,
      transform 300ms ease;
  }

  .nf__links a:hover strong {
    color: var(--color-navy);
  }

  .nf__links a:hover .nf__arrow {
    border-color: var(--color-orange);
    background: var(--color-orange);
    transform: rotate(-45deg);
  }

  @media (max-width: 1024px) {
    .nf__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .nf h1 {
      font-stretch: 100%;
      font-size: clamp(2.25rem, 10vw, 2.75rem);
    }
  }
</style>
