---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';

const kurumsal = [
  {
    title: 'Hakkımızda',
    description: `${site.foundedYear}'dan bu yana deneyimimiz, ekibimiz ve çalışma prensiplerimiz.`,
    href: '/hakkimizda',
    icon: 'building',
    image: '/img/hakkimizda.png',
  },
  {
    title: 'Vizyon & Misyon',
    description: 'Bugünün ihtiyaçlarını geleceğin değerleriyle birleştiren yaklaşımımız.',
    href: '/hakkimizda/vizyon-misyon',
    icon: 'binoculars',
    image: '/img/projects/vadistanbul/vadistanbul.webp',
  },
  {
    title: 'Belgelerimiz',
    description: 'ISO sertifikalarımız, iş bitirme belgelerimiz ve e-katalog.',
    href: '/belgeler',
    icon: 'document',
    image: '/img/projects/varyap-meridien-konut/varyap-meridien-konut.webp',
  },
];

const stats = [
  { value: String(site.foundedYear), label: 'Kuruluş Yılı' },
  { value: String(site.stats.employeeCount), label: 'Çalışan' },
  { value: String(site.stats.avgAnnualProjects), label: 'Yıllık Ortalama Proje' },
  { value: String(site.completionCertificatesCount), label: 'İş Bitirme Belgesi' },
];
---

<Layout
  title="Kurumsal | Sayda İnşaat"
  description="Sayda İnşaat hakkında, vizyon ve misyonumuz, belgelerimiz ve haberler."
  hideCtaBanner
>
  <section class="kh-hero">
    <div class="kh-hero__media" aria-hidden="true">
      <img src="/img/sayda-insaat-hero01.webp" alt="" fetchpriority="high" />
    </div>
    <p class="kh-hero__script" aria-hidden="true">“Daha iyi<br />yarınlar<br />için sağlam<br />yapılar”</p>

    <div class="container kh-hero__inner">
      <div class="eyebrow">
        <span class="eyebrow__bar"></span>
        <span>KURUMSAL</span>
      </div>
      <h1>Sayda İnşaat'ı Tanıyın</h1>
      <p class="kh-hero__lead">
        {site.foundedYear}'dan bu yana İstanbul'da kentsel dönüşüm ve müteahhitlik hizmeti veriyoruz.
        Hikayemiz, değerlerimiz ve belgelerimiz hakkında bilgi alın.
      </p>

      <ul class="kh-hero__stats">
        {
          stats.map((stat) => (
            <li>
              <span class="kh-hero__stat-value">{stat.value}</span>
              <span class="kh-hero__stat-label">{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="kh-cards">
    <div class="container">
      <ul class="kh-cards__grid">
        {
          kurumsal.map((item, index) => (
            <li class={`reveal reveal-d${index + 1}`}>
              <a class="kh-card" href={item.href}>
                <img class="kh-card__image" src={item.image} alt="" loading="lazy" />
                <span class="kh-card__icon">
                  <Icon name={item.icon} size={24} />
                </span>
                <div class="kh-card__body">
                  <h2>{item.title}</h2>
                  <p>{item.description}</p>
                </div>
                <span class="kh-card__arrow">
                  <Icon name="arrow" size={20} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="kh-cta">
    <img class="kh-cta__bg" src="/img/sayda-insaat-hero02.webp" alt="" loading="lazy" />
    <div class="container kh-cta__inner reveal">
      <div>
        <div class="eyebrow eyebrow--light">
          <span class="eyebrow__bar"></span>
          <span>BİRLİKTE DAHA GÜÇLÜ YAPILAR</span>
        </div>
        <h2>Yeni projeniz için bizimle çalışın.</h2>
      </div>
      <div class="kh-cta__side">
        <p>Deneyimimiz, uzman ekibimiz ve çözüm odaklı yaklaşımımızla yanınızdayız.</p>
        <a class="btn btn--white" href="/iletisim#quote-form">
          Teklif Al <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Tam genişlik: bu sayfada içerik 1200px ile sınırlanmaz */
  .container {
    max-width: none;
    padding-inline: clamp(var(--edge-mobile), 4vw, 72px);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--color-navy);
  }

  .eyebrow__bar {
    display: block;
    width: 28px;
    height: 2px;
    background: currentColor;
  }

  .eyebrow--light {
    color: rgba(255, 255, 255, 0.75);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 15px 26px;
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 700;
    transition:
      background var(--transition),
      color var(--transition);
  }

  .btn--white {
    background: #fff;
    color: var(--color-navy);
  }

  .btn--white:hover {
    background: #e8e9f5;
  }

  h2 {
    font-size: clamp(1.75rem, 2.2vw + 1rem, 2.5rem);
    color: var(--color-navy-deep);
  }

  /* Hero */
  .kh-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
  }

  .kh-hero__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 58%;
  }

  .kh-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% center;
  }

  .kh-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--color-bg) 0%, rgba(255, 255, 255, 0) 45%),
      linear-gradient(to top, var(--color-bg) 0%, rgba(255, 255, 255, 0) 22%);
  }

  .kh-hero__script {
    position: absolute;
    top: 64px;
    left: 50%;
    z-index: 1;
    font-family: var(--font-script);
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    line-height: 1.1;
    color: rgba(255, 255, 255, 0.85);
    transform: rotate(-9deg);
    text-shadow: 0 2px 12px rgba(19, 21, 74, 0.35);
  }

  .kh-hero__inner {
    position: relative;
    z-index: 2;
    padding-block: 72px 56px;
  }

  .kh-hero h1 {
    max-width: 14ch;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    letter-spacing: -0.02em;
    color: var(--color-navy-deep);
  }

  .kh-hero__lead {
    max-width: 46ch;
    margin-top: 18px;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  .kh-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--color-border);
  }

  .kh-hero__stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2vw + 0.5rem, 2rem);
    color: var(--color-navy-deep);
  }

  .kh-hero__stat-label {
    display: block;
    margin-top: 4px;
    font-size: var(--fs-small);
    color: var(--color-text-faint);
  }

  /* Cards */
  .kh-cards {
    padding-block: 24px 88px;
  }

  .kh-cards__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }

  .kh-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .kh-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .kh-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(19, 21, 74, 0.92) 0%, rgba(19, 21, 74, 0.25) 55%, rgba(19, 21, 74, 0.05) 100%);
  }

  .kh-card:hover .kh-card__image {
    transform: scale(1.06);
  }

  .kh-card__icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: 28px 28px 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(4px);
  }

  .kh-card__body {
    position: relative;
    z-index: 1;
    padding: 24px 28px 28px;
  }

  .kh-card__body h2 {
    font-size: 1.375rem;
    color: #fff;
  }

  .kh-card__body p {
    margin-top: 10px;
    max-width: 30ch;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
  }

  .kh-card__arrow {
    position: absolute;
    z-index: 1;
    right: 24px;
    bottom: 24px;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    transition:
      background var(--transition),
      color var(--transition);
  }

  .kh-card:hover .kh-card__arrow {
    background: #fff;
    color: var(--color-navy);
  }

  /* CTA */
  .kh-cta {
    position: relative;
    overflow: hidden;
    padding-block: 88px;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .kh-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
    mix-blend-mode: luminosity;
  }

  .kh-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(25, 27, 74, 0.92), rgba(25, 27, 74, 0.6));
  }

  .kh-cta__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .kh-cta h2 {
    max-width: 14ch;
    font-size: clamp(1.75rem, 2.6vw + 1rem, 2.75rem);
    color: #fff;
  }

  .kh-cta__side {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .kh-cta__side p {
    max-width: 34ch;
    font-size: var(--fs-small);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .kh-hero__media {
      width: 100%;
    }

    .kh-hero__media::after {
      background: linear-gradient(to right, var(--color-bg) 0%, rgba(255, 255, 255, 0.7) 55%, rgba(255, 255, 255, 0.2) 100%);
    }

    .kh-hero__script {
      display: none;
    }

    .kh-cards__grid {
      grid-template-columns: 1fr 1fr;
    }

    .kh-cta__inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  @media (max-width: 640px) {
    .kh-hero__inner {
      padding-block: 56px 48px;
    }

    .kh-hero__stats {
      gap: var(--space-m);
    }

    .kh-cards {
      padding-block: 16px 64px;
    }

    .kh-cards__grid {
      grid-template-columns: 1fr;
    }

    .kh-card {
      aspect-ratio: 4 / 3.4;
    }
  }
</style>
