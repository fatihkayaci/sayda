---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';

const kurumsal = [
  {
    title: 'Hakkımızda',
    description: `${site.foundedYear}'dan bu yana deneyimimiz, ekibimiz ve çalışma prensiplerimiz.`,
    href: '/hakkimizda',
  },
  {
    title: 'Vizyon & Misyon',
    description: 'Bugünün ihtiyaçlarını geleceğin değerleriyle birleştiren yaklaşımımız.',
    href: '/hakkimizda/vizyon-misyon',
  },
  {
    title: 'Belgelerimiz',
    description: 'ISO sertifikalarımız, iş bitirme belgelerimiz ve e-katalog.',
    href: '/belgeler',
  },
];

const stats = [
  { value: String(site.foundedYear), label: 'Kuruluş Yılı' },
  { value: '30+', label: 'Yıllık Deneyim' },
  { value: String(site.completionCertificatesCount), label: 'İş Bitirme Belgesi' },
  { value: 'ISO', label: '9001 · 14001 · 10002' },
];
---

<Layout
  title="Kurumsal | Sayda İnşaat"
  description="Sayda İnşaat hakkında, vizyon ve misyonumuz, belgelerimiz ve haberler."
  heading="Sayda İnşaat'ı Tanıyın"
>
  <section class="page">
    <div class="container page__split">
      <div>
        <p>
          {site.foundedYear}'dan bu yana İstanbul'da kentsel dönüşüm ve müteahhitlik hizmeti veriyoruz. Hikayemiz,
          değerlerimiz ve belgelerimiz hakkında bilgi alın.
        </p>
        <p><em>“Daha iyi yarınlar için sağlam yapılar”</em></p>

        <div class="page__facts">
          {
            stats.map((s) => (
              <div>
                <strong>{s.value}</strong>
                {s.label}
              </div>
            ))
          }
        </div>

        <h2>Bizi yakından tanıyın</h2>
        <div class="page__grid">
          {
            kurumsal.map((item) => (
              <a class="page__box" href={item.href}>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </a>
            ))
          }
        </div>
      </div>
      <div class="page__aside">
        <img src="/img/hakkimizda.png" alt="Sayda İnşaat" loading="lazy" />
      </div>
    </div>
  </section>
</Layout>
