---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PageIndex from '../../components/PageIndex.astro';
import site from '../../data/site.json';

const pages = [
  {
    title: 'Hakkımızda',
    description: `${site.foundedYear}'dan bu yana deneyimimiz, ekibimiz ve çalışma prensiplerimiz.`,
    href: '/hakkimizda',
    image: '/img/hakkimizda.png',
  },
  {
    title: 'Vizyon & Misyon',
    description: 'Bugünün ihtiyaçlarını geleceğin değerleriyle birleştiren yaklaşımımız.',
    href: '/hakkimizda/vizyon-misyon',
    image: '/img/projects/vadistanbul/vadistanbul.webp',
  },
  {
    title: 'Belgelerimiz',
    description: 'ISO sertifikalarımız, iş bitirme belgelerimiz ve e-katalog.',
    href: '/belgeler',
    image: '/img/projects/varyap-meridien-konut/varyap-meridien-konut.webp',
  },
];
---

<Layout
  title="Kurumsal | Sayda İnşaat"
  description="Sayda İnşaat hakkında, vizyon ve misyonumuz, belgelerimiz ve haberler."
>
  <PageHero
    eyebrow="Kurumsal"
    breadcrumbs={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Kurumsal' }]}
    image="/img/sayda-insaat-hero04.webp"
    imagePosition="30% center"
    size="compact"
    facts={[
      { value: String(site.foundedYear), label: 'Kuruluş' },
      { value: String(site.completionCertificatesCount), label: 'İş Bitirme Belgesi' },
      { value: String(site.certifications.length), label: 'Sertifika' },
    ]}
  >
    Sayda İnşaat'ı <em>tanıyın.</em>
  </PageHero>

  <section class="kr-index">
    <div class="container">
      <PageIndex label="Kurumsal Sayfalar" items={pages} />
    </div>
  </section>
</Layout>

<style>
  .kr-index {
    padding-block: clamp(80px, 9vw, 140px);
    background: var(--color-bg);
  }
</style>
