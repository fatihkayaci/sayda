---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';

const kurumsal = [
  {
    title: 'Hakkımızda',
    description: `${site.foundedYear}'dan bu yana deneyimimiz, ekibimiz ve çalışma prensiplerimiz.`,
    href: '/hakkimizda',
    icon: 'building',
    image: '/img/hakkimizda.png',
  },
  {
    title: 'Vizyon & Misyon',
    description: 'Bugünün ihtiyaçlarını geleceğin değerleriyle birleştiren yaklaşımımız.',
    href: '/hakkimizda/vizyon-misyon',
    icon: 'binoculars',
    image: '/img/projects/vadistanbul/vadistanbul.webp',
  },
  {
    title: 'Belgelerimiz',
    description: 'ISO sertifikalarımız, iş bitirme belgelerimiz ve e-katalog.',
    href: '/belgeler',
    icon: 'document',
    image: '/img/projects/varyap-meridien-konut/varyap-meridien-konut.webp',
  },
];

const stats = [
  { value: String(site.foundedYear), label: 'Kuruluş Yılı' },
  { value: '30+', label: 'Yıllık Deneyim' },
  { value: String(site.completionCertificatesCount), label: 'İş Bitirme Belgesi' },
  { value: 'ISO', label: '9001 · 14001 · 10002' },
];
---

<Layout
  title="Kurumsal | Sayda İnşaat"
  description="Sayda İnşaat hakkında, vizyon ve misyonumuz, belgelerimiz ve haberler."
>
  <section class="kh-hero">
    <div class="kh-hero__media" aria-hidden="true">
      <img src="/img/sayda-insaat-hero01.webp" alt="" fetchpriority="high" />
    </div>

    <div class="container kh-hero__inner">
      <nav class="kh-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Ana Sayfa</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Kurumsal</span>
      </nav>

      <div class="kh-hero__grid">
        <div class="kh-hero__main">
          <div class="eyebrow eyebrow--light">
            <span class="eyebrow__bar"></span>
            <span>Kurumsal</span>
          </div>
          <h1 class="kh-hero__title">
            Sayda<br />
            <span class="kh-hero__title-accent">İnşaat'ı</span><br />
            Tanıyın
          </h1>
          <p class="kh-hero__lead">
            {site.foundedYear}'dan bu yana İstanbul'da kentsel dönüşüm ve müteahhitlik hizmeti veriyoruz.
            Hikayemiz, değerlerimiz ve belgelerimiz hakkında bilgi alın.
          </p>
        </div>

        <div class="kh-hero__quote">
          <p>“Daha iyi yarınlar için sağlam yapılar”</p>
        </div>
      </div>
    </div>
  </section>

  <section class="kh-stats">
    <div class="container kh-stats__grid">
      {
        stats.map((stat) => (
          <div class="kh-stats__item">
            <span class="kh-stats__value">{stat.value}</span>
            <span class="kh-stats__label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="kh-cards">
    <div class="container">
      <div class="eyebrow">
        <span class="eyebrow__bar"></span>
        <span>Kurumsal Sayfalar</span>
      </div>
      <h2 class="kh-cards__title">Bizi yakından tanıyın</h2>

      <ul class="kh-cards__grid">
        {
          kurumsal.map((item, index) => (
            <li class={`reveal reveal-d${index + 1}`}>
              <a class="kh-card" href={item.href}>
                <div class="kh-card__media">
                  <img class="kh-card__image" src={item.image} alt="" loading="lazy" />
                  <span class="kh-card__icon">
                    <Icon name={item.icon} size={22} />
                  </span>
                </div>
                <div class="kh-card__body">
                  <div class="kh-card__row">
                    <span class="kh-card__num">{String(index + 1).padStart(2, '0')}</span>
                    <span class="kh-card__arrow">
                      <Icon name="arrow" size={18} />
                    </span>
                  </div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>


</Layout>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .eyebrow__bar {
    display: block;
    width: 28px;
    height: 2px;
    background: currentColor;
  }

  .eyebrow--light {
    color: var(--color-on-dark-muted);
  }

  h2 {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 700;
    letter-spacing: -0.015em;
    font-size: clamp(1.75rem, 2.2vw + 1rem, 2.75rem);
    color: var(--color-navy-deep);
  }

  /* Hero */
  .kh-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .kh-hero__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 52%;
  }

  .kh-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% center;
  }

  .kh-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-navy-deep) 0%, rgba(25, 27, 74, 0.55) 35%, rgba(25, 27, 74, 0.15) 100%);
  }

  .kh-hero__inner {
    position: relative;
    z-index: 2;
    min-height: 560px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: 56px 96px;
  }

  .kh-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 56px;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--color-on-dark-muted);
  }

  .kh-breadcrumb a {
    color: var(--color-on-dark-muted);
    transition: color var(--transition);
  }

  .kh-breadcrumb a:hover {
    color: #fff;
  }

  .kh-breadcrumb [aria-current] {
    color: #fff;
  }

  .kh-hero__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr));
    gap: var(--space-xl);
    align-items: end;
  }

  .kh-hero__title {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.01em;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: #fff;
  }

  .kh-hero .eyebrow--light {
    color: #8589e6;
  }

  .kh-hero__title-accent {
    font-weight: 300;
    color: #8589e6;
  }

  .kh-hero__lead {
    max-width: 46ch;
    margin-top: 26px;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.8);
  }

  .kh-hero__quote {
    display: flex;
    justify-content: flex-end;
  }

  .kh-hero__quote p {
    max-width: 380px;
    margin: 0;
    padding: 4px 0 4px 26px;
    border-left: 2px solid #8589e6;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 600;
    font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: #fff;
  }

  /* Stats band */
  .kh-stats {
    background: var(--color-navy);
    color: #fff;
  }

  .kh-stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  .kh-stats__item {
    padding: 40px 28px;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
  }

  .kh-stats__value {
    display: block;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
  }

  .kh-stats__label {
    display: block;
    margin-top: 12px;
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  /* Cards */
  .kh-cards {
    padding-block: 96px;
    background: var(--color-bg-light);
  }

  .kh-cards__title {
    margin: 0 0 40px;
  }

  .kh-cards__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }

  .kh-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--color-text);
    transition:
      box-shadow var(--transition),
      transform var(--transition);
  }

  .kh-card:hover {
    box-shadow: 0 24px 48px -24px rgba(13, 21, 51, 0.35);
    transform: translateY(-4px);
  }

  .kh-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-light);
  }

  .kh-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .kh-card:hover .kh-card__image {
    transform: scale(1.06);
  }

  .kh-card__icon {
    position: absolute;
    top: 18px;
    left: 18px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(19, 21, 74, 0.55);
    backdrop-filter: blur(4px);
    color: #fff;
  }

  .kh-card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    padding: 26px 28px 30px;
  }

  .kh-card__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .kh-card__num {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-navy);
  }

  .kh-card__arrow {
    display: grid;
    place-items: center;
    color: var(--color-navy);
    transition: transform var(--transition);
  }

  .kh-card:hover .kh-card__arrow {
    transform: translateX(4px);
  }

  .kh-card__body h3 {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--color-navy-deep);
  }

  .kh-card__body p {
    margin: 0;
    max-width: 32ch;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .kh-hero__media {
      width: 100%;
    }

    .kh-hero__media::after {
      background: linear-gradient(
        90deg,
        var(--color-navy-deep) 0%,
        rgba(25, 27, 74, 0.75) 55%,
        rgba(25, 27, 74, 0.35) 100%
      );
    }

    .kh-hero__quote {
      justify-content: flex-start;
    }

    .kh-cards__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .kh-hero__inner {
      padding-block: 40px 64px;
    }

    .kh-breadcrumb {
      margin-bottom: 36px;
    }

    .kh-cards {
      padding-block: 64px;
    }

    .kh-cards__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
