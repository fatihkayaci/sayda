---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';

const mapSrc =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3004.8431446997392!2d29.050132814863236!3d41.137950019385016!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14caca992de690d7%3A0x610000eea3614bdc!2zS2F5ZMSxcmFrIFNrLiBObzo5LCBUYXJhYnlhLCAzNDQ1NyBTYXLEsXllci_EsHN0YW5idWw!5e0!3m2!1str!2str!4v1453124749653';

const phones = ['+90 212 223 88 12', '+90 212 299 42 92', '+90 212 299 42 93', '(fax) +90 212 223 61 70'];
---

<Layout
  title="İletişim | Sayda İnşaat"
  description="Sayda İnşaat iletişim bilgileri ve teklif formu."
  organizationSchema
  hideCtaBanner
  heading="İletişim"
>
  <section class="page" id="quote-form">
    <div class="container contact">
      <div>
        <form id="contactForm" class="contact__form">
          <input type="hidden" name="access_key" value={site.web3formsAccessKey} />
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

          <input type="text" name="name" placeholder="Ad Soyad" required autocomplete="name" aria-label="Ad Soyad" />
          <input type="email" name="email" placeholder="E-Mail" required autocomplete="email" aria-label="E-Mail" />
          <input type="text" name="subject" placeholder="Konu" aria-label="Konu" />
          <textarea name="message" rows="6" placeholder="Mesaj" required aria-label="Mesaj"></textarea>

          <label class="consent">
            <input type="checkbox" name="kvkk" required />
            <span>
              <a href="/kvkk-aydinlatma-metni" target="_blank" rel="noopener noreferrer">KVKK Aydınlatma Metni</a>'ni
              okudum, kişisel verilerimin işlenmesini kabul ediyorum.
            </span>
          </label>

          <div>
            <button type="submit" class="contact__send">Gönder</button>
          </div>
          <p id="contactStatus" role="status" aria-live="polite"></p>
        </form>

        <iframe class="map" title="Sayda İnşaat konumu" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>

      <aside class="contact__info">
        <ul>
          <li>
            <span class="icon"><Icon name="pin" size={22} /></span>
            <p>{site.address.street}, {site.address.postalCode} {site.address.neighborhood} / {site.address.city.toLocaleUpperCase('tr')}</p>
          </li>
          <li>
            <span class="icon"><Icon name="mail" size={22} /></span>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          </li>
          <li>
            <span class="icon"><Icon name="phone" size={22} /></span>
            <p>
              {phones.map((phone) => <span class="phone">{phone}</span>)}
            </p>
          </li>
        </ul>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .contact__form {
    display: grid;
    gap: 14px;
  }

  .contact__form input,
  .contact__form textarea {
    padding: 14px 16px;
    font-size: 13px;
    background: #f6f6f6;
    border: 1px solid #ececec;
  }

  .contact__form textarea {
    resize: vertical;
  }

  .contact__send {
    width: 180px;
    padding: 0;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    line-height: 44px;
    text-transform: uppercase;
    color: #fff;
    background: #1d1d1d;
    border: 0;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .contact__send:hover {
    background: #f69c00;
  }

  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 12px;
  }

  .consent input {
    width: auto;
    margin-top: 3px;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  .map {
    width: 100%;
    height: 300px;
    margin-top: 30px;
    border: 0;
  }

  .contact__info li {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 22px 20px;
    background: #fff;
    border-bottom: 1px solid #eee;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.04);
  }

  .icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    color: #f69c00;
    border: 1px solid #f69c00;
    border-radius: 50%;
  }

  .contact__info p {
    margin: 0;
    font-size: 13px;
  }

  .phone {
    display: block;
    line-height: 1.8;
  }

  [data-state='error'] {
    color: #c0392b;
  }

  [data-state='success'] {
    color: #2e7d32;
  }

  @media (max-width: 800px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const status = document.getElementById('contactStatus');
    if (!form || !status) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const accessKey = (form.elements.namedItem('access_key') as HTMLInputElement)?.value;
      if (!accessKey) {
        status.textContent = 'Form şu an gönderime kapalı, lütfen telefonla ulaşın.';
        status.setAttribute('data-state', 'error');
        return;
      }

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitButton.disabled = true;
      status.textContent = 'Gönderiliyor...';
      status.removeAttribute('data-state');

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const result = await res.json();

        if (!result.success) throw new Error(result.message ?? 'Unknown error');
        status.textContent = 'Teşekkürler, talebiniz alındı. En kısa sürede dönüş yapacağız.';
        status.setAttribute('data-state', 'success');
        form.reset();
      } catch {
        status.textContent = 'Gönderilemedi, lütfen telefonla ulaşın.';
        status.setAttribute('data-state', 'error');
      } finally {
        submitButton.disabled = false;
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>

  .ct-eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 13px;
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-navy);
  }

  .ct-eyebrow span {
    display: block;
    width: 36px;
    height: 2px;
    background: currentColor;
  }

  .ct-eyebrow--small {
    font-size: 0.7rem;
    margin-bottom: 9px;
  }

  /* Hero */
  .ct-hero {
    position: relative;
    overflow: hidden;
    background: #eef2f9;
  }

  .ct-hero__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 58%;
  }

  .ct-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% top;
  }

  .ct-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, #eef2f9 0%, rgba(238, 242, 249, 0) 48%);
  }

  .ct-hero__inner {
    position: relative;
    padding-block: 36px 49px;
  }

  .ct-hero__breadcrumb {
    display: flex;
    gap: 13px;
    margin-bottom: 30px;
    font-size: 0.84rem;
    color: var(--color-text-muted);
  }

  .ct-hero__breadcrumb a:hover {
    color: var(--color-navy);
  }

  .ct-hero h1 {
    margin-bottom: 18px;
    font-size: clamp(2.52rem, 4.928vw, 3.92rem);
    line-height: 1.05;
    color: var(--color-text);
  }

  .ct-hero__lead {
    max-width: 52ch;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .ct-hero__quote {
    position: absolute;
    top: 50%;
    right: clamp(20px, 4vw, 72px);
    padding-left: 21px;
    border-left: 3px solid rgba(255, 255, 255, 0.9);
    font-size: 1.26rem;
    line-height: 1.6;
    color: #fff;
    text-shadow: 0 2px 12px rgba(19, 21, 74, 0.5);
    transform: translateY(-50%);
  }

  /* Main */
  .ct-main {
    padding-block: 21px 36px;
    background: #f4f6fb;
  }

  .ct-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 21px;
  }

  .ct-cards li {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 25px 27px;
    border-radius: 3px;
    background: #fff;
    box-shadow: 0 2px 14px rgba(43, 46, 131, 0.06);
  }

  .ct-cards__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .ct-cards h2 {
    margin-bottom: 4px;
    font-family: var(--font-body);
    font-size: 0.98rem;
    font-weight: 800;
    color: var(--color-navy-deep);
  }

  .ct-cards p {
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .ct-cards a:hover {
    color: var(--color-navy);
    text-decoration: underline;
  }

  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 36px;
    align-items: stretch;
  }

  .ct-map {
    position: relative;
    min-height: 470px;
    overflow: hidden;
    border-radius: 4px;
    background: #e3e8f2;
  }

  .ct-map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ct-map__card {
    position: absolute;
    top: 18px;
    left: 20px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 21px 30px 21px 22px;
    border-radius: 4px;
    background: var(--color-navy-deep);
    color: #fff;
    box-shadow: 0 8px 24px rgba(17, 19, 24, 0.25);
  }

  .ct-map__card div {
    display: grid;
    gap: 4px;
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .ct-map__card strong {
    font-size: 1.05rem;
    color: #fff;
  }

  .ct-map__card a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 12px;
    font-weight: 700;
    color: #fff;
  }

  /* Form */
  .ct-form {
    padding: 25px 31px 30px;
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 2px 20px rgba(43, 46, 131, 0.07);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  .ct-form h2 {
    margin-bottom: 9px;
    font-size: clamp(1.68rem, 2.464vw, 2.1rem);
    color: var(--color-navy-deep);
  }

  .ct-form__lead {
    margin-bottom: 21px;
    font-size: 0.84rem;
    color: var(--color-text-muted);
  }

  .ct-form form {
    display: grid;
    gap: 16px;
  }

  .ct-form__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }

  .ct-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .ct-form label {
    display: grid;
    gap: 7px;
  }

  .ct-form label > span {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-navy-deep);
  }

  .ct-form input:not([type='checkbox']),
  .ct-form select,
  .ct-form textarea {
    width: 100%;
    padding: 12px 13px;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: #fff;
    font: inherit;
    font-size: 0.84rem;
    color: var(--color-text);
  }

  .ct-form input:not([type='checkbox']),
  .ct-form select {
    height: 45px;
  }

  .ct-form textarea {
    min-height: 99px;
    resize: vertical;
  }

  .ct-form input:focus,
  .ct-form select:focus,
  .ct-form textarea:focus {
    outline: none;
    border-color: var(--color-navy);
  }

  .ct-form__consent {
    display: flex !important;
    align-items: center;
    gap: 12px;
    font-size: 0.77rem;
    color: var(--color-text-muted);
  }

  .ct-form .ct-form__consent > span {
    font-size: 0.77rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .ct-form__consent input {
    flex: none;
    width: 16px;
    height: 16px;
  }

  .ct-form__consent a {
    font-weight: 700;
    color: var(--color-navy);
  }

  .ct-form__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .ct-form__actions button {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    padding: 14px 30px;
    border: 0;
    border-radius: 3px;
    background: var(--color-navy-deep);
    color: #fff;
    font: inherit;
    font-size: 0.91rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--transition);
  }

  .ct-form__actions button:hover {
    background: var(--color-navy);
  }

  .ct-form__actions button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .ct-form__secure {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.77rem;
    color: var(--color-text-faint);
  }

  .ct-form__status {
    min-height: 1em;
    font-size: 0.84rem;
  }

  .ct-form__status:empty {
    display: none;
  }

  .ct-form__status[data-state='success'] {
    color: #1f7a4d;
  }

  .ct-form__status[data-state='error'] {
    color: #b3261e;
  }

  /* Offices */
  .ct-offices {
    padding-block: 13px 63px;
    background: #f4f6fb;
  }

  .ct-offices__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 9px 27px;
    margin-bottom: 22px;
  }

  .ct-offices__head h2 {
    padding-left: 16px;
    border-left: 3px solid var(--color-navy);
    font-family: var(--font-body);
    font-size: 1.54rem;
    font-weight: 800;
    color: var(--color-navy-deep);
  }

  .ct-offices__head p {
    font-size: 0.91rem;
    color: var(--color-text-muted);
  }

  .ct-offices__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 27px;
  }

  .ct-offices__grid a {
    display: flex;
    align-items: center;
    gap: 21px;
    padding: 13px 22px 13px 13px;
    border-radius: 3px;
    background: #fff;
    box-shadow: 0 2px 14px rgba(43, 46, 131, 0.06);
    color: var(--color-navy);
    transition: box-shadow 200ms;
  }

  .ct-offices__grid a:hover {
    box-shadow: 0 8px 26px rgba(43, 46, 131, 0.13);
  }

  .ct-offices__grid img {
    flex: none;
    width: 106px;
    height: 76px;
    border-radius: 3px;
    object-fit: cover;
  }

  .ct-offices__grid span {
    flex: 1;
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .ct-offices__grid strong {
    display: block;
    margin-bottom: 2px;
    font-size: 1.05rem;
    color: var(--color-navy-deep);
  }

  @media (max-width: 1200px) {
    .ct-cards {
      grid-template-columns: 1fr 1fr;
    }

    .ct-grid {
      grid-template-columns: 1fr;
    }

    .ct-map {
      min-height: 381px;
    }

    .ct-offices__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 900px) {
    .ct-hero__media {
      width: 100%;
      opacity: 0.4;
    }

    .ct-hero__quote {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .ct-cards,
    .ct-form__row,
    .ct-offices__grid {
      grid-template-columns: 1fr;
    }

    .ct-form__actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .ct-map__card {
      right: 12px;
      left: 12px;
    }
  }
</style>
