---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import projects from '../../data/projects.json';

const hero = projects.find((p) => p.slug === 'atlas-park-avm-ofis')!;
import SectionHead from '../../components/SectionHead.astro';
import services from '../../data/services.json';
import site from '../../data/site.json';

const mapsQuery = encodeURIComponent('SAYDA, Tarabya, Kaydırak Sk. No:3, 34457 Sarıyer/İstanbul');
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const mapSrc = `https://www.google.com/maps?q=${mapsQuery}&z=16&output=embed`;

const addressLine = `${site.address.neighborhood} / ${site.address.district}, ${site.address.city} ${site.address.postalCode}`;
---

<Layout ogImage={hero.image}
  title="İletişim ve Teklif Talebi | Sayda İnşaat Tarabya"
  description="Sayda İnşaat Tarabya / Sarıyer ofis adresi, telefon ve e-posta bilgileri. Projeniz için teklif formunu doldurun, size dönüş yapalım."
  organizationSchema
  hideCtaBanner
>
  <PageHero
    eyebrow="Bize Ulaşın"
    breadcrumbs={[{ label: 'Ana Sayfa', href: '/' }, { label: 'İletişim' }]}
    variant="photo"
    image={hero.image}
    imagePosition="center"
    size="short"
    credit={'imageCredit' in hero ? hero.imageCredit : undefined}
  >
    Projenizi <em>konuşalım.</em>
  </PageHero>

  <section class="ct-main">
    <div class="container ct-main__inner">
      <div class="ct-form" id="quote-form">
        <SectionHead label="Mesaj Gönderin" title="Teklif ve bilgi talebi." />
        <p class="ct-form__lead">Formu doldurun, ekibimiz en kısa sürede sizinle iletişime geçsin.</p>

        <form id="contactForm">
          <input type="hidden" name="form_type" value="contact" />
          <input type="checkbox" name="botcheck" class="ct-form__honeypot" tabindex="-1" autocomplete="off" />

          <fieldset class="ct-form__services">
            <legend>Hangi hizmetle ilgileniyorsunuz?</legend>
            <div>
              {
                services.map((service) => (
                  <label class="ct-pill">
                    <input type="radio" name="service" value={service.title} />
                    <span>{service.title}</span>
                  </label>
                ))
              }
              <label class="ct-pill">
                <input type="radio" name="service" value="Diğer" />
                <span>Diğer</span>
              </label>
            </div>
          </fieldset>

          <div class="ct-form__row">
            <label>
              <span>Ad Soyad *</span>
              <input type="text" name="name" placeholder="Adınız ve soyadınız" required autocomplete="name" />
            </label>
            <label>
              <span>Telefon *</span>
              <input type="tel" name="phone" placeholder="+90 5XX XXX XX XX" required autocomplete="tel" />
            </label>
          </div>

          <label>
            <span>E-posta *</span>
            <input type="email" name="email" placeholder="ornek@mail.com" required autocomplete="email" />
          </label>

          <label>
            <span>Mesajınız *</span>
            <textarea name="message" rows="5" placeholder="Projenizden kısaca bahsedin: konum, alan, ihtiyaç..." required></textarea>
          </label>

          <label class="ct-form__consent">
            <input type="checkbox" name="kvkk" required />
            <span>
              <a href="/kvkk-aydinlatma-metni" target="_blank" rel="noopener noreferrer">KVKK Aydınlatma Metni</a>'ni
              okudum, kişisel verilerimin işlenmesini kabul ediyorum.
            </span>
          </label>

          <div class="ct-form__actions">
            <button type="submit">
              Mesaj Gönder <Icon name="arrow" size={18} />
            </button>
            <p class="ct-form__secure">
              <Icon name="lock" size={16} />
              Bilgileriniz güvenle saklanır.
            </p>
          </div>

          <p class="ct-form__status" id="contactStatus" role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="ct-side">
        <div class="ct-direct">
          <a class="ct-direct__item ct-direct__item--big" href={site.phoneHref}>
            <span class="ct-direct__label"><Icon name="phone" size={18} /> Telefon</span>
            <strong>{site.phone}</strong>
          </a>
          <a class="ct-direct__item ct-direct__item--big" href={`mailto:${site.email}`}>
            <span class="ct-direct__label"><Icon name="mail" size={18} /> E-posta</span>
            <strong>{site.email}</strong>
          </a>
          <a class="ct-direct__item" href={mapsUrl} target="_blank" rel="noopener noreferrer">
            <span class="ct-direct__label"><Icon name="pin" size={18} /> Adres</span>
            <span>
              {site.address.street}
              <br />
              {addressLine}
            </span>
          </a>
          <div class="ct-direct__item">
            <span class="ct-direct__label"><Icon name="clock" size={18} /> Çalışma Saatleri</span>
            <span>
              {
                site.workingHours.map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))
              }
            </span>
          </div>
        </div>

        <div class="ct-map">
          <iframe title="Sayda İnşaat konumu" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <a class="ct-map__link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
            Yol Tarifi Al <Icon name="arrow" size={16} />
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  function initContactForm() {
    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const status = document.getElementById('contactStatus');
    if (!form || !status || form.dataset.ready) return;
    form.dataset.ready = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitButton.disabled = true;
      status.textContent = 'Gönderiliyor...';
      status.removeAttribute('data-state');

      try {
        const res = await fetch('/form.php', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await res.json();

        if (!result.success) throw new Error(result.message ?? 'Unknown error');
        status.textContent = 'Teşekkürler, talebiniz alındı. En kısa sürede dönüş yapacağız.';
        status.setAttribute('data-state', 'success');
        form.reset();
      } catch {
        status.textContent = 'Gönderilemedi, lütfen telefonla ulaşın.';
        status.setAttribute('data-state', 'error');
      } finally {
        submitButton.disabled = false;
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  /* Sidebar: direct contact + map */
  .ct-side {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    align-self: start;
    display: grid;
    gap: 16px;
  }

  .ct-direct {
    display: grid;
    padding: 8px 32px;
    border-radius: var(--radius);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .ct-direct__item {
    display: grid;
    gap: 10px;
    padding: 24px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  .ct-direct__item:first-child {
    border-top: 0;
  }

  a.ct-direct__item:hover {
    color: #fff;
  }

  a.ct-direct__item:hover strong {
    color: var(--color-orange);
  }

  .ct-direct__label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .ct-direct__label :global(svg) {
    color: var(--color-orange);
  }

  .ct-direct__item strong {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 800;
    font-size: clamp(1.375rem, 1vw + 0.9rem, 2rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    color: #fff;
    transition: color var(--transition);
  }

  /* Form + map */
  .ct-main {
    padding-block: clamp(48px, 5vw, 80px) clamp(80px, 9vw, 140px);
    background: var(--color-bg);
  }

  .ct-main__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .ct-form {
    scroll-margin-top: var(--header-h);
  }

  .ct-form :global(.section-head) {
    margin-bottom: 20px;
  }

  .ct-form__lead {
    margin-bottom: 40px;
    font-size: 1.0625rem;
    color: var(--color-text-muted);
  }

  .ct-form form {
    display: grid;
    gap: 22px;
  }

  .ct-form__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }

  .ct-form__services {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .ct-form__services legend {
    margin-bottom: 12px;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-navy-deep);
  }

  .ct-form__services > div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ct-pill {
    position: relative;
    cursor: pointer;
  }

  .ct-pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .ct-pill span {
    display: inline-block;
    padding: 10px 18px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: 999px;
    background: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-navy-deep);
    transition:
      background var(--transition),
      border-color var(--transition),
      color var(--transition);
  }

  .ct-pill:hover span {
    border-color: var(--color-navy);
  }

  .ct-pill input:checked + span {
    border-color: var(--color-navy-deep);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .ct-pill input:focus-visible + span {
    outline: 2px solid var(--color-orange);
    outline-offset: 2px;
  }

  .ct-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .ct-form label:not(.ct-pill) {
    display: grid;
    gap: 8px;
  }

  .ct-form label > span {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-navy-deep);
  }

  .ct-form input:not([type='checkbox']):not([type='radio']),
  .ct-form textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: #fff;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--color-text);
    transition: border-color var(--transition);
  }

  .ct-form input:not([type='checkbox']):not([type='radio']) {
    height: 54px;
  }

  .ct-form textarea {
    min-height: 140px;
    resize: vertical;
  }

  .ct-form input:focus,
  .ct-form textarea:focus {
    outline: none;
    border-color: var(--color-navy);
  }

  .ct-form .ct-form__consent {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
  }

  .ct-form .ct-form__consent > span {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .ct-form__consent input {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--color-navy);
  }

  .ct-form__consent a {
    font-weight: 700;
    color: var(--color-navy);
  }

  .ct-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .ct-form__actions button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 58px;
    padding: 0 32px;
    border: 0;
    border-radius: var(--radius);
    background: var(--color-orange);
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-navy-deep);
    cursor: pointer;
    transition: background var(--transition);
  }

  .ct-form__actions button:hover {
    background: var(--color-orange-dark);
  }

  .ct-form__actions button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .ct-form__secure {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .ct-form__status {
    font-size: 0.9375rem;
  }

  .ct-form__status:empty {
    display: none;
  }

  .ct-form__status[data-state='success'] {
    color: var(--color-success);
  }

  .ct-form__status[data-state='error'] {
    color: var(--color-error);
  }

  .ct-map {
    position: relative;
    height: 280px;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-border);
  }

  .ct-map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.6);
  }

  .ct-map__link {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 18px;
    border-radius: var(--radius);
    background: var(--color-navy-deep);
    font-size: 0.875rem;
    font-weight: 700;
    color: #fff;
    transition: background var(--transition);
  }

  .ct-map__link:hover {
    background: var(--color-navy);
  }

  @media (max-width: 1100px) {
    .ct-main__inner {
      grid-template-columns: 1fr;
    }

    .ct-side {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .ct-form__row {
      grid-template-columns: 1fr;
    }

    .ct-direct {
      padding-inline: 24px;
    }
  }
</style>