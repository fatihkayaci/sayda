---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import QuoteForm from '../../components/home/QuoteForm.astro';
import site from '../../data/site.json';
---

<Layout title="İletişim | Sayda İnşaat" description="Sayda İnşaat iletişim bilgileri ve teklif formu." organizationSchema>
  <section class="iletisim">
    <div class="container">
      <h1>İletişim</h1>
      <p class="iletisim__legal-name">{site.legalName}</p>
      <ul class="iletisim__list">
        <li>
          <Icon name="pin" size={20} />
          <span>{site.address.street}, {site.address.neighborhood} / {site.address.district}, {site.address.city} {site.address.postalCode}</span>
        </li>
        <li>
          <Icon name="phone" size={20} />
          <a href={site.phoneHref}>{site.phone}</a>
        </li>
        <li>
          <Icon name="mail" size={20} />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        {
          site.social.instagram && (
            <li>
              <Icon name="instagram" size={20} />
              <a href={site.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
            </li>
          )
        }
        {
          site.social.linkedin && (
            <li>
              <Icon name="linkedin" size={20} />
              <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </li>
          )
        }
      </ul>
    </div>
  </section>

  <QuoteForm />
</Layout>

<style>
  .iletisim {
    padding-block: var(--space-block-compact) 0;
  }

  .iletisim .container {
    max-width: 760px;
  }

  .iletisim h1 {
    font-size: var(--fs-h1);
  }

  .iletisim__legal-name {
    margin-top: var(--space-s);
    color: var(--color-text-faint);
    font-size: var(--fs-small);
  }

  .iletisim__list {
    margin-top: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .iletisim__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
    font-size: var(--fs-body);
  }
</style>
