<section class="cta-banner">
  <div class="container cta-banner__inner reveal">
    <h2>Projeniz için Bizimle Çalışın</h2>
    <p>Uzman kadromuzla projenizi planlamadan teslimata kadar yönetiyoruz.</p>
    <a class="cta-banner__btn" href="/iletisim#quote-form">Teklif Al →</a>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--color-navy);
    padding-block: 90px;
  }

  .cta-banner__inner {
    max-width: 896px;
    margin-inline: auto;
    text-align: center;
  }

  .cta-banner__inner h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(31px, 4.48vw, 49px);
    color: #fff;
    margin-bottom: 22px;
  }

  .cta-banner__inner p {
    font-size: 21px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 45px;
  }

  .cta-banner__btn {
    display: inline-block;
    padding: 19px 49px;
    background: #fff;
    color: var(--color-navy);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-radius: var(--radius);
    transition: background var(--transition);
  }

  .cta-banner__btn:hover {
    background: #e8e9f5;
  }

  @media (max-width: 640px) {
    .cta-banner {
      padding-block: 54px;
    }

    .cta-banner__inner p {
      font-size: 18px;
      margin-bottom: 27px;
    }

    .cta-banner__btn {
      padding: 16px 31px;
    }
  }
</style>
