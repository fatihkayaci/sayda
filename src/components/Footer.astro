---
import Icon from './Icon.astro';
import site from '../data/site.json';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <img class="footer__logo" src={site.logo} alt="Sayda İnşaat" width="196" height="46" />
      <p class="footer__name">{site.legalName}</p>
      <p class="footer__tagline">
        {site.foundedYear} yılından bu yana, nitelikli yapılar, güvenilir çözümler ve sürdürülebilir projeler ile geleceği inşa ediyoruz.
      </p>
      <div class="footer__social-list">
        {
          site.social.instagram && (
            <a class="footer__social" href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <Icon name="instagram" size={22} />
            </a>
          )
        }
        {
          site.social.linkedin && (
            <a class="footer__social" href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <Icon name="linkedin" size={22} />
            </a>
          )
        }
      </div>
    </div>

    <nav class="footer__column" aria-label="Hızlı linkler">
      <h2>Hızlı Linkler</h2>
      <ul>
        <li><a href="/">Anasayfa</a></li>
        <li><a href="/hakkimizda">Kurumsal</a></li>
        <li><a href="/hizmetler">Hizmetler</a></li>
        <li><a href="/projeler">Projeler</a></li>
        <li><a href="/belgeler">E-Katalog</a></li>
        <li><a href="/iletisim">İletişim</a></li>
      </ul>
    </nav>

    <nav class="footer__column" aria-label="Kurumsal">
      <h2>Kurumsal</h2>
      <ul>
        <li><a href="/hakkimizda">Hakkımızda</a></li>
        <li><a href="/hakkimizda/vizyon-misyon">Vizyon &amp; Misyon</a></li>
        <li><a href="/belgeler">Belgelerimiz</a></li>
        <li><a href="/kariyer">İnsan Kaynakları</a></li>
        <li><a href={site.documents.catalog} target="_blank" rel="noopener noreferrer">Online Katalog</a></li>
      </ul>
    </nav>

    <div class="footer__column">
      <h2>İletişim</h2>
      <ul class="footer__contact">
        <li>
          <Icon name="pin" size={21} />
          <span>{site.address.street}, {site.address.neighborhood} / {site.address.city}</span>
        </li>
        <li>
          <Icon name="phone" size={21} />
          <a href={site.phoneHref}>{site.phone}</a>
        </li>
        <li>
          <Icon name="mail" size={21} />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom container">
    <p>&copy; {year} {site.legalName}. Tüm hakları saklıdır.</p>
    <nav class="footer__legal" aria-label="Yasal">
      <a href="/gizlilik-politikasi">Gizlilik Politikası</a>
      <a href="/kvkk-aydinlatma-metni">KVKK Aydınlatma Metni</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: #0f1a36;
    color: var(--color-on-dark-muted);
    padding-block: var(--space-xl) var(--space-l);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
    gap: var(--space-l);
  }

  .footer__logo {
    display: block;
    height: 56px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .footer__label {
    margin-top: var(--space-m);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .footer__name {
    margin-top: var(--space-s);
    font-size: calc(var(--fs-small) * 1.05);
    font-weight: 600;
    color: #fff;
  }

  .footer__tagline {
    margin-top: var(--space-xs);
    max-width: 32ch;
    font-size: calc(var(--fs-small) * 1.12);
  }

  .footer__social-list {
    display: flex;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  .footer__social {
    display: inline-flex;
    color: var(--color-on-dark-muted);
    transition: color var(--transition);
  }

  .footer__social:hover {
    color: #fff;
  }

  .footer__column h2 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: calc(var(--fs-small) * 1.12);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-m);
  }

  .footer__column ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    font-size: calc(var(--fs-small) * 1.12);
  }

  .footer__column a {
    transition: color var(--transition);
  }

  .footer__column a:hover {
    color: #fff;
  }

  .footer__contact li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .footer__bottom {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: calc(var(--fs-small) * 1.12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .footer__legal {
    display: flex;
    gap: var(--space-m);
  }

  .footer__legal a {
    transition: color var(--transition);
  }

  .footer__legal a:hover {
    color: #fff;
  }

  @media (max-width: 1024px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--space-l);
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding-block: var(--space-xl) var(--space-l);
    }

    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
