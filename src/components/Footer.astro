---
import Icon from './Icon.astro';
import site from '../data/site.json';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__col">
      <img class="footer__logo" src="/img/legacy/logo-3.png" alt="Sayda İnşaat" loading="lazy" />
    </div>

    <div class="footer__col">
      <h2>Hakkımızda</h2>
      <p>
        Sayda İnşaat Taahhüt Sanayi ve Ticaret Limited Şirketi {site.foundedYear} yılında kurulmuş ve bu tarihten beri birçok büyük proje için
        çeşitli müteahhitlik ve alt-müteahhitlik “uzman ekip” hizmetleri vermektedir.
      </p>
      <div class="footer__social-list">
        {
          site.social.instagram && (
            <a class="footer__social" href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <Icon name="instagram" size={18} />
            </a>
          )
        }
        {
          site.social.linkedin && (
            <a class="footer__social" href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <Icon name="linkedin" size={18} />
            </a>
          )
        }
      </div>
    </div>

    <nav class="footer__col" aria-label="Kurumsal">
      <h2>Kurumsal</h2>
      <ul class="footer__links">
        <li><a href="/hakkimizda">Hakkımızda</a></li>
        <li><a href="/hakkimizda/vizyon-misyon">Vizyon-Misyon</a></li>
        <li><a href="/belgeler">Belgelerimiz</a></li>
        <li><a href={site.documents.catalog} target="_blank" rel="noopener noreferrer">Online Katalog</a></li>
      </ul>
    </nav>

    <div class="footer__col">
      <h2>İletişim</h2>
      <p>{site.address.street} {site.address.postalCode} {site.address.neighborhood} / {site.address.city.toLocaleUpperCase('tr')}</p>
      <p class="footer__tel">Tel : <a href={site.phoneHref}>{site.phone}</a></p>
      <p class="footer__mail"><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>Copyright &copy; Sayda İnşaat.</p>
      <nav class="footer__legal" aria-label="Yasal">
        <a href="/gizlilik-politikasi">Gizlilik Politikası</a>
        <a href="/kvkk-aydinlatma-metni">KVKK Aydınlatma Metni</a>
        <a href="/cerez-politikasi">Çerez Politikası</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #161616;
    color: #636363;
    font-family: 'Open Sans', sans-serif;
    font-size: 14px;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    max-width: 1170px;
    padding: 80px 15px 60px;
  }

  .footer__logo {
    width: 240px;
    height: auto;
  }

  .footer__col h2 {
    margin-bottom: 20px;
    padding-bottom: 14px;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    color: #fff;
    border-bottom: 1px solid #262728;
  }

  .footer__col p {
    line-height: 26px;
  }

  .footer__social-list {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid #8e846f;
    border-radius: 50%;
    color: #fff;
    transition: all 0.3s ease;
  }

  .footer__social:hover {
    background: #ffbb00;
    border-color: #ffbb00;
    color: #000;
  }

  .footer__links a {
    display: block;
    margin-bottom: 10px;
    padding-bottom: 10px;
    line-height: 24px;
    border-bottom: 1px solid #2c2c2e;
    transition: color 0.3s ease;
  }

  .footer__links a::before {
    content: '›';
    margin-right: 15px;
  }

  .footer__links li:last-child a {
    border-bottom: 0;
  }

  .footer__tel {
    font-weight: 700;
    font-family: Georgia, 'Times New Roman', serif;
  }

  .footer__mail {
    margin-top: 14px !important;
    padding-top: 14px;
    border-top: 1px solid #262728;
    font-family: Georgia, 'Times New Roman', serif;
  }

  .footer__contact li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-block: 7px;
  }

  .footer a:hover {
    color: #ffbb00;
  }

  .footer__bottom {
    background: #0f0f0f;
    color: #3f3f3f;
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    max-width: 1170px;
    padding: 24px 15px;
    font-size: 14px;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
