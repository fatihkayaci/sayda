---
interface Feature {
  icon: string;
  text: string;
}

interface Props {
  image: string;
  features: Feature[];
}

const { image, features } = Astro.props;
---

<div class="page__split page__split--rev">
  <img src={image} alt="" loading="lazy" width="400" height="300" />
  <ul class="list">
    {features.map((feature) => <li>{feature.text}</li>)}
  </ul>
</div>
