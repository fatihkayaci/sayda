---
import Icon from '../Icon.astro';

interface Feature {
  icon: string;
  text: string;
}

interface Props {
  image: string;
  features: Feature[];
}

const { image, features } = Astro.props;
---

<div class="svc-media">
  <img src={image} alt="" loading="lazy" />
  <ul class="svc-media__card">
    {
      features.map((feature) => (
        <li>
          <Icon name={feature.icon} size={27} />
          <span>{feature.text}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .svc-media {
    position: relative;
    margin-bottom: 45px;
    border-radius: 4px;
    overflow: hidden;
  }

  .svc-media img {
    width: 100%;
    height: 314px;
    object-fit: cover;
  }

  .svc-media__card {
    position: absolute;
    top: 50%;
    right: 32px;
    display: grid;
    gap: 18px;
    width: min(336px, 46%);
    padding: 27px 31px;
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 8px 30px rgba(17, 19, 24, 0.15);
    transform: translateY(-50%);
  }

  .svc-media__card li {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 0.98rem;
    color: var(--color-navy-deep);
  }

  .svc-media__card li :global(svg) {
    flex: none;
    color: var(--color-navy);
  }

  @media (max-width: 700px) {
    .svc-media {
      display: grid;
    }

    .svc-media img {
      height: 224px;
    }

    .svc-media__card {
      position: static;
      width: auto;
      transform: none;
      box-shadow: none;
      border: 1px solid var(--color-border);
      border-top: 0;
      border-radius: 0 0 4px 4px;
    }
  }
</style>
