---
// Service page hero: full-width photo of a project where the service was delivered, with title, summary,
// key points and a quote button over a dark gradient. The h1 comes from the default slot so a word can be
// highlighted with <em>.
import Icon from '../Icon.astro';
import site from '../../data/site.json';
import projects from '../../data/projects.json';
import { srcset } from '../../utils/image';
import { hasCoverVariants, shortProjectTitle } from '../../utils/project';
import { breadcrumbLd } from '../../utils/schema';

interface Props {
  eyebrow: string;
  name: string;
  text: string;
  points: string[];
  /** Slug of the project whose cover is the background; it's also linked in the corner. */
  project: string;
}

const { eyebrow, name, text, points, project: slug } = Astro.props;
const project = projects.find((p) => p.slug === slug)!;
const image = project.image;
const credit = 'imageCredit' in project ? project.imageCredit : undefined;
// Some legacy names carry a news-style tail ("… İNCE İŞLERİ BİZ YAPIYORUZ"); keep just the project name.
const projectName = shortProjectTitle(project.name).replace(/\s+(İNCE İŞLERİ|SATIŞ OFİSİ)?\s*BİZ YAPIYORUZ$/i, '').replace(/\s+İNCE İŞLERİ$/i, '');
const breadcrumbData = breadcrumbLd(
  [{ label: 'Ana Sayfa', href: '/' }, { label: 'Faaliyet Alanları', href: '/faaliyet-alanlari' }, { label: name }],
  Astro.url.pathname
);
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbData)} />

<section class="svc-hero">
  <img
    class="svc-hero__bg"
    src={image}
    srcset={hasCoverVariants(image) ? srcset(image, 960, 1920) : undefined}
    sizes="100vw"
    alt=""
    fetchpriority="high"
  />
  <div class="svc-hero__shade"></div>

  <div class="container svc-hero__inner">
    <nav class="svc-hero__breadcrumb" aria-label="Konum">
      <a href="/">Ana Sayfa</a>
      <span aria-hidden="true">/</span>
      <a href="/faaliyet-alanlari">Faaliyet Alanları</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{name}</span>
    </nav>

    <div class="svc-hero__text">
      <p class="svc-hero__eyebrow"><span></span>{eyebrow}</p>
      <h1 data-words><slot /></h1>
      <p class="svc-hero__lead">{text}</p>

      <ul class="svc-hero__points">
        {
          points.map((point) => (
            <li>
              <Icon name="check" size={16} />
              {point}
            </li>
          ))
        }
      </ul>

      <div class="svc-hero__actions">
        <a class="svc-hero__btn" href="/iletisim#quote-form">
          Teklif Al <Icon name="arrow" size={18} />
        </a>
        <a class="svc-hero__phone" href={site.phoneHref}>
          <Icon name="phone" size={18} />
          {site.phone}
        </a>
      </div>
    </div>
  </div>

  <a class="svc-hero__project" href={project.href}>
    <span>Fotoğraftaki proje</span>
    {projectName}
    <Icon name="arrow" size={14} />
  </a>
  {
    credit && (
      <a class="svc-hero__credit" href={credit.href} target="_blank" rel="noopener noreferrer">
        {credit.label}
      </a>
    )
  }
</section>

<style>
  .svc-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .svc-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .svc-hero__shade {
    position: absolute;
    inset: 0;
    /* Solid behind the text, fading out to the right so the photo shows on that side. */
    background: linear-gradient(
        to right,
        var(--color-navy-deep) 0%,
        var(--color-navy-deep) 40%,
        rgba(28, 29, 46, 0.85) 48%,
        rgba(28, 29, 46, 0.55) 58%,
        rgba(28, 29, 46, 0.25) 68%,
        rgba(28, 29, 46, 0) 80%
      );
  }

  .svc-hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: clamp(560px, 78vh, 760px);
    padding-block: 32px 96px;
  }

  .svc-hero__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.7);
  }

  .svc-hero__breadcrumb a:hover,
  .svc-hero__breadcrumb [aria-current] {
    color: #fff;
  }

  .svc-hero__breadcrumb [aria-current] {
    font-weight: 600;
  }

  .svc-hero__text {
    max-width: 680px;
    margin-block: auto 0;
    padding-top: 48px;
  }

  .svc-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .svc-hero__eyebrow span {
    width: 40px;
    height: 3px;
    background: var(--color-orange);
  }

  .svc-hero h1 {
    margin-top: 24px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(2.5rem, 3.6vw + 0.75rem, 5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.3);
  }

  .svc-hero h1 :global(em) {
    font-style: normal;
    box-shadow: inset 0 -0.18em 0 rgba(245, 162, 27, 0.85);
  }

  .svc-hero__lead {
    max-width: 56ch;
    margin-top: 24px;
    font-size: 1.125rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
  }

  .svc-hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .svc-hero__points li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(6px);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .svc-hero__points :global(svg) {
    color: var(--color-orange);
  }

  .svc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 36px;
  }

  .svc-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 58px;
    padding: 0 30px;
    border-radius: var(--radius);
    background: var(--color-orange);
    font-weight: 700;
    color: var(--color-navy-deep);
    transition: background var(--transition);
  }

  .svc-hero__btn:hover {
    background: var(--color-orange-dark);
  }

  .svc-hero__phone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
  }

  .svc-hero__phone :global(svg) {
    color: var(--color-orange);
  }

  /* which project the photo shows, bottom right */
  .svc-hero__project {
    position: absolute;
    right: clamp(20px, 4vw, 72px);
    bottom: 32px;
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: 8px;
    padding-left: 16px;
    border-left: 3px solid var(--color-orange);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .svc-hero__project span {
    grid-column: 1 / -1;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .svc-hero__project :global(svg) {
    color: var(--color-orange);
    transition: transform var(--transition);
  }

  .svc-hero__project:hover :global(svg) {
    transform: translateX(4px);
  }

  .svc-hero__credit {
    position: absolute;
    right: 12px;
    bottom: 8px;
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .svc-hero__credit:hover {
    color: #fff;
  }

  @media (max-width: 1024px) {
    .svc-hero__shade {
      background: rgba(20, 21, 34, 0.7);
    }

    .svc-hero__project {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .svc-hero h1 {
      font-stretch: 100%;
      font-size: clamp(2.25rem, 10vw, 2.75rem);
    }
  }
</style>
