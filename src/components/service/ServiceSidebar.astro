---
import Icon from '../Icon.astro';
import site from '../../data/site.json';

interface Props {
  active: number;
  cards?: boolean;
  ctaEyebrow?: string;
  ctaTitle?: string;
  ctaText?: string;
  ctaImage?: string;
  caption?: string;
}

const {
  active,
  cards = false,
  ctaEyebrow,
  ctaTitle = 'Projeniz için teklif almak ister misiniz?',
  ctaText = 'Uzman ekibimiz projenizi değerlendirsin.',
  ctaImage = '/img/projects/varyap-meridien-konut/varyap-meridien-konut.webp',
  caption,
} = Astro.props;

const tabs = [
  { number: '01', title: 'Kat Karşılığı İnşaat', href: '/hizmetler/kat-karsiligi-insaat', icon: 'home' },
  { number: '02', title: 'Alt Müteahhitlik', href: '/hizmetler/alt-muteahhitlik', icon: 'helmet' },
  { number: '03', title: 'Anahtar Teslim Müteahhitlik', href: '/hizmetler/anahtar-teslim-muteahhitlik', icon: 'key' },
  { number: '04', title: 'Proje Yönetimi & Danışmanlık', href: '/hizmetler/proje-yonetimi-danismanlik', icon: 'document' },
  { number: '05', title: 'Otel Renovasyonu', href: '/hizmetler/otel-renovasyonu', icon: 'building' },
];
---

<div class="svc-sidebar" class:list={{ 'svc-sidebar--cards': cards }}>
  <div class="svc-sidebar__tabs">
    {
      tabs.map((tab, i) => (
        <a href={tab.href} class="svc-tab" class:list={{ active: i === active }} aria-current={i === active ? 'page' : undefined}>
          <span class="svc-tab__icon">
            <Icon name={tab.icon} size={31} />
          </span>
          <span class="svc-tab__text">
            <span class="svc-tab__num">{tab.number}</span>
            <span class="svc-tab__title">{tab.title}</span>
          </span>
          <span class="svc-tab__arrow">
            <Icon name="arrow" size={21} />
          </span>
        </a>
      ))
    }
  </div>

  <div class="svc-sidebar__cta">
    <img src={ctaImage} alt="" loading="lazy" />
    <div class="svc-sidebar__cta-body">
      {ctaEyebrow && <span class="svc-sidebar__cta-eyebrow">{ctaEyebrow}</span>}
      <h3>{ctaTitle}</h3>
      <p>{ctaText}</p>
      <a href="/iletisim#quote-form" class="svc-sidebar__cta-btn">Teklif Al →</a>
      <a href={site.phoneHref} class="svc-sidebar__cta-phone">
        <Icon name="phone" size={18} />
        {site.phone}
      </a>
    </div>
  </div>

  {
    caption && (
      <p class="svc-sidebar__caption">
        <span />
        {caption}
      </p>
    )
  }
</div>

<style>
  .svc-sidebar {
    display: flex;
    flex-direction: column;
    gap: 27px;
    position: sticky;
    top: calc(var(--header-h) + 18px);
    min-width: 0;
    max-width: 100%;
  }

  .svc-sidebar__tabs {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .svc-tab {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 21px 22px;
    border-radius: 4px;
    background: #f6f7fc;
    color: var(--color-navy-deep);
    transition:
      background 180ms,
      color 180ms;
  }

  .svc-tab:hover {
    background: #eceefa;
  }

  .svc-tab.active {
    background: var(--color-navy-deep);
    color: #fff;
  }

  .svc-tab__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 45px;
    color: var(--color-navy);
  }

  .svc-tab.active .svc-tab__icon {
    color: #fff;
  }

  .svc-tab__text {
    display: grid;
    flex: 1;
    gap: 2px;
    min-width: 0;
  }

  .svc-tab__num {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-text-faint);
  }

  .svc-tab.active .svc-tab__num {
    color: rgba(255, 255, 255, 0.7);
  }

  .svc-tab__title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .svc-tab__arrow {
    flex: none;
    color: var(--color-navy);
  }

  .svc-tab.active .svc-tab__arrow {
    color: #fff;
  }

  .svc-sidebar--cards .svc-tab:not(.active) {
    background: #fff;
    box-shadow: 0 2px 14px rgba(17, 19, 24, 0.06);
  }

  .svc-sidebar--cards .svc-tab:not(.active):hover {
    background: #f6f7fc;
  }

  .svc-sidebar--cards .svc-tab {
    padding-block: 30px;
  }

  .svc-sidebar__cta-eyebrow {
    font-size: 0.77rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: rgba(255, 255, 255, 0.8);
  }

  .svc-sidebar__caption {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-inline: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    line-height: 1.6;
    color: var(--color-text-faint);
  }

  .svc-sidebar__caption span {
    flex: none;
    width: 45px;
    height: 1px;
    background: var(--color-navy);
    opacity: 0.6;
  }

  .svc-sidebar__cta {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .svc-sidebar__cta img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
    mix-blend-mode: luminosity;
  }

  .svc-sidebar__cta-body {
    position: relative;
    display: grid;
    gap: 16px;
    padding: 31px 27px;
  }

  .svc-sidebar__cta h3 {
    font-size: clamp(1.26rem, 1.568vw, 1.54rem);
    line-height: 1.25;
    color: #fff;
  }

  .svc-sidebar__cta p {
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .svc-sidebar__cta-btn {
    display: block;
    padding: 16px;
    border-radius: 4px;
    background: #fff;
    color: var(--color-navy-deep);
    font-size: 0.98rem;
    font-weight: 700;
    text-align: center;
    transition: background 180ms;
  }

  .svc-sidebar__cta-btn:hover {
    background: #e8e9f5;
  }

  .svc-sidebar__cta-phone {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.98rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .svc-sidebar__cta-phone:hover {
    color: #fff;
  }

  @media (max-width: 1024px) {
    .svc-sidebar {
      position: static;
      gap: var(--space-m);
    }

    .svc-sidebar__tabs {
      flex-direction: row;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      padding-bottom: 4px;
      scrollbar-width: none;
    }

    .svc-sidebar__tabs::-webkit-scrollbar {
      display: none;
    }

    .svc-tab {
      flex: 0 0 auto;
      min-width: 246px;
      max-width: 291px;
      scroll-snap-align: start;
      scroll-margin-inline: 8px;
    }
  }

  @media (max-width: 700px) {
    .svc-tab {
      min-width: 213px;
      padding: 16px 18px;
      gap: 13px;
    }

    .svc-tab__title {
      font-size: 0.91rem;
    }
  }
</style>

<script>
  const revealActiveTab = () => {
    if (!window.matchMedia('(max-width: 1024px)').matches) return;
    const tab = document.querySelector('.svc-tab[aria-current="page"]');
    if (!(tab instanceof HTMLElement)) return;
    tab.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'auto' });
  };

  document.addEventListener('astro:page-load', revealActiveTab);
  revealActiveTab();
</script>
