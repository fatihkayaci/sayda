---
import site from '../../data/site.json';

interface Props {
  active: number;
  cards?: boolean;
  ctaEyebrow?: string;
  ctaTitle?: string;
  ctaText?: string;
  ctaImage?: string;
  caption?: string;
}

const {
  active,
  ctaTitle = 'Projeniz için teklif almak ister misiniz?',
  ctaText = 'Uzman ekibimiz projenizi değerlendirsin.',
} = Astro.props;

const tabs = [
  { title: 'Kat Karşılığı İnşaat', href: '/hizmetler/kat-karsiligi-insaat' },
  { title: 'Alt Müteahhitlik', href: '/hizmetler/alt-muteahhitlik' },
  { title: 'Anahtar Teslim Müteahhitlik', href: '/hizmetler/anahtar-teslim-muteahhitlik' },
  { title: 'Proje Yönetimi & Danışmanlık', href: '/hizmetler/proje-yonetimi-danismanlik' },
  { title: 'Tesis Renovasyonu', href: '/hizmetler/otel-renovasyonu' },
  { title: 'Kentsel Dönüşüm', href: '/hizmetler/kentsel-donusum' },
];
---

<aside class="svc-side">
  <h2>Hizmetlerimiz</h2>
  <ul>
    {
      tabs.map((tab, i) => (
        <li class:list={{ active: i === active }}>
          <a href={tab.href} aria-current={i === active ? 'page' : undefined}>{tab.title}</a>
        </li>
      ))
    }
  </ul>
  <div class="page__box">
    <h3>{ctaTitle}</h3>
    <p>{ctaText}</p>
    <p><a class="btn" href="/iletisim#quote-form">Teklif Al</a></p>
    <p><a href={site.phoneHref}>{site.phone}</a></p>
  </div>
</aside>

<style>
  .svc-side ul {
    margin-bottom: 24px;
  }

  .svc-side li {
    border-bottom: 1px solid #e4e4e4;
  }

  .svc-side li a {
    display: block;
    padding: 10px 0;
    font-weight: 600;
  }

  .svc-side li.active a {
    color: #f69c00;
  }
</style>
