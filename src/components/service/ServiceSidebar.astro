---
import site from '../../data/site.json';

interface Props {
  active: number;
}

const { active } = Astro.props;

const tabs = [
  {
    number: '01',
    title: 'Kat Karşılığı İnşaat',
    href: '/hizmetler/kat-karsiligi-insaat',
    icon: '<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>',
  },
  {
    number: '02',
    title: 'Alt Müteahhitlik',
    href: '/hizmetler/alt-muteahhitlik',
    icon: '<circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
  },
  {
    number: '03',
    title: 'Anahtar Teslim Müteahhitlik',
    href: '/hizmetler/anahtar-teslim-muteahhitlik',
    icon: '<rect x="2" y="7" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" stroke="currentColor" stroke-width="1.7"/><line x1="12" y1="12" x2="12" y2="16" stroke="currentColor" stroke-width="1.7"/><line x1="10" y1="14" x2="14" y2="14" stroke="currentColor" stroke-width="1.7"/>',
  },
  {
    number: '04',
    title: 'Proje Yönetimi & Danışmanlık',
    href: '/hizmetler/proje-yonetimi-danismanlik',
    icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    number: '05',
    title: 'Otel Renovasyonu',
    href: '/hizmetler/otel-renovasyonu',
    icon: '<rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.7"/><line x1="3" y1="9" x2="21" y2="9" stroke="currentColor" stroke-width="1.7"/><line x1="9" y1="21" x2="9" y2="9" stroke="currentColor" stroke-width="1.7"/>',
  },
];
---

<div class="svc-sidebar">
  <div class="svc-sidebar__tabs">
    {
      tabs.map((tab, i) => (
        <a href={tab.href} class="svc-tab" class:list={{ active: i === active }} aria-current={i === active ? 'page' : undefined}>
          <span class="svc-tab__icon" set:html={`<svg viewBox="0 0 24 24" fill="none" width="22" height="22">${tab.icon}</svg>`} />
          <span>
            <span class="svc-tab__num">{tab.number}</span>
            <span class="svc-tab__title">{tab.title}</span>
          </span>
        </a>
      ))
    }
  </div>

  <div class="svc-sidebar__cta">
    <h3>Bu hizmet için teklif almak ister misiniz?</h3>
    <p>Uzman ekibimiz projenizi değerlendirsin.</p>
    <a href="/iletisim#quote-form" class="svc-sidebar__cta-btn">Teklif Al →</a>
    <a href={site.phoneHref} class="svc-sidebar__cta-phone">
      <svg viewBox="0 0 24 24" fill="none" width="14" height="14"><path d="M5 4h4l2 5-3 2a12 12 0 005 5l2-3 5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      {site.phone}
    </a>
  </div>
</div>

<style>
  .svc-sidebar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: sticky;
    top: calc(var(--header-h) + 16px);
    min-width: 0;
    max-width: 100%;
  }

  .svc-sidebar__tabs {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .svc-tab {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    border-radius: 6px;
    border: 2px solid transparent;
    text-align: left;
    background: none;
    width: 100%;
    transition:
      background 180ms,
      transform 150ms;
  }

  .svc-tab:hover {
    background: var(--color-bg-light);
  }

  .svc-tab.active {
    background: var(--color-navy);
    border-color: var(--color-navy);
  }

  .svc-tab__icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-bg-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-navy);
    transition: background 180ms;
  }

  .svc-tab.active .svc-tab__icon {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  .svc-tab__num {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-text-faint);
    transition: color 180ms;
  }

  .svc-tab.active .svc-tab__num {
    color: rgba(255, 255, 255, 0.6);
  }

  .svc-tab__title {
    display: block;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
    transition: color 180ms;
  }

  .svc-tab.active .svc-tab__title {
    color: #fff;
  }

  .svc-sidebar__cta {
    margin-top: 16px;
    background: var(--color-navy);
    border-radius: 6px;
    padding: 28px 24px;
    display: grid;
    gap: 14px;
  }

  .svc-sidebar__cta h3 {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(15px, 4vw, 17px);
    color: #fff;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .svc-sidebar__cta p {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
  }

  .svc-sidebar__cta-btn {
    display: block;
    padding: 13px;
    background: #fff;
    color: var(--color-navy);
    font-size: 13px;
    font-weight: 700;
    border-radius: 4px;
    text-align: center;
    transition: background 180ms;
  }

  .svc-sidebar__cta-btn:hover {
    background: #e8e9f5;
  }

  .svc-sidebar__cta-phone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 13px;
    transition: color 180ms;
  }

  .svc-sidebar__cta-phone:hover {
    color: #fff;
  }

  @media (max-width: 1024px) {
    .svc-sidebar {
      position: static;
      flex-direction: column;
      overflow: visible;
      gap: var(--space-m);
    }

    .svc-sidebar__tabs {
      flex-direction: row;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      gap: 8px;
      padding-bottom: 4px;
      scrollbar-width: none;
    }

    .svc-sidebar__tabs::-webkit-scrollbar {
      display: none;
    }

    .svc-tab {
      width: auto;
      min-width: 168px;
      max-width: 240px;
      flex: 0 0 auto;
      flex-direction: column;
      align-items: flex-start;
      padding: 14px 16px;
      scroll-snap-align: start;
      scroll-margin-inline: 8px;
    }

    .svc-sidebar__cta {
      padding: 24px 20px;
    }
  }

  @media (max-width: 700px) {
    .svc-tab {
      min-width: 148px;
      padding: 12px 14px;
      gap: 10px;
    }

    .svc-tab__icon {
      width: 36px;
      height: 36px;
    }

    .svc-tab__title {
      font-size: 13px;
    }
  }
</style>

<script>
  const revealActiveTab = () => {
    if (!window.matchMedia('(max-width: 1024px)').matches) return;
    const tab = document.querySelector('.svc-tab[aria-current="page"]');
    if (!(tab instanceof HTMLElement)) return;
    tab.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'auto' });
  };

  document.addEventListener('astro:page-load', revealActiveTab);
  revealActiveTab();
</script>
