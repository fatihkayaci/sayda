---
import '../../styles/services.css';
---

<section class="svc-hero">
  <div class="svc-hero__media" aria-hidden="true">
    <img src="/img/sayda-insaat-hero01.webp" alt="" fetchpriority="high" />
  </div>

  <div class="container svc-hero__inner">
    <nav class="svc-hero__breadcrumb" aria-label="Konum">
      <a href="/">Anasayfa</a>
      <span>/</span>
      <span aria-current="page">Hizmetler</span>
    </nav>

    <div class="svc-hero__eyebrow">
      <span class="svc-hero__eyebrow-bar"></span>
      <span>NE YAPIYORUZ?</span>
    </div>

    <h1>Hizmetlerimiz</h1>
    <p class="svc-hero__lead">Yaşam alanlarına değer katacak kalıcı çözümler üretiyoruz.</p>

    <p class="svc-hero__quote" aria-hidden="true">
      “Güvenli yapılar,<br />daha iyi yarınlar.”
      <span></span>
    </p>
  </div>
</section>

<style>
  .svc-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-navy-deep);
  }

  .svc-hero__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 62%;
  }

  .svc-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  .svc-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--color-navy-deep) 0%, rgba(25, 27, 74, 0) 55%),
      linear-gradient(to left, rgba(25, 27, 74, 0.9) 0%, rgba(25, 27, 74, 0) 45%),
      rgba(25, 27, 74, 0.3);
  }

  .svc-hero .svc-hero__inner {
    position: relative;
    z-index: 1;
    max-width: none;
    padding-block: 36px 49px;
    padding-inline: clamp(22px, 4vw, 81px);
  }

  .svc-hero__breadcrumb {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .svc-hero__breadcrumb a:hover {
    color: #fff;
  }

  .svc-hero__breadcrumb span:first-of-type {
    color: rgba(255, 255, 255, 0.45);
  }

  .svc-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 9px;
  }

  .svc-hero__eyebrow-bar {
    display: block;
    width: 36px;
    height: 2px;
    background: rgba(255, 255, 255, 0.85);
  }

  .svc-hero__eyebrow span:last-child {
    font-size: 0.77rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.7);
  }

  .svc-hero h1 {
    font-size: clamp(2.52rem, 5.152vw, 3.92rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .svc-hero__lead {
    max-width: 30ch;
    margin-top: 16px;
    font-size: clamp(1.12rem, 1.568vw, 1.4rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
  }

  .svc-hero__quote {
    position: absolute;
    top: 50%;
    right: clamp(20px, 4vw, 72px);
    padding-left: 27px;
    border-left: 1px solid rgba(255, 255, 255, 0.55);
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: clamp(1.26rem, 1.792vw, 1.68rem);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.9);
    transform: translateY(-50%);
  }

  .svc-hero__quote span {
    display: block;
    width: 45px;
    height: 1px;
    margin-top: 18px;
    background: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 1024px) {
    .svc-hero__media {
      width: 100%;
      opacity: 0.55;
    }

    .svc-hero__quote {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .svc-hero__inner {
      padding-block: 27px 40px;
    }
  }
</style>
