---
// Three real project cards picked by slug, so each service page carries its own photos.
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import allProjects from '../../data/projects.json';
import { shortProjectTitle } from '../../utils/project';

interface Props {
  label: string;
  title: string;
  slugs: string[];
}

const { label, title, slugs } = Astro.props;
const projects = slugs
  .map((slug) => allProjects.find((p) => p.slug === slug))
  .filter((p): p is (typeof allProjects)[number] => Boolean(p));
---

{
  projects.length > 0 && (
    <section class="svc-projects">
      <div class="container">
        <div class="svc-projects__head">
          <SectionHead label={label} title={title} />
          <a href="/projeler">
            Tüm Projeler <Icon name="arrow" size={18} />
          </a>
        </div>
        <div class="svc-projects__grid">
          {projects.map((project) => (
            <a class="svc-projects__card" href={project.href}>
              <img src={project.image} alt={`${project.name} - Sayda İnşaat`} loading="lazy" />
              <span class="svc-projects__body">
                <strong>{shortProjectTitle(project.name)}</strong>
                <span>{[project.location.split(' - ')[0], project.area].filter(Boolean).join(' · ')}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .svc-projects {
    padding-block: clamp(80px, 9vw, 140px);
    background: var(--color-bg-light);
  }

  .svc-projects__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .svc-projects__head > a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(40px, 5vw, 64px);
    padding-bottom: 6px;
    border-bottom: 2px solid var(--color-orange);
    font-weight: 700;
    white-space: nowrap;
    color: var(--color-navy-deep);
  }

  .svc-projects__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .svc-projects__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .svc-projects__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .svc-projects__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(28, 29, 46, 0.9) 0%, rgba(28, 29, 46, 0.2) 50%, rgba(28, 29, 46, 0) 70%);
  }

  .svc-projects__card::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    height: 5px;
    background: var(--color-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms ease;
  }

  .svc-projects__card:hover img {
    transform: scale(1.06);
  }

  .svc-projects__card:hover::after {
    transform: none;
  }

  .svc-projects__body {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 22px;
    z-index: 2;
    display: grid;
    gap: 6px;
  }

  .svc-projects__body strong {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 800;
    font-size: clamp(1.25rem, 0.6vw + 1rem, 1.5rem);
    line-height: 1.1;
  }

  .svc-projects__body span {
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 1024px) {
    .svc-projects__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .svc-projects__grid {
      grid-template-columns: 1fr;
    }

    .svc-projects__head > a {
      display: none;
    }
  }
</style>
