---
interface Step {
  title: string;
  description: string;
}

interface Props {
  heading: string;
  steps: Step[];
  color?: 'navy' | 'navy-deep';
}

const { heading, steps, color = 'navy' } = Astro.props;
---

<h3 class="process-steps__heading">{heading}</h3>
<div class="process-steps">
  {
    steps.map((step, i) => (
      <>
        <div class="process-step">
          <div class:list={['process-step__num', { 'process-step__num--deep': color === 'navy-deep' }]}>
            {String(i + 1).padStart(2, '0')}
          </div>
          <div class="process-step__body">
            <h4>{step.title}</h4>
            <p>{step.description}</p>
          </div>
        </div>
        {i < steps.length - 1 && <div class="process-step__line" />}
      </>
    ))
  }
</div>

<style>
  .process-steps__heading {
    font-family: var(--font-body);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-navy-deep);
    margin-bottom: 27px;
  }

  .process-steps {
    display: grid;
    gap: 0;
    margin-bottom: 0;
  }

  .process-step {
    display: grid;
    grid-template-columns: 63px 1fr;
    gap: 22px;
    align-items: start;
  }

  .process-step__num {
    width: 63px;
    height: 63px;
    border-radius: 50%;
    background: var(--color-navy);
    color: #fff;
    font-family: 'Archivo Black', sans-serif;
    font-size: 21px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .process-step__num--deep {
    background: #191b4a;
  }

  .process-step__body {
    padding-top: 13px;
    min-width: 0;
  }

  .process-step__body h4 {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-navy-deep);
    margin-bottom: 7px;
  }

  .process-step__body p {
    font-size: 16px;
    color: #6b6d7a;
    line-height: 1.7;
  }

  .process-step__line {
    width: 2px;
    height: 27px;
    background: rgba(43, 46, 131, 0.2);
    margin: 7px 0 7px 30px;
  }

  @media (max-width: 640px) {
    .process-steps {
      margin-bottom: 40px;
    }

    .process-step {
      grid-template-columns: 49px minmax(0, 1fr);
      gap: 13px;
    }

    .process-step__num {
      width: 49px;
      height: 49px;
      font-size: 16px;
    }

    .process-step__line {
      height: 27px;
      margin: 7px 0 7px 23px;
    }

    .process-step__body {
      padding-top: 7px;
    }
  }
</style>
