---
interface Step {
  title: string;
  description: string;
}

interface Props {
  heading: string;
  steps: Step[];
  color?: 'navy' | 'navy-deep';
}

const { heading, steps } = Astro.props;
---

<h3>{heading}</h3>
<ol class="list">
  {
    steps.map((step, i) => (
      <li>
        <strong>{String(i + 1).padStart(2, '0')} · {step.title}:</strong> {step.description}
      </li>
    ))
  }
</ol>
