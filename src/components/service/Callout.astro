---
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<div class="callout">
  <h4>{title}</h4>
  <p>{text}</p>
</div>

<style>
  .callout {
    border-left: 4px solid var(--color-navy);
    padding-left: 27px;
  }

  .callout h4 {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 9px;
  }

  .callout p {
    font-size: 16px;
    color: #6b6d7a;
    line-height: 1.75;
  }

  @media (max-width: 640px) {
    .callout {
      padding-left: 18px;
    }
  }
</style>
