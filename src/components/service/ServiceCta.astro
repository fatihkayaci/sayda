---
import Icon from '../Icon.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  label?: string;
  href?: string;
}

const {
  eyebrow = 'DAHA İYİ YAŞAM ALANLARI İÇİN',
  title = 'Yeni projenizi birlikte hayata geçirelim.',
  text = 'Uzman kadromuzla projenizi planlamadan teslimata kadar yönetiyoruz.',
  label = 'Teklif Al',
  href = '/iletisim#quote-form',
} = Astro.props;
---

<section class="svc-cta">
  <img class="svc-cta__bg" src="/img/projects/varyap-meridien-konut/varyap-meridien-konut.webp" alt="" loading="lazy" />
  <div class="container svc-cta__inner reveal">
    <div>
      <div class="svc-cta__eyebrow">
        <span></span>
        {eyebrow}
      </div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="svc-cta__btn" href={href}>
      {label} <Icon name="arrow" size={21} />
    </a>
  </div>
</section>

<style>
  .svc-cta {
    position: relative;
    overflow: hidden;
    padding-block: 54px;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .svc-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
    mix-blend-mode: luminosity;
  }

  .svc-cta__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    max-width: none;
    padding-inline: clamp(var(--edge-mobile), 4vw, 81px);
  }

  .svc-cta__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
    font-size: 0.77rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.8);
  }

  .svc-cta__eyebrow span {
    display: block;
    width: 36px;
    height: 2px;
    background: rgba(255, 255, 255, 0.8);
  }

  .svc-cta h2 {
    font-size: clamp(1.68rem, 2.912vw, 2.52rem);
    color: #fff;
  }

  .svc-cta p {
    margin-top: 12px;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .svc-cta__btn {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 13px;
    padding: 18px 36px;
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-navy-deep);
    font-size: 0.98rem;
    font-weight: 700;
    transition: background var(--transition);
  }

  .svc-cta__btn:hover {
    background: #e8e9f5;
  }

  @media (max-width: 700px) {
    .svc-cta__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-m);
    }
  }
</style>
