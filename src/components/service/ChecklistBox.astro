---
type Item = string | { label: string; icon: string };

interface Props {
  heading: string;
  lead?: string;
  items: Item[];
  iconFill?: string;
}

const { heading, lead, items } = Astro.props;
---

<h3>{heading}</h3>
{lead && <p>{lead}</p>}
<ul class="list">
  {items.map((item) => <li>{typeof item === 'string' ? item : item.label}</li>)}
</ul>
