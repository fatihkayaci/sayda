---
interface Props {
  number: string;
  title: string;
  lead: string;
  tagline?: string;
  taglineIcon?: string;
  taglineVariant?: 'icon' | 'quote';
  card?: boolean;
  cornerImage?: string;
  titleTag?: 'h1' | 'h2';
}

const { number, title, lead, tagline, cornerImage } = Astro.props;
---

<div class="svc-panel">
  {cornerImage && <img class="svc-panel__corner" src={cornerImage} alt="" loading="lazy" width="300" height="200" />}
  <p><small>HİZMET {number}</small></p>
  <h2>{title}</h2>
  <p><strong>{lead}</strong></p>
  {tagline && <p><em>{tagline}</em></p>}
  <slot />
</div>

<style>
  .svc-panel__corner {
    float: right;
    width: 260px;
    height: auto;
    margin: 0 0 16px 24px;
  }
</style>
