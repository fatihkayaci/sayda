---
import Icon from '../Icon.astro';

interface Props {
  number: string;
  title: string;
  lead: string;
  tagline?: string;
  taglineIcon?: string;
  taglineVariant?: 'icon' | 'quote';
  card?: boolean;
  cornerImage?: string;
  titleTag?: 'h1' | 'h2';
}

const {
  number,
  title,
  lead,
  tagline,
  taglineIcon = 'home',
  taglineVariant = 'icon',
  card = false,
  cornerImage,
  titleTag = 'h2',
} = Astro.props;
const Title = titleTag;
---

<div class="svc-panel" class:list={{ 'svc-panel--card': card }}>
  {cornerImage && <img class="svc-panel__corner" src={cornerImage} alt="" loading="lazy" />}
  <div class="svc-panel__head">
    <div class="svc-panel__intro">
      <div class="svc-panel__eyebrow">
        <span class="svc-panel__eyebrow-bar"></span>
        <span>HİZMET {number}</span>
      </div>
      <Title>{title}</Title>
      <p class="svc-panel__lead">{lead}</p>
    </div>

    {
      tagline && (
        <aside class:list={['svc-panel__tagline', { 'svc-panel__tagline--quote': taglineVariant === 'quote' }]}>
          {taglineVariant === 'icon' && <Icon name={taglineIcon} size={58} />}
          <p>{tagline}</p>
          {taglineVariant === 'quote' && <span class="svc-panel__tagline-rule" />}
        </aside>
      )
    }
  </div>

  <slot />
</div>

<style>
  .svc-panel {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .svc-panel__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 36px;
    margin-bottom: 36px;
  }

  .svc-panel__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
  }

  .svc-panel__eyebrow-bar {
    display: block;
    width: 36px;
    height: 2px;
    background: var(--color-navy);
  }

  .svc-panel__eyebrow span:last-child {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--color-navy);
  }

  .svc-panel--card {
    position: relative;
    overflow: hidden;
    padding: 45px 49px 54px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 4px 30px rgba(43, 46, 131, 0.08);
  }

  .svc-panel__corner {
    position: absolute;
    top: 0;
    right: 0;
    width: 426px;
    height: 336px;
    object-fit: cover;
    filter: grayscale(1) contrast(0.9) brightness(1.15);
    opacity: 0.4;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse at 100% 0%, #000 25%, transparent 72%);
    mask-image: radial-gradient(ellipse at 100% 0%, #000 25%, transparent 72%);
  }

  .svc-panel--card > :not(.svc-panel__corner) {
    position: relative;
  }

  .svc-panel h1,
  .svc-panel h2 {
    margin-bottom: 18px;
    font-size: clamp(1.96rem, 3.36vw, 2.8rem);
    line-height: 1.15;
    color: var(--color-navy-deep);
  }

  .svc-panel__lead {
    max-width: 62ch;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .svc-panel__tagline {
    display: grid;
    align-content: center;
    gap: 16px;
    width: 291px;
    padding-left: 36px;
    border-left: 1px solid var(--color-border);
    color: var(--color-navy);
  }

  .svc-panel__tagline p {
    font-size: 1.19rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--color-navy-deep);
  }

  .svc-panel__tagline--quote {
    width: 336px;
    align-content: start;
    padding-top: 13px;
    padding-left: 40px;
  }

  .svc-panel__tagline--quote p {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 1.33rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .svc-panel__tagline-rule {
    display: block;
    width: 54px;
    height: 1px;
    margin-top: 13px;
    background: var(--color-navy);
    opacity: 0.6;
  }

  @media (max-width: 1280px) {
    .svc-panel__tagline {
      width: 246px;
      padding-left: 27px;
    }
  }

  @media (max-width: 900px) {
    .svc-panel--card {
      padding: 31px 25px 36px;
    }

    .svc-panel__corner {
      display: none;
    }

    .svc-panel__tagline--quote {
      width: auto;
    }

    .svc-panel__head {
      grid-template-columns: 1fr;
    }

    .svc-panel__tagline {
      width: auto;
      padding: 22px 0 0;
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
  }
</style>
