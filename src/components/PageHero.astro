---
// Light, typographic page hero with a slanted photo panel. The h1 content comes from the default slot,
// so a page can highlight a word with <em>.
// variant="photo" is the corporate pages' version: a full-width project photo under a dark gradient.
import { srcset } from '../utils/image';
import { hasCoverVariants } from '../utils/project';
import { breadcrumbLd } from '../utils/schema';

interface Props {
  eyebrow: string;
  breadcrumbs: { label: string; href?: string }[];
  image: string;
  imagePosition?: string;
  /** Large outlined text behind the title, e.g. a year. */
  backdrop?: string;
  facts?: { value: string; label: string }[];
  /** 'short' keeps the hero low so the page's main content (e.g. a form) starts on the first screen. */
  size?: 'full' | 'compact' | 'short';
  variant?: 'light' | 'photo';
  /** Source of a photo taken from another site, shown in the corner. */
  credit?: { label: string; href: string };
}

const {
  eyebrow,
  breadcrumbs,
  image,
  imagePosition = '40% center',
  backdrop,
  facts = [],
  size = 'full',
  variant = 'light',
  credit,
} = Astro.props;
const breadcrumbData = breadcrumbLd(breadcrumbs, Astro.url.pathname);
// Small counts tick up from zero; years and words are shown as they are.
const isCountable = (value: string) => /^\d{1,3}$/.test(value);
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbData)} />

<section class:list={['page-hero', `page-hero--${size}`, `page-hero--${variant}`]}>
  <div class="page-hero__photo" aria-hidden="true">
    <img
      src={image}
      srcset={hasCoverVariants(image) ? srcset(image, 960, 1920) : undefined}
      sizes={variant === 'photo' ? '100vw' : '46vw'}
      alt=""
      fetchpriority="high"
      style={`object-position: ${imagePosition}`}
    />
  </div>
  {
    credit && (
      <a class="page-hero__credit" href={credit.href} target="_blank" rel="noopener noreferrer">
        {credit.label}
      </a>
    )
  }

  <div class="container page-hero__inner">
    <nav class="page-hero__breadcrumb" aria-label="Konum">
      {
        breadcrumbs.map((crumb, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
          </>
        ))
      }
    </nav>

    {backdrop && <span class="page-hero__backdrop" aria-hidden="true">{backdrop}</span>}

    <div class="page-hero__text">
      <p class="page-hero__eyebrow"><span></span>{eyebrow}</p>
      <h1 data-words><slot /></h1>
      {
        facts.length > 0 && (
          <ul class="page-hero__facts">
            {facts.map((fact) => (
              <li>
                <b>{isCountable(fact.value) ? <span data-count={fact.value}>{fact.value}</span> : fact.value}</b>
                {fact.label}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-light);
  }

  .page-hero__photo {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 46%;
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
  }

  .page-hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-block: 40px 72px;
  }

  .page-hero--full .page-hero__inner {
    min-height: calc(100svh - var(--header-h));
    max-height: 920px;
  }

  .page-hero--compact .page-hero__inner {
    min-height: 580px;
  }

  .page-hero--short .page-hero__inner {
    padding-block: 32px 56px;
  }

  .page-hero--short .page-hero__text {
    padding-top: 40px;
  }

  .page-hero__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .page-hero__breadcrumb a:hover {
    color: var(--color-navy);
  }

  .page-hero__breadcrumb [aria-current] {
    color: var(--color-navy-deep);
    font-weight: 600;
  }

  .page-hero__backdrop {
    position: absolute;
    left: calc(var(--edge) - 0.06em);
    bottom: 0.02em;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(9rem, 22vw, 24rem);
    line-height: 0.75;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 2px rgba(47, 48, 145, 0.12);
    pointer-events: none;
    user-select: none;
  }

  .page-hero__text {
    position: relative;
    margin-block: auto;
    max-width: 58%;
    padding-top: 32px;
  }

  .page-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .page-hero__eyebrow span {
    width: 40px;
    height: 3px;
    background: var(--color-orange);
  }

  .page-hero h1 {
    margin-top: 28px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(2.75rem, 5.4vw + 0.5rem, 7rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--color-navy-deep);
  }

  .page-hero--compact h1 {
    font-size: clamp(2.5rem, 4.4vw + 0.5rem, 5.75rem);
  }

  .page-hero--short h1 {
    font-size: clamp(2.5rem, 3.4vw + 0.5rem, 4.5rem);
  }

  .page-hero h1 :global(em) {
    font-style: normal;
    color: var(--color-navy);
    box-shadow: inset 0 -0.18em 0 rgba(245, 162, 27, 0.55);
  }

  .page-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .page-hero__facts li {
    display: grid;
    gap: 6px;
    padding-left: 18px;
    border-left: 3px solid var(--color-orange);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .page-hero__facts b {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--color-navy-deep);
  }

  /* Photo variant: full-width photo, dark gradient, white type */
  .page-hero--photo {
    background: var(--color-navy-deep);
    color: #fff;
  }

  .page-hero--photo .page-hero__photo {
    left: 0;
    width: 100%;
    clip-path: none;
  }


  .page-hero--photo .page-hero__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Solid behind the text, fading out to the right so the photo shows on that side. */
    background: linear-gradient(
        to right,
        var(--color-navy-deep) 0%,
        var(--color-navy-deep) 40%,
        rgba(28, 29, 46, 0.85) 48%,
        rgba(28, 29, 46, 0.55) 58%,
        rgba(28, 29, 46, 0.25) 68%,
        rgba(28, 29, 46, 0) 80%
      );
  }

  .page-hero--photo .page-hero__breadcrumb,
  .page-hero--photo .page-hero__breadcrumb a {
    color: rgba(255, 255, 255, 0.75);
  }

  .page-hero--photo .page-hero__breadcrumb a:hover,
  .page-hero--photo .page-hero__breadcrumb [aria-current] {
    color: #fff;
  }

  .page-hero--photo .page-hero__eyebrow {
    color: rgba(255, 255, 255, 0.85);
  }

  .page-hero--photo h1 {
    color: #fff;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.3);
  }

  .page-hero--photo h1 :global(em) {
    color: #fff;
    box-shadow: inset 0 -0.18em 0 rgba(245, 162, 27, 0.85);
  }

  .page-hero--photo .page-hero__backdrop {
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.12);
  }

  .page-hero--photo .page-hero__facts li {
    color: rgba(255, 255, 255, 0.75);
  }

  .page-hero--photo .page-hero__facts b {
    color: #fff;
  }

  .page-hero__credit {
    position: absolute;
    right: 12px;
    bottom: 8px;
    z-index: 1;
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.6);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .page-hero__credit:hover {
    color: #fff;
  }

  @media (max-width: 1024px) {
    .page-hero--light .page-hero__photo {
      width: 100%;
      clip-path: none;
      opacity: 0.18;
    }

    .page-hero--photo .page-hero__photo::after {
      background: rgba(20, 21, 34, 0.65);
    }

    .page-hero__text {
      max-width: none;
    }

    .page-hero--compact .page-hero__inner {
      min-height: 480px;
    }
  }

  @media (max-width: 640px) {
    .page-hero__backdrop {
      left: var(--edge-mobile);
    }

    .page-hero__facts {
      gap: 20px 28px;
    }
  }

  @media (max-width: 480px) {
    .page-hero h1,
    .page-hero--compact h1,
    .page-hero--short h1 {
      font-stretch: 100%;
      font-size: clamp(2.25rem, 10vw, 2.75rem);
    }
  }
</style>
