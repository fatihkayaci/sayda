---
import site from '../data/site.json';

interface Props {
  title: string;
  description: string;
  /** Emit page-level schema.org JSON-LD (e.g. LocalBusiness). */
  organizationSchema?: boolean;
  ogImage?: string;
  jsonLd?: object[];
  /** ISO date; marks the page as an article (news and blog posts). */
  publishedTime?: string;
}

const { title, organizationSchema = false, ogImage, jsonLd = [], publishedTime } = Astro.props;

// Google cuts snippets at ~160 characters; trim long ones at a word boundary instead.
const description =
  Astro.props.description.length > 160
    ? `${Astro.props.description.slice(0, 157).replace(/\s+\S*$/, '')}…`
    : Astro.props.description;

const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(ogImage ?? '/img/og-default.jpg', site.url).toString();

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.legalName,
  url: `${site.url}/`,
  logo: new URL(site.logo, site.url).toString(),
  image: new URL('/img/og-default.jpg', site.url).toString(),
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.foundedYear),
  numberOfEmployees: { '@type': 'QuantitativeValue', value: site.stats.employeeCount },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '18:00',
  },
  areaServed: [
    { '@type': 'City', name: 'İstanbul' },
    { '@type': 'Country', name: 'Türkiye' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.district,
    addressRegion: site.address.city,
    postalCode: site.address.postalCode,
    addressCountry: 'TR',
  },
  sameAs: Object.values(site.social),
};

// Tells Google which name to show for the site in results (homepage only, per Google's guidance).
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  alternateName: ['Sayda', 'Sayda İnşaat Taahhüt'],
  url: `${site.url}/`,
  inLanguage: 'tr-TR',
  publisher: { '@id': `${site.url}/#organization` },
};
const isHome = Astro.url.pathname === '/';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={publishedTime ? 'article' : 'website'} />
{publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="tr_TR" />
<meta property="og:site_name" content={site.name} />
<meta property="og:image" content={ogImageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}

{isHome && <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)} />}
{
  organizationSchema && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationLd)} />
  )
}
{
  jsonLd.map((schema) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  ))
}
