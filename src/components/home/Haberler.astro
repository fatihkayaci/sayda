---
import haberlerData from '../../data/haberler.json';

const MAX_AGE_DAYS = 180;

const sorted = [...haberlerData].sort((a, b) => (a.date < b.date ? 1 : -1));
const newest = sorted[0];
const ageInDays = newest ? (Date.now() - new Date(newest.date).getTime()) / 86_400_000 : Infinity;
const isStale = ageInDays > MAX_AGE_DAYS;

const items = sorted.slice(0, 3);
const formatter = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---

{
  !isStale && items.length > 0 && (
    <section class="haberler">
      <div class="container">
        <div class="haberler__header">
          <h2>Haberler</h2>
          <a class="haberler__all" href="/haberler">
            Tümünü gör
          </a>
        </div>

        <div class="haberler__grid">
          {items.map((haber) => (
            <a class="haber-card" href={`/haberler/${haber.slug}`}>
              <img src={haber.image} alt={haber.title} loading="lazy" />
              <div class="haber-card__info">
                <span class="haber-card__date">{formatter.format(new Date(haber.date))}</span>
                <h3>{haber.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .haberler {
    padding-block: var(--space-xl);
    background: var(--color-bg-light);
  }

  .haberler__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-l);
  }

  .haberler__header h2 {
    font-size: var(--fs-h2);
  }

  .haberler__all {
    font-weight: 700;
    font-size: var(--fs-small);
    color: var(--color-navy);
    white-space: nowrap;
  }

  .haberler__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }

  .haber-card {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .haber-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .haber-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .haber-card__info {
    padding: var(--space-m);
  }

  .haber-card__date {
    font-size: var(--fs-small);
    color: var(--color-text-faint);
  }

  .haber-card h3 {
    margin-top: 6px;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  @media (max-width: 1024px) {
    .haberler__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .haberler__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
