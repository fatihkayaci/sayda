---
import Icon from '../Icon.astro';
import site from '../../data/site.json';

const certLabel = site.certifications.map((c) => c.name.replace('ISO ', '')).join(' · ');
---

<section class="about" id="hakkimizda">
  <div class="about__grid" aria-hidden="true"></div>
  <div class="container about__inner reveal">
    <div class="about__media">
      <img src="/img/hakkimizda.png" alt="Sayda İnşaat" loading="lazy" />
      <div class="about__badge">
        <span class="about__badge-year">{site.foundedYear}</span>
        <span class="about__badge-label">KURULUŞ YILI</span>
      </div>
    </div>

    <div class="about__content">
      <div class="about__eyebrow">
        <span class="about__eyebrow-bar"></span>
        <span>HAKKIMIZDA</span>
      </div>
      <h2>Güvenle<br />İnşa Ediyoruz</h2>
      <p>
        {site.foundedYear} yılında kurulan Sayda İnşaat, İstanbul ve Türkiye genelinde konut, ticari yapı,
        sağlık kampüsü ve otel projelerinde ince işler ile taahhüt hizmetleri sunmaktadır.
      </p>
      <p>
        ISO {certLabel} belgeleriyle kaliteyi ve sürdürülebilirliği taahhüt ediyoruz.
        {site.contractorLicenseGroup} grubu yüklenici yetki belgemiz ve {site.completionCertificatesCount} adet iş bitirme
        belgemizle sektörde güvenilir bir referans noktasıyız.
      </p>
      <div class="about__badges">
        <div class="about__mini-badge">
          <Icon name="check" size={18} />
          <span>ISO {certLabel}</span>
        </div>
        <div class="about__mini-badge">
          <Icon name="document" size={18} />
          <span>{site.contractorLicenseGroup} Grubu Yetki Belgesi</span>
        </div>
      </div>
      <a class="about__link" href="/hakkimizda">Bize Ulaşın →</a>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    background: var(--color-navy-deep);
    padding-block: 112px;
    overflow: hidden;
  }

  .about__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 72px 72px;
    pointer-events: none;
  }

  .about__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .about__media {
    position: relative;
  }

  .about__media img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: 6px;
  }

  .about__badge {
    position: absolute;
    bottom: -28px;
    right: -28px;
    background: var(--color-navy);
    color: #fff;
    padding: 28px 32px;
    border-radius: 6px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
  }

  .about__badge-year {
    display: block;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 48px;
    line-height: 1;
  }

  .about__badge-label {
    font-size: 13px;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.7);
  }

  .about__content {
    display: grid;
    gap: 24px;
  }

  .about__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .about__eyebrow-bar {
    display: block;
    width: 44px;
    height: 3px;
    background: #fff;
  }

  .about__eyebrow span:last-child {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.6);
  }

  .about__content h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(28px, 4vw, 46px);
    line-height: 1.05;
    color: #fff;
  }

  .about__content p {
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.75);
    text-wrap: pretty;
  }

  .about__badges {
    display: flex;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .about__mini-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius);
    font-size: 13px;
    font-weight: 600;
    color: #fff;
  }

  .about__link {
    align-self: start;
    display: inline-block;
    margin-top: 8px;
    padding: 15px 32px;
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 700;
    background: #fff;
    color: var(--color-navy);
    transition: background var(--transition);
  }

  .about__link:hover {
    background: #e8e9f5;
  }

  @media (max-width: 1024px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }

    .about__media img {
      height: 380px;
    }

    .about__badge {
      right: 16px;
      bottom: -20px;
      padding: 20px 24px;
    }
  }
</style>
