---
import site from '../../data/site.json';

const certLabel = site.certifications.map((c) => c.name.replace('ISO ', '')).join(' · ');
---

<section class="abt" id="hakkimizda">
  <div class="container abt__grid">
    <div class="abt__media reveal reveal-left">
      <div class="abt__img">
        <img src="/img/hakkimizda.png" alt="Sayda İnşaat" loading="lazy" />
      </div>
      <div class="abt__since">
        <div class="abt__since-label">Since</div>
        <div class="abt__since-year">{site.foundedYear}</div>
      </div>
    </div>

    <div class="reveal reveal-right">
      <div class="eyebrow">Hakkımızda</div>
      <h2 class="h2">Güvenle inşa ediyoruz</h2>
      <p class="abt__lead">
        {site.foundedYear} yılında kurulan Sayda İnşaat, İstanbul ve Türkiye genelinde konut, ticari yapı,
        sağlık kampüsü ve otel projelerinde ince işler ile taahhüt hizmetleri sunmaktadır.
      </p>
      <p class="abt__text">
        ISO {certLabel} belgeleriyle kaliteyi ve sürdürülebilirliği taahhüt ediyoruz.
        {site.contractorLicenseGroup} grubu yüklenici yetki belgemiz ve {site.completionCertificatesCount} adet iş bitirme
        belgemizle sektörde güvenilir bir referans noktasıyız.
      </p>
      <div class="abt__chips">
        <span>ISO {certLabel}</span>
        <span>{site.contractorLicenseGroup} Grubu Yetki Belgesi</span>
      </div>
      <a href="/hakkimizda" class="btn btn--dark abt__btn">Bizi Tanıyın <span>→</span></a>
    </div>
  </div>
</section>

<style>
  .abt {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-navy);
    margin-bottom: 16px;
  }

  .h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 1.05;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .abt__grid {
    padding-top: 120px;
    padding-bottom: 120px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 80px;
    align-items: center;
  }

  .abt__media {
    position: relative;
  }

  .abt__img {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--color-bg-light);
  }

  .abt__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .abt__since {
    position: absolute;
    right: -24px;
    bottom: -40px;
    background: var(--color-navy);
    color: #fff;
    padding: 30px 40px 34px;
    box-shadow: 0 30px 60px -20px rgba(20, 22, 58, 0.45);
  }

  .abt__since-label {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }

  .abt__since-year {
    font-family: var(--font-display);
    font-size: 96px;
    font-weight: 800;
    font-stretch: 120%;
    line-height: 0.9;
    letter-spacing: -0.02em;
    margin-top: 6px;
  }

  .abt__lead {
    margin: 28px 0 0;
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .abt__text {
    margin: 18px 0 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .abt__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .abt__chips span {
    padding: 10px 16px;
    border: 1px solid rgba(43, 46, 131, 0.3);
    color: var(--color-navy);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 54px;
    padding: 0 28px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.2s;
  }

  .btn--dark {
    background: var(--color-navy);
    color: #fff;
  }

  .btn--dark:hover {
    background: var(--color-navy-deep);
    color: #fff;
  }

  .abt__btn {
    margin-top: 40px;
  }

  @media (max-width: 760px) {
    .h2 {
      font-size: 34px;
    }

    .abt__grid {
      padding-top: 72px;
      padding-bottom: 72px;
      gap: 72px;
    }

    .abt__since {
      right: 12px;
      bottom: -32px;
      padding: 20px 26px 24px;
    }

    .abt__since-label {
      font-size: 14px;
    }

    .abt__since-year {
      font-size: 60px;
    }
  }
</style>
