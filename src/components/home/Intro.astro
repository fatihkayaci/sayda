---
import site from '../../data/site.json';

const areaInMillions = Number(site.stats.totalCompletedArea.replace(/[^\d]/g, '')) / 1_000_000;

// count: animated numeric part; decimals: digits kept while counting; suffix renders in orange.
const stats = [
  { value: site.foundedYear, decimals: 0, count: false, suffix: '', label: 'Yılından Beri' },
  { value: site.stats.completedProjects, decimals: 0, count: true, suffix: '+', label: 'Tamamlanan Proje' },
  { value: site.stats.ongoingProjects, decimals: 0, count: true, suffix: '+', label: 'Devam Eden Proje' },
  { value: areaInMillions, decimals: 2, count: true, suffix: 'M+', label: 'm² Uygulama Alanı' },
];

const format = (n: number, decimals: number) =>
  n.toLocaleString('tr-TR', { minimumFractionDigits: decimals, maximumFractionDigits: decimals, useGrouping: false });
---

<section class="intro" aria-label="Rakamlarla Sayda İnşaat">
  <div class="container">
    <div class="intro__stats">
      {
        stats.map((s) => (
          <div class="intro__stat">
            <b>
              <span
                data-countup={s.count ? s.value : undefined}
                data-decimals={s.decimals}
              >
                {format(s.value, s.decimals)}
              </span>
              {s.suffix && <em>{s.suffix}</em>}
            </b>
            <span class="intro__label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intro {
    padding-block: 72px;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .intro__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-l);
  }

  .intro__stat {
    position: relative;
    padding-top: 28px;
  }

  .intro__stat::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 48px;
    height: 4px;
    background: var(--color-orange);
  }

  .intro__stat b {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(2.75rem, 4.2vw + 0.75rem, 5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-navy-deep);
    font-variant-numeric: tabular-nums;
  }

  .intro__stat em {
    font-style: normal;
    font-size: 0.6em;
    color: var(--color-orange-text);
  }

  .intro__label {
    display: block;
    margin-top: 14px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .intro {
      padding-block: 48px;
    }

    .intro__stats {
      gap: var(--space-m);
    }

    .intro__stat::before {
      width: 32px;
      height: 3px;
    }

    .intro__label {
      font-size: 0.8125rem;
      letter-spacing: 0.06em;
    }
  }

  /* Tablet and phone: 2 × 2 */
  @media (max-width: 900px) {
    .intro__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 36px;
    }
  }

  @media (max-width: 560px) {
    .intro__stat b {
      font-size: 2.5rem;
    }
  }
</style>
