---
import Icon from '../Icon.astro';
import site from '../../data/site.json';

const area = `${(Number(site.stats.totalCompletedArea.replace(/[^\d]/g, '')) / 1_000_000).toLocaleString('tr-TR')}M+`;

const stats = [
  { icon: 'calendar', value: String(site.foundedYear), label: 'Yılından Beri' },
  { icon: 'check', value: '30+', label: 'Tamamlanan Proje' },
  { icon: 'area', value: area, label: 'm² Uygulama Alanı' },
];
---

<section class="intro">
  <div class="container">
    <div class="intro__stats">
      {
        stats.map((s) => (
          <div class="intro__stat">
            <i class="intro__icon">
              <Icon name={s.icon} size={32} />
            </i>
            <div>
              <b>{s.value}</b>
              <span>{s.label}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intro {
    padding-block: 56px;
    background: linear-gradient(135deg, #fff 0%, #f1f4fb 100%);
  }

  .intro__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .intro__stat {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding-block: 8px;
  }

  .intro__stat + .intro__stat {
    border-left: 1px solid var(--color-border);
  }

  .intro__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 68px;
    height: 68px;
    background: #fff;
    border-bottom: 3px solid var(--color-orange);
    box-shadow: 0 6px 20px rgba(20, 27, 46, 0.08);
    color: var(--color-navy);
  }

  .intro__icon :global(svg) {
    stroke-width: 1.4;
  }

  .intro__stat b {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.9rem, 2.4vw + 0.6rem, 2.8rem);
    line-height: 1;
    color: var(--color-navy);
  }

  .intro__stat span {
    display: block;
    margin-top: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .intro {
      padding-block: 36px;
    }

    .intro__stat {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }

    .intro__icon {
      width: 52px;
      height: 52px;
    }

    .intro__icon :global(svg) {
      width: 26px;
      height: 26px;
    }

    .intro__stat span {
      margin-top: 6px;
      font-size: 0.66rem;
      letter-spacing: 0.04em;
    }
  }

  @media (max-width: 480px) {
    .intro__icon {
      width: 44px;
      height: 44px;
    }

    .intro__stat b {
      font-size: 1.4rem;
    }

    .intro__stat span {
      font-size: 0.58rem;
    }
  }
</style>
