---
import Icon from '../Icon.astro';
import allProjects from '../../data/projects.json';
import { shortProjectTitle, splitLocation } from '../../utils/project';

const picks = [
  { slug: 'terrace-bahce-konut', image: '/img/home/residence-sunset.webp' },
  { slug: 'capital-tower-ofis', image: '/img/home/twin-towers.webp' },
  { slug: 'gaziantep-sehir-hastanesi', image: '/img/home/hospital.webp' },
  { slug: 'atlas-park-avm-ofis', image: '/img/home/mall.webp' },
];
const projects = picks.flatMap(({ slug, image }) => {
  const project = allProjects.find((p) => p.slug === slug);
  return project ? [{ ...project, image }] : [];
});
---

<section class="fp">
  <div class="container">
    <div class="fp__head">
      <div>
        <span class="fp__eyebrow">Projelerimiz</span>
        <h2>Geleceğe Değer Katan Yapılar</h2>
      </div>
      <a href="/projeler">Tüm Projeleri Gör <Icon name="arrow" size={14} /></a>
    </div>
    <div class="fp__grid">
      {
        projects.map((p) => (
          <a href={p.href} class="fp__card">
            <img src={p.image} alt={`${p.name} - Sayda İnşaat`} loading="lazy" />
            <div class="fp__body">
              <div>
                <span class="fp__type">{p.type}</span>
                <h3>{shortProjectTitle(p.name)} Projesi</h3>
                <span class="fp__loc">
                  <Icon name="pin" size={12} />
                  {splitLocation(p.location).short}
                </span>
              </div>
              <i><Icon name="arrow" size={16} /></i>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fp {
    padding-block: 40px 56px;
    background: #eef3fa;
  }

  .fp__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: 22px;
  }

  .fp__eyebrow {
    display: block;
    margin-bottom: 4px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3a4a7a;
  }

  .fp__head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.7rem;
    line-height: 1.15;
    color: var(--color-navy);
  }

  .fp__head > a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-navy);
    white-space: nowrap;
  }

  .fp__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .fp__card {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #141a27;
    color: #fff;
  }

  .fp__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .fp__card:hover img {
    transform: scale(1.04);
  }

  .fp__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 14, 28, 0) 50%, rgba(10, 14, 28, 0.92) 100%);
  }

  .fp__body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    padding: 14px;
  }

  .fp__type {
    display: block;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #cfd5e6;
  }

  .fp__body h3 {
    margin-block: 3px 4px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.25;
  }

  .fp__loc {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.68rem;
    color: #e7b24c;
  }

  .fp__body i {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border: 1.5px solid #fff;
    border-radius: 50%;
    transition:
      background var(--transition),
      color var(--transition);
  }

  .fp__card:hover .fp__body i {
    background: #fff;
    color: var(--color-navy);
  }

  @media (max-width: 1024px) {
    .fp__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .fp__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .fp__head h2 {
      font-size: 1.4rem;
    }

    .fp__grid {
      grid-template-columns: 1fr;
    }

    .fp__card {
      aspect-ratio: 4 / 3;
    }
  }
</style>
