---
import Icon from '../Icon.astro';
import allProjects from '../../data/projects.json';
import { shortProjectTitle } from '../../utils/project';

const picks = [
  { slug: 'terrace-bahce-konut', image: '/img/home/residence-sunset.webp' },
  { slug: 'capital-tower-ofis', image: '/img/home/twin-towers.webp' },
  { slug: 'gaziantep-sehir-hastanesi', image: '/img/home/hospital.webp' },
  { slug: 'atlas-park-avm-ofis', image: '/img/home/mall.webp' },
];
const projects = picks.flatMap(({ slug, image }) => {
  const project = allProjects.find((p) => p.slug === slug);
  return project ? [{ ...project, image }] : [];
});
---

<section class="fp">
  <div class="container">
    <div class="fp__head">
      <div>
        <span class="eyebrow"><i></i>Öne Çıkan Projeler</span>
        <h2>Yaşam Alanlarına Değer Katıyoruz</h2>
      </div>
      <a href="/projeler">Tüm Projeler <Icon name="arrow" size={14} /></a>
    </div>
    <div class="fp__grid">
      {
        projects.map((p) => (
          <a href={p.href} class="fp__card">
            <img src={p.image} alt={`${p.name} - Sayda İnşaat`} loading="lazy" />
            <div class="fp__body">
              <div>
                <span class="fp__type">{p.type}</span>
                <h3>{shortProjectTitle(p.name)}</h3>
              </div>
              <i><Icon name="arrow" size={16} /></i>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fp {
    padding-block: 40px 56px;
    background: #fff;
  }

  .fp__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: 22px;
  }

  .fp__head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.7rem;
    line-height: 1.15;
    color: var(--color-navy);
  }

  .fp__head > a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border: 1.5px solid #2a2f45;
    font-size: 0.8rem;
    font-weight: 700;
    color: #141b2e;
    white-space: nowrap;
  }

  .fp__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .fp__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: #fff;
  }

  .fp__card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .fp__card:hover img {
    transform: scale(1.04);
  }

  .fp__card {
    position: relative;
  }

  .fp__body {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 14px 14px 16px;
    background: var(--color-navy);
  }

  .fp__type {
    display: block;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #cfd5e6;
  }

  .fp__body h3 {
    margin-top: 3px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .fp__body i {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    background: var(--color-orange);
    color: #fff;
  }

  @media (max-width: 1024px) {
    .fp__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .fp__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .fp__head h2 {
      font-size: 1.4rem;
    }

    .fp__grid {
      grid-template-columns: 1fr;
    }

  }
</style>
