---
import allProjects from '../../data/projects.json';
import { shortProjectTitle } from '../../utils/project';

const projects = allProjects.filter((p) => p.image).slice(0, 12);
---

<section class="fp">
  <div class="fp__inner">
    <h2 class="visually-hidden">Projelerimiz</h2>
    <div class="fp__nav">
      <button type="button" class="fp__btn" data-dir="-1" aria-label="Önceki projeler">‹</button>
      <button type="button" class="fp__btn" data-dir="1" aria-label="Sonraki projeler">›</button>
    </div>
    <ul class="fp__track">
      {
        projects.map((p) => (
          <li class="fp__item">
            <a href={p.href} class="fp__card">
              <img src={p.image} alt={p.name} width="138" height="150" loading="lazy" />
              <h3>{shortProjectTitle(p.name)}</h3>
              <span class="fp__more">Detaylar</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.fp').forEach((fp) => {
    const track = fp.querySelector<HTMLElement>('.fp__track')!;
    fp.querySelectorAll<HTMLElement>('.fp__btn').forEach((btn) =>
      btn.addEventListener('click', () => {
        track.scrollBy({ left: Number(btn.dataset.dir) * track.clientWidth, behavior: 'smooth' });
      }),
    );
  });
</script>

<style>
  .fp {
    padding-block: 40px 70px;
    background: url('/img/legacy/projects-bg.jpg') center center no-repeat;
    background-size: cover;
    background-color: #c9ccd6;
    font-family: var(--font-body);
  }

  .fp__inner {
    max-width: 1170px;
    margin-inline: auto;
    padding-inline: 15px;
  }

  .fp__nav {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin-bottom: 40px;
  }

  .fp__btn {
    width: 28px;
    height: 28px;
    border: 1px solid #ddd;
    background: #fff;
    color: #555;
    font-size: 18px;
    line-height: 1;
  }

  .fp__btn:hover {
    background: #f7a238;
    color: #fff;
  }

  .fp__track {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .fp__track::-webkit-scrollbar {
    display: none;
  }

  .fp__item {
    flex: 0 0 calc(50% - 12px);
    scroll-snap-align: start;
  }

  .fp__card {
    position: relative;
    display: block;
    min-height: 150px;
    padding-left: 138px;
    background: #fff;
  }

  .fp__card img {
    position: absolute;
    top: 0;
    left: 0;
    width: 138px;
    height: 150px;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .fp__card:hover img {
    opacity: 0.45;
  }

  .fp__card h3 {
    display: inline-block;
    position: relative;
    top: 12px;
    left: -20px;
    max-width: calc(100% - 100px);
    margin: 0;
    padding: 8px 20px;
    font-size: 12px;
    line-height: 26px;
    font-weight: 700;
    text-transform: uppercase;
    color: #fff;
    background: #2e3191;
  }

  .fp__more {
    position: absolute;
    top: 0;
    right: 0;
    padding: 0 20px;
    font-size: 12px;
    line-height: 37px;
    text-transform: uppercase;
    color: #fff;
    background: #f7a238;
  }

  @media (max-width: 800px) {
    .fp__item {
      flex-basis: 100%;
    }
  }
</style>
