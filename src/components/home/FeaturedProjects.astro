---
import Icon from '../Icon.astro';
import allProjects from '../../data/projects.json';
import { shortProjectTitle, hasCoverVariants } from '../../utils/project';
import { srcset } from '../../utils/image';

// Each card shows the project's own cover (the same photo as on its detail page). The first one is the big tile.
const picks = ['atlas-park-avm-ofis', 'terrace-bahce-konut', 'capital-tower-ofis', 'gaziantep-sehir-hastanesi'];
const projects = picks.flatMap((slug) => {
  const project = allProjects.find((p) => p.slug === slug);
  return project ? [project] : [];
});
---

<section class="fp">
  <div class="container">
    <div class="fp__head">
      <div>
        <span class="eyebrow"><i></i>Öne Çıkan Projeler</span>
        <h2 data-words>Yaşam Alanlarına Değer Katıyoruz</h2>
      </div>
      <a href="/projeler">Tüm Projeler <Icon name="arrow" size={14} /></a>
    </div>
    <div class="fp__grid">
      {
        projects.map((p) => (
          <a href={p.href} class="fp__card">
            <img
              src={p.image}
              srcset={hasCoverVariants(p.image) ? srcset(p.image, 960, 1920) : undefined}
              sizes="(max-width: 900px) 100vw, 50vw"
              alt={`${p.name} - Sayda İnşaat`}
              loading="lazy"
            />
            <div class="fp__body">
              <div>
                <span class="fp__type">{p.type}</span>
                <h3>{shortProjectTitle(p.name)}</h3>
                {p.location && <span class="fp__loc">{p.location.replace(' - ', ' · ')}</span>}
              </div>
              <i><Icon name="arrow" size={16} /></i>
            </div>
            {'imageCredit' in p && p.imageCredit && <span class="fp__credit">{p.imageCredit.label}</span>}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fp {
    padding-block: 72px;
    background: #fff;
  }

  .fp__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: 40px;
  }

  .fp__head h2 {
    margin-top: 12px;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(2rem, 2.6vw + 1rem, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-navy-deep);
  }

  .fp__head > a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border: 1.5px solid var(--color-navy-deep);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-navy-deep);
    white-space: nowrap;
  }

  .fp__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    grid-template-rows: 250px 250px;
    gap: 16px;
  }

  .fp__card {
    position: relative;
    display: block;
    overflow: hidden;
    color: #fff;
    background: var(--color-navy-deep);
  }

  .fp__card:nth-child(1) {
    grid-row: 1 / 3;
  }

  .fp__card:nth-child(4) {
    grid-column: 2 / 4;
  }

  .fp__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .fp__card:hover img {
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .fp__card img,
    .fp__loc {
      transition: none;
    }
  }

  .fp__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(28, 29, 46, 0) 40%, rgba(28, 29, 46, 0.9) 100%);
    pointer-events: none;
  }

  .fp__body {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    padding: 20px;
  }

  .fp__type {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-orange);
  }

  .fp__body h3 {
    margin-top: 4px;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .fp__card:nth-child(1) h3 {
    font-size: 1.75rem;
  }

  /* location slides in under the title on hover */
  .fp__loc {
    display: block;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    margin-top: 4px;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.8);
    transition:
      max-height 400ms ease,
      opacity 300ms ease;
  }

  .fp__card:hover .fp__loc,
  .fp__card:focus-visible .fp__loc {
    max-height: 20px;
    opacity: 1;
  }

  @media (hover: none) {
    .fp__loc {
      max-height: none;
      opacity: 1;
    }
  }

  /* photo credit, kept visible until usage permissions are settled (see HERO-IMAGE-LICENSES.md) */
  .fp__credit {
    position: absolute;
    top: 8px;
    right: 10px;
    z-index: 1;
    font-size: 0.625rem;
    color: rgba(255, 255, 255, 0.7);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
  }

  .fp__body i {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    background: var(--color-orange);
    color: #fff;
  }

  @media (max-width: 1024px) {
    .fp__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: 300px 220px 220px;
    }

    .fp__card:nth-child(1) {
      grid-column: 1 / 3;
      grid-row: auto;
    }

    .fp__card:nth-child(4) {
      grid-column: 1 / 3;
    }
  }

  @media (max-width: 600px) {
    .fp__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .fp__head h2 {
      font-size: 2rem;
    }

    .fp__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-rows: 240px;
    }

    .fp__card:nth-child(1),
    .fp__card:nth-child(4) {
      grid-column: auto;
    }
  }
</style>
