---
import Icon from '../Icon.astro';
import allProjects from '../../data/projects.json';
import { statusLabel, formatDateRange } from '../../utils/project';

const featured = allProjects.filter((project) => project.featured);
const rest = allProjects.filter((project) => !project.featured).slice(0, 2);
const projects = [...featured, ...rest].slice(0, 3);
---

<section class="prj" id="projeler">
  <div class="container prj__wrap">
    <div class="prj__head">
      <div class="reveal reveal-left">
        <div class="eyebrow eyebrow--light">Öne Çıkan Projeler</div>
        <h2 class="h2">Gerçek projeler,<br />gerçek sonuçlar</h2>
      </div>
      <a href="/projeler" class="prj__all reveal reveal-right">Tüm Projeler <span>→</span></a>
    </div>
    <div class="prj__grid">
      {
        projects.map((project, i) => (
          <a href={project.href} class={`prj__card reveal reveal-d${i + 1}`}>
            <div class="prj__img">
              {project.image ? (
                <img src={project.image} alt={`${project.name} - Sayda İnşaat`} loading="lazy" />
              ) : (
                <div class="prj__img-empty">
                  <Icon name="photo" size={36} />
                </div>
              )}
              <span class={`prj__badge prj__badge--${project.status}`}>{statusLabel(project.status)}</span>
              <div class="prj__ribbon">
                <h3>{project.name}</h3>
                <span class="prj__cta">Detaylar <span>→</span></span>
              </div>
            </div>
            <div class="prj__body">
              {project.employer && <div class="prj__loc">{project.employer} · {project.location}</div>}
              <div class="prj__meta">
                <b>{project.area}</b>
                <span>{formatDateRange(project.startDate, project.endDate)}</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .prj {
    background: var(--color-navy-dark);
    color: #fff;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .eyebrow--light {
    color: var(--color-on-dark-muted);
  }

  .h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 1.05;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .prj__wrap {
    padding-top: 120px;
    padding-bottom: 120px;
  }

  .prj__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 56px;
  }

  .prj__all {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--color-on-dark-muted);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }

  .prj__all:hover {
    color: var(--color-on-dark-muted);
  }

  .prj__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 28px;
  }

  .prj__card {
    display: flex;
    flex-direction: column;
    color: #fff;
  }

  .prj__card:hover {
    color: var(--color-bg-light);
  }

  .prj__img {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-navy-deep);
  }

  .prj__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .prj__img-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: rgba(255, 255, 255, 0.3);
  }

  .prj__card:hover .prj__img img {
    transform: scale(1.04);
  }

  .prj__badge {
    position: absolute;
    top: 18px;
    left: 18px;
    padding: 7px 12px;
    background: #fff;
    color: var(--color-navy);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .prj__badge--devam-eden {
    background: var(--color-navy);
    color: #fff;
  }

  .prj__ribbon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    background: linear-gradient(0deg, rgba(13, 21, 51, 0.92), rgba(13, 21, 51, 0.55) 85%, transparent);
  }

  .prj__ribbon h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    font-stretch: 108%;
    line-height: 1.2;
    color: #fff;
  }

  .prj__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    border-radius: 6px;
    background: var(--color-accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.3s ease;
  }

  .prj__cta span {
    transition: transform 0.3s ease;
  }

  .prj__card:hover .prj__cta {
    background: var(--color-accent-dark);
  }

  .prj__card:hover .prj__cta span {
    transform: translateX(3px);
  }

  .prj__body {
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .prj__loc {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .prj__meta {
    display: flex;
    gap: 20px;
    margin-top: 6px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
  }

  .prj__meta b {
    color: #fff;
  }

  @media (max-width: 760px) {
    .h2 {
      font-size: 34px;
    }

    .prj__wrap {
      padding-top: 72px;
      padding-bottom: 72px;
    }
  }
</style>
