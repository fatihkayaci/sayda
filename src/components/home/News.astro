---
import news from '../../data/haberler.json';
import site from '../../data/site.json';

const items = [...news].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 2);

const docs = [
  { title: 'Sertifikalarımız', href: site.documents.certificate, image: '/img/legacy/sertifika.png', external: true },
  { title: 'Tanıtım Katalog', href: site.documents.catalog, image: '/img/legacy/pdfkat.png', external: true },
  { title: 'İş Bitirme Belgelerimiz', href: '/belgeler', image: '/img/legacy/isbitirme.png', external: false },
];

const fmt = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${d}.${m}.${y}`;
};
---

<section class="news">
  <div class="container news__layout">
    <div class="news__list">
      <h2>Bizden Haberler</h2>
      <ul>
        {
          items.map((n) => (
            <li>
              <img src={n.image} alt="" width="98" height="76" loading="lazy" />
              <div>
                <h3>{n.title}</h3>
                <time class="news__date">{fmt(n.date)}</time>
                <a href={`/haberler/${n.slug}`}>Devamı..</a>
              </div>
            </li>
          ))
        }
      </ul>
      <a class="news__all" href="/haberler">Tüm Haberler..</a>
    </div>

    <div class="news__doc">
      <h2>{docs[0].title}</h2>
      <a href={docs[0].href} target="_blank" rel="noopener noreferrer">
        <img src={docs[0].image} alt={docs[0].title} loading="lazy" />
      </a>
    </div>

    <div class="news__stack">
      {
        docs.slice(1).map((d) => (
          <div class="news__doc">
            <h2>{d.title}</h2>
            <a href={d.href} target={d.external ? '_blank' : undefined} rel={d.external ? 'noopener noreferrer' : undefined}>
              <img src={d.image} alt={d.title} loading="lazy" />
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .news {
    background: #dce8eb;
    padding-block: 30px 40px;
    font-family: var(--font-body);
  }

  .news__layout {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 30px;
    max-width: 1170px;
    padding-inline: 15px;
  }

  .news__list h2,
  .news__doc h2 {
    margin: 40px 0 10px;
    font-size: 16px;
    line-height: 26px;
    text-transform: uppercase;
    color: #da9700;
  }

  .news__list ul {
    max-width: 302px;
  }

  .news__list li {
    display: flex;
    gap: 12px;
    margin-bottom: 25px;
    padding: 5px;
    background: #fff;
    color: #000;
  }

  .news__list li > div {
    flex: 1;
  }

  .news__list img {
    width: 98px;
    height: 76px;
    object-fit: cover;
    flex: none;
  }

  .news__list h3 {
    margin-top: 10px;
    font-size: 13px;
    line-height: 16px;
    font-weight: 400;
  }

  .news__date {
    display: block;
    margin: 14px 0 6px;
    font-size: 12px;
    color: #da9700;
  }

  .news__list li a {
    font-size: 13px;
    color: #3d7ab5;
  }

  .news__all {
    display: block;
    max-width: 302px;
    padding: 6px 5px;
    background: #fff;
    text-align: right;
    font-size: 13px;
    color: #3d7ab5;
  }

  .news__doc img {
    max-width: 190px;
    height: auto;
  }

  .news__stack .news__doc img {
    max-width: 80px;
  }

  @media (max-width: 800px) {
    .news__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
