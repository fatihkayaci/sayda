---
import Icon from '../Icon.astro';
import news from '../../data/haberler.json';
import site from '../../data/site.json';
import { variant } from '../../utils/image';

// Each card shows the news item's own photo (all have a -640 copy).
const items = [...news].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);

const docs = [
  { title: 'Sertifikalarımız', href: site.documents.certificate, image: '/img/belgeler/iso-9001.webp', external: true },
  { title: 'Tanıtım Kataloğu', href: site.documents.catalog, image: '/img/belgeler/katalog-kapak.webp', external: true },
  { title: 'İş Bitirme Belgelerimiz', href: '/projeler/is-bitirme-belgeleri', image: '/img/is-bitirme/is-bitirme-01.webp', external: false },
];

const fmt = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  const months = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
  return `${d} ${months[m - 1]} ${y}`;
};
---

<section class="news">
  <div class="container news__layout">
    <div>
      <div class="news__head news__head--main">
        <div>
          <span class="eyebrow"><i></i>Güncel</span>
          <h2 data-words>Bizden Haberler</h2>
        </div>
        <a href="/haberler">Tüm Haberler <Icon name="arrow" size={14} /></a>
      </div>
      <div class="news__grid">
        {
          items.map((n) => (
            <a href={`/haberler/${n.slug}`} class="news__card">
              <img src={variant(n.image, 640)} alt="" width="640" height="480" loading="lazy" />
              <div>
                <time>{fmt(n.date)}</time>
                <h3>{n.title}</h3>
                <span class="news__more">
                  Devamını Oku <Icon name="arrow" size={13} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
    <aside class="certs">
      <div class="news__head news__head--main">
        <div>
          <span class="eyebrow"><i></i>Sertifika ve Katalog</span>
          <h2 data-words>Sertifikalarımız</h2>
        </div>
        <a href="/sertifikalar">Tümü <Icon name="arrow" size={14} /></a>
      </div>
      <div class="certs__body">
        <div class="certs__card">
          <img src="/img/belgeler/iso-9001-360.webp" alt="Sertifika" width="240" height="300" loading="lazy" />
          <p>Kalite ve güven standartlarımızı belgeleyen sertifikalarımız.</p>
        </div>
        <ul class="certs__docs">
          {
            docs.map((d) => (
              <li>
                <a href={d.href} {...(d.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                  <img class="certs__thumb" src={variant(d.image, 240)} alt="" loading="lazy" />
                  <span>{d.title}</span>
                  <Icon name="arrow" size={13} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .news {
    padding-block: 72px;
    background: var(--color-bg-light);
  }

  .news__layout {
    display: grid;
    grid-template-columns: 2.2fr 1fr;
    grid-template-rows: auto 1fr;
    column-gap: var(--space-l);
  }

  /* both columns share the heading row and the content row so they line up */
  .news__layout > * {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
  }

  .news__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: 18px;
  }

  .news__head h2 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-navy-deep);
  }

  .news__head--main {
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .news__head--main h2 {
    margin-top: 12px;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(2rem, 2.6vw + 1rem, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .news__head > a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
    white-space: nowrap;
  }

  .news__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 16px;
  }

  .news__card {
    display: flex;
    flex-direction: column;
    background: #fff;
    box-shadow: 0 4px 16px rgba(20, 27, 46, 0.06);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .news__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(20, 27, 46, 0.12);
  }

  .news__card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .news__card > div {
    padding: 14px 16px 18px;
  }

  /* first story is the lead, the rest are compact rows */
  .news__card:nth-child(1) {
    grid-row: 1 / 3;
  }

  .news__card:nth-child(1) img {
    flex: 1;
    min-height: 0;
    aspect-ratio: auto;
  }

  .news__card:nth-child(1) h3 {
    font-size: 1.25rem;
  }

  .news__card:nth-child(n + 2) {
    flex-direction: row;
  }

  .news__card:nth-child(n + 2) img {
    flex: none;
    width: 42%;
    aspect-ratio: auto;
    height: 100%;
  }

  .news__card:nth-child(n + 2) > div {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .news time {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-orange-text);
  }

  .news h3 {
    margin-block: 8px 12px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-navy-deep);
  }

  .news__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-navy);
  }

  .certs__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .certs__card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 16px;
    background: #fff;
    box-shadow: 0 4px 16px rgba(20, 27, 46, 0.06);
  }

  .certs__card img {
    flex: none;
    width: 100px;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .certs__card p {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-navy-deep);
  }

  .certs__docs {
    flex: 1;
    display: grid;
    grid-auto-rows: 1fr;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .certs__docs a {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px 8px 10px;
    background: #fff;
    border-left: 3px solid var(--color-orange);
    box-shadow: 0 4px 16px rgba(20, 27, 46, 0.06);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy-deep);
    transition: transform var(--transition);
  }

  .certs__docs a:hover {
    transform: translateX(3px);
  }

  .certs__docs a > span:nth-child(2) {
    flex: 1;
  }

  .certs__thumb {
    flex: none;
    align-self: stretch;
    width: 64px;
    height: auto;
    min-height: 72px;
    object-fit: cover;
    border: 1px solid #d9e0e5;
  }

  @media (max-width: 1100px) {
    .news__layout {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: var(--space-l);
    }

    .news__layout > * {
      display: block;
      grid-row: auto;
    }
  }

  @media (max-width: 700px) {
    .news__grid {
      grid-template-columns: 1fr;
    }

    .news__card:nth-child(1) {
      grid-row: auto;
    }

    .news__card:nth-child(1) img {
      aspect-ratio: 16 / 10;
    }

    .news__card:nth-child(n + 2) img {
      width: 38%;
      min-height: 110px;
    }
  }
</style>
