---
import site from '../../data/site.json';

const cards = [
  {
    title: 'Sertifikalarımız',
    description: 'ISO 9001, ISO 14001, ISO 10002 kalite belgelerimizi inceleyin.',
    cta: 'İNCELE →',
    href: '/belgeler',
  },
  {
    title: 'Tanıtım Kataloğu',
    description: 'Tüm proje ve hizmetlerimizi içeren detaylı PDF katalog.',
    cta: 'PDF İNDİR ↓',
    href: site.documents.catalog,
  },
  {
    title: 'İş Bitirme Belgeleri',
    description: `${site.completionCertificatesCount} adet iş bitirme belgemize ait bilgiler ve belgeler.`,
    cta: 'GÖRÜNTÜLE →',
    href: '/belgeler',
  },
];
---

<section class="doc" id="belgeler">
  <div class="container doc__wrap reveal">
    <div class="eyebrow eyebrow--light">Hızlı Erişim</div>
    <h2 class="h2 doc__title">Belge &amp; dokümanlar</h2>

    <div class="doc__grid">
      {
        cards.map((card) => (
          <a
            class="doc__card"
            href={card.href}
            target={card.href.endsWith('.pdf') ? '_blank' : undefined}
            rel={card.href.endsWith('.pdf') ? 'noopener noreferrer' : undefined}
          >
            <h3>{card.title}</h3>
            <p>{card.description}</p>
            <span>{card.cta}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .doc {
    background: var(--color-navy);
    color: #fff;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .eyebrow--light {
    color: var(--color-on-dark-muted);
  }

  .h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 1.05;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .doc__wrap {
    padding-top: 130px;
    padding-bottom: 110px;
  }

  .doc__title {
    font-size: 40px;
    margin-bottom: 48px;
  }

  .doc__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }

  .doc__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 36px;
    background: var(--color-navy-dark);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
    transition:
      border-color 0.3s,
      background 0.3s;
  }

  .doc__card:hover {
    border-color: var(--color-on-dark-muted);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .doc__card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    font-stretch: 108%;
  }

  .doc__card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
  }

  .doc__card span {
    margin-top: 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-on-dark-muted);
  }

  @media (max-width: 760px) {
    .doc__wrap {
      padding-top: 80px;
      padding-bottom: 72px;
    }

    .doc__title {
      font-size: 32px;
    }
  }
</style>
