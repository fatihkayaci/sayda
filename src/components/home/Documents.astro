---
import Icon from '../Icon.astro';
import site from '../../data/site.json';

const cards = [
  {
    icon: 'check',
    title: 'Sertifikalarımız',
    description: 'ISO 9001, ISO 14001, ISO 10002 kalite belgelerimizi inceleyin.',
    cta: 'İNCELE →',
    href: '/belgeler',
  },
  {
    icon: 'document',
    title: 'Tanıtım Kataloğu',
    description: 'Tüm proje ve hizmetlerimizi içeren detaylı PDF katalog.',
    cta: 'PDF İNDİR ↓',
    href: site.documents.catalog,
  },
  {
    icon: 'check',
    title: 'İş Bitirme Belgeleri',
    description: `${site.completionCertificatesCount} adet iş bitirme belgemize ait bilgiler ve belgeler.`,
    cta: 'GÖRÜNTÜLE →',
    href: '/belgeler',
  },
];
---

<section class="documents" id="belgeler">
  <div class="container reveal">
    <div class="documents__eyebrow">
      <span class="documents__eyebrow-bar"></span>
      <span>HIZLI ERİŞİM</span>
    </div>
    <h2>Belge &amp; Dökümanlar</h2>

    <div class="documents__grid">
      {
        cards.map((card) => (
          <a
            class="documents__card"
            href={card.href}
            target={card.href.endsWith('.pdf') ? '_blank' : undefined}
            rel={card.href.endsWith('.pdf') ? 'noopener noreferrer' : undefined}
          >
            <Icon name={card.icon} size={28} />
            <h3>{card.title}</h3>
            <p>{card.description}</p>
            <span class="documents__cta">{card.cta}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .documents {
    padding-block: 96px;
    background: var(--color-bg);
  }

  .documents__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .documents__eyebrow-bar {
    display: block;
    width: 44px;
    height: 3px;
    background: var(--color-navy);
  }

  .documents__eyebrow span:last-child {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--color-navy);
  }

  .documents h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(26px, 3vw, 38px);
    color: var(--color-text);
    margin-bottom: 48px;
  }

  .documents__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .documents__card {
    padding: 36px 32px;
    border-radius: 6px;
    border: 1px solid rgba(43, 46, 131, 0.14);
    display: grid;
    gap: 16px;
    color: var(--color-text);
    transition:
      border-color 200ms,
      box-shadow 200ms,
      transform 200ms;
  }

  .documents__card:hover {
    border-color: var(--color-navy);
    box-shadow: 0 16px 40px rgba(43, 46, 131, 0.12);
    transform: translateY(-4px);
  }

  .documents__card :global(svg) {
    color: var(--color-navy);
  }

  .documents__card h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text);
  }

  .documents__card p {
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--color-text-faint);
  }

  .documents__cta {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-navy);
  }

  @media (max-width: 1024px) {
    .documents__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 700px) {
    .documents__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
