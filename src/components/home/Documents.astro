---
import Icon from '../Icon.astro';
import site from '../../data/site.json';

const documents = [
  {
    title: 'Şirket Kataloğu',
    description: 'Tamamlanan projeler ve hizmet kapsamımızın özeti.',
    href: site.documents.catalog,
  },
  {
    title: 'İş Bitirme Sertifikaları',
    description: 'Resmi iş bitirme belgeleri.',
    href: site.documents.certificate,
  },
];
---

<section class="documents">
  <div class="container">
    <div class="documents__header">
      <h2>Belge &amp; Dökümanlar</h2>
      <a class="documents__all" href="/belgeler">Tüm belgeler</a>
    </div>

    <div class="documents__grid">
      {
        documents.map((doc) => (
          <a class="document-card" href={doc.href} target="_blank" rel="noopener noreferrer">
            <span class="document-card__icon">
              <Icon name="document" size={24} />
            </span>
            <div>
              <h3>{doc.title}</h3>
              <p>{doc.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .documents {
    padding-block: var(--space-xl);
    background: var(--color-bg-light);
  }

  .documents__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-l);
  }

  .documents__header h2 {
    font-size: var(--fs-h2);
  }

  .documents__all {
    font-weight: 700;
    font-size: var(--fs-small);
    color: var(--color-navy);
    white-space: nowrap;
  }

  .documents__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }

  .document-card {
    display: flex;
    gap: var(--space-s);
    padding: var(--space-m);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .document-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .document-card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: var(--color-bg-light);
    color: var(--color-navy);
  }

  .document-card h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.0625rem;
  }

  .document-card p {
    margin-top: 4px;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .documents__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
