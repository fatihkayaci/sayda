---
import Icon from '../Icon.astro';
import site from '../../data/site.json';

const cards = [
  {
    image: '/img/home/belge1.webp',
    title: 'Sertifikalarımız',
    description: `${site.certifications.map((c) => c.name).join(', ')} kalite yönetim belgelerimizi inceleyebilirsiniz.`,
    cta: 'Sertifikaları Gör',
    href: '/belgeler',
  },
  {
    image: '/img/home/belge2.webp',
    title: 'Tanıtım Katalog',
    description: 'Kurumsal tanıtım kataloğumuzu indirerek projelerimiz ve hizmetlerimiz hakkında detaylı bilgi alabilirsiniz.',
    cta: 'Kataloğu İndir',
    href: site.documents.catalog,
  },
  {
    image: '/img/home/belge3.webp',
    title: 'İş Bitirme Belgelerimiz',
    description: `Tamamlanan projelerimize ait ${site.completionCertificatesCount} adet iş bitirme belgemizi görüntüleyebilirsiniz.`,
    cta: 'Belgeleri Gör',
    href: '/belgeler',
  },
];
---

<section class="doc">
  <div class="container">
    <div class="doc__head">
      <span class="doc__eyebrow">Kurumsal Dokümanlar</span>
      <h2>Belgelerimiz</h2>
    </div>
    <div class="doc__grid">
      {
        cards.map((c) => (
          <a
            href={c.href}
            class="doc__card"
            target={c.href.endsWith('.pdf') ? '_blank' : undefined}
            rel={c.href.endsWith('.pdf') ? 'noopener noreferrer' : undefined}
          >
            <img class="doc__thumb" src={c.image} alt={c.title} loading="lazy" />
            <div class="doc__text">
              <h3>{c.title}</h3>
              <p>{c.description}</p>
              <span class="doc__cta">
                {c.cta} <Icon name="arrow" size={13} />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .doc {
    padding-block: 40px 56px;
    background: #eef3fa;
  }

  .doc__head {
    margin-bottom: 22px;
  }

  .doc__eyebrow {
    display: block;
    margin-bottom: 4px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3a4a7a;
  }

  .doc__head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.7rem;
    line-height: 1.15;
    color: var(--color-navy);
  }

  .doc__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .doc__card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 14px 18px 14px 14px;
    background: #fff;
    border: 1px solid #e6eaf2;
    box-shadow: 0 4px 16px rgba(20, 27, 46, 0.06);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .doc__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(20, 27, 46, 0.12);
  }

  .doc__thumb {
    flex: none;
    width: 120px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .doc__text h3 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .doc__text p {
    margin-block: 6px 12px;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .doc__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  @media (max-width: 1024px) {
    .doc__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .doc__head h2 {
      font-size: 1.4rem;
    }

    .doc__thumb {
      width: 92px;
    }
  }
</style>
