---
import Icon from '../Icon.astro';
import site from '../../data/site.json';
---

<section class="cta-band">
  <div class="container cta-band__inner">
    <p class="cta-band__text">Kentsel dönüşüm, kat karşılığı inşaat veya müteahhitlik ihtiyacınızı anlatın, size dönelim.</p>
    <div class="cta-band__actions">
      <a class="cta-band__phone" href={site.phoneHref}>
        <Icon name="phone" size={20} />
        {site.phone}
      </a>
      <a class="button button--primary" href="/iletisim#quote-form">Teklif Alın</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--space-block-sm);
  }

  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-m);
  }

  .cta-band__text {
    font-size: 1.0625rem;
    max-width: 48ch;
  }

  .cta-band__actions {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }

  .cta-band__phone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--color-navy);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .cta-band__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .cta-band__actions {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
