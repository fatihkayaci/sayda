---
import Icon from '../Icon.astro';
import site from '../../data/site.json';

// Videos from the company's YouTube channel; the player iframe is only created on click.
const videos = [
  { id: 'psFESHJLIF0', title: 'Gaziantep Şehir Hastanesi' },
  { id: 'C0xP_C6Ryww', title: 'Capital Tower' },
  { id: '2YJHZTCjf3U', title: 'Atlas Park AVM' },
  { id: 'ipKgWjCjOjU', title: 'Referans Güneşli Projesi' },
];
const [first] = videos;
---

<!-- data-no-reveal: thumbnails and poster show straight away (no scroll wipe), they are small. -->
<section class="vid" data-videos data-no-reveal>
  <div class="container">
    <div class="vid__head">
      <div>
        <span class="eyebrow"><i></i>Sahadan</span>
        <h2 data-words>Proje Videolarımız</h2>
      </div>
      <a href={site.social.youtube} target="_blank" rel="noopener noreferrer">
        Tüm Videolar <Icon name="arrow" size={14} />
      </a>
    </div>
    <div class="vid__grid">
      <div class="vid__player" data-player>
        <button type="button" class="vid__cover" data-play aria-label={`${first.title} videosunu oynat`}>
          <img src={`/img/videos/${first.id}.webp`} alt="" data-cover-img />
          <span class="vid__play" aria-hidden="true"></span>
          <span class="vid__title" data-cover-title>{first.title}</span>
        </button>
      </div>

      <ol class="vid__list">
        {
          videos.map((v, i) => (
            <li>
              <button
                type="button"
                class:list={['vid__item', { 'is-active': i === 0 }]}
                data-video={v.id}
                data-title={v.title}
              >
                <span class="vid__thumb">
                  <img src={`/img/videos/${v.id}.webp`} alt="" />
                </span>
                <span class="vid__name">{v.title}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  function initVideos() {
    document.querySelectorAll<HTMLElement>('[data-videos]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const player = root.querySelector<HTMLElement>('[data-player]')!;
      const cover = player.innerHTML;
      const items = [...root.querySelectorAll<HTMLButtonElement>('[data-video]')];
      let current = items[0];

      const play = (item: HTMLButtonElement) => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${item.dataset.video}?autoplay=1&rel=0`;
        iframe.title = item.dataset.title ?? '';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        player.replaceChildren(iframe);
      };

      player.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('[data-play]')) play(current);
      });

      items.forEach((item) => {
        item.addEventListener('click', () => {
          current = item;
          items.forEach((it) => it.classList.toggle('is-active', it === item));
          player.innerHTML = cover;
          play(item);
        });
      });
    });
  }

  initVideos();
  document.addEventListener('astro:page-load', initVideos);
</script>

<style>
  .vid {
    padding-block: 72px;
    background: #fff;
  }

  .vid__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .vid__head h2 {
    margin-top: 12px;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(2rem, 2.6vw + 1rem, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-navy-deep);
  }

  .vid__head a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
    white-space: nowrap;
  }

  .vid__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  /* Player */
  .vid__player {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-navy-deep);
  }

  .vid__player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .vid__cover {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .vid__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity var(--transition);
  }

  .vid__cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(28, 29, 46, 0) 50%, rgba(28, 29, 46, 0.85) 100%);
  }

  .vid__cover:hover img {
    opacity: 1;
  }

  .vid__title {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 20px;
    z-index: 1;
    font-size: 1.25rem;
    font-weight: 800;
    text-align: left;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  .vid__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 76px;
    height: 76px;
    transform: translate(-50%, -50%);
    border: 2px solid #fff;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    transition:
      background var(--transition),
      border-color var(--transition);
  }

  .vid__play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-40%, -50%);
    border-left: 18px solid #fff;
    border-top: 11px solid transparent;
    border-bottom: 11px solid transparent;
  }

  .vid__cover:hover .vid__play {
    border-color: var(--color-orange);
    background: var(--color-orange);
  }

  /* Playlist */
  /* the player's 16:9 sets the row height; the list just fills it */
  .vid__list {
    display: grid;
    grid-template-rows: repeat(4, minmax(0, 1fr));
    gap: 10px;
    height: 0;
    min-height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vid__item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    padding: 8px;
    border: 1px solid var(--color-border);
    background: #fff;
    text-align: left;
    cursor: pointer;
    transition:
      background var(--transition),
      border-color var(--transition);
  }

  .vid__item:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-light);
  }

  .vid__item.is-active {
    border-color: var(--color-navy-deep);
    background: var(--color-navy-deep);
  }

  .vid__thumb {
    position: relative;
    display: block;
    height: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-navy-deep);
  }

  .vid__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vid__name {
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--color-navy-deep);
  }

  .vid__item.is-active .vid__name {
    color: #fff;
  }

  @media (max-width: 900px) {
    .vid__grid {
      grid-template-columns: 1fr;
    }

    .vid__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      height: auto;
    }

    .vid__item {
      grid-template-columns: minmax(0, 46%) 1fr;
    }

    .vid__thumb {
      height: auto;
    }
  }

  @media (max-width: 480px) {
    .vid__item {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .vid__name {
      font-size: 0.75rem;
    }

    .vid__play {
      width: 56px;
      height: 56px;
    }

    .vid__title {
      font-size: 1rem;
      left: 16px;
      bottom: 14px;
    }
  }
</style>
