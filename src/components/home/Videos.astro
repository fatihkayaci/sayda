---
import Icon from '../Icon.astro';

// Placeholder: gerçek video (YouTube) verisi eklenince `id` alanı doldurulup linke çevrilebilir.
const videos = [
  { title: 'Gaziantep Şehir Hastanesi', image: '/img/home/hospital.webp' },
  { title: 'Capital Tower', image: '/img/home/twin-towers.webp' },
  { title: 'Atlas Park AVM', image: '/img/home/mall.webp' },
  { title: 'Referans Güneşli Projesi', image: '/img/home/site-team.webp' },
];
---

<section class="vid">
  <div class="container">
    <div class="vid__head">
      <h2>Proje Videolarımız</h2>
      <a href="/projeler">Tüm Videolar <Icon name="arrow" size={14} /></a>
    </div>
    <div class="vid__grid">
      {
        videos.map((v) => (
          <div class="vid__card">
            <img src={v.image} alt="" loading="lazy" />
            <h3>{v.title}</h3>
            <span class="vid__play" aria-hidden="true"></span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .vid {
    padding-block: 72px;
    background: #fff;
  }

  .vid__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: 18px;
  }

  .vid__head h2 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    color: #141b2e;
  }

  .vid__head a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-navy);
    white-space: nowrap;
  }

  .vid__grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: repeat(3, 1fr);
    gap: 16px;
  }

  .vid__card {
    position: relative;
    overflow: hidden;
    background: #141a27;
  }

  .vid__card:nth-child(1) {
    grid-row: 1 / 4;
    min-height: 400px;
  }

  .vid__card:nth-child(1) h3 {
    font-size: 1.1rem;
    bottom: 18px;
    left: 20px;
  }

  .vid__card:nth-child(1) .vid__play {
    top: 50%;
    width: 72px;
    height: 72px;
  }

  .vid__card:nth-child(n + 2) .vid__play {
    top: 50%;
    width: 36px;
    height: 36px;
    border-width: 1.5px;
  }

  .vid__card:nth-child(n + 2) .vid__play::after {
    border-left-width: 9px;
    border-top-width: 6px;
    border-bottom-width: 6px;
  }

  .vid__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
  }

  .vid__card h3 {
    position: absolute;
    bottom: 10px;
    left: 12px;
    right: 12px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #fff;
    z-index: 1;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  .vid__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 14, 28, 0) 50%, rgba(10, 14, 28, 0.8) 100%);
  }

  .vid__play {
    z-index: 1;
    position: absolute;
    top: 45%;
    left: 50%;
    width: 48px;
    height: 48px;
    transform: translate(-50%, -50%);
    border: 2px solid #fff;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
  }

  .vid__play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-40%, -50%);
    border-left: 13px solid #fff;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
  }

  @media (max-width: 800px) {
    .vid__grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: none;
      gap: 10px;
    }

    .vid__card:nth-child(1) {
      grid-column: 1 / 4;
      grid-row: auto;
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .vid__card:nth-child(n + 2) {
      aspect-ratio: 4 / 3;
    }

    .vid__card:nth-child(n + 2) h3 {
      bottom: 6px;
      left: 8px;
      right: 8px;
      font-size: 0.6rem;
      line-height: 1.2;
    }

    .vid__card:nth-child(n + 2) .vid__play {
      width: 28px;
      height: 28px;
    }

    .vid__card:nth-child(n + 2) .vid__play::after {
      border-left-width: 7px;
      border-top-width: 5px;
      border-bottom-width: 5px;
    }
  }
</style>
