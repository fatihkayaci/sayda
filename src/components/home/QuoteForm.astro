---
import Icon from '../Icon.astro';
import services from '../../data/services.json';
import site from '../../data/site.json';

interface Props {
  id?: string;
}

const { id = 'quote-form' } = Astro.props;
---

<section class="quote-form" id={id}>
  <div class="container">
  <div class="quote-form__card reveal">
    <div class="quote-form__intro">
      <div class="quote-form__eyebrow">
        <span class="quote-form__eyebrow-bar"></span>
        <span>TEKLİF ALIN</span>
      </div>
      <h2>Projenizi Birlikte Hayata Geçirelim</h2>
      <p>Formu doldurun, uzman ekibimiz en kısa sürede sizinle iletişime geçsin.</p>
      <ul class="quote-form__contact">
        <li>
          <a href={site.phoneHref}>
            <span class="quote-form__contact-icon"><Icon name="phone" size={17} /></span>
            {site.phone}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`}>
            <span class="quote-form__contact-icon"><Icon name="mail" size={17} /></span>
            {site.email}
          </a>
        </li>
        <li class="quote-form__contact-address">
          <span class="quote-form__contact-icon"><Icon name="pin" size={17} /></span>
          <span>{site.address.street}<br />{site.address.neighborhood} / {site.address.city}</span>
        </li>
      </ul>
    </div>

    <form class="quote-form__form" id="quoteForm">
      <input type="hidden" name="access_key" value={site.web3formsAccessKey} />
      <input type="checkbox" name="botcheck" class="quote-form__honeypot" tabindex="-1" autocomplete="off" />

      <div class="quote-form__row">
        <label>
          <span>Ad Soyad</span>
          <input type="text" name="name" required />
        </label>
        <label>
          <span>Telefon</span>
          <input type="tel" name="phone" required />
        </label>
      </div>

      <label>
        <span>E-posta</span>
        <input type="email" name="email" required />
      </label>

      <label>
        <span>İlgilendiğiniz Hizmet</span>
        <select name="service">
          {services.map((service) => <option value={service.title}>{service.title}</option>)}
          <option value="Diğer">Diğer</option>
        </select>
      </label>

      <label>
        <span>Mesajınız</span>
        <textarea name="message" rows="4"></textarea>
      </label>

      <label class="quote-form__consent">
        <input type="checkbox" name="kvkk" required />
        <span>
          <a href="/kvkk-aydinlatma-metni" target="_blank" rel="noopener noreferrer">KVKK Aydınlatma Metni</a>'ni okudum, kişisel
          verilerimin işlenmesini kabul ediyorum.
        </span>
      </label>

      <button type="submit" class="button button--primary">Gönder</button>

      <p class="quote-form__status" id="quoteStatus" role="status" aria-live="polite"></p>
    </form>
  </div>
  </div>
</section>

<style>
  .quote-form {
    padding-block: 96px;
    background: var(--color-bg-light);
  }

  .quote-form__card {
    max-width: 1100px;
    margin-inline: auto;
    background: var(--color-bg);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(43, 46, 131, 0.1);
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
  }

  .quote-form__intro {
    background: var(--color-navy);
    padding: 56px 48px;
    display: grid;
    gap: 28px;
    align-content: center;
    color: #fff;
  }

  .quote-form__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .quote-form__eyebrow-bar {
    display: block;
    width: 44px;
    height: 3px;
    background: rgba(255, 255, 255, 0.5);
  }

  .quote-form__eyebrow span:last-child {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.6);
  }

  .quote-form__intro h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.2;
    color: #fff;
  }

  .quote-form__intro p {
    font-size: 15px;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.75);
  }

  .quote-form__contact {
    display: grid;
    gap: 18px;
    margin-top: 8px;
  }

  .quote-form__contact a,
  .quote-form__contact-address {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
  }

  .quote-form__contact-address {
    align-items: flex-start;
    color: rgba(255, 255, 255, 0.75);
  }

  .quote-form__contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    flex-shrink: 0;
  }

  .quote-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: 52px 48px;
  }

  .quote-form__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-m);
  }

  .quote-form__form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .quote-form__form input:not([type='checkbox']),
  .quote-form__form select,
  .quote-form__form textarea {
    font: inherit;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .quote-form__form input:focus,
  .quote-form__form select:focus,
  .quote-form__form textarea:focus {
    outline: 2px solid var(--color-navy);
    outline-offset: 1px;
  }

  .quote-form__consent {
    flex-direction: row;
    align-items: flex-start;
    gap: 10px;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .quote-form__consent input {
    margin-top: 3px;
  }

  .quote-form__consent a {
    font-weight: 700;
    color: var(--color-navy);
  }

  .quote-form__honeypot {
    display: none;
  }

  .quote-form__form button {
    align-self: flex-start;
    border: none;
  }

  .quote-form__status {
    font-size: var(--fs-small);
    font-weight: 600;
    min-height: 1em;
  }

  .quote-form__status[data-state='success'] {
    color: #1b7f3a;
  }

  .quote-form__status[data-state='error'] {
    color: #b3261e;
  }

  @media (max-width: 1024px) {
    .quote-form__card {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .quote-form__intro,
    .quote-form__form {
      padding: var(--space-l) var(--edge-mobile);
    }
  }

  @media (max-width: 640px) {
    .quote-form__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const form = document.getElementById('quoteForm') as HTMLFormElement | null;
  const status = document.getElementById('quoteStatus');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    const accessKey = (form.elements.namedItem('access_key') as HTMLInputElement)?.value;
    if (!accessKey) {
      status.textContent = 'Form şu an gönderime kapalı, lütfen telefonla ulaşın.';
      status.setAttribute('data-state', 'error');
      return;
    }

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitButton.disabled = true;
    status.textContent = 'Gönderiliyor...';
    status.removeAttribute('data-state');

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await res.json();

      if (result.success) {
        status.textContent = 'Teşekkürler, talebiniz alındı. En kısa sürede dönüş yapacağız.';
        status.setAttribute('data-state', 'success');
        form.reset();
      } else {
        throw new Error(result.message ?? 'Unknown error');
      }
    } catch {
      status.textContent = 'Gönderilemedi, lütfen telefonla ulaşın.';
      status.setAttribute('data-state', 'error');
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
