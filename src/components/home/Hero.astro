---
import site from '../../data/site.json';

const tags = ['Güvenilir Takvim, Adil Fiyat', 'Profesyonel Çözümler', 'Yüksek Kalitede Uygulamalar', 'Kentsel Dönüşüm Çözümleri'];
const interval = 6;
---

<section class="hero" data-interval={interval * 1000} style={`--dur:${interval}s`}>
  <div class="hero__media">
    <img
      class="hero__image is-on"
      src="/img/sayda-insaat-hero01.webp"
      alt="Sayda İnşaat şantiye görünümü"
      fetchpriority="high"
    />
    <img class="hero__image" src="/img/sayda-insaat-hero02.webp" alt="" />
    <img class="hero__image" src="/img/sayda-insaat-hero03.webp" alt="" />
    <img class="hero__image" src="/img/sayda-insaat-hero04.webp" alt="" />
  </div>
  <div class="hero__shade"></div>

  <div class="container hero__content">
    <div class="hero__eyebrow"><span></span>{site.foundedYear}'dan bu yana · İstanbul</div>
    <h1 class="sr-only">Sayda İnşaat</h1>
    <div class="hero__tags" aria-live="polite">
      {
        tags.map((tag, i) => (
          <div class:list={['hero__tag', { 'is-on': i === 0 }]}>
            <i></i>
            <span>{tag}</span>
          </div>
        ))
      }
    </div>
    <p class="hero__lead">
      {site.foundedYear}'dan bu yana İstanbul'da kentsel dönüşüm, kat karşılığı inşaat ve anahtar teslim
      müteahhitlik hizmeti veriyoruz.
    </p>
    <div class="hero__ctas">
      <a href="/projeler" class="btn btn--primary">Projelerimiz <span>→</span></a>
      <a href="/iletisim#quote-form" class="btn btn--outline">Teklif Alın</a>
    </div>
  </div>

  <div class="hero__tabs">
    <div class="container hero__tabs-grid">
      {
        tags.map((tag, i) => (
          <button type="button" class:list={['hero__tab', { 'is-on': i === 0 }]} data-i={i}>
            <b></b>
            <small>0{i + 1}</small>
            <span>{tag}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  const heroTimers = new WeakMap<HTMLElement, number>();

  function initHero() {
    document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
      const dur = Number(hero.dataset.interval) || 6000;
      const groups = ['.hero__tag', '.hero__tab'].map((selector) => [...hero.querySelectorAll(selector)]);
      const images = [...hero.querySelectorAll<HTMLElement>('.hero__image')];
      let current = 0;

      const go = (n: number) => {
        groups.forEach((group) =>
          group.forEach((el, i) => {
            el.classList.toggle('is-on', i === n);
            el.classList.toggle('is-past', i < n);
          })
        );
        images.forEach((img, i) => img.classList.toggle('is-on', i === n % images.length));
        current = n;
        const prevTimer = heroTimers.get(hero);
        if (prevTimer) clearTimeout(prevTimer);
        heroTimers.set(
          hero,
          window.setTimeout(() => go((current + 1) % groups[0].length), dur)
        );
      };

      groups[1].forEach((btn, i) => btn.addEventListener('click', () => go(i)));

      // The first tag/tab render with `is-on` already applied server-side, so the
      // underline-fill transition has no "from" state to animate on load. Strip it,
      // force a reflow, then re-apply via go(0) so the first fill animates too.
      groups.forEach((group) => group.forEach((el) => el.classList.remove('is-on', 'is-past')));
      void hero.offsetWidth;
      go(0);
    });
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  .hero {
    position: relative;
    height: calc(100vh - var(--header-h));
    min-height: 660px;
    max-height: 920px;
    overflow: hidden;
    background: #1b1b1b;
    color: #fff;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 1.2s ease,
      transform calc(var(--dur) + 1.5s) ease-out;
  }

  .hero__image.is-on {
    opacity: 1;
    transform: scale(1);
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    /* Nötr, hafif gölge: fotoğrafın kendi renkleri (kulelerin turuncusu vb.) korunur */
    background:
      radial-gradient(ellipse at 50% 45%, rgba(0, 0, 0, 0.32) 0%, rgba(0, 0, 0, 0.12) 60%, rgba(0, 0, 0, 0) 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 40%);
  }

  .hero__content {
    position: relative;
    height: 100%;
    padding-bottom: 110px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 20px;
  }

  .hero__eyebrow span {
    width: 36px;
    height: 2px;
    background: var(--color-orange);
  }

  .hero__eyebrow::after {
    content: '';
    width: 36px;
    height: 2px;
    background: var(--color-orange);
  }

  .hero__tags {
    display: grid;
    justify-items: center;
    overflow: hidden;
  }

  .hero__tag {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
    white-space: nowrap;
  }

  .hero__tag.is-past {
    transform: translateY(-24px);
  }

  .hero__tag.is-on {
    opacity: 1;
    transform: none;
  }

  .hero__tag i {
    width: 12px;
    height: 12px;
    background: var(--color-orange);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .hero__tag span {
    font-size: clamp(28px, 4.4vw, 64px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .hero__lead {
    margin: 22px auto 0;
    max-width: 620px;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    text-wrap: pretty;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 34px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 54px;
    padding: 0 28px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .btn--primary {
    background: var(--color-orange);
    color: #1a1a1a;
  }

  .btn--primary:hover {
    background: var(--color-orange-dark);
  }

  .btn--outline {
    border: 1.5px solid rgba(255, 255, 255, 0.8);
    color: #fff;
  }

  .btn--outline:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .hero__tabs {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .hero__tabs-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .hero__tab {
    position: relative;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    padding: 24px 20px 28px 0;
    color: rgba(255, 255, 255, 0.55);
    font-family: inherit;
    display: flex;
    gap: 14px;
    align-items: baseline;
    transition: color 0.4s;
  }

  .hero__tab::before {
    content: '';
    position: absolute;
    left: 0;
    right: 20px;
    top: -1px;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
  }

  .hero__tab b {
    position: absolute;
    left: 0;
    top: -1px;
    height: 2px;
    width: 0;
    max-width: calc(100% - 20px);
    background: var(--color-orange);
  }

  .hero__tab.is-on {
    color: #fff;
  }

  .hero__tab.is-on b {
    width: 100%;
    transition: width var(--dur) linear;
  }

  .hero__tab small {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .hero__tab span {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .hero__tab span {
      display: none;
    }

    .hero__content {
      padding-bottom: 110px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 600px;
    }

    .hero__lead {
      font-size: 16px;
    }

    .hero__tag {
      align-items: flex-start;
      text-align: left;
    }

    .hero__tag span {
      white-space: normal;
      line-height: 1.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__image {
      transition: opacity 1.2s ease;
      transform: none;
    }
  }
</style>
