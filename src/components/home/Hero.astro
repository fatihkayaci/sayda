---
import Icon from '../Icon.astro';
import projects from '../../data/projects.json';
import { srcset } from '../../utils/image';

interface Slide {
  image: string;
  title: string;
  /** Project slug: the slide gets a tag linking to that project's page. */
  project?: string;
  /** Short project name shown on the tag. */
  name?: string;
  /** Shown on the tag when the project has no district. */
  place?: string;
  credit?: string;
  creditHref?: string;
}

// Two kinds of photos:
// - Sayda's own slider photos from the old site (sayda.com.tr); no credit needed.
// - Photos taken from the developers' / architects' sites. Usage permission is still pending —
//   see HERO-IMAGE-LICENSES.md. Keep the credit visible.
const slideData: Slide[] = [
  {
    image: '/img/home/hero-buyukyali-tower.webp',
    title: 'Geleceği Birlikte İnşa Ediyoruz',
    project: 'buyukyali',
    name: 'Büyükyalı',
    credit: 'Görsel: Chapman Taylor',
    creditHref: 'https://www.chapmantaylor.com/projects/buyukyali',
  },
  {
    image: '/img/home/hero-referans-gunesli.webp',
    title: 'Şehre Değer Katan Yapılar',
    project: 'referans-gunesli',
    name: 'Referans Güneşli',
  },
  {
    image: '/img/home/hero-vadistanbul-bulvar.webp',
    title: 'Projeden Teslime Yanınızdayız',
    project: 'vadistanbul',
    name: 'Vadistanbul',
    credit: 'Görsel: Artaş Holding',
    creditHref: 'https://www.artasholding.com/tr-tr/proje/vadistanbul-bulvar/',
  },
  {
    image: '/img/home/hero-varyap-meridian.webp',
    title: 'Her Detayda Ustalık',
    project: 'varyap-meridien-konut',
    name: 'Varyap Meridian',
  },
  {
    image: '/img/home/hero-gaziantep-hospital.webp',
    title: 'Büyük Projelerin Güvenilir Ortağı',
    project: 'gaziantep-sehir-hastanesi',
    name: 'Gaziantep Şehir Hastanesi',
    place: 'Gaziantep',
    credit: 'Görsel: Meridiam',
    creditHref: 'https://www.meridiam.com/assets/gaziantep-hospital-turkey/',
  },
  {
    image: '/img/home/hero-terrace-bahce.webp',
    title: 'Planlandığı Gibi, Zamanında',
    project: 'terrace-bahce-konut',
    name: 'Terrace Bahçe',
  },
  {
    image: '/img/home/hero-yasmin-resort.webp',
    title: 'Profesyonel Çözümler',
    project: 'yasmin-resort-hotel',
    name: 'Yasmin Resort',
  },
  {
    image: '/img/home/hero-referans-besiktas.webp',
    title: 'Kentsel Dönüşümde Güvenilir Çözüm',
    project: 'referans-besiktas-abbasaga',
    name: 'Referans Beşiktaş',
    credit: 'Görsel: Kiler GYO',
    creditHref: 'https://www.referansbesiktas.com/',
  },
  {
    image: '/img/home/hero-referans-kartal-loca.webp',
    title: 'Sağlam Temeller, Kalıcı Değerler',
    project: 'referans-kartal-loca-2',
    name: 'Referans Kartal Loca',
    credit: 'Görsel: Kiler GYO',
    creditHref: 'https://referanskartalloca.com.tr/',
  },
];

const slides = slideData.map((slide) => {
  const project = slide.project ? projects.find((p) => p.slug === slide.project)! : undefined;
  const tag = project && {
    href: project.href,
    name: slide.name ?? project.name,
    meta: [project.type, slide.place ?? project.district].filter(Boolean).join(' · '),
    ongoing: project.status === 'devam-eden',
  };
  return { ...slide, tag };
});
---

<section class="hero" data-interval="6000">
  {
    slides.map((slide, i) => (
      // Hidden slides are inert so their links can't be tabbed to.
      <div class:list={['hero__slide', { 'is-on': i === 0 }]} inert={i !== 0}>
        {i === 0 ? (
          <img src={slide.image} srcset={srcset(slide.image, 960, 1920)} sizes="100vw" alt="" fetchpriority="high" />
        ) : (
          // Later slides wait for the page to load so they don't compete with the first image.
          <img data-src={slide.image} data-srcset={srcset(slide.image, 960, 1920)} sizes="100vw" alt="" />
        )}
        {(slide.tag || slide.credit) && (
          <div class="hero__project">
            {slide.tag && (
              <a class="hero__tag" href={slide.tag.href} aria-label={`${slide.tag.name} projesini incele`}>
                <span class="hero__tag-text">
                  <span class="hero__tag-meta">
                    {slide.tag.meta}
                    {slide.tag.ongoing && <em>Devam Ediyor</em>}
                  </span>
                  <span class="hero__tag-name">{slide.tag.name}</span>
                </span>
                <span class="hero__tag-arrow" aria-hidden="true">
                  <Icon name="arrow" size={18} />
                </span>
                <span class="hero__tag-progress" aria-hidden="true"></span>
              </a>
            )}
            {slide.credit && (
              <a class="hero__credit" href={slide.creditHref} target="_blank" rel="noopener noreferrer">
                {slide.credit}
              </a>
            )}
          </div>
        )}
      </div>
    ))
  }
  <div class="hero__shade"></div>

  <div class="container hero__content">
    {
      slides.map((slide, i) =>
        i === 0 ? (
          <h1 class="hero__title is-on">{slide.title}</h1>
        ) : (
          <p class="hero__title" aria-hidden="true">
            {slide.title}
          </p>
        )
      )
    }
  </div>

  <button class="hero__arrow hero__arrow--prev" type="button" aria-label="Önceki resim">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6" /></svg>
  </button>
  <button class="hero__arrow hero__arrow--next" type="button" aria-label="Sonraki resim">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6" /></svg>
  </button>
</section>

<script>
  const heroTimers = new WeakMap<HTMLElement, number>();

  function initHero() {
    document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
      if (hero.dataset.ready) return;
      hero.dataset.ready = 'true';

      const slides = [...hero.querySelectorAll('.hero__slide')];
      const titles = [...hero.querySelectorAll('.hero__title')];
      const dur = Number(hero.dataset.interval) || 6000;
      let current = 0;

      const show = (next: number) => {
        // Freeze the outgoing photo at its current zoom; dropping the animation would snap it to full size mid-fade.
        const leaving = slides[current].querySelector('img')!;
        leaving.style.transform = getComputedStyle(leaving).transform;
        current = (next + slides.length) % slides.length;
        // The incoming photo starts its zoom from the beginning (the animation overrides this inline value anyway).
        slides[current].querySelector('img')!.style.transform = '';
        [slides, titles].forEach((list) => list.forEach((el, i) => el.classList.toggle('is-on', i === current)));
        slides.forEach((el, i) => ((el as HTMLElement).inert = i !== current));
      };

      // Restart the timer after a manual step so the new image gets its full time.
      const start = () => {
        const prev = heroTimers.get(hero);
        if (prev) clearInterval(prev);
        heroTimers.set(hero, window.setInterval(() => show(current + 1), dur));
      };

      hero.querySelector('.hero__arrow--prev')!.addEventListener('click', () => {
        show(current - 1);
        start();
      });
      hero.querySelector('.hero__arrow--next')!.addEventListener('click', () => {
        show(current + 1);
        start();
      });
      const loadRest = () =>
        hero.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
          img.srcset = img.dataset.srcset ?? '';
          img.src = img.dataset.src ?? '';
          img.removeAttribute('data-src');
        });
      if (document.readyState === 'complete') loadRest();
      else window.addEventListener('load', loadRest, { once: true });

      // Start the first zoom (and the slide timer) when the splash is gone; the timeout is a safety net.
      const ready = () => {
        if (hero.classList.contains('is-ready')) return;
        hero.classList.add('is-ready');
        start();
      };
      if (!document.getElementById('splash') || (window as { __saydaSplashDone?: boolean }).__saydaSplashDone) ready();
      else {
        window.addEventListener('sayda:splash-done', ready, { once: true });
        setTimeout(ready, 2500);
      }
    });
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: calc(100vh - var(--header-h));
    height: calc(100svh - var(--header-h));
    min-height: 600px;
    overflow: hidden;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero__slide.is-on {
    opacity: 1;
  }

  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Slow zoom-out on the active slide. A keyframe animation (not a transition) so it also plays on the
     first slide, which is already active when the page loads; it starts once the splash has gone. */
  .hero:not(.is-ready) .hero__slide.is-on img {
    transform: scale(1.08);
  }

  .hero.is-ready .hero__slide.is-on img {
    animation: hero-zoom 7s ease-out both;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }

  .hero__slide:not(.is-on) {
    pointer-events: none;
  }

  /* Project tag in the bottom-right corner: links to the project; the photo credit sits under it */
  .hero__project {
    position: absolute;
    right: clamp(16px, 3vw, 48px);
    bottom: clamp(20px, 4vh, 40px);
    z-index: 3;
    display: grid;
    justify-items: end;
    gap: 8px;
  }

  .hero__tag {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 260px;
    padding: 14px 14px 14px 18px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-left: 3px solid var(--color-orange);
    background: rgba(28, 29, 46, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    opacity: 0;
    transform: translateX(24px);
    transition:
      opacity 600ms ease,
      transform 600ms ease,
      background var(--transition);
  }

  .hero__slide.is-on .hero__tag {
    opacity: 1;
    transform: none;
    transition-delay: 400ms, 400ms, 0ms;
  }

  .hero__tag:hover {
    background: rgba(28, 29, 46, 0.85);
  }

  .hero__tag-text {
    display: grid;
    gap: 4px;
    margin-right: auto;
  }

  .hero__tag-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .hero__tag-meta em {
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--color-orange);
    color: var(--color-navy-deep);
    font-style: normal;
    letter-spacing: 0.08em;
  }

  .hero__tag-name {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .hero__tag-arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-orange);
    color: var(--color-navy-deep);
    transition: transform var(--transition);
  }

  .hero__tag:hover .hero__tag-arrow {
    transform: translateX(4px);
  }

  /* Fills over the slide's time on screen (matches data-interval) */
  .hero__tag-progress {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-orange);
    transform: scaleX(0);
    transform-origin: left;
  }

  .hero.is-ready .hero__slide.is-on .hero__tag-progress {
    animation: hero-progress 6s linear both;
  }

  @keyframes hero-progress {
    to {
      transform: scaleX(1);
    }
  }

  .hero__credit {
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.6);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .hero__credit:hover {
    color: #fff;
  }

  /* only a soft centre glow so the slogan stays readable */
  .hero__shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 45% at 50% 50%, rgba(28, 29, 46, 0.6) 0%, rgba(28, 29, 46, 0.2) 60%, rgba(28, 29, 46, 0) 100%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    text-align: center;
  }

  /* all slogans share one cell; only the active one is visible */
  .hero__title {
    grid-area: 1 / 1;
    max-width: 16ch;
    margin: 0;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 600ms ease,
      transform 600ms ease;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(2rem, 2.6vw + 1rem, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  .hero__title.is-on {
    opacity: 1;
    transform: none;
    transition-delay: 200ms;
  }

  .hero__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    background: rgba(28, 29, 46, 0.25);
    color: #fff;
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      background var(--transition),
      border-color var(--transition),
      color var(--transition);
  }

  .hero__arrow--prev {
    left: clamp(16px, 3vw, 48px);
  }

  .hero__arrow--next {
    right: clamp(16px, 3vw, 48px);
  }

  .hero__arrow:hover {
    border-color: var(--color-orange);
    background: var(--color-orange);
    color: var(--color-navy-deep);
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 480px;
    }

    .hero__arrow {
      top: auto;
      bottom: 24px;
      width: 44px;
      height: 44px;
      transform: none;
    }

    .hero__title {
      font-stretch: 105%;
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }

    /* Between the two arrows at the bottom */
    .hero__project {
      right: 72px;
      bottom: 12px;
      left: 72px;
      justify-items: stretch;
      gap: 4px;
    }

    .hero__tag {
      min-width: 0;
      gap: 10px;
      padding: 10px 10px 10px 12px;
    }

    .hero__tag-name {
      font-size: 0.9375rem;
    }

    .hero__tag-meta {
      font-size: 0.625rem;
      letter-spacing: 0.1em;
    }

    .hero__tag-arrow {
      width: 32px;
      height: 32px;
    }

    .hero__credit {
      justify-self: center;
      font-size: 0.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide,
    .hero__slide img,
    .hero__title,
    .hero__tag {
      transition: none;
    }

    .hero.is-ready .hero__slide.is-on .hero__tag-progress {
      animation: none;
    }

    .hero__slide img,
    .hero:not(.is-ready) .hero__slide.is-on img,
    .hero.is-ready .hero__slide.is-on img {
      transform: none;
      animation: none;
    }
  }
</style>
