---
// Canlı sitedeki slider: 4 slayt, sağa hizalı düz beyaz başlık, ok/nokta yok.
// Sayfanın H1'i (SEO) "Yüksek Kalitede Uygulamalar" slaytında kalır.
const slides = [
  { image: '/img/sayda-insaat-hero01.webp', title: 'Zamanında Teslim' },
  { image: '/img/sayda-insaat-hero02.webp', title: 'Profesyonel Çözümler' },
  { image: '/img/sayda-insaat-hero03.webp', title: 'Yüksek Kalitede Uygulamalar', h1: true },
  { image: '/img/sayda-insaat-hero04.webp', title: 'Kentsel Dönüşüm Çözümleri' },
];
---

<section class="hero" data-interval="6000">
  {
    slides.map((slide, i) => (
      <div class:list={['hero__slide', { 'is-on': i === 0 }]}>
        <img src={slide.image} alt="" width="1920" height="740" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} />
        <div class="hero__caption">
          {slide.h1 ? <h1><b>{slide.title}</b></h1> : <p><b>{slide.title}</b></p>}
        </div>
      </div>
    ))
  }
</section>

<script>
  document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
    const slides = [...hero.querySelectorAll('.hero__slide')];
    const dur = Number(hero.dataset.interval) || 6000;
    let current = 0;
    window.setInterval(() => {
      slides[current].classList.remove('is-on');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-on');
    }, dur);
  });
</script>

<style>
  .hero {
    position: relative;
    aspect-ratio: 1920 / 740;
    min-height: 260px;
    background: #012c3c;
    overflow: hidden;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .hero__slide.is-on {
    opacity: 1;
  }

  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__caption {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 15px;
    text-align: center;
    pointer-events: none;
  }

  .hero__caption h1,
  .hero__caption p {
    margin: 0;
    font-size: clamp(20px, 3.4vw, 40px);
    line-height: 1.2;
    text-transform: uppercase;
    color: #fff;
  }
</style>
