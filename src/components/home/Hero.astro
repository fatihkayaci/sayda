---
import Icon from '../Icon.astro';

const slides = [
  'Güvenilir Takvim, Adil Fiyat',
  'Profesyonel Çözümler',
  'Yüksek Kalitede Uygulamalar',
  'Kentsel Dönüşüm Çözümleri',
];
const interval = 6;
---

<section class="hero" data-interval={interval * 1000} style={`--dur:${interval}s`}>
  <div class="hero__media">
    <img
      class="hero__image is-on"
      src="/img/sayda-insaat-hero01.webp"
      alt="Sayda İnşaat şantiye görünümü"
      fetchpriority="high"
    />
    <img class="hero__image" src="/img/sayda-insaat-hero02.webp" alt="" />
    <img class="hero__image" src="/img/sayda-insaat-hero03.webp" alt="" />
    <img class="hero__image" src="/img/sayda-insaat-hero04.webp" alt="" />
  </div>
  <div class="hero__shade"></div>

  <button type="button" class="hero__arrow hero__arrow--prev" aria-label="Önceki">
    <Icon name="arrowLeft" size={22} />
  </button>
  <button type="button" class="hero__arrow hero__arrow--next" aria-label="Sonraki">
    <Icon name="arrow" size={22} />
  </button>

  <div class="container hero__content">
    <h1 class="hero__title" aria-live="polite">
      {
        slides.map((slide, i) => (
          <span class:list={['hero__title-line', { 'is-on': i === 0 }]}>{slide}</span>
        ))
      }
    </h1>
  </div>
</section>

<script>
  const heroTimers = new WeakMap<HTMLElement, number>();

  function initHero() {
    document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
      const dur = Number(hero.dataset.interval) || 6000;
      const lines = [...hero.querySelectorAll<HTMLElement>('.hero__title-line')];
      const images = [...hero.querySelectorAll<HTMLElement>('.hero__image')];
      const count = lines.length;
      let current = 0;

      const render = (n: number) => {
        lines.forEach((el, i) => el.classList.toggle('is-on', i === n));
        images.forEach((img, i) => img.classList.toggle('is-on', i === n % images.length));
        current = n;
      };

      const go = (n: number, restart = true) => {
        render(((n % count) + count) % count);
        if (!restart) return;
        const prevTimer = heroTimers.get(hero);
        if (prevTimer) clearTimeout(prevTimer);
        heroTimers.set(
          hero,
          window.setTimeout(() => go(current + 1), dur)
        );
      };

      hero.querySelector('.hero__arrow--prev')?.addEventListener('click', () => go(current - 1));
      hero.querySelector('.hero__arrow--next')?.addEventListener('click', () => go(current + 1));

      go(0);
    });
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  .hero {
    position: relative;
    height: calc(100vh - var(--header-h));
    min-height: 480px;
    max-height: 760px;
    overflow: hidden;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero__image.is-on {
    opacity: 1;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(13, 21, 51, 0.55) 0%, rgba(13, 21, 51, 0.15) 55%, rgba(13, 21, 51, 0.35) 100%);
  }

  .hero__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(13, 21, 51, 0.3);
    color: #fff;
    transform: translateY(-50%);
    transition:
      background var(--transition),
      border-color var(--transition);
  }

  .hero__arrow:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .hero__arrow--prev {
    left: var(--edge-mobile);
  }

  .hero__arrow--next {
    right: var(--edge-mobile);
  }

  @media (min-width: 640px) {
    .hero__arrow--prev {
      left: var(--edge);
    }

    .hero__arrow--next {
      right: var(--edge);
    }
  }

  @media (max-width: 640px) {
    .hero__arrow {
      width: 38px;
      height: 38px;
    }
  }

  .hero__content {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hero__title {
    display: grid;
    margin: 0;
    max-width: 960px;
  }

  .hero__title-line {
    grid-area: 1 / 1;
    min-width: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(28px, 5vw, 56px);
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-wrap: balance;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease;
  }

  .hero__title-line.is-on {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__image {
      transition: opacity 1.2s ease;
    }
  }
</style>
