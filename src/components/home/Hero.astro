---
import site from '../../data/site.json';
---

<section class="hero">
  <div class="hero__media">
    <img class="hero__image" src="/img/hero.jpg" alt="Sayda İnşaat şantiye görünümü" />
  </div>
  <div class="hero__overlay"></div>
  <div class="hero__grid"></div>

  <div class="hero__inner">
    <div class="hero__eyebrow">
      <span class="hero__eyebrow-bar"></span>
      <span class="hero__eyebrow-text">{site.foundedYear}'DAN BUGÜNE</span>
    </div>
    <h1 class="hero__title">
      <span class="hero__title-line">SAYDA</span>
      <span class="hero__title-line hero__title-line--outline">İNŞAAT</span>
    </h1>
    <p class="hero__subtitle">
      {site.foundedYear}'dan bu yana İstanbul'da kentsel dönüşüm, kat karşılığı inşaat ve
      anahtar teslim müteahhitlik hizmeti veriyoruz.
    </p>
    <div class="hero__cta">
      <a class="button button--primary" href="/kentsel-donusum">Kentsel Dönüşüm</a>
      <a class="button button--secondary" href="/projeler">Projelerimiz</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 88vh;
    background: var(--color-bg-light);
    color: var(--color-text);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--color-bg-light) 0%,
      var(--color-bg-light) 12%,
      rgba(244, 245, 250, 0) 55%
    );
    pointer-events: none;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(43, 46, 131, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(43, 46, 131, 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 12%, transparent 55%);
    mask-image: linear-gradient(90deg, #000 0%, #000 12%, transparent 55%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    padding: var(--space-xxl) var(--edge) var(--space-xxl) 72px;
    max-width: 620px;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: var(--space-m);
  }

  .hero__eyebrow-bar {
    display: block;
    width: 44px;
    height: 3px;
    background: var(--color-navy);
  }

  .hero__eyebrow-text {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.28em;
    color: var(--color-navy);
  }

  .hero__title {
    font-family: var(--font-accent);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .hero__title-line {
    display: block;
    font-size: clamp(56px, 7.2vw, 108px);
    color: var(--color-navy);
  }

  .hero__title-line--outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-navy);
  }

  .hero__subtitle {
    margin-top: 36px;
    max-width: 440px;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  .hero .button {
    padding: 16px 34px;
    font-size: 15px;
    letter-spacing: 0.04em;
  }

  .hero .button--secondary {
    color: var(--color-navy);
    border: 2px solid rgba(43, 46, 131, 0.3);
  }

  .hero .button--secondary:hover {
    background: rgba(43, 46, 131, 0.06);
    border-color: var(--color-navy);
  }

  @media (max-width: 770px) {
    .hero__inner {
      padding-left: var(--edge);
    }

    .hero__overlay {
      display: none;
    }

    .hero__grid {
      display: none;
    }

    .hero .button--secondary {
      color: #fff;
      border-color: rgba(255, 255, 255, 0.7);
    }

    .hero .button--secondary:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: #fff;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 520px;
    }

    .hero__inner {
      padding-inline: var(--edge-mobile);
    }

    .hero__cta {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
