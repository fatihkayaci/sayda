---
import Icon from '../Icon.astro';
import site from '../../data/site.json';

const slides = [
  'Güvenilir Takvim, Adil Fiyat',
  'Profesyonel Çözümler',
  'Yüksek Kalitede Uygulamalar',
  'Kentsel Dönüşüm Çözümleri',
];
const interval = 6;
---

<section class="hero" data-interval={interval * 1000} style={`--dur:${interval}s`}>
  <div class="hero__media">
    <img
      class="hero__image is-on"
      src="/img/sayda-insaat-hero01.webp"
      alt="Sayda İnşaat şantiye görünümü"
      fetchpriority="high"
    />
    <img class="hero__image" src="/img/sayda-insaat-hero02.webp" alt="" />
    <img class="hero__image" src="/img/sayda-insaat-hero03.webp" alt="" />
    <img class="hero__image" src="/img/sayda-insaat-hero04.webp" alt="" />
  </div>
  <div class="hero__shade"></div>

  <button type="button" class="hero__arrow hero__arrow--prev" aria-label="Önceki">
    <Icon name="arrowLeft" size={22} />
  </button>
  <button type="button" class="hero__arrow hero__arrow--next" aria-label="Sonraki">
    <Icon name="arrow" size={22} />
  </button>

  <div class="container hero__content">
    <div class="hero__eyebrow"><span></span>{site.foundedYear}'dan bu yana · İstanbul</div>
    <h1 class="hero__title" aria-live="polite">
      {
        slides.map((slide, i) => (
          <span class:list={['hero__title-line', { 'is-on': i === 0 }]}>{slide}</span>
        ))
      }
    </h1>
    <p class="hero__lead">
      {site.foundedYear}'dan bu yana İstanbul'da kentsel dönüşüm, kat karşılığı inşaat ve anahtar teslim
      müteahhitlik hizmeti veriyoruz.
    </p>
    <div class="hero__ctas">
      <a href="/projeler" class="btn btn--primary">Projelerimiz <span>→</span></a>
      <a href="/iletisim#quote-form" class="btn btn--outline">Teklif Alın</a>
    </div>

    <div class="hero__dots" role="tablist" aria-label="Slaytlar">
      {
        slides.map((slide, i) => (
          <button
            type="button"
            class:list={['hero__dot', { 'is-on': i === 0 }]}
            data-i={i}
            aria-label={slide}
          >
            <b />
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  const heroTimers = new WeakMap<HTMLElement, number>();

  function initHero() {
    document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
      const dur = Number(hero.dataset.interval) || 6000;
      const lines = [...hero.querySelectorAll<HTMLElement>('.hero__title-line')];
      const dots = [...hero.querySelectorAll<HTMLElement>('.hero__dot')];
      const images = [...hero.querySelectorAll<HTMLElement>('.hero__image')];
      const count = lines.length;
      let current = 0;

      const render = (n: number) => {
        lines.forEach((el, i) => {
          el.classList.toggle('is-on', i === n);
          el.classList.toggle('is-past', i < n);
        });
        dots.forEach((el, i) => el.classList.toggle('is-on', i === n));
        images.forEach((img, i) => img.classList.toggle('is-on', i === n % images.length));
        current = n;
      };

      const go = (n: number, restart = true) => {
        render(((n % count) + count) % count);
        if (!restart) return;
        const prevTimer = heroTimers.get(hero);
        if (prevTimer) clearTimeout(prevTimer);
        heroTimers.set(
          hero,
          window.setTimeout(() => go(current + 1), dur)
        );
      };

      dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));
      hero.querySelector('.hero__arrow--prev')?.addEventListener('click', () => go(current - 1));
      hero.querySelector('.hero__arrow--next')?.addEventListener('click', () => go(current + 1));

      // The first line/dot render with `is-on` already applied server-side, so the
      // transition has no "from" state to animate on load. Strip it, force a
      // reflow, then re-apply via go(0) so the first fill animates too.
      lines.forEach((el) => el.classList.remove('is-on', 'is-past'));
      dots.forEach((el) => el.classList.remove('is-on'));
      void hero.offsetWidth;
      go(0);
    });
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  .hero {
    position: relative;
    height: calc(100vh - var(--header-h));
    min-height: 600px;
    max-height: 820px;
    overflow: hidden;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 1.2s ease,
      transform calc(var(--dur) + 1.5s) ease-out;
  }

  .hero__image.is-on {
    opacity: 1;
    transform: scale(1);
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(13, 21, 51, 0.86) 0%, rgba(13, 21, 51, 0.5) 52%, rgba(13, 21, 51, 0.2) 100%),
      linear-gradient(0deg, rgba(13, 21, 51, 0.55) 0%, rgba(13, 21, 51, 0) 40%);
  }

  .hero__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(13, 21, 51, 0.35);
    color: #fff;
    transform: translateY(-50%);
    transition:
      background var(--transition),
      border-color var(--transition);
  }

  .hero__arrow:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .hero__arrow--prev {
    left: var(--edge-mobile);
  }

  .hero__arrow--next {
    right: var(--edge-mobile);
  }

  @media (min-width: 640px) {
    .hero__arrow--prev {
      left: var(--edge);
    }

    .hero__arrow--next {
      right: var(--edge);
    }
  }

  @media (max-width: 640px) {
    .hero__arrow {
      width: 40px;
      height: 40px;
    }
  }

  .hero__content {
    position: relative;
    height: 100%;
    padding-bottom: 90px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
    margin-bottom: 22px;
  }

  .hero__eyebrow span {
    width: 36px;
    height: 2px;
    background: var(--color-accent);
  }

  .hero__title {
    display: grid;
    margin: 0;
    max-width: 900px;
    overflow: hidden;
  }

  .hero__title-line {
    grid-area: 1 / 1;
    min-width: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(32px, 5.6vw, 68px);
    line-height: 1.08;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    text-wrap: balance;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .hero__title-line.is-past {
    transform: translateY(-24px);
  }

  .hero__title-line.is-on {
    opacity: 1;
    transform: none;
  }

  .hero__lead {
    margin: 22px 0 0;
    max-width: 560px;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    text-wrap: pretty;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 54px;
    padding: 0 28px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .btn--primary {
    background: var(--color-accent);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--color-accent-dark);
  }

  .btn--outline {
    border: 1.5px solid var(--color-on-dark-muted);
    color: #fff;
  }

  .btn--outline:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .hero__dots {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 48px;
  }

  .hero__dot {
    position: relative;
    width: 34px;
    height: 4px;
    background: rgba(255, 255, 255, 0.28);
    border: 0;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
  }

  .hero__dot b {
    position: absolute;
    inset: 0;
    width: 0;
    background: var(--color-accent);
  }

  .hero__dot.is-on b {
    width: 100%;
    transition: width var(--dur) linear;
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 560px;
    }

    .hero__lead {
      font-size: 16px;
    }

    .hero__content {
      padding-bottom: 60px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__image {
      transition: opacity 1.2s ease;
      transform: none;
    }
  }
</style>
