---
import site from '../../data/site.json';
---

<section class="hero">
  <div class="hero__media">
    <img
      class="hero__image hero__image--1"
      src="/img/sayda-insaat-hero01.webp"
      alt="Sayda İnşaat şantiye görünümü"
      fetchpriority="high"
    />
    <img class="hero__image hero__image--2" src="/img/sayda-insaat-hero02.webp" alt="" />
    <div class="hero__overlay-diagonal"></div>
    <div class="hero__overlay-bottom"></div>
  </div>
  <div class="hero__grid"></div>

  <div class="hero__inner">
    <div class="hero__eyebrow">
      <span class="hero__eyebrow-bar"></span>
      <span class="hero__eyebrow-text">{site.foundedYear}'DAN BU YANA</span>
    </div>
    <h1 class="hero__title">
      <span class="hero__title-line">SAYDA</span>
      <span class="hero__title-line hero__title-line--outline">İNŞAAT</span>
    </h1>
    <p class="hero__subtitle">
      {site.foundedYear}'dan bu yana İstanbul'da kentsel dönüşüm, kat karşılığı inşaat ve
      anahtar teslim müteahhitlik hizmeti veriyoruz.
    </p>
    <div class="hero__cta">
      <a class="hero__btn hero__btn--primary" href="/projeler">Projelerimizi İnceleyin →</a>
      <a class="hero__btn hero__btn--outline" href="/iletisim#quote-form">Teklif Alın</a>
    </div>
  </div>

  <div class="hero__scroll">
    <span>SCROLL</span>
    <span class="hero__scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 640px;
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    animation:
      heroPan 12s ease-out both,
      heroCrossfade 14s ease-in-out infinite;
  }

  .hero__image--2 {
    animation-delay: 0s, -7s;
  }

  @keyframes heroCrossfade {
    0%,
    45% {
      opacity: 1;
    }
    50%,
    95% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  .hero__overlay-diagonal {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(19, 21, 74, 0.9) 0%,
      rgba(19, 21, 74, 0.6) 45%,
      rgba(19, 21, 74, 0.25) 100%
    );
  }

  .hero__overlay-bottom {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(19, 21, 74, 0.75) 0%, transparent 40%);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 72px 72px;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0.6) 0%, transparent 60%);
    mask-image: linear-gradient(to right, rgba(0, 0, 0, 0.6) 0%, transparent 60%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding: 0 var(--edge) 96px 72px;
    max-width: 720px;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: var(--space-m);
    animation: heroFadeUp 0.8s 0.2s both;
  }

  .hero__eyebrow-bar {
    display: block;
    width: 48px;
    height: 3px;
    background: #fff;
  }

  .hero__eyebrow-text {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.32em;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
  }

  .hero__title {
    font-family: var(--font-accent);
    font-weight: 800;
    line-height: 0.87;
    letter-spacing: -0.04em;
    animation: heroFadeUp 0.8s 0.3s both;
  }

  .hero__title-line {
    display: block;
    font-size: clamp(64px, 9vw, 128px);
    color: #fff;
  }

  .hero__title-line--outline {
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.55);
  }

  .hero__subtitle {
    max-width: 500px;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
    margin-top: 36px;
    text-wrap: pretty;
    animation: heroFadeUp 0.8s 0.45s both;
  }

  .hero__cta {
    display: flex;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin-top: 44px;
    animation: heroFadeUp 0.8s 0.6s both;
  }

  .hero__btn {
    display: inline-block;
    padding: 16px 36px;
    border-radius: var(--radius);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition:
      background var(--transition),
      border-color var(--transition);
  }

  .hero__btn--primary {
    background: var(--color-navy);
    color: #fff;
  }

  .hero__btn--primary:hover {
    background: var(--color-navy-dark);
  }

  .hero__btn--outline {
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.5);
  }

  .hero__btn--outline:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }

  .hero__scroll {
    position: absolute;
    bottom: 40px;
    right: 72px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    animation: heroFadeUp 1s 0.8s both;
  }

  .hero__scroll span:first-child {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.45);
    writing-mode: vertical-rl;
  }

  .hero__scroll-line {
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.5), transparent);
  }

  @media (max-width: 900px) {
    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .hero__inner {
      padding: 0 var(--edge-mobile) 80px;
    }
  }

  @media (max-width: 480px) {
    .hero__title-line {
      font-size: clamp(40px, 15vw, 64px);
    }

    .hero__eyebrow-text {
      letter-spacing: 0.16em;
      font-size: 0.75rem;
    }

    .hero__btn {
      width: 100%;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__image {
      animation: none;
    }

    .hero__image--2 {
      opacity: 0;
    }

    .hero__eyebrow,
    .hero__title,
    .hero__subtitle,
    .hero__cta,
    .hero__scroll {
      animation: none;
    }
  }
</style>
