---
const slides = [
  { image: '/img/sayda-insaat-hero01.webp', title: 'Yüksek Kalitede Uygulamalar' },
  { image: '/img/sayda-insaat-hero02.webp', title: 'Profesyonel Çözümler' },
  { image: '/img/sayda-insaat-hero03.webp', title: 'Güvenilir Takvim, Adil Fiyat' },
  { image: '/img/sayda-insaat-hero04.webp', title: 'Kentsel Dönüşüm Çözümleri' },
];
---

<section class="hero" data-interval="6000">
  {
    slides.map((slide, i) => (
      <div class:list={['hero__slide', { 'is-on': i === 0 }]}>
        <img src={slide.image} alt="" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} />
        {i === 0 ? <h1 class="hero__title">{slide.title}</h1> : <p class="hero__title">{slide.title}</p>}
      </div>
    ))
  }
  <div class="hero__shade"></div>
</section>

<script>
  const heroTimers = new WeakMap<HTMLElement, number>();

  function initHero() {
    document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
      const slides = [...hero.querySelectorAll('.hero__slide')];
      const dur = Number(hero.dataset.interval) || 6000;
      let current = 0;
      const prev = heroTimers.get(hero);
      if (prev) clearInterval(prev);
      heroTimers.set(
        hero,
        window.setInterval(() => {
          slides[current].classList.remove('is-on');
          current = (current + 1) % slides.length;
          slides[current].classList.add('is-on');
        }, dur)
      );
    });
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  .hero {
    position: relative;
    height: calc(100vh - var(--header-h));
    height: calc(100svh - var(--header-h));
    min-height: 480px;
    overflow: hidden;
    background: #1b2130;
    color: #fff;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero__slide.is-on {
    opacity: 1;
  }

  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13, 17, 28, 0.45) 0%, rgba(13, 17, 28, 0.1) 35%, rgba(13, 17, 28, 0.25) 100%);
    pointer-events: none;
  }

  .hero__title {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0 var(--edge-mobile);
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 112%;
    font-size: clamp(26px, 3.4vw, 46px);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.4);
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transition: none;
    }
  }
</style>
