---
import site from '../../data/site.json';
---

<section class="hero">
  <img class="hero__image" src="/img/hero-placeholder.svg" alt="Sayda İnşaat şantiye görünümü" />
  <div class="hero__overlay"></div>

  <div class="container hero__inner">
    <h1 class="hero__title">SAYDA<span>İNŞAAT</span></h1>
    <p class="hero__subtitle">
      {site.foundedYear}'dan bu yana İstanbul'da kentsel dönüşüm, kat karşılığı inşaat ve
      anahtar teslim müteahhitlik hizmeti veriyoruz.
    </p>
    <div class="hero__cta">
      <a class="button button--primary" href="/kentsel-donusum">Kentsel Dönüşüm Hizmetlerimiz</a>
      <a class="button button--secondary" href="#quote-form">Teklif Alın</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 640px;
    color: #fff;
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(25, 27, 74, 0.55) 0%, rgba(25, 27, 74, 0.85) 100%);
  }

  .hero__inner {
    position: relative;
    padding-block: var(--space-xxl) var(--space-xl);
    max-width: 760px;
  }

  .hero__title {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: 0.01em;
  }

  .hero__title span {
    margin-left: 0.3em;
    color: var(--color-on-dark-muted);
  }

  .hero__subtitle {
    margin-top: var(--space-m);
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 56ch;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  .hero .button--secondary {
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .hero .button--secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #fff;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 520px;
    }

    .hero__cta {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
