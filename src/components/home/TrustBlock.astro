---
import site from '../../data/site.json';

const yearsInBusiness = new Date().getFullYear() - site.foundedYear;

const areaInMillions = Number(site.stats.totalCompletedArea.replace(/[^\d]/g, '')) / 1_000_000;
const areaLabel = `${areaInMillions.toFixed(2).replace(/\.?0+$/, '')}M`;

const stats = [
  { value: `${yearsInBusiness}`, suffix: '+', label: 'Yıllık Deneyim' },
  { value: areaLabel, suffix: ' m²', label: 'Tamamlanan Alan' },
  { value: String(site.completionCertificatesCount), suffix: '', label: 'İş Bitirme Belgesi' },
  { value: site.contractorLicenseGroup, suffix: '', label: 'Yüklenici Yetki Belgesi' },
];
---

<section class="stats">
  <div class="container stats__grid">
    <div>
      <div class="eyebrow eyebrow--light">Sayılarla Sayda</div>
      <h2 class="stats__title">Güven. Deneyim.<br />Kalıcı değer.</h2>
    </div>
    <div class="stats__items">
      {
        stats.map((s, i) => (
          <div class={`stats__item reveal reveal-right reveal-d${i + 1}`}>
            <div class="stats__value">
              {s.value}
              <span>{s.suffix}</span>
            </div>
            <div class="stats__label">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stats {
    background: var(--color-navy);
    color: #fff;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .eyebrow--light {
    color: var(--color-on-dark-muted);
  }

  .stats__grid {
    padding-top: 90px;
    padding-bottom: 90px;
    display: grid;
    grid-template-columns: minmax(260px, 320px) 1fr;
    gap: 48px;
    align-items: end;
  }

  .stats__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 38px;
    line-height: 1.08;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }

  .stats__items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    row-gap: 32px;
  }

  .stats__item {
    padding: 8px 28px;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: clamp(34px, 3.6vw, 48px);
    font-weight: 700;
    font-stretch: 115%;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .stats__value span {
    font-size: 24px;
    font-weight: 500;
  }

  .stats__label {
    margin-top: 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 900px) {
    .stats__grid {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 32px;
    }
  }

  @media (max-width: 760px) {
    .stats__grid {
      padding-top: 64px;
      padding-bottom: 64px;
    }

    .stats__items {
      grid-template-columns: 1fr 1fr;
    }

    .stats__item {
      padding: 8px 16px;
    }
  }
</style>
