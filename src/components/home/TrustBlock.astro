---
import site from '../../data/site.json';

const yearsInBusiness = new Date().getFullYear() - site.foundedYear;

const stats = [
  {
    value: `${yearsInBusiness}+`,
    label: 'YILLIK DENEYİM',
    icon: '<rect x="8" y="10" width="32" height="30" rx="2"/><line x1="8" y1="18" x2="40" y2="18"/><line x1="16" y1="6" x2="16" y2="14"/><line x1="32" y1="6" x2="32" y2="14"/>',
  },
  {
    value: site.stats.totalCompletedArea.replace(' m²', '') + '+',
    label: 'M² TAMAMLANAN ALAN',
    icon: '<rect x="6" y="7" width="36" height="36" rx="2"/><line x1="15" y1="7" x2="15" y2="43" stroke-width="1.4"/><line x1="25" y1="7" x2="25" y2="43" stroke-width="1.4"/><line x1="6" y1="20" x2="42" y2="20" stroke-width="1.4"/><line x1="6" y1="32" x2="42" y2="32" stroke-width="1.4"/>',
  },
  {
    value: String(site.completionCertificatesCount),
    label: 'İŞ BİTİRME BELGESİ',
    icon: '<path d="M24 6L40 12V22C40 32 33 40 24 43C15 40 8 32 8 22V12L24 6Z"/><path d="M17 23L22 28L31 18" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    value: site.contractorLicenseGroup,
    label: 'YÜKL. YETKİ BELGESİ',
    icon: '<rect x="9" y="6" width="18" height="36"/><rect x="27" y="18" width="12" height="24"/>',
  },
];

---

<section class="trust">
  <div class="trust__decor" aria-hidden="true"></div>
  <div class="trust__inner">
    <div class="trust__intro reveal">
      <div class="trust__eyebrow">
        <span class="trust__eyebrow-bar"></span>
        <span class="trust__eyebrow-text">SAYILARLA SAYDA</span>
      </div>
      <h2>Güven. Deneyim.<br />Kalıcı Değer.</h2>
    </div>

    <div class="trust__stats">
      {
        stats.map((stat, i) => (
          <div class={`trust__stat reveal reveal-d${i + 1}`}>
            <svg viewBox="0 0 48 48" fill="none" width="26" height="26" stroke="rgba(255,255,255,0.7)" stroke-width="1.8" set:html={stat.icon} />
            <span class="trust__stat-value">{stat.value}</span>
            <span class="trust__stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .trust {
    position: relative;
    background: var(--color-navy);
    color: #fff;
    padding-block: 0;
    overflow: hidden;
  }

  .trust__decor {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 80% 50%, rgba(255, 255, 255, 0.04) 0%, transparent 60%);
    pointer-events: none;
  }

  .trust__inner {
    position: relative;
    display: grid;
    width: 100%;
    max-width: none;
    margin-inline: 0;
    grid-template-columns: minmax(240px, 0.85fr) minmax(0, 1.15fr);
    gap: 0;
    padding-left: var(--edge);
    padding-right: 0;
    align-items: stretch;
  }

  .trust__intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: 28px;
  }

  .trust__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: var(--space-s);
  }

  .trust__eyebrow-bar {
    display: block;
    width: 44px;
    height: 3px;
    background: #fff;
  }

  .trust__eyebrow-text {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.6);
  }

  .trust__intro h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.2;
    max-width: 260px;
  }

  .trust__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .trust__stat {
    background: var(--color-navy);
    padding: 36px 28px;
    display: grid;
    gap: 10px;
    justify-items: center;
    text-align: center;
    min-width: 0;
  }

  .trust__stat-value {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(16px, 6vw, 44px);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .trust__stat-label {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.65);
  }

  @media (max-width: 1024px) {
    .trust__inner {
      grid-template-columns: 1fr;
      gap: var(--space-l);
      padding-right: var(--edge);
    }

    .trust__intro {
      padding-right: 0;
    }

    .trust__stats {
      margin-inline: calc(var(--edge) * -1);
    }
  }

  @media (max-width: 700px) {
    .trust__inner {
      padding-left: var(--edge-mobile);
      padding-right: var(--edge-mobile);
    }

    .trust__stats {
      margin-inline: calc(var(--edge-mobile) * -1);
    }

    .trust__stat {
      padding: 30px 24px;
    }
  }

  @media (max-width: 480px) {
    .trust__stat {
      padding: 24px 16px;
    }
  }
</style>
