---
import Icon from '../Icon.astro';
import site from '../../data/site.json';

const yearsInBusiness = new Date().getFullYear() - site.foundedYear;

const proofs = [
  {
    icon: 'helmet',
    title: `${site.foundedYear}'dan beri`,
    description: 'Aynı şirket, aynı ekip. Kentsel dönüşümde ve müteahhitlikte süreklilik.',
  },
  {
    icon: 'check',
    title: 'Kurumsal işverenler',
    description: 'Kurumsal firmaların denetim süreçlerinden geçmiş bir tedarikçi.',
  },
  {
    icon: 'document',
    title: 'İş bitirme belgeli',
    description: 'Tamamlanan projelerin resmi belgeleri, isteyen incelesin.',
  },
];

const documents = [
  { title: 'İş Bitirme Belgeleri', href: site.documents.certificate },
  { title: 'Katalog', href: site.documents.catalog },
  { title: 'Tüm Belgeler', href: '/belgeler' },
];
---

<section class="trust">
  <div class="container">
    <div class="trust__top">
      <div class="trust__eyebrow">
        <span class="trust__eyebrow-bar"></span>
        <span class="trust__eyebrow-text">SAYILARLA SAYDA</span>
      </div>
      <p class="trust__years">
        <span class="trust__years-value">{yearsInBusiness}+</span>
        <span class="trust__years-label">YILLIK DENEYİM</span>
      </p>
    </div>

    <div class="trust__proofs">
      {
        proofs.map((proof) => (
          <div class="trust__proof">
            <span class="trust__proof-icon">
              <Icon name={proof.icon} size={24} />
            </span>
            <div>
              <h3>{proof.title}</h3>
              <p>{proof.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="trust__documents">
      {
        documents.map((doc, i) => (
          <>
            {i > 0 && <span class="trust__documents-sep" aria-hidden="true">·</span>}
            <a href={doc.href} target={doc.href.endsWith('.pdf') ? '_blank' : undefined} rel="noopener noreferrer">
              {doc.title}
            </a>
          </>
        ))
      }
    </div>
  </div>
</section>

<style>
  .trust {
    background: var(--color-navy);
    color: #fff;
    padding-block: var(--space-block);
  }

  .trust__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-s);
    padding-bottom: var(--space-l);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .trust__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .trust__eyebrow-bar {
    display: block;
    width: 44px;
    height: 3px;
    background: #fff;
  }

  .trust__eyebrow-text {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.75);
  }

  .trust__years {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .trust__years-value {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 2.5rem;
  }

  .trust__years-label {
    font-size: var(--fs-small);
    letter-spacing: 0.1em;
    opacity: 0.75;
  }

  .trust__proofs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-l);
    padding-block: var(--space-l);
  }

  .trust__proof {
    display: flex;
    gap: var(--space-s);
  }

  .trust__proof-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
  }

  .trust__proof h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .trust__proof p {
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--color-on-dark-muted);
  }

  .trust__documents {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-top: var(--space-l);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .trust__documents a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    transition: text-decoration-color var(--transition);
  }

  .trust__documents a:hover {
    text-decoration-color: #fff;
  }

  .trust__documents-sep {
    opacity: 0.5;
  }

  @media (max-width: 1024px) {
    .trust__proofs {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }

  @media (max-width: 640px) {
    .trust__top {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-m);
    }
  }
</style>
