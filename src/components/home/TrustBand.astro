---
import Icon from '../Icon.astro';
import site from '../../data/site.json';

const proofs = [
  {
    icon: 'helmet',
    title: `${site.foundedYear}'dan beri`,
    description: 'Aynı şirket, aynı ekip. Kentsel dönüşümde ve müteahhitlikte otuz yıla yakın süreklilik.',
  },
  {
    icon: 'document',
    title: 'İş bitirme belgeleri',
    description: 'Tamamlanan projelerin resmi belgeleri, isteyen incelesin.',
    href: '/belgeler',
  },
  {
    icon: 'check',
    title: 'Kurumsal işverenler',
    description: 'Kurumsal firmaların denetim süreçlerinden geçmiş bir tedarikçi.',
  },
];
---

<section class="trust-band">
  <div class="container trust-band__grid">
    {
      proofs.map((proof) => {
        const Tag = proof.href ? 'a' : 'div';
        return (
          <Tag class="trust-band__item" href={proof.href}>
            <span class="trust-band__icon">
              <Icon name={proof.icon} size={26} />
            </span>
            <div>
              <h3>{proof.title}</h3>
              <p>{proof.description}</p>
            </div>
          </Tag>
        );
      })
    }
  </div>
</section>

<style>
  .trust-band {
    padding-block: var(--space-xl);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .trust-band__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-l);
  }

  .trust-band__item {
    display: flex;
    gap: var(--space-s);
  }

  a.trust-band__item {
    transition: opacity var(--transition);
  }

  a.trust-band__item:hover {
    opacity: 0.8;
  }

  .trust-band__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
  }

  .trust-band__item h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .trust-band__item p {
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--color-on-dark-muted);
  }

  @media (max-width: 1024px) {
    .trust-band__grid {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }
</style>
