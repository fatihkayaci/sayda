---
const steps = [
  {
    number: '01',
    title: 'Görüşme & Keşif',
    description: 'Arsa, bina veya proje talebinizi yerinde inceler, ilk değerlendirmeyi yaparız.',
  },
  {
    number: '02',
    title: 'Anlaşma & Planlama',
    description: 'Kat karşılığı veya sözleşme koşulları netleşir, proje ve ruhsat süreci başlar.',
  },
  {
    number: '03',
    title: 'İnşaat',
    description: 'Saha ekiplerimiz projeyi zaman planına göre yürütür, süreç düzenli raporlanır.',
  },
  {
    number: '04',
    title: 'Teslim',
    description: 'İş bitirme belgeleri ile birlikte anahtar teslimi yapılır.',
  },
];
---

<section class="process">
  <div class="container">
    <h2>Çalışma Sürecimiz</h2>

    <ol class="process__grid">
      {
        steps.map((step) => (
          <li class="process-step">
            <span class="process-step__number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    padding-block: var(--space-xl);
  }

  .process h2 {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-l);
  }

  .process__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
  }

  .process-step {
    position: relative;
    padding-top: var(--space-m);
    border-top: 2px solid var(--color-navy);
  }

  .process-step__number {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-text-faint);
  }

  .process-step h3 {
    margin-top: var(--space-xs);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.0625rem;
  }

  .process-step p {
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .process__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .process__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
