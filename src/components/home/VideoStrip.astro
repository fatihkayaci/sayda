---
import allProjects from '../../data/projects.json';

const slugs = ['gaziantep-entegre-saglik-kampusu', 'buyukyali', 'referans-kartal-loca-1', 'referans-besiktas-abbasaga'];
const items = slugs
  .map((slug) => allProjects.find((p) => p.href === `/projeler/${slug}`))
  .filter((p): p is (typeof allProjects)[number] => Boolean(p))
  .slice(0, 4);
---

<section class="reel">
  <div class="container reel__grid">
    {
      items.map((project) => (
        <a href={project.href} class="reel__item reveal">
          <img src={project.image} alt={`${project.name} - Sayda İnşaat`} loading="lazy" />
          <span class="reel__play" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
          <span class="reel__label">{project.name}</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .reel {
    background: var(--color-bg);
    padding-block: 56px;
  }

  .reel__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 16px;
  }

  .reel__item {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-navy-deep);
  }

  .reel__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .reel__item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(13, 21, 51, 0.85) 0%, rgba(13, 21, 51, 0.15) 55%);
  }

  .reel__item:hover img {
    transform: scale(1.05);
  }

  .reel__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-accent-dark);
    transform: translate(-50%, -50%);
    transition:
      background var(--transition),
      transform var(--transition);
  }

  .reel__item:hover .reel__play {
    background: var(--color-accent);
    color: #fff;
    transform: translate(-50%, -50%) scale(1.06);
  }

  .reel__label {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }
</style>
