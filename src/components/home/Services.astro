---
import Icon from '../Icon.astro';
import services from '../../data/services.json';

const items = services.slice(0, 4);
---

<section class="svc">
  <div class="container">
    <div class="svc__head">
      <span class="svc__eyebrow">Hizmetlerimiz</span>
      <h2>Her Aşamada Güçlü Çözümler</h2>
    </div>
    <div class="svc__grid">
      {
        items.map((s) => (
          <a href={s.href} class="svc__card">
            <i class="svc__arrow"><Icon name="arrow" size={13} /></i>
            <Icon name={s.icon} size={44} class="svc__icon" />
            <h3>{s.title}</h3>
            <p>{s.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .svc {
    padding-block: 44px 56px;
    background: #fff;
  }

  .svc__head {
    margin-bottom: 22px;
  }

  .svc__eyebrow {
    display: block;
    margin-bottom: 4px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3a4a7a;
  }

  .svc__head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.7rem;
    line-height: 1.15;
    color: var(--color-navy);
  }

  .svc__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .svc__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 20px 24px;
    background: #fff;
    border: 1px solid #e6eaf2;
    box-shadow: 0 4px 16px rgba(20, 27, 46, 0.06);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .svc__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(20, 27, 46, 0.12);
  }

  .svc__card :global(.svc__icon) {
    margin-bottom: 18px;
    color: var(--color-navy);
    stroke-width: 1.3;
  }

  .svc__arrow {
    position: absolute;
    top: 20px;
    right: 18px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid #c9d0e0;
    border-radius: 50%;
    color: var(--color-navy);
  }

  .svc__card h3 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    color: #141b2e;
  }

  .svc__card p {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .svc__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .svc__head h2 {
      font-size: 1.4rem;
    }

    .svc__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
