---
import Icon from '../Icon.astro';
import services from '../../data/services.json';
---

<section class="svc">
  <div class="container svc__layout">
    <div class="svc__intro">
      <span class="eyebrow"><i></i>Hizmetlerimiz</span>
      <h2>Değer Katan Çözümler</h2>
      <p>Arsadan anahtar teslimine, ihtiyacınıza uygun inşaat ve müteahhitlik çözümleri.</p>
      <a class="svc__all" href="/hizmetler">Tüm Hizmetler <Icon name="arrow" size={14} /></a>
    </div>

    <ol class="svc__list">
      {
        services.map((s, i) => (
          <li>
            <a href={s.href} class="svc__row">
              <span class="svc__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc__text">
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </span>
              <img src={s.image} alt="" loading="lazy" />
              <i class="svc__arrow">
                <Icon name="arrow" size={14} />
              </i>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .svc {
    padding-block: 72px;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .svc__layout {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .svc__intro {
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .svc__intro .eyebrow {
    color: var(--color-on-dark-muted);
  }

  .svc__intro h2 {
    margin-block: 12px 20px;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(2rem, 2.6vw + 1rem, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .svc__intro p {
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-on-dark-muted);
  }

  .svc__all {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding: 12px 20px;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    font-size: 0.875rem;
    font-weight: 700;
    transition:
      background var(--transition),
      color var(--transition);
  }

  .svc__all:hover {
    border-color: var(--color-orange);
    background: var(--color-orange);
    color: var(--color-navy-deep);
  }

  .svc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .svc__row {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr 120px auto;
    align-items: center;
    gap: 16px;
    padding: 26px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    transition: padding var(--transition);
  }

  .svc__row:hover,
  .svc__row:focus-visible {
    padding-inline: 16px;
    background: rgba(255, 255, 255, 0.05);
  }

  .svc__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--color-orange);
  }

  .svc__text h3 {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .svc__text p {
    max-width: 52ch;
    margin-top: 6px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-on-dark-muted);
  }

  .svc__arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    transition:
      background var(--transition),
      border-color var(--transition);
  }

  .svc__row:hover .svc__arrow {
    background: var(--color-orange);
    border-color: var(--color-orange);
  }

  .svc__row img {
    width: 120px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(0.6);
    transition: filter var(--transition);
  }

  .svc__row:hover img {
    filter: none;
  }

  @media (max-width: 1024px) {
    .svc__layout {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }

    .svc__intro {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .svc {
      padding-block: 48px;
    }

    .svc__row {
      grid-template-columns: 32px 1fr auto;
      gap: 12px;
    }

    .svc__row img {
      display: none;
    }
  }
</style>
