---
import services from '../../data/services.json';
---

<section class="svc" id="hizmetler">
  <div class="container svc__wrap">
    <div class="svc__head reveal reveal-left">
      <div class="svc__head-l">
        <div class="eyebrow">Hizmetlerimiz</div>
        <h2 class="h2">Her aşamayı uzmanlıkla yönetiyoruz</h2>
      </div>
      <p>Planlamadan teslimata kadar tüm süreçlerde kalite, güvenlik ve sürdürülebilirliği ön planda tutuyoruz.</p>
    </div>
    <div class="svc__grid">
      {
        services.map((s, i) => (
          <a href={s.href} class={`svc__card reveal reveal-d${(i % 4) + 1}`}>
            <div class="svc__top">
              <span>0{i + 1}</span>
              <span>→</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .svc {
    background: var(--color-bg-light);
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-navy);
    margin-bottom: 16px;
  }

  .h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 48px;
    line-height: 1.05;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .svc__wrap {
    padding-top: 120px;
    padding-bottom: 120px;
  }

  .svc__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 56px;
  }

  .svc__head-l {
    max-width: 620px;
  }

  .svc__head p {
    margin: 0;
    max-width: 420px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .svc__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1px;
    background: rgba(43, 46, 131, 0.12);
    border: 1px solid rgba(43, 46, 131, 0.12);
  }

  .svc__card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 280px;
    padding: 40px 36px;
    background: var(--color-bg);
    color: var(--color-text);
    transition: background 0.3s;
  }

  .svc__card:hover {
    background: var(--color-bg-light);
    color: var(--color-text);
  }

  .svc__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-navy);
  }

  .svc__top span:first-child {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .svc__top span:last-child {
    font-size: 20px;
    transition: transform 0.3s;
  }

  .svc__card:hover .svc__top span:last-child {
    transform: translateX(4px);
  }

  .svc__card h3 {
    margin: auto 0 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    font-stretch: 108%;
    line-height: 1.15;
  }

  .svc__card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  @media (max-width: 760px) {
    .h2 {
      font-size: 34px;
    }

    .svc__wrap {
      padding-top: 72px;
      padding-bottom: 72px;
    }

    .svc__grid {
      grid-template-columns: 1fr;
    }

    .svc__card {
      min-height: 0;
      padding: 28px 24px;
    }
  }
</style>
