---
import Icon from '../Icon.astro';
import services from '../../data/services.json';
---

<section class="services" id="hizmetler">
  <div class="container services__inner">
    <div class="services__intro reveal reveal-left">
      <div class="services__eyebrow">
        <span class="services__eyebrow-bar"></span>
        <span>HİZMETLERİMİZ</span>
      </div>
      <h2>Her Aşamayı Uzmanlıkla Yönetiyoruz</h2>
      <p>Planlamadan teslimata kadar tüm süreçlerde kalite, güvenlik ve sürdürülebilirliği ön planda tutuyoruz.</p>
      <a class="services__cta" href="/iletisim#quote-form">Teklif Al →</a>
    </div>

    <div class="services__grid">
      {
        services.map((service, i) => (
          <a class={`svc-card reveal reveal-right reveal-d${(i % 4) + 1}`} href={service.href}>
            <span class="svc-card__icon">
              <Icon name={service.icon} size={26} />
            </span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: 112px;
    background: var(--color-bg);
  }

  .services__inner {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: var(--space-l);
    align-items: start;
  }

  .services__intro {
    position: sticky;
    top: 96px;
  }

  .services__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .services__eyebrow-bar {
    display: block;
    width: 44px;
    height: 3px;
    background: var(--color-navy);
  }

  .services__eyebrow span:last-child {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--color-navy);
  }

  .services__intro h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(28px, 3.5vw, 40px);
    line-height: 1.1;
    margin-bottom: var(--space-s);
  }

  .services__intro p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    text-wrap: pretty;
    margin-bottom: var(--space-m);
  }

  .services__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 30px;
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--color-navy);
    color: #fff;
    transition: background var(--transition);
  }

  .services__cta:hover {
    background: var(--color-navy-dark);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .svc-card {
    display: block;
    padding: 32px 28px;
    border-radius: var(--radius);
    background: var(--color-bg);
    border: 1px solid rgba(43, 46, 131, 0.12);
    transition:
      border-color 200ms,
      box-shadow 200ms,
      transform 200ms;
  }

  .svc-card:hover {
    border-color: var(--color-navy);
    box-shadow: 0 16px 40px rgba(43, 46, 131, 0.12);
    transform: translateY(-4px);
  }

  .svc-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--color-bg-light);
    color: var(--color-navy);
    margin-bottom: 20px;
  }

  .svc-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 10px;
  }

  .svc-card p {
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--color-text-faint);
  }

  @media (max-width: 1024px) {
    .services__inner {
      grid-template-columns: 1fr;
    }

    .services__intro {
      position: static;
    }
  }

  @media (max-width: 700px) {
    .services {
      padding-block: 64px;
    }

    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
