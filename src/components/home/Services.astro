---
import Icon from '../Icon.astro';
import services from '../../data/services.json';

const binaSahipleri = services.filter((s) => s.audience === 'bina-sahipleri');
const anaYukleniciler = services.filter((s) => s.audience === 'ana-yukleniciler');
---

<section class="services">
  <div class="container">
    <div class="services__header">
      <h2>Hizmetlerimiz</h2>
      <p>İhtiyacınıza göre iki ayrı yol: bina sahipleri ve ana yükleniciler için farklı hizmetler.</p>
    </div>

    <div class="services__columns">
      <div class="services__column services__column--lead">
        <span class="services__column-label">Bina Sahipleri İçin</span>
        <ul>
          {
            binaSahipleri.map((service) => (
              <li>
                <a href={service.href}>
                  <span class="services__item-icon">
                    <Icon name={service.icon} size={24} />
                  </span>
                  <span>
                    <h3>{service.title}</h3>
                    <p>{service.description}</p>
                  </span>
                  <Icon name="arrow" size={18} class="services__item-arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="services__column">
        <span class="services__column-label">Ana Yükleniciler İçin</span>
        <ul>
          {
            anaYukleniciler.map((service) => (
              <li>
                <a href={service.href}>
                  <span class="services__item-icon">
                    <Icon name={service.icon} size={24} />
                  </span>
                  <span>
                    <h3>{service.title}</h3>
                    <p>{service.description}</p>
                  </span>
                  <Icon name="arrow" size={18} class="services__item-arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: var(--space-block);
    background: var(--color-bg-light);
  }

  .services__header {
    max-width: 56ch;
    margin-bottom: var(--space-l);
  }

  .services__header h2 {
    font-size: var(--fs-h2);
  }

  .services__header p {
    margin-top: var(--space-s);
    color: var(--color-text-muted);
  }

  .services__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
    align-items: start;
  }

  .services__column {
    padding: var(--space-l);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .services__column--lead {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: #fff;
  }

  .services__column--lead .services__column-label {
    color: #9fa3e8;
  }

  .services__column--lead p {
    color: var(--color-on-dark-muted);
  }

  .services__column--lead .services__item-icon {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .services__column--lead li + li {
    border-top-color: rgba(255, 255, 255, 0.15);
  }

  .services__column-label {
    display: block;
    font-size: var(--fs-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-navy);
    margin-bottom: var(--space-m);
  }

  .services__column ul {
    display: flex;
    flex-direction: column;
  }

  .services__column li + li {
    border-top: 1px solid var(--color-border);
  }

  .services__column li a {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding-block: var(--space-s);
    transition: opacity var(--transition);
  }

  .services__column li a:hover {
    opacity: 0.75;
  }

  .services__item-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: var(--color-bg-light);
    color: var(--color-navy);
  }

  .services__column li a > span:nth-child(2) {
    flex: 1;
  }

  .services__column h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.0625rem;
  }

  .services__column p {
    margin-top: 4px;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .services__item-arrow {
    flex-shrink: 0;
    opacity: 0.5;
  }

  @media (max-width: 900px) {
    .services__columns {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .services__column {
      padding: var(--space-m);
    }
  }
</style>
