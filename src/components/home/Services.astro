---
import Icon from '../Icon.astro';
import services from '../../data/services.json';

const images = ['/img/home/gold-towers.webp', '/img/home/residence-sunset.webp', '/img/home/sayda-hq.webp', '/img/home/site-team.webp'];
const items = services.slice(0, 4).map((s, i) => ({ ...s, image: images[i] }));
---

<section class="svc">
  <div class="container">
    <div class="svc__head">
      <span class="eyebrow"><i></i>Hizmetlerimiz</span>
      <h2>Değer Katan Çözümler</h2>
    </div>
    <div class="svc__grid">
      {
        items.map((s) => (
          <a href={s.href} class="svc__card">
            <img src={s.image} alt="" loading="lazy" />
            <div class="svc__body">
              <Icon name={s.icon} size={32} class="svc__icon" />
              <h3>{s.title}</h3>
              <p>{s.description}</p>
              <i class="svc__arrow"><Icon name="arrow" size={13} /></i>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .svc {
    padding-block: 44px 56px;
    background: #fff;
  }

  .svc__head {
    margin-bottom: 22px;
  }

  .svc__head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.7rem;
    line-height: 1.15;
    color: var(--color-navy);
  }

  .svc__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .svc__card {
    display: flex;
    flex-direction: column;
    background: #fff;
    box-shadow: 0 4px 16px rgba(20, 27, 46, 0.08);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .svc__card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .svc__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    padding: 0 20px 20px;
  }

  .svc__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(20, 27, 46, 0.12);
  }

  .svc__card :global(.svc__icon) {
    margin: -16px 0 8px;
    padding: 6px;
    width: 44px;
    height: 44px;
    background: #fff;
    color: var(--color-navy);
    stroke-width: 1.3;
  }

  .svc__arrow {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-top: auto;
    border: 1px solid #2a2f45;
    color: #141b2e;
  }

  .svc__card p {
    margin-bottom: 14px;
  }

  .svc__card h3 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    color: #141b2e;
  }

  .svc__card p {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .svc__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .svc__head h2 {
      font-size: 1.4rem;
    }

    .svc__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
