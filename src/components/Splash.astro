    <div class="splash__dim"><span>SAYDA İNŞAAT · {site.foundedYear}</span></div>
  </div>
</div>
<noscript><style>#splash{display:none}</style></noscript>

<script is:inline data-astro-rerun>
  (function () {
    var el = document.getElementById('splash');
    if (!el) return;
    var seen = false;
    try {
      seen = !!sessionStorage.getItem('sayda-splash');
      sessionStorage.setItem('sayda-splash', '1');
    } catch (e) {}
    // The hero waits for this before starting its first zoom, so it isn't spent behind the splash.
    var done = function () {
      window.__saydaSplashDone = true;
      window.dispatchEvent(new Event('sayda:splash-done'));
    };
    if (seen) {
      el.remove();
      done();
      return;
    }
    // The page loads underneath. Leave once it has loaded, but not before the drawing
    // finishes (1.5s) and never later than 1.9s (+0.4s fade).
    var start = Date.now();
    var gone = false;
    var leave = function () {
      if (gone) return;
      gone = true;
      el.classList.add('is-leaving');
      done();
      setTimeout(function () {
        el.remove();
      }, 400);
    };
    var whenLoaded = function () {
      setTimeout(leave, Math.max(0, 1500 - (Date.now() - start)));
    };
    if (document.readyState === 'complete') whenLoaded();
    else window.addEventListener('load', whenLoaded, { once: true });
    setTimeout(leave, 1900);
  })();
</script>

<style is:global>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--color-navy-deep);
    transition:
      opacity 400ms ease,
      transform 400ms ease;
  }

  /* Blueprint grid */
  .splash::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center;
    animation: splash-fade 400ms ease forwards;
  }

  .splash.is-leaving {
    opacity: 0;
    transform: scale(1.05);
    pointer-events: none;
  }

  .splash__frame {
    position: relative;
    padding: 30px 40px;
  }

  /* Construction lines running past the frame edges */
  .splash__rule {
    position: absolute;
    background: rgba(255, 255, 255, 0.35);
    animation: 650ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .splash__rule--top,
  .splash__rule--bottom {
    left: -50vw;
    right: -50vw;
    height: 1px;
    transform: scaleX(0);
    animation-name: splash-scale-x;
  }

  .splash__rule--left,
  .splash__rule--right {
    top: -50vh;
    bottom: -50vh;
    width: 1px;
    transform: scaleY(0);
    animation-name: splash-scale-y;
  }

  .splash__rule--top {
    top: 0;
    transform-origin: left;
    animation-delay: 100ms;
  }

  .splash__rule--bottom {
    bottom: 0;
    transform-origin: right;
    animation-delay: 220ms;
  }

  .splash__rule--left {
    left: 0;
    transform-origin: top;
    animation-delay: 160ms;
  }

  .splash__rule--right {
    right: 0;
    transform-origin: bottom;
    animation-delay: 280ms;
  }

  .splash__logo {
    display: block;
    width: clamp(210px, 28vw, 330px);
    height: auto;
    overflow: visible;
  }

  .splash__logo path {
    fill: #fff;
    fill-opacity: 0;
    stroke: #fff;
    stroke-width: 0.7;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation:
      splash-draw 800ms 350ms cubic-bezier(0.65, 0, 0.35, 1) forwards,
      splash-fill 350ms 1000ms ease forwards;
  }

  /* Dimension line under the logo */
  .splash__dim {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: -30px;
    height: 9px;
    border-inline: 1px solid var(--color-orange);
    opacity: 0;
    animation: splash-fade 350ms 950ms ease forwards;
  }

  .splash__dim::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    height: 1px;
    background: var(--color-orange);
  }

  .splash__dim span {
    position: absolute;
    left: 50%;
    top: -3px;
    transform: translateX(-50%);
    padding: 0 10px;
    background: var(--color-navy-deep);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    white-space: nowrap;
    color: var(--color-orange);
  }

  @keyframes splash-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes splash-scale-x {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes splash-scale-y {
    to {
      transform: scaleY(1);
    }
  }

  @keyframes splash-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes splash-fill {
    to {
      fill-opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash::before,
    .splash__rule,
    .splash__logo path,
    .splash__dim {
      animation: none;
      opacity: 1;
      transform: none;
      fill-opacity: 1;
      stroke-dashoffset: 0;
    }
  }
</style>
