  <div class="splash__frame">
    <span class="splash__rule splash__rule--top"></span>
    <span class="splash__rule splash__rule--bottom"></span>
    <span class="splash__rule splash__rule--left"></span>
    <span class="splash__rule splash__rule--right"></span>
    <svg class="splash__logo" viewBox="0 0 287 66">
