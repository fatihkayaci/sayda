---
import site from '../data/site.json';
---

<div id="splash" class="splash" aria-hidden="true">
  <div class="splash__inner">
    <img class="splash__logo" src={site.logo} alt="" width="287" height="66" />
    <span class="splash__line"></span>
  </div>
</div>
<noscript><style>#splash{display:none}</style></noscript>

<script is:inline data-astro-rerun>
  (function () {
    var el = document.getElementById('splash');
    if (!el) return;
    var seen = false;
    try {
      seen = !!sessionStorage.getItem('sayda-splash');
      sessionStorage.setItem('sayda-splash', '1');
    } catch (e) {}
    if (seen) {
      el.remove();
      return;
    }
    setTimeout(function () {
      el.classList.add('is-leaving');
    }, 1700);
    setTimeout(function () {
      el.remove();
    }, 2000);
  })();
</script>

<style is:global>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 50% 45%, #ffffff 0%, #eef1f9 70%);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  .splash.is-leaving {
    opacity: 0;
    transform: scale(1.04);
    pointer-events: none;
  }

  .splash__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  .splash__logo {
    width: clamp(210px, 28vw, 330px);
    height: auto;
    clip-path: inset(0 100% 0 0);
    transform: scale(0.94);
    animation: splash-reveal 900ms 150ms cubic-bezier(0.65, 0, 0.25, 1) forwards;
  }

  .splash__line {
    width: clamp(210px, 28vw, 330px);
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-navy), transparent);
    transform: scaleX(0);
    opacity: 0;
    animation: splash-line 800ms 700ms ease-out forwards;
  }

  @keyframes splash-reveal {
    to {
      clip-path: inset(0 0 0 0);
      transform: scale(1);
    }
  }

  @keyframes splash-line {
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash__logo,
    .splash__line {
      animation: none;
      clip-path: none;
      transform: none;
      opacity: 1;
    }
  }
</style>
