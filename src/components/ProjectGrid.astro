---
import Icon from './Icon.astro';
import { statusLabel, formatDateRange } from '../utils/project';

interface Project {
  slug: string;
  name: string;
  employer: string;
  location: string;
  district?: string;
  type?: string;
  area: string;
  status: string;
  startDate: string;
  endDate: string;
  image: string;
  href: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const searchText = (project: Project) =>
  [project.name, project.location, project.employer, project.district, project.type].filter(Boolean).join(' ');
---

<div class="project-grid">
  {
    projects.map((project, i) => (
      <a
        class={`project-card reveal reveal-d${(i % 4) + 1}`}
        href={project.href}
        data-district={project.district || ''}
        data-type={project.type || ''}
        data-search={searchText(project)}
      >
        <div class="project-card__media">
          {project.image ? (
            <img src={project.image} alt={`${project.name} - Sayda İnşaat`} loading="lazy" />
          ) : (
            <div class="project-card__media-empty">
              <Icon name="photo" size={36} />
            </div>
          )}
          <span class={`project-card__badge project-card__badge--${project.status}`}>{statusLabel(project.status)}</span>
          {project.district && <span class="project-card__district-badge">{project.district}</span>}
        </div>
        <div class="project-card__info">
          <h2>{project.name}</h2>
          <span class="project-card__location">{project.location.replace(' - ', ' · ')}</span>
          {project.employer && <span class="project-card__employer">{project.employer}</span>}
          <div class="project-card__meta">
            {
              project.area && (
                <span class="project-card__stat project-card__area">
                  <Icon name="area" size={18} />
                  {project.area}
                </span>
              )
            }
            <span class="project-card__stat project-card__date">
              <Icon name="calendar" size={18} />
              {formatDateRange(project.startDate, project.endDate)}
            </span>
            <span class="project-card__arrow" aria-hidden="true">
              <Icon name="arrow" size={18} />
            </span>
          </div>
        </div>
      </a>
    ))
  }
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-bg);
    box-shadow: 0 2px 16px rgba(43, 46, 131, 0.07);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
  }

  .project-card__media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .project-card__media-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-bg-light);
    color: var(--color-border);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.05);
  }

  .project-card__badge {
    position: absolute;
    top: 13px;
    left: 12px;
    z-index: 1;
    padding: 5px 13px;
    border-radius: 3px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .project-card__badge--devam-eden {
    background: var(--color-navy);
    color: #fff;
  }

  .project-card__badge--tamamlanan {
    background: rgba(255, 255, 255, 0.85);
    color: var(--color-navy-deep);
    backdrop-filter: blur(4px);
  }

  .project-card__district-badge {
    position: absolute;
    top: 13px;
    right: 12px;
    z-index: 1;
    padding: 5px 13px;
    border-radius: 3px;
    font-size: 0.77rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-navy-deep);
  }

  .project-card__info {
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1;
    padding: 21px 22px 18px;
  }

  .project-card h2 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.19rem;
    line-height: 1.3;
    color: var(--color-navy-deep);
  }

  .project-card__location {
    font-size: 0.91rem;
    color: var(--color-text-muted);
  }

  .project-card__employer {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-text-faint);
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 8px;
    gap: 18px;
    margin-top: auto;
    padding-top: 16px;
  }

  .project-card__stat {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    white-space: nowrap;
    font-size: 0.84rem;
    color: var(--color-text-muted);
  }

  .project-card__stat :global(svg) {
    color: var(--color-navy);
  }

  .project-card__area {
    font-weight: 700;
    color: var(--color-navy-deep);
  }

  .project-card__arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--color-navy);
    color: #fff;
    transition: background var(--transition);
  }

  .project-card:hover .project-card__arrow {
    background: var(--color-navy-deep);
  }

  @media (max-width: 1024px) {
    .project-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
