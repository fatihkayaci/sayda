---
interface Project {
  slug: string;
  name: string;
  employer: string;
  location: string;
  image: string;
  href: string;
  description?: string[];
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const fallbackImage = '/img/sayda-insaat-hero01.webp';
const excerpt = (p: Project) => {
  const text = (p.description ?? [])[0] ?? '';
  return text.length > 120 ? `${text.slice(0, 120)}..` : text;
};
---

<div class="project-list" data-project-list>
  {
    projects.map((project) => (
      <article class="project-row">
        <a class="project-row__img" href={project.href}>
          <img src={project.image || fallbackImage} alt={`${project.name} - Sayda İnşaat`} width="760" height="360" loading="lazy" />
        </a>
        <div class="project-row__box">
          <h2>
            <a href={project.href}>{project.name}</a>
          </h2>
          {project.employer && <span class="project-row__employer">{project.employer}</span>}
          <span class="project-row__rule" />
          <p>{excerpt(project)}</p>
          <a class="project-row__btn" href={project.href}>Proje İncele</a>
        </div>
      </article>
    ))
  }
</div>
<ul class="project-pager" data-project-pager hidden></ul>

<script>
  const PAGE_SIZE = 6;
  const list = document.querySelector<HTMLElement>('[data-project-list]');
  const pager = document.querySelector<HTMLElement>('[data-project-pager]');
  if (list && pager) {
    const rows = [...list.querySelectorAll<HTMLElement>('.project-row')];
    const pages = Math.ceil(rows.length / PAGE_SIZE);
    const show = (page: number) => {
      rows.forEach((row, i) => (row.hidden = Math.floor(i / PAGE_SIZE) !== page - 1));
      pager.querySelectorAll('li').forEach((li, i) => li.classList.toggle('active', i === page - 1));
    };
    if (pages > 1) {
      pager.hidden = false;
      for (let p = 1; p <= pages; p++) {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(p);
        btn.addEventListener('click', () => {
          show(p);
          list.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        li.appendChild(btn);
        pager.appendChild(li);
      }
      show(1);
    }
  }
</script>

<style>
  .project-list {
    display: grid;
    gap: 40px;
  }

  .project-row {
    display: grid;
    grid-template-columns: 2fr 1fr;
    align-items: stretch;
    background: #fff;
    box-shadow: 0 0 14px rgba(0, 0, 0, 0.06);
  }

  .project-row[hidden] {
    display: none;
  }

  .project-row__img {
    display: block;
    overflow: hidden;
  }

  .project-row__img img {
    width: 100%;
    height: 100%;
    max-height: 360px;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .project-row__img:hover img {
    opacity: 0.8;
  }

  .project-row__box {
    padding: 32px 26px;
  }

  .project-row__box h2 {
    margin: 0 0 6px;
    padding: 0;
    font-size: 13px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .project-row__box h2::after {
    display: none;
  }

  .project-row__box h2 a {
    color: #333 !important;
  }

  .project-row__employer {
    display: block;
    font-size: 12px;
    text-transform: uppercase;
    color: #8e8d8d;
  }

  .project-row__rule {
    display: block;
    width: 35px;
    height: 2px;
    margin: 14px 0 22px;
    background: #36abfc;
  }

  .project-row__box p {
    font-size: 12px;
    color: #484848;
  }

  .project-row__btn {
    display: inline-block;
    padding: 0 20px;
    font-size: 11px;
    font-weight: 700;
    line-height: 28px;
    text-transform: uppercase;
    color: #fff !important;
    background: #36abfc;
  }

  .project-row__btn:hover {
    background: #f69c00;
  }

  .project-pager {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 40px;
  }

  .project-pager[hidden] {
    display: none;
  }

  .project-pager button {
    width: 36px;
    height: 36px;
    font: inherit;
    color: #555;
    background: #fff;
    border: 1px solid #ddd;
  }

  .project-pager .active button,
  .project-pager button:hover {
    color: #fff;
    background: #f69c00;
    border-color: #f69c00;
  }

  @media (max-width: 800px) {
    .project-row {
      grid-template-columns: 1fr;
    }
  }
</style>
