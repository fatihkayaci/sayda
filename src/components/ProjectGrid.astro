---
import Icon from './Icon.astro';
import { statusLabel, formatDateRange } from '../utils/project';

interface Project {
  slug: string;
  name: string;
  employer: string;
  location: string;
  district?: string;
  area: string;
  status: string;
  startDate: string;
  endDate: string;
  image: string;
  href: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="project-grid">
  {
    projects.map((project, i) => (
      <a class={`project-card reveal reveal-d${(i % 4) + 1}`} href={project.href} data-district={project.district || ''}>
        <div class="project-card__media">
          {project.image ? (
            <img src={project.image} alt={`${project.name} - Sayda İnşaat`} loading="lazy" />
          ) : (
            <div class="project-card__media-empty">
              <Icon name="photo" size={32} />
            </div>
          )}
          <span class={`project-card__badge project-card__badge--${project.status}`}>{statusLabel(project.status)}</span>
          {project.district && <span class="project-card__district-badge">{project.district}</span>}
        </div>
        <div class="project-card__info">
          <h2>{project.name}</h2>
          <span class="project-card__location">{project.location}</span>
          {project.employer && <span class="project-card__employer">{project.employer}</span>}
          <div class="project-card__meta">
            {project.area && <span class="project-card__area">{project.area}</span>}
            <span class="project-card__date">{formatDateRange(project.startDate, project.endDate)}</span>
          </div>
        </div>
      </a>
    ))
  }
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg);
    box-shadow: 0 2px 16px rgba(43, 46, 131, 0.07);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
  }

  .project-card__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .project-card__media-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--color-bg-light);
    color: var(--color-border);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.05);
  }

  .project-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(19, 21, 74, 0.65) 0%, transparent 55%);
  }

  .project-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    padding: 5px 12px;
    border-radius: 2px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #fff;
  }

  .project-card__badge--devam-eden {
    background: var(--color-navy);
  }

  .project-card__badge--tamamlanan {
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(4px);
  }

  .project-card__district-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1;
    padding: 5px 12px;
    border-radius: 2px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #fff;
    background: rgba(19, 21, 74, 0.55);
    backdrop-filter: blur(4px);
  }

  .project-card__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    padding: var(--space-m);
  }

  .project-card h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .project-card__location {
    font-size: var(--fs-small);
    color: var(--color-text-faint);
  }

  .project-card__employer {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .project-card__meta {
    display: flex;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
  }

  .project-card__area {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-navy);
  }

  .project-card__date {
    font-size: var(--fs-small);
    color: var(--color-text-faint);
  }

  @media (max-width: 1024px) {
    .project-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
