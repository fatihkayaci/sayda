---
interface Props {
  description: string[];
  works: string[];
}

const { description, works } = Astro.props;
---

<section class="project-scope reveal">
  <h2>İş Kapsamı</h2>
  {description.map((paragraph) => <p>{paragraph}</p>)}
  {
    works.length > 0 && (
      <div class="project-scope__works">
        {works.map((work) => <span>{work}</span>)}
      </div>
    )
  }
</section>

<style>
  .project-scope {
    margin-top: 45px;
  }

  .project-scope h2 {
    margin-bottom: 22px;
    padding-left: 16px;
    border-left: 3px solid var(--color-navy);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.54rem;
    line-height: 1.2;
    color: var(--color-navy-deep);
  }

  .project-scope p {
    max-width: 78ch;
    padding-left: 19px;
    font-size: 0.98rem;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .project-scope p + p {
    margin-top: 16px;
  }

  .project-scope__works {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 25px;
    padding-left: 19px;
  }

  .project-scope__works span {
    display: inline-flex;
    align-items: center;
    padding: 7px 18px;
    background: #fff;
    border: 1px solid #c9cde3;
    border-radius: 20px;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }
</style>
