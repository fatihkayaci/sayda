---
interface Props {
  description: string[];
  works: string[];
}

const { description, works } = Astro.props;
---

<section>
  <h2>İş Kapsamı</h2>
  {description.map((paragraph) => <p>{paragraph}</p>)}
  {works.length > 0 && <ul class="list">{works.map((work) => <li>{work}</li>)}</ul>}
</section>
