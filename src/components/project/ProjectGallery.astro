---
import { projectImageAlt } from '../../utils/project';

interface Props {
  title: string;
  images: string[];
  project?: { name: string; location: string; works?: string[] };
}

const { title, images, project } = Astro.props;
const imageAlts = images.map((_, i) => (project ? projectImageAlt(project, i) : `${title} proje fotoğrafı ${i + 1}`));
---

{
  images.length > 0 && (
    <div class="project-gallery">
      {images.map((src, i) => (
        <a href={src} target="_blank" rel="noopener noreferrer">
          <img
            src={src}
            alt={imageAlts[i]}
            width="400"
            height="300"
            loading={i === 0 ? undefined : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </a>
      ))}
      <p class="project-gallery__caption">* Görseller temsili niteliktedir.</p>
    </div>
  )
}

<style>
  .project-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 10px;
    margin-bottom: 30px;
  }

  .project-gallery img {
    width: 100%;
    height: 150px;
    object-fit: cover;
  }

  .project-gallery a:first-child {
    grid-column: 1 / -1;
  }

  .project-gallery a:first-child img {
    height: auto;
    max-height: 460px;
  }

  .project-gallery__caption {
    grid-column: 1 / -1;
    font-size: 12px;
    color: #8e8d8d;
  }
</style>
