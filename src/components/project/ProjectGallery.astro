---
interface Props {
  title: string;
  images: string[];
}

const { title, images } = Astro.props;
const thumbs = images.slice(0, 3);
---

<div class="project-gallery reveal">
  <div class="project-gallery__main">
    <img data-gallery-main src={thumbs[0]} alt={`${title} proje fotoğrafı`} />
  </div>
  <div class="project-gallery__thumbs">
    {
      thumbs.map((src, i) => (
        <button
          type="button"
          class="project-gallery__thumb"
          class:list={{ 'is-active': i === 0 }}
          data-gallery-thumb
          data-src={src}
          aria-label={`${title} fotoğrafı ${i + 1}`}
        >
          <img src={src} alt="" />
        </button>
      ))
    }
  </div>
  <p class="project-gallery__caption">* Görseller temsili niteliktedir.</p>
</div>

<script>
  function initGalleries() {
    document.querySelectorAll<HTMLElement>('.project-gallery').forEach((gallery) => {
      const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
      const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const src = thumb.getAttribute('data-src');
          if (!main || !src) return;
          main.style.opacity = '0';
          setTimeout(() => {
            main.src = src;
            main.style.opacity = '1';
          }, 150);
          thumbs.forEach((t) => t.classList.toggle('is-active', t === thumb));
        });
      });
    });
  }

  initGalleries();
  document.addEventListener('astro:page-load', initGalleries);
</script>

<style>
  .project-gallery__main {
    height: 420px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-bg-light);
  }

  .project-gallery__main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 300ms;
  }

  .project-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 12px;
  }

  .project-gallery__thumb {
    height: 100px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    transition:
      transform 180ms,
      box-shadow 180ms;
  }

  .project-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-gallery__thumb:hover {
    transform: scale(1.03);
    box-shadow: 0 8px 24px rgba(43, 46, 131, 0.15);
  }

  .project-gallery__thumb.is-active {
    box-shadow: 0 0 0 3px var(--color-navy);
  }

  .project-gallery__caption {
    margin-top: 12px;
    font-size: 12px;
    color: var(--color-text-faint);
    font-style: italic;
  }
</style>
