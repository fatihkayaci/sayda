---
import Icon from '../Icon.astro';
import certificates from '../../data/certificates.json';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const items = certificates.filter((c) => c.project === slug);
---

{
  items.length > 0 && (
    <section class="project-certs reveal">
      <div class="project-certs__heading">
        <h2>{items.length > 1 ? 'İş Bitirme Belgeleri' : 'İş Bitirme Belgesi'}</h2>
        <span>{items.length} BELGE</span>
      </div>

      <ul class="project-certs__list">
        {items.map((c) => (
          <li>
            <a href={c.large} target="_blank" rel="noopener noreferrer">
              <img src={c.image} alt={`${c.issuer} tarafından verilen belge: ${c.title}`} width="480" height="640" loading="lazy" />
              <span class="project-certs__text">
                <small>
                  {c.issuer}
                  {c.date && <> · {c.date}</>}
                </small>
                <b>{c.title}</b>
                <em>
                  Belgeyi aç <Icon name="arrow" size={14} />
                </em>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .project-certs {
    margin-top: 56px;
  }

  .project-certs__heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 26px;
  }

  .project-certs__heading h2 {
    padding-left: 16px;
    border-left: 4px solid var(--color-orange);
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(1.75rem, 1.4vw + 1rem, 2.5rem);
    line-height: 1.2;
    color: var(--color-navy-deep);
  }

  .project-certs__heading span {
    padding: 6px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .project-certs__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-certs__list a {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px;
    height: 100%;
    padding: 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .project-certs__list a:hover {
    border-color: var(--color-navy);
    box-shadow: var(--shadow);
  }

  .project-certs__list img {
    width: 96px;
    height: 128px;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--color-border);
  }

  .project-certs__text {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .project-certs__text small {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-orange-text);
  }

  .project-certs__text b {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-navy-deep);
  }

  .project-certs__text em {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-size: 0.8125rem;
    font-style: normal;
    font-weight: 700;
    color: var(--color-navy);
  }
</style>
