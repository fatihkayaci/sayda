---
import { shortProjectTitle, projectImageAlt } from '../../utils/project';

interface Props {
  project: {
    name: string;
    status: string;
    image: string;
    location: string;
    works?: string[];
    tagline?: string;
    description?: string[];
  };
}

const { project } = Astro.props;
const title = shortProjectTitle(project.name);
const heroAlt = projectImageAlt(project);
const lead = project.tagline ?? project.description?.[0];
---

<section class="project-hero">
  {project.image && <img src={project.image} alt={heroAlt} fetchpriority="high" />}
  <div class="project-hero__overlay"></div>

  <div class="container project-hero__inner">
    <nav class="project-hero__breadcrumb" aria-label="Konum">
      <a href="/">Anasayfa</a>
      <span>/</span>
      <a href="/projeler">Projeler</a>
      <span>/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <span class="project-hero__rule"></span>
    <h1>{project.name}</h1>
    {lead && <p>{lead}</p>}
  </div>
</section>

<style>

  .project-hero {
    position: relative;
    overflow: hidden;
    min-height: 269px;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .project-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .project-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(19, 21, 74, 0.85) 0%, rgba(19, 21, 74, 0.45) 55%, rgba(19, 21, 74, 0.2) 100%);
  }

  .project-hero__inner {
    position: relative;
    padding-block: 40px 45px;
  }

  .project-hero__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .project-hero__breadcrumb a {
    color: rgba(255, 255, 255, 0.8);
    transition: color var(--transition);
  }

  .project-hero__breadcrumb a:hover {
    color: #fff;
  }

  .project-hero__breadcrumb span:not([aria-current]) {
    color: rgba(255, 255, 255, 0.5);
  }

  .project-hero__rule {
    display: block;
    width: 54px;
    height: 2px;
    margin-bottom: 18px;
    background: rgba(255, 255, 255, 0.8);
  }

  .project-hero h1 {
    font-size: clamp(1.96rem, 4.032vw, 3.08rem);
    line-height: 1.1;
    color: #fff;
  }

  .project-hero p {
    max-width: 52ch;
    margin-top: 16px;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.92);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .project-hero__inner {
      padding-block: 31px 36px;
    }
  }
</style>
