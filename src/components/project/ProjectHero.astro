---
import Icon from '../Icon.astro';
import { shortProjectTitle, statusLabel, projectImageAlt } from '../../utils/project';

interface Props {
  project: {
    name: string;
    status: string;
    image: string;
    location: string;
    works?: string[];
  };
}

const { project } = Astro.props;
const title = shortProjectTitle(project.name);
const heroAlt = projectImageAlt(project);
---

<div class="project-hero-media">
  {project.image ? (
    <img src={project.image} alt={heroAlt} fetchpriority="high" />
  ) : (
    <div class="project-hero-media__empty">
      <Icon name="photo" size={48} />
    </div>
  )}
  <div class="project-hero-media__gradient"></div>
  <div class="project-hero-media__top">
    <a class="project-hero-media__back" href="/projeler">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      Tüm Projeler
    </a>
    <span class={`project-hero-media__badge project-hero-media__badge--${project.status}`}>{statusLabel(project.status)}</span>
  </div>
</div>

<section class="project-breadcrumb">
  <div class="container">
    <nav class="project-breadcrumb__nav" aria-label="Konum">
      <a href="/">Anasayfa</a>
      <span>/</span>
      <a href="/projeler">Projeler</a>
      <span>/</span>
      <span aria-current="page">{title}</span>
    </nav>
    <h1>{project.name}</h1>
  </div>
</section>

<style>
  .project-hero-media {
    padding-top: 76px;
    position: relative;
    height: 520px;
    overflow: hidden;
  }

  .project-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-hero-media__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--color-navy);
    color: rgba(255, 255, 255, 0.35);
  }

  .project-hero-media__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(19, 21, 74, 0.75) 0%, rgba(19, 21, 74, 0.2) 50%, transparent 100%);
  }

  .project-hero-media__top {
    position: absolute;
    top: 32px;
    left: 48px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .project-hero-media__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    backdrop-filter: blur(8px);
    transition: background 150ms;
  }

  .project-hero-media__back:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .project-hero-media__badge {
    padding: 10px 18px;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    border-radius: var(--radius);
  }

  .project-hero-media__badge--devam-eden {
    background: var(--color-navy);
  }

  .project-hero-media__badge--tamamlanan {
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(4px);
  }

  .project-breadcrumb {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .project-breadcrumb .container {
    padding-block: var(--space-m);
  }

  .project-breadcrumb__nav {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--space-s);
    font-size: 13px;
  }

  .project-breadcrumb__nav a {
    color: var(--color-text-faint);
    transition: color var(--transition);
  }

  .project-breadcrumb__nav a:hover {
    color: var(--color-navy);
  }

  .project-breadcrumb__nav span:not([aria-current]) {
    color: var(--color-border);
  }

  .project-breadcrumb__nav span[aria-current] {
    color: var(--color-text-muted);
  }

  .project-breadcrumb h1 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(26px, 4vw, 42px);
    color: var(--color-text);
    line-height: 1.1;
  }

  @media (max-width: 640px) {
    .project-hero-media {
      height: 360px;
    }

    .project-hero-media__top {
      left: var(--edge-mobile);
      right: var(--edge-mobile);
    }
  }
</style>
