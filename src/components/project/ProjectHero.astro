---
import Icon from '../Icon.astro';
import { shortProjectTitle, statusLabel, formatDateRange, splitLocation } from '../../utils/project';

interface Props {
  project: {
    name: string;
    status: string;
    location: string;
    area: string;
    startDate: string;
    endDate: string;
    employer: string;
    description: string[];
    image: string;
  };
}

const { project } = Astro.props;
const title = shortProjectTitle(project.name);
const location = splitLocation(project.location);
---

<section class="project-hero">
  <div class="container project-hero__inner">
    <div class="project-hero__content">
      <a class="project-hero__back" href="/projeler">← Tüm Projeler</a>
      <h1>{title}</h1>
      <div class="project-hero__subline">
        <span class="project-hero__location">{location.full.toUpperCase()}</span>
        <span class={`project-hero__badge project-hero__badge--${project.status}`}>{statusLabel(project.status)}</span>
      </div>
      {project.description[0] && <p class="project-hero__lead">{project.description[0]}</p>}

      <dl class="project-hero__meta">
        <div class="project-hero__meta-item">
          <Icon name="area" size={20} class="project-hero__meta-icon" />
          <div><dd>{project.area}</dd><dt>Proje Alanı</dt></div>
        </div>
        <div class="project-hero__meta-item">
          <Icon name="calendar" size={20} class="project-hero__meta-icon" />
          <div><dd>{formatDateRange(project.startDate, project.endDate)}</dd><dt>Uygulama Süresi</dt></div>
        </div>
        <div class="project-hero__meta-item">
          <Icon name="pin" size={20} class="project-hero__meta-icon" />
          <div><dd>{location.short}</dd><dt>Lokasyon</dt></div>
        </div>
        <div class="project-hero__meta-item">
          <Icon name="check" size={20} class="project-hero__meta-icon" />
          <div><dd>{statusLabel(project.status)}</dd><dt>Durum</dt></div>
        </div>
      </dl>

      {project.employer && (
        <div class="project-hero__employer">
          <span class="project-hero__employer-label">İşveren</span>
          <span class="project-hero__employer-value">{project.employer}</span>
        </div>
      )}
    </div>
    <div class="project-hero__media">
      <img src={project.image} alt={`${title} proje görseli`} fetchpriority="high" />
    </div>
  </div>
</section>

<style>
  .project-hero { padding-bottom: var(--space-xl); }
  .project-hero__inner { display: grid; grid-template-columns: minmax(0, 42%) minmax(0, 58%); gap: 0; align-items: start; }
  .project-hero__content { padding: 48px clamp(32px, 5vw, 72px) 0 0; }
  .project-hero__back { display: inline-block; margin-bottom: clamp(24px, 3vw, 48px); font-size: var(--fs-small); font-weight: 600; color: var(--color-text-muted); transition: color var(--transition); }
  .project-hero__back:hover { color: var(--color-navy); }
  .project-hero__content h1 { font-size: clamp(3.25rem, 5vw, 5.25rem); letter-spacing: -.05em; line-height: .98; }
  .project-hero__subline { display: flex; align-items: center; gap: var(--space-s); margin-top: var(--space-s); }
  .project-hero__location { font-size: var(--fs-small); font-weight: 700; letter-spacing: .08em; color: var(--color-text-faint); }
  .project-hero__badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 2px; font-size: .75rem; font-weight: 700; }
  .project-hero__badge--tamamlanan { background: #e5f3ea; color: #1f7a41; }
  .project-hero__badge--devam-eden { background: #eaedfa; color: var(--color-navy); }
  .project-hero__lead { max-width: 46ch; margin-top: var(--space-m); color: var(--color-text-muted); line-height: 1.6; }
  .project-hero__meta { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin-top: var(--space-l); }
  .project-hero__meta-item { padding: 0 14px; border-right: 1px solid var(--color-border); }
  .project-hero__meta-item:first-child { padding-left: 0; }
  .project-hero__meta-item:last-child { border-right: 0; }
  .project-hero__meta-icon { display: block; margin-bottom: var(--space-s); color: var(--color-navy); }
  .project-hero__meta-item dd { margin: 0; font-size: 1.125rem; font-weight: 700; color: var(--color-text); }
  .project-hero__meta-item dt { margin-top: 6px; font-size: .625rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--color-text-faint); }
  .project-hero__employer { display: flex; flex-direction: column; gap: 4px; margin-top: var(--space-l); padding-top: var(--space-l); border-top: 1px solid var(--color-border); }
  .project-hero__employer-label { font-size: .6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--color-text-faint); }
  .project-hero__employer-value { color: var(--color-text-muted); }
  .project-hero__media img { width: 100%; aspect-ratio: 1.45 / 1; object-fit: cover; }
  @media (max-width: 1024px) { .project-hero { padding-top: var(--space-l); } .project-hero__inner { grid-template-columns: 1fr; gap: var(--space-l); } .project-hero__content { padding: 0; } .project-hero__media img { min-height: 0; aspect-ratio: 16 / 10; } }
  @media (max-width: 640px) { .project-hero { padding-top: var(--space-m); } .project-hero__content h1 { font-size: clamp(2.5rem, 12vw, 3.25rem); } .project-hero__meta { grid-template-columns: 1fr 1fr; row-gap: var(--space-m); } .project-hero__meta-item:nth-child(2n) { border-right: 0; } .project-hero__meta-item:nth-child(-n + 2) { padding-bottom: var(--space-m); border-bottom: 1px solid var(--color-border); } .project-hero__meta-item:nth-child(n + 3) { padding-top: var(--space-m); } }
</style>
