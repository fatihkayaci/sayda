---
import site from '../../data/site.json';

interface Props {
  project: {
    name: string;
    employer: string;
    location: string;
    district?: string;
    type?: string;
    services?: string[];
    status: string;
    area: string;
    startDate: string;
    endDate: string;
  };
}

const { project } = Astro.props;
const ongoing = project.status === 'devam-eden';

const rows = [
  { label: 'Proje', value: project.name },
  { label: 'İşveren', value: project.employer },
  { label: 'Lokasyon', value: project.location },
  { label: 'İlçe', value: project.district },
  { label: 'Alan', value: project.area },
  { label: 'Başlangıç', value: project.startDate },
  { label: 'Bitiş', value: project.endDate || (ongoing ? 'Devam Ediyor' : '') },
  { label: 'Durum', value: ongoing ? 'Devam Ediyor' : 'Tamamlandı' },
  { label: 'Proje Türü', value: project.type },
  { label: 'Hizmetlerimiz', value: project.services?.join(', ') },
].filter((row) => row.value);
---

<aside class="page__aside">
  <div class="page__box">
    <h2>Proje Bilgileri</h2>
    <dl>
      {
        rows.map((row) => (
          <div class="row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="page__box cta">
    <h3>Benzer Proje için Teklif Alın</h3>
    <p>Uzman ekibimiz projenizi değerlendirsin.</p>
    <p><a class="btn" href="/iletisim#quote-form">Teklif Al</a></p>
    <p><a href={site.phoneHref}>{site.phone}</a></p>
    <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>
</aside>

<style>
  .row {
    padding: 8px 0;
    border-bottom: 1px solid #eee;
  }

  dt {
    font-size: 11px;
    text-transform: uppercase;
    color: #8e8d8d;
  }

  dd {
    margin: 2px 0 0;
    color: #333;
  }

  .cta {
    margin-top: 20px;
  }
</style>
