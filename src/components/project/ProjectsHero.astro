---
import Icon from '../Icon.astro';
import site from '../../data/site.json';
import projects from '../../data/projects.json';
import { shortProjectTitle } from '../../utils/project';
import { srcset } from '../../utils/image';
import { breadcrumbLd } from '../../utils/schema';

interface Props {
  active: 'all' | 'devam-eden' | 'tamamlanan';
}

const { active } = Astro.props;

const devamEdenCount = projects.filter((p) => p.status === 'devam-eden').length;
const tamamlananCount = projects.filter((p) => p.status === 'tamamlanan').length;

const tabs = [
  { key: 'all', label: 'Tümü', count: projects.length, href: '/projeler' },
  { key: 'devam-eden', label: 'Devam Eden', count: devamEdenCount, href: '/projeler/devam-eden' },
  { key: 'tamamlanan', label: 'Tamamlanan', count: tamamlananCount, href: '/projeler/tamamlanan' },
] as const;

const sortTr = (a: string, b: string) => a.localeCompare(b, 'tr');
const districts = [...new Set(projects.map((p) => p.district).filter((d): d is string => Boolean(d)))].sort(sortTr);
const types = [...new Set(projects.map((p) => p.type).filter((t): t is string => Boolean(t)))].sort(sortTr);

const areaInMillions = Number(site.stats.totalCompletedArea.replace(/[^\d]/g, '')) / 1_000_000;

// Background slides: projects whose covers are sharp at full screen width (≈1900px+).
const slideSlugs = ['vadistanbul', 'yasmin-resort-hotel', 'ciragan-otel-renovasyonu', 'buyukyali', 'akbati-avm-konut'];
const slides = slideSlugs
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is (typeof projects)[number] => Boolean(p?.imageCredit))
  .map((p) => ({ image: p.image, name: shortProjectTitle(p.name), href: p.href, credit: p.imageCredit! }));

const crumbs = [{ label: 'Anasayfa', href: '/' }, { label: 'Projeler', href: active === 'all' ? undefined : '/projeler' }];
if (active !== 'all') crumbs.push({ label: active === 'devam-eden' ? 'Devam Eden' : 'Tamamlanan', href: undefined });
const breadcrumbData = breadcrumbLd(crumbs, Astro.url.pathname);

// The numeric part counts up from zero when the strip scrolls into view. Project totals are the
// company's own figures (site.json), not the count of projects listed on the site.
const stats = [
  { value: areaInMillions, decimals: 2, suffix: 'M m²', label: 'Toplam Alan' },
  { value: site.stats.completedProjects, decimals: 0, suffix: '+', label: 'Tamamlanan Proje' },
  { value: site.stats.ongoingProjects, decimals: 0, suffix: '+', label: 'Devam Eden Proje' },
  { value: site.completionCertificatesCount, decimals: 0, suffix: '', label: 'İş Bitirme Belgesi' },
];
const format = (n: number, decimals: number) =>
  n.toLocaleString('tr-TR', { minimumFractionDigits: decimals, maximumFractionDigits: decimals, useGrouping: false });
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbData)} />

<section class="projects-hero" data-projects-hero>
  <div class="projects-hero__media" aria-hidden="true">
    {
      slides.map((slide, i) => (
        <img
          class:list={{ 'is-on': i === 0 }}
          src={slide.image}
          srcset={srcset(slide.image, 960, 1920)}
          sizes="100vw"
          alt=""
          fetchpriority={i === 0 ? 'high' : undefined}
          loading={i === 0 ? undefined : 'lazy'}
        />
      ))
    }
  </div>

  {
    slides.length > 0 && (
      <div class="projects-hero__captions">
        {slides.map((slide, i) => (
          <p class:list={['projects-hero__caption', { 'is-on': i === 0 }]}>
            <a href={slide.href}>{slide.name}</a>
            <a class="projects-hero__credit" href={slide.credit.href} target="_blank" rel="noopener noreferrer">
              {slide.credit.label}
            </a>
          </p>
        ))}
      </div>
    )
  }

  <div class="container projects-hero__inner reveal">
    <nav class="projects-hero__breadcrumb" aria-label="Konum">
      <a href="/">Anasayfa</a>
      <span>/</span>
      <span aria-current="page">Projeler</span>
    </nav>

    <div class="projects-hero__eyebrow">
      <span class="projects-hero__eyebrow-bar"></span>
      <span>REFERANSLARIMIZ</span>
    </div>

    <h1 data-words>Geçmişten Bugüne<br />Hayata Geçirdiğimiz Projeler</h1>
    <p class="projects-hero__lead">
      {site.foundedYear}'dan bu yana İstanbul ve Türkiye genelinde tamamladığımız ve devam eden projeleri keşfedin.
    </p>

    <p class="projects-hero__slogan" aria-hidden="true">
      DAHA İYİ<br />YAŞAM ALANLARI<br />İNŞA EDİYORUZ
    </p>
  </div>
</section>

<section class="projects-stats">
  <div class="container">
    <dl>
      {
        stats.map((stat) => (
          <div class="projects-stats__text">
            <dt>{stat.label}</dt>
            <dd>
              <span data-count={stat.value} data-decimals={stat.decimals}>{format(stat.value, stat.decimals)}</span>{stat.suffix}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<div class="projects-filters container">
  <label class="projects-filters__search">
    <span class="sr-only">Proje ara</span>
    <Icon name="search" size={22} />
    <input type="search" placeholder="Proje ara... (ör. Vadistanbul)" data-project-search autocomplete="off" />
  </label>

  {
    districts.length > 0 && (
      <label class="projects-filters__select">
        <span class="sr-only">İlçeye göre filtrele</span>
        <select data-district-filter>
          <option value="all">Tüm İlçeler</option>
          {districts.map((district) => (
            <option value={district}>{district}</option>
          ))}
        </select>
      </label>
    )
  }

  {
    types.length > 0 && (
      <label class="projects-filters__select">
        <span class="sr-only">Proje türüne göre filtrele</span>
        <select data-type-filter>
          <option value="all">Tüm Proje Türleri</option>
          {types.map((type) => (
            <option value={type}>{type}</option>
          ))}
        </select>
      </label>
    )
  }

  <nav class="projects-filters__tabs" aria-label="Proje durumu">
    {
      tabs.map((tab) => (
        <a href={tab.href} class="projects-filters__btn" aria-current={active === tab.key ? 'page' : undefined}>
          {tab.label} ({tab.count})
        </a>
      ))
    }
  </nav>
</div>

<script>
  function initProjectFilters() {
    const search = document.querySelector<HTMLInputElement>('[data-project-search]');
    const district = document.querySelector<HTMLSelectElement>('[data-district-filter]');
    const type = document.querySelector<HTMLSelectElement>('[data-type-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    if (!search || cards.length === 0) return;

    const normalize = (value: string) => value.toLocaleLowerCase('tr').trim();

    const apply = () => {
      const query = normalize(search.value);
      const districtValue = district?.value ?? 'all';
      const typeValue = type?.value ?? 'all';

      cards.forEach((card) => {
        const matchesQuery = !query || normalize(card.dataset.search ?? '').includes(query);
        const matchesDistrict = districtValue === 'all' || card.dataset.district === districtValue;
        const matchesType = typeValue === 'all' || card.dataset.type === typeValue;
        card.hidden = !(matchesQuery && matchesDistrict && matchesType);
      });

      // The ongoing-projects slider hides when the chosen type isn't among its projects.
      document.querySelectorAll<HTMLElement>('[data-featured]').forEach((featured) => {
        const types = (featured.dataset.types ?? '').split(',');
        featured.hidden = typeValue !== 'all' && !types.includes(typeValue);
      });

      document.querySelectorAll<HTMLElement>('[data-project-group]').forEach((group) => {
        const visible = group.querySelectorAll('.project-card:not([hidden])').length;
        group.hidden = visible === 0;
        const count = group.querySelector('[data-group-count]');
        if (count) count.textContent = `${visible} PROJE`;
      });
    };

    // ?tur=Otel preselects the type filter (used by the Hakkımızda expertise panels).
    const typeParam = new URLSearchParams(window.location.search).get('tur');
    const hasTypeOption = Boolean(type && typeParam && [...type.options].some((o) => o.value === typeParam));

    search.value = '';
    if (district) district.value = 'all';
    if (type) type.value = hasTypeOption ? typeParam! : 'all';
    apply();

    search.addEventListener('input', apply);
    district?.addEventListener('change', apply);
    type?.addEventListener('change', apply);
  }

  initProjectFilters();
  document.addEventListener('astro:page-load', initProjectFilters);

  const heroTimers = new WeakMap<HTMLElement, number>();

  function initProjectsHero() {
    document.querySelectorAll<HTMLElement>('[data-projects-hero]').forEach((hero) => {
      const images = [...hero.querySelectorAll('.projects-hero__media img')];
      const captions = [...hero.querySelectorAll('.projects-hero__caption')];
      if (images.length < 2 || heroTimers.has(hero)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let current = 0;
      heroTimers.set(
        hero,
        window.setInterval(() => {
          current = (current + 1) % images.length;
          [images, captions].forEach((list) => list.forEach((el, i) => el.classList.toggle('is-on', i === current)));
        }, 5500)
      );
    });
  }

  initProjectsHero();
  document.addEventListener('astro:page-load', initProjectsHero);
</script>

<style>

  .projects-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-navy-deep);
    color: #fff;
  }

  .projects-hero__media {
    position: absolute;
    inset: 0;
  }

  /* slides crossfade; the active one slowly zooms out */
  .projects-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 1.4s ease,
      transform 7s ease-out;
  }

  .projects-hero__media img.is-on {
    opacity: 1;
    transform: scale(1);
  }

  .projects-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Solid behind the text, fading out to the right so the photo shows on that side. */
    background: linear-gradient(
        to right,
        var(--color-navy-deep) 0%,
        var(--color-navy-deep) 40%,
        rgba(28, 29, 46, 0.85) 48%,
        rgba(28, 29, 46, 0.55) 58%,
        rgba(28, 29, 46, 0.25) 68%,
        rgba(28, 29, 46, 0) 80%
      );
  }

  .projects-hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(460px, 62vh, 640px);
    padding-block: 54px 80px;
  }

  .projects-hero__captions {
    position: absolute;
    right: clamp(20px, 4vw, 72px);
    bottom: 22px;
    z-index: 1;
    display: grid;
    justify-items: end;
  }

  .projects-hero__caption {
    grid-area: 1 / 1;
    display: grid;
    justify-items: end;
    gap: 2px;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 600ms ease,
      transform 600ms ease;
    pointer-events: none;
  }

  .projects-hero__caption.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .projects-hero__caption a:first-child {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #fff;
  }

  .projects-hero__caption a:first-child:hover {
    color: var(--color-orange);
  }

  .projects-hero__credit {
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .projects-hero__credit:hover {
    color: #fff;
  }

  .projects-hero__breadcrumb {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    font-size: 0.84rem;
  }

  .projects-hero__breadcrumb a {
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--transition);
  }

  .projects-hero__breadcrumb a:hover {
    color: #fff;
  }

  .projects-hero__breadcrumb span:first-of-type {
    color: rgba(255, 255, 255, 0.4);
  }

  .projects-hero__breadcrumb span[aria-current] {
    color: rgba(255, 255, 255, 0.85);
  }

  .projects-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .projects-hero__eyebrow-bar {
    display: block;
    width: 31px;
    height: 2px;
    background: var(--color-orange);
  }

  .projects-hero__eyebrow span:last-child {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.75);
  }

  .projects-hero h1 {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    font-size: clamp(2.25rem, 4.4vw, 4.25rem);
    line-height: 0.98;
    color: #fff;
    margin-bottom: 24px;
  }

  .projects-hero__lead {
    max-width: 52ch;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
  }

  .projects-hero__slogan {
    position: absolute;
    top: 50%;
    right: clamp(20px, 4vw, 72px);
    padding-left: 25px;
    border-left: 1px solid rgba(255, 255, 255, 0.85);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    line-height: 2;
    transform: translateY(-50%);
  }

  /* Stats */
  .projects-stats {
    background: #fff;
  }

  .projects-stats dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-l);
    margin: 0;
    padding-block: 56px;
    border-bottom: 1px solid var(--color-border);
  }

  .projects-stats dl > div {
    position: relative;
    min-width: 0;
    padding-top: 24px;
  }

  .projects-stats dl > div::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 40px;
    height: 4px;
    background: var(--color-orange);
  }


  .projects-stats__text {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  /* dt must come first in the markup; the number still shows on top */
  .projects-stats dd {
    order: -1;
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(2.25rem, 2.6vw + 1rem, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    color: var(--color-navy-deep);
  }

  .projects-stats dt {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Filters */
  .projects-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 40px 36px;
  }

  .projects-filters__search {
    display: flex;
    align-items: center;
    gap: 13px;
    flex: 3 1 240px;
    padding: 0 18px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: #fff;
    color: var(--color-navy);
  }

  .projects-filters__search input {
    flex: 1;
    min-width: 0;
    height: 49px;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 0.84rem;
    color: var(--color-text);
    outline: none;
  }

  .projects-filters__search:focus-within {
    border-color: var(--color-navy);
  }

  .projects-filters__select {
    flex: 1 1 160px;
    min-width: 0;
  }

  .projects-filters__select select {
    width: 100%;
    height: 49px;
    padding: 0 16px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: #fff;
    color: var(--color-navy-deep);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
  }

  .projects-filters__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    flex: 1 1 100%;
  }

  .projects-filters__btn {
    flex: 1 1 140px;
    max-width: 220px;
    padding: 13px 20px;
    border-radius: 4px;
    text-align: center;
    font-size: 0.84rem;
    font-weight: 700;
    border: 1px solid var(--color-border-strong);
    background: #fff;
    color: var(--color-navy-deep);
    transition:
      background var(--transition),
      color var(--transition),
      border-color var(--transition);
  }

  .projects-filters__btn:hover,
  .projects-filters__btn[aria-current='page'] {
    background: var(--color-navy);
    color: #fff;
    border-color: var(--color-navy);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1024px) {
    .projects-hero__slogan {
      display: none;
    }

    .projects-hero__media::after {
      background: rgba(28, 29, 46, 0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-hero__media img,
    .projects-hero__caption {
      transition: none;
    }

    .projects-hero__media img {
      transform: none;
    }
  }

  /* Wide uppercase titles: narrow the width axis on phones so long words fit */
  @media (max-width: 480px) {
    .projects-hero h1 {
      font-stretch: 100%;
      font-size: clamp(1.75rem, 9vw, 2.5rem);
    }
  }
</style>
