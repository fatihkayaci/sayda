---
import Icon from '../Icon.astro';
import { shortProjectTitle } from '../../utils/project';

interface RelatedProject {
  href: string;
  name: string;
  location: string;
  area: string;
  image: string;
}

interface Props {
  projects: RelatedProject[];
}

const { projects } = Astro.props;
---

{
  projects.length > 0 && (
    <section class="project-related reveal">
      <div class="project-related__heading">
        <h2>Diğer Projeler</h2>
        <a href="/projeler">
          Tüm Projeleri Gör <Icon name="arrow" size={18} />
        </a>
      </div>

      <div class="related-grid">
        {projects.map((project) => (
          <a class="related-card" href={project.href}>
            <div class="related-card__media">
              {project.image ? (
                <img src={project.image} alt={`${shortProjectTitle(project.name)} - Sayda İnşaat`} loading="lazy" />
              ) : (
                <div class="related-card__media-empty">
                  <Icon name="photo" size={31} />
                </div>
              )}
            </div>
            <div class="related-card__info">
              <h3>{shortProjectTitle(project.name)}</h3>
              <p>{[project.location, project.area].filter(Boolean).join(' | ')}</p>
              <span>
                Detay <Icon name="arrow" size={16} />
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="project-related__all">
        <a href="/projeler">
          Tüm Projeleri Gör <Icon name="arrow" size={18} />
        </a>
      </div>
    </section>
  )
}

<style>
  .project-related {
    margin-top: 81px;
  }

  .project-related__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    margin-bottom: 27px;
  }

  .project-related__heading h2 {
    padding-left: 16px;
    border-left: 3px solid var(--color-navy);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.68rem;
    line-height: 1.2;
    color: var(--color-navy-deep);
  }

  .project-related__heading a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-navy-deep);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 27px;
  }

  .related-card {
    display: block;
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-bg);
    box-shadow: 0 2px 12px rgba(43, 46, 131, 0.07);
    transition:
      transform 200ms,
      box-shadow 200ms;
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(43, 46, 131, 0.13);
  }

  .related-card__media {
    height: 213px;
    overflow: hidden;
  }

  .related-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease;
  }

  .related-card__media-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--color-bg-light);
    color: var(--color-border);
  }

  .related-card:hover .related-card__media img {
    transform: scale(1.05);
  }

  .related-card__info {
    padding: 16px 21px 21px;
  }

  .related-card__info h3 {
    margin-bottom: 4px;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-navy-deep);
  }

  .related-card__info p {
    margin-bottom: 9px;
    font-size: 0.84rem;
    color: var(--color-text-muted);
  }

  .related-card__info span {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .project-related__all {
    margin-top: 36px;
    text-align: center;
  }

  .project-related__all a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 36px;
    border: 1px solid var(--color-navy);
    border-radius: 3px;
    color: var(--color-navy-deep);
    font-size: 0.84rem;
    font-weight: 700;
    transition:
      background 180ms,
      color 180ms;
  }

  .project-related__all a:hover {
    background: var(--color-navy);
    color: #fff;
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .related-grid {
      grid-template-columns: 1fr;
    }

    .project-related__heading a {
      display: none;
    }
  }
</style>
