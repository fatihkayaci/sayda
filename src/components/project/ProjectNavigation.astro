---
import Icon from '../Icon.astro';
import { shortProjectTitle } from '../../utils/project';

interface RelatedProject {
  href: string;
  name: string;
  location: string;
  area: string;
  image: string;
}

interface Props {
  projects: RelatedProject[];
}

const { projects } = Astro.props;
---

{
  projects.length > 0 && (
    <div class="project-related reveal">
      <div class="project-related__heading">
        <span class="project-related__bar" />
        <h2>Diğer Projeler</h2>
      </div>

      <div class="related-grid">
        {projects.map((project) => (
          <a class="related-card" href={project.href}>
            <div class="related-card__media">
              {project.image ? (
                <img src={project.image} alt={`${shortProjectTitle(project.name)} - Sayda İnşaat`} loading="lazy" />
              ) : (
                <div class="related-card__media-empty">
                  <Icon name="photo" size={28} />
                </div>
              )}
            </div>
            <div class="related-card__info">
              <h3>{shortProjectTitle(project.name)}</h3>
              <p>
                {project.location} · {project.area}
              </p>
              <span>DETAY →</span>
            </div>
          </a>
        ))}
      </div>

      <div class="project-related__all">
        <a href="/projeler">Tüm Projeleri Gör →</a>
      </div>
    </div>
  )
}

<style>
  .project-related {
    margin-top: 80px;
  }

  .project-related__heading {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: var(--space-l);
  }

  .project-related__bar {
    display: block;
    width: 4px;
    height: 28px;
    border-radius: 2px;
    background: var(--color-navy);
  }

  .project-related__heading h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 22px;
    color: var(--color-text);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .related-card {
    display: block;
    overflow: hidden;
    border-radius: 6px;
    background: var(--color-bg);
    box-shadow: 0 2px 12px rgba(43, 46, 131, 0.07);
    transition:
      transform 200ms,
      box-shadow 200ms;
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(43, 46, 131, 0.13);
  }

  .related-card__media {
    height: 200px;
    overflow: hidden;
  }

  .related-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease;
  }

  .related-card__media-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--color-bg-light);
    color: var(--color-border);
  }

  .related-card:hover .related-card__media img {
    transform: scale(1.05);
  }

  .related-card__info {
    padding: 20px 20px 24px;
  }

  .related-card__info h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 6px;
  }

  .related-card__info p {
    font-size: 13px;
    color: var(--color-text-faint);
    margin-bottom: 10px;
  }

  .related-card__info span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-navy);
  }

  .project-related__all {
    text-align: center;
    margin-top: 40px;
  }

  .project-related__all a {
    display: inline-block;
    padding: 14px 36px;
    border: 2px solid var(--color-navy);
    color: var(--color-navy);
    font-size: 14px;
    font-weight: 700;
    border-radius: var(--radius);
    transition:
      background 180ms,
      color 180ms;
  }

  .project-related__all a:hover {
    background: var(--color-navy);
    color: #fff;
  }

  @media (max-width: 768px) {
    .related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 500px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

