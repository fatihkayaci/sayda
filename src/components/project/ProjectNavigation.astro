---
import { shortProjectTitle } from '../../utils/project';

interface RelatedProject {
  href: string;
  name: string;
  location: string;
  area: string;
  image: string;
}

interface Props {
  projects: RelatedProject[];
}

const { projects } = Astro.props;
---

{
  projects.length > 0 && (
    <section>
      <h2>Diğer Projeler</h2>
      <div class="related">
        {projects.map((project) => (
          <a class="page__box" href={project.href}>
            {project.image && (
              <img src={project.image} alt={`${shortProjectTitle(project.name)} - Sayda İnşaat`} width="300" height="200" loading="lazy" />
            )}
            <h3>{shortProjectTitle(project.name)}</h3>
            <p>{[project.location, project.area].filter(Boolean).join(' | ')}</p>
          </a>
        ))}
      </div>
      <p>
        <a href="/projeler">Tüm Projeleri Gör →</a>
      </p>
    </section>
  )
}

<style>
  .related {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 14px;
  }

  .related img {
    width: 100%;
    height: 150px;
    object-fit: cover;
  }
</style>
