---
interface Feature {
  icon: string;
  title: string;
  text: string;
}

interface Props {
  features?: Feature[];
}

const { features = [] } = Astro.props;
---

{
  features.length > 0 && (
    <section>
      <h2>Proje Özellikleri</h2>
      <ul class="list">
        {features.map((feature) => (
          <li>
            <strong>{feature.title}:</strong> {feature.text}
          </li>
        ))}
      </ul>
    </section>
  )
}
