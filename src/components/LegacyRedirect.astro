---
import redirects from '../data/legacy-redirects.json';

interface Props {
  page: keyof typeof redirects;
}

const { page } = Astro.props;
// Point straight at the served /path/ form so the old URL doesn't chain into a second redirect.
const slash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const source = redirects[page];
const config = {
  ...source,
  fallback: slash(source.fallback),
  map: Object.fromEntries(Object.entries(source.map).map(([key, path]) => [key, slash(path)])),
};
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <title>Yönlendiriliyor | Sayda İnşaat</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`https://www.sayda.com.tr${config.fallback}`} />
    <meta http-equiv="refresh" content={`1;url=${config.fallback}`} />
    <script
      is:inline
      define:vars={{ config }}
      >
      var value = new URLSearchParams(location.search).get(config.param);
      location.replace((value !== null && config.map[value]) || config.fallback);
    </script>
  </head>
  <body>
    <p><a href={config.fallback}>Yeni sayfaya gitmek için tıklayın.</a></p>
  </body>
</html>
