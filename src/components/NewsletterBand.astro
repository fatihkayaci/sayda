---
// Full-width dark newsletter band: oversized heading beside an email field.
import Icon from './Icon.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  subject?: string;
  note?: string;
}

const {
  eyebrow = 'Bülten',
  title = 'Gelişmeleri kaçırmayın.',
  text = 'En yeni haberler ve duyurular için e-posta bültenimize abone olun.',
  subject = 'Bülten aboneliği',
  note = 'E-posta adresiniz yalnızca bülten gönderimi için kullanılır.',
} = Astro.props;
---

<section class="news-band">
  <div class="container news-band__inner">
    <div class="news-band__text">
      <p class="news-band__eyebrow">{eyebrow}</p>
      <h2 data-words>{title}</h2>
      <p>{text}</p>
    </div>

    <form class="news-band__form" id="newsBandForm">
      <input type="hidden" name="form_type" value="newsletter" />
      <input type="hidden" name="subject" value={subject} />
      <input type="checkbox" name="botcheck" class="news-band__honeypot" tabindex="-1" autocomplete="off" />

      <div class="news-band__field">
        <input type="email" name="email" placeholder="E-posta adresiniz" required aria-label="E-posta adresiniz" />
        <button type="submit">
          Abone Ol <Icon name="arrow" size={18} />
        </button>
      </div>
      <p class="news-band__note">
        <Icon name="lock" size={14} />
        {note}
      </p>
      <p class="news-band__status" id="newsBandStatus" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  function initNewsBand() {
    const form = document.getElementById('newsBandForm') as HTMLFormElement | null;
    const status = document.getElementById('newsBandStatus');
    if (!form || !status || form.dataset.ready) return;
    form.dataset.ready = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitButton.disabled = true;
      status.textContent = 'Gönderiliyor...';
      status.removeAttribute('data-state');

      try {
        const res = await fetch('/form.php', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await res.json();
        if (!result.success) throw new Error(result.message ?? 'Unknown error');
        status.textContent = 'Teşekkürler, aboneliğiniz alındı.';
        status.setAttribute('data-state', 'success');
        form.reset();
      } catch {
        status.textContent = 'Gönderilemedi, lütfen daha sonra tekrar deneyin.';
        status.setAttribute('data-state', 'error');
      } finally {
        submitButton.disabled = false;
      }
    });
  }

  initNewsBand();
  document.addEventListener('astro:page-load', initNewsBand);
</script>

<style>
  .news-band {
    padding-block: clamp(72px, 8vw, 120px);
    background: var(--color-navy-deep);
    color: #fff;
  }

  .news-band__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    align-items: end;
    gap: 40px 96px;
  }

  .news-band__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .news-band__eyebrow::before {
    content: '';
    width: 40px;
    height: 3px;
    background: var(--color-orange);
  }

  .news-band h2 {
    max-width: 16ch;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(2.25rem, 3vw + 1rem, 4rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: #fff;
  }

  .news-band__text > p:last-child {
    max-width: 48ch;
    margin-top: 20px;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  .news-band__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }

  .news-band__field {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.35);
    transition: border-color var(--transition);
  }

  .news-band__field:focus-within {
    border-color: var(--color-orange);
  }

  .news-band input[type='email'] {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: clamp(1.125rem, 0.6vw + 0.9rem, 1.5rem);
    font-weight: 600;
    color: #fff;
    outline: none;
  }

  .news-band input[type='email']::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  .news-band button {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 10px;
    height: 56px;
    padding: 0 28px;
    border: 0;
    border-radius: var(--radius);
    background: var(--color-orange);
    color: var(--color-navy-deep);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--transition);
  }

  .news-band button:hover {
    background: var(--color-orange-dark);
  }

  .news-band button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .news-band__note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .news-band__status {
    margin-top: 12px;
    font-size: 0.9375rem;
    color: #fff;
  }

  .news-band__status[data-state='error'] {
    color: #ffb4a8;
  }

  .news-band__status:empty {
    display: none;
  }

  @media (max-width: 900px) {
    .news-band__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .news-band__field {
      flex-direction: column;
      align-items: stretch;
    }

    .news-band button {
      justify-content: center;
    }
  }
</style>
