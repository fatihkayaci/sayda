---
import Icon from './Icon.astro';
import site from '../data/site.json';

const navLinks = [
  { label: 'Ana Sayfa', href: '/' },
  {
    label: 'Kurumsal',
    href: '/kurumsal',
    children: [
      { label: 'Hakkımızda', href: '/hakkimizda' },
      { label: 'Vizyon & Misyon', href: '/hakkimizda/vizyon-misyon' },
      { label: 'Haberler', href: '/haberler' },
      { label: 'Sertifikalar', href: '/sertifikalar' },
      { label: 'İş Bitirme Belgeleri', href: '/projeler/is-bitirme-belgeleri' },
    ],
  },
  {
    label: 'Faaliyet Alanları',
    href: '/faaliyet-alanlari',
    children: [
      { label: 'Anahtar Teslim Müteahhitlik', href: '/faaliyet-alanlari/anahtar-teslim-muteahhitlik' },
      { label: 'Alt Müteahhitlik', href: '/faaliyet-alanlari/alt-muteahhitlik' },
      { label: 'Kat Karşılığı İnşaat', href: '/faaliyet-alanlari/kat-karsiligi-insaat' },
      { label: 'Kentsel Dönüşüm', href: '/faaliyet-alanlari/kentsel-donusum' },
      { label: 'Bina ve Tesis Renovasyonu', href: '/faaliyet-alanlari/bina-ve-tesis-renovasyonu' },
      { label: 'Proje Yönetimi & Danışmanlık', href: '/faaliyet-alanlari/proje-yonetimi-danismanlik' },
    ],
  },
  { label: 'Projeler', href: '/projeler' },
  { label: 'Blog', href: '/blog' },
  // İnsan Kaynakları (/kariyer) is reached from the contact page, so İletişim stays lit there.
  { label: 'İletişim', href: '/iletisim', alsoActiveOn: ['/kariyer'] },
];

const normalizePath = (path: string) => (path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path);
const currentPath = normalizePath(Astro.url.pathname);

const isPathActive = (href?: string) => {
  if (!href) return false;
  const h = normalizePath(href);
  if (h === '/') return currentPath === '/';
  return currentPath === h || currentPath.startsWith(`${h}/`);
};

// Only the most specific matching child is active, so /hakkimizda/vizyon-misyon
// doesn't also light up /hakkimizda.
const activeChildHref = (children?: { href: string }[]) =>
  children
    ?.filter((child) => isPathActive(child.href))
    .sort((a, b) => b.href.length - a.href.length)[0]?.href;

// A child listed under another menu (İş Bitirme under Kurumsal, path /projeler/...)
// owns the page, so Projeler doesn't light up as well.
const claimedByChild = navLinks.some((item) => activeChildHref(item.children));
---

<header class="header" transition:persist="sayda-header">
  <div class="header__inner">
    <a href="/" class="header__logo">
      <img src={site.logo} alt="Sayda İnşaat" width="196" height="46" />
    </a>

    <nav class="header__nav" id="mainMenu">
      <ul>
        {
          navLinks.map((item, i) => {
            const activeChild = activeChildHref(item.children);
            const childActive = Boolean(activeChild);
            const itemActive =
              childActive ||
              (!claimedByChild && (isPathActive(item.href) || Boolean(item.alsoActiveOn?.some(isPathActive))));
            return (
              <li class="header__nav-item" class:list={{ 'has-dropdown': item.children }}>
                {item.children ? (
                  <div class="header__nav-item-row">
                    {item.href ? (
                      <a href={item.href} class="header__nav-link" class:list={{ 'is-active': itemActive }}>
                        {item.label}
                      </a>
                    ) : (
                      <button
                        type="button"
                        class="header__nav-link header__nav-link--label"
                        class:list={{ 'is-active': itemActive }}
                        aria-expanded="false"
                        aria-controls={`dropdown-${i}`}
                      >
                        {item.label}
                      </button>
                    )}
                    <button
                      type="button"
                      class="header__dropdown-toggle"
                      aria-expanded="false"
                      aria-controls={`dropdown-${i}`}
                      aria-label={`${item.label} alt menüsünü aç`}
                    >
                      <Icon name="chevronDown" size={16} />
                    </button>
                  </div>
                ) : (
                  <a
                    href={item.href}
                    class="header__nav-link"
                    class:list={{ 'is-active': itemActive }}
                    data-also-active={item.alsoActiveOn?.join(' ')}
                  >
                    {item.label}
                  </a>
                )}
                {item.children && (
                  <ul class="header__dropdown" id={`dropdown-${i}`}>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class:list={{ 'is-active': child.href === activeChild }}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
        <li class="header__nav-item header__nav-cta-item">
          <a href="/iletisim#quote-form" class="header__nav-link header__nav-cta-link">
            Teklif Al
            <Icon name="arrow" size={16} />
          </a>
        </li>
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__cta" href="/iletisim#quote-form">
        Teklif Al
        <Icon name="arrow" size={16} />
      </a>
      <button class="header__hamburger" id="menuButton" aria-expanded="false" aria-controls="mainMenu" aria-label="Menüyü aç">
        <Icon name="menu" class="header__hamburger-icon header__hamburger-icon--open" />
        <Icon name="close" class="header__hamburger-icon header__hamburger-icon--close" />
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(28, 29, 46, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: transform 300ms ease;
  }

  .header.is-hidden {
    transform: translateY(-100%);
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-m);
    height: var(--header-h);
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: 0 var(--edge);
  }

  .header__logo {
    position: relative;
    display: flex;
    align-items: center;
    align-self: stretch;
    padding-left: var(--edge-mobile);
    padding-right: 44px;
  }

  .header__logo::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    left: -100vw;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    clip-path: polygon(0 0, 100% 0, calc(100% - 28px) 100%, 0 100%);
  }

  .header__logo img {
    position: relative;
    display: block;
    height: 40px;
    width: auto;
  }

  @media (min-width: 1330px) {
    .header__inner {
      grid-template-columns: auto 1fr;
    }

    .header__logo {
      padding-left: 0;
      padding-right: 70px;
    }

    .header__logo::before {
      clip-path: polygon(0 0, 100% 0, calc(100% - 44px) 100%, 0 100%);
    }

    .header__logo img {
      height: 56px;
    }

    .header .header__actions {
      display: none;
    }

    .header__nav {
      display: flex;
      align-items: center;
      align-self: stretch;
    }

    .header__nav > ul {
      justify-content: center;
      flex: 1;
      transform: translateY(1.5px); /* büyük harflerin optik merkezi için */
    }
  }

  .header__nav > ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 1.8vw, 40px);
  }

  .header__nav-item {
    position: relative;
  }

  .header__nav-cta-item {
    display: none;
  }

  .header__nav-item-row {
    display: flex;
    align-items: center;
    gap: 2px;
    line-height: 1;
  }

  .header__nav-item:not(.header__nav-cta-item) {
    display: flex;
    align-items: center;
  }

  .header__nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
    transition: color var(--transition);
  }

  .header__nav-link--label {
    background: none;
    border: none;
    padding: 0;
  }

  .header__nav-link:hover {
    color: #fff;
  }

  .header__nav-link.is-active {
    color: #e8a13a;
  }

  .header__dropdown li a.is-active {
    color: var(--color-navy);
    font-weight: 700;
    background: var(--color-bg-light);
  }

  .header__dropdown-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 4px;
    color: rgba(255, 255, 255, 0.88);
    transition: transform var(--transition);
  }

  .header__nav-item.is-open .header__dropdown-toggle {
    transform: rotate(180deg);
  }

  .header__dropdown {
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    min-width: 240px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: var(--space-xs);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition:
      opacity var(--transition),
      transform var(--transition),
      visibility var(--transition);
  }

  .header__dropdown li a {
    display: block;
    padding: 10px 12px;
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--color-text);
    transition:
      background var(--transition),
      color var(--transition);
  }

  .header__dropdown li a:hover {
    background: var(--color-bg-light);
    color: var(--color-navy);
  }

  @media (min-width: 1330px) {
    .header__nav-item.is-open .header__dropdown,
    .header__nav-item:focus-within .header__dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
  }

  @media (hover: hover) and (min-width: 1330px) {
    .header__nav-item:hover .header__dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .header__nav-item:hover .header__dropdown-toggle {
      transform: rotate(180deg);
    }
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .header__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-orange);
    color: var(--color-navy-deep);
    padding: 12px 22px;
    border-radius: 10px;
    font-size: var(--fs-small);
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 8px 20px rgba(245, 162, 27, 0.3);
    transition:
      background var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .header__cta:hover {
    background: var(--color-orange-dark);
    box-shadow: 0 10px 24px rgba(245, 162, 27, 0.45);
    transform: translateY(-1px);
  }

  .header__hamburger {
    display: none;
    background: none;
    border: none;
    padding: 4px;
    color: #fff;
  }

  @media (max-width: 1329px) {
    /* backdrop-filter would make the fixed full-screen menu relative to the header, so drop it while open */
    :global(body.menu-open) .header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      background: #1c1d2e;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    :global(body.menu-open) .header__logo::before {
      background: #fff;
    }

    .header__inner {
      height: var(--header-h-compact);
      padding-right: var(--edge-mobile);
    }

    .header__logo,
    .header__actions {
      position: relative;
      z-index: 2;
    }

    .header__nav {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      z-index: 1;
      margin-left: 0;
      overflow-y: auto;
      background: #1c1d2e;
      padding: calc(var(--header-h-compact) + var(--space-l)) var(--edge-mobile) var(--space-l);
      transform: translateX(100%);
      visibility: hidden;
      pointer-events: none;
      transition:
        transform var(--transition),
        visibility var(--transition);
    }

    .header__nav.is-open {
      transform: translateX(0);
      visibility: visible;
      pointer-events: auto;
    }

    .header__nav > ul {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-m);
    }

    .header__nav-link {
      font-size: 1.125rem;
      white-space: normal;
    }

    .header__nav-item-row {
      justify-content: space-between;
    }

    .header__dropdown {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
      max-height: none;
      box-shadow: none;
      border: none;
      background: none;
      margin-top: var(--space-s);
      padding: 0 0 0 var(--space-s);
      transition: none;
    }

    .header__dropdown li a {
      color: rgba(255, 255, 255, 0.7);
    }

    .header__dropdown li a:hover {
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
    }

    .header__nav-item.is-open .header__dropdown {
      display: block;
    }

    .header__cta {
      padding: 10px 16px;
    }

    .header__hamburger {
      display: block;
    }

    .header__actions {
      margin-left: auto;
    }
  }

  @media (max-width: 470px) {
    .header__cta {
      display: none;
    }

    .header__nav-cta-item {
      display: block;
      margin-top: var(--space-s);
    }

    .header__nav-cta-link {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      background: var(--color-orange);
      color: var(--color-navy-deep);
      padding: 12px 24px;
      border-radius: 10px;
      font-weight: 700;
      transition: background var(--transition);
    }

    .header__nav-cta-link:hover {
      background: var(--color-orange-dark);
      color: var(--color-navy-deep);
    }
  }

</style>

<script>
  const els = () => ({
    header: document.querySelector('.header'),
    button: document.getElementById('menuButton'),
    menu: document.getElementById('mainMenu'),
  });

  const closeDropdowns = () => {
    document.querySelectorAll('.header__nav-item.is-open').forEach((openItem) => {
      openItem.classList.remove('is-open');
      openItem
        .querySelectorAll('.header__dropdown-toggle, .header__nav-link--label')
        .forEach((el) => el.setAttribute('aria-expanded', 'false'));
    });
  };

  const isCompactNav = () => window.matchMedia('(max-width: 1329px)').matches;

  const setMenuOpen = (open: boolean) => {
    const { button, menu } = els();
    menu?.classList.toggle('is-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
    document.body.classList.toggle('menu-open', open);
    if (isCompactNav()) {
      menu?.setAttribute('aria-hidden', String(!open));
    } else {
      menu?.removeAttribute('aria-hidden');
    }
    if (!open) closeDropdowns();
  };

  let lastScrollY = window.scrollY;

  const updateHeaderBackground = () => {
    const { header, menu } = els();
    const y = window.scrollY;
    const menuOpen = menu?.classList.contains('is-open');
    const scrollingDown = y > lastScrollY;
    const hide = y > 80 && scrollingDown && !menuOpen;
    if (Math.abs(y - lastScrollY) > 4 || y <= 80) {
      header?.classList.toggle('is-hidden', hide);
      lastScrollY = y;
    }
  };

  const normalizePath = (path: string) => (path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path);

  const updateActiveNav = () => {
    const current = normalizePath(window.location.pathname);
    const isPathActive = (href: string | null) => {
      if (!href) return false;
      const h = normalizePath(href);
      if (h === '/') return current === '/';
      return current === h || current.startsWith(`${h}/`);
    };

    const items = [...document.querySelectorAll<HTMLElement>('.header__nav-item')].map((item) => {
      // Only the longest matching child href wins (see activeChildHref above).
      const children = [...item.querySelectorAll<HTMLAnchorElement>('.header__dropdown a')];
      const best = children
        .filter((child) => isPathActive(child.getAttribute('href')))
        .sort((a, b) => (b.getAttribute('href') ?? '').length - (a.getAttribute('href') ?? '').length)[0];
      children.forEach((child) => child.classList.toggle('is-active', child === best));
      return { item, childActive: Boolean(best) };
    });
    const claimedByChild = items.some(({ childActive }) => childActive);

    items.forEach(({ item, childActive }) => {
      const topLink = item.querySelector<HTMLElement>(
        '.header__nav-item-row > .header__nav-link, :scope > a.header__nav-link'
      );
      if (topLink) {
        topLink.classList.toggle(
          'is-active',
          childActive ||
            (!claimedByChild &&
              [topLink.getAttribute('href'), ...(topLink.dataset.alsoActive?.split(' ') ?? [])].some(isPathActive))
        );
      }
    });
  };

  const toggleDropdown = (toggle: Element) => {
    const item = toggle.closest('.header__nav-item');
    if (!item) return;
    const isOpen = item.classList.contains('is-open');

    document.querySelectorAll('.header__nav-item.is-open').forEach((openItem) => {
      if (openItem !== item) {
        openItem.classList.remove('is-open');
        openItem
          .querySelectorAll('.header__dropdown-toggle, .header__nav-link--label')
          .forEach((el) => el.setAttribute('aria-expanded', 'false'));
      }
    });

    item.classList.toggle('is-open', !isOpen);
    item
      .querySelectorAll('.header__dropdown-toggle, .header__nav-link--label')
      .forEach((el) => el.setAttribute('aria-expanded', String(!isOpen)));
  };

  const onDocumentClick = (event: Event) => {
    const target = event.target as Element | null;
    if (!target) return;

    if (target.closest('#menuButton')) {
      const { menu } = els();
      setMenuOpen(!menu?.classList.contains('is-open'));
      return;
    }

    const dropdownToggle = target.closest('.header__dropdown-toggle, .header__nav-link--label');
    if (dropdownToggle) {
      toggleDropdown(dropdownToggle);
      return;
    }

    if (target.closest('#mainMenu a')) {
      return;
    }

    const { menu, button } = els();
    if (menu?.contains(target) || button?.contains(target)) return;
    closeDropdowns();
  };

  const resetMenu = () => {
    setMenuOpen(false);
    updateHeaderBackground();
    updateActiveNav();
  };

  const win = window as Window & { __saydaHeaderNavV2?: boolean };

  if (!win.__saydaHeaderNavV2) {
    win.__saydaHeaderNavV2 = true;

    window.addEventListener('click', onDocumentClick, true);
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenuOpen(false);
    });
    window.addEventListener('scroll', updateHeaderBackground, { passive: true });
    window.matchMedia('(min-width: 1330px)').addEventListener('change', (event) => {
      if (event.matches) setMenuOpen(false);
    });
    document.addEventListener('astro:before-preparation', resetMenu);
    document.addEventListener('astro:after-swap', resetMenu);
    document.addEventListener('astro:page-load', resetMenu);
  }

  resetMenu();
</script>


