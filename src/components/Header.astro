---
import Icon from './Icon.astro';
import site from '../data/site.json';

const navLinks = [
  { label: 'Ana Sayfa', href: '/' },
  {
    label: 'Kurumsal',
    href: '/kurumsal',
    children: [
      { label: 'Hakkımızda', href: '/hakkimizda' },
      { label: 'Vizyon & Misyon', href: '/hakkimizda/vizyon-misyon' },
      { label: 'Belgelerimiz', href: '/belgeler' },
    ],
  },
  {
    label: 'Hizmetler',
    href: '/hizmetler',
    children: [
      { label: 'Alt Müteahhitlik', href: '/hizmetler/alt-muteahhitlik' },
      { label: 'Anahtar Teslim Müteahhitlik', href: '/hizmetler/anahtar-teslim-muteahhitlik' },
      { label: 'Kat Karşılığı İnşaat', href: '/hizmetler/kat-karsiligi-insaat' },
      { label: 'Proje Yönetimi & Danışmanlık', href: '/hizmetler/proje-yonetimi-danismanlik' },
      { label: 'Otel Renovasyonu', href: '/hizmetler/otel-renovasyonu' },
    ],
  },
  { label: 'Kentsel Dönüşüm', href: '/kentsel-donusum' },
  {
    label: 'Projeler',
    href: '/projeler',
    children: [
      { label: 'Devam Eden', href: '/projeler/devam-eden' },
      { label: 'Tamamlanan', href: '/projeler/tamamlanan' },
    ],
  },
  { label: 'Haberler', href: '/haberler' },
  { label: 'Rehber', href: '/rehber' },
];

const normalizePath = (path: string) => (path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path);
const currentPath = normalizePath(Astro.url.pathname);

const isPathActive = (href?: string) => {
  if (!href) return false;
  const h = normalizePath(href);
  if (h === '/') return currentPath === '/';
  return currentPath === h || currentPath.startsWith(`${h}/`);
};
---

<header class="header" transition:persist="sayda-header">
  <div class="header__inner">
    <a href="/" class="header__logo">
      <img src={site.logo} alt="Sayda İnşaat" width="148" height="34" />
    </a>

    <nav class="header__nav" id="mainMenu">
      <ul>
        {
          navLinks.map((item, i) => {
            const childActive = item.children?.some((child) => isPathActive(child.href)) ?? false;
            const itemActive = isPathActive(item.href) || childActive;
            return (
              <li class="header__nav-item" class:list={{ 'has-dropdown': item.children }}>
                {item.children ? (
                  <div class="header__nav-item-row">
                    {item.href ? (
                      <a href={item.href} class="header__nav-link" class:list={{ 'is-active': itemActive }}>
                        {item.label}
                      </a>
                    ) : (
                      <button
                        type="button"
                        class="header__nav-link header__nav-link--label"
                        class:list={{ 'is-active': itemActive }}
                        aria-expanded="false"
                        aria-controls={`dropdown-${i}`}
                      >
                        {item.label}
                      </button>
                    )}
                    <button
                      type="button"
                      class="header__dropdown-toggle"
                      aria-expanded="false"
                      aria-controls={`dropdown-${i}`}
                      aria-label={`${item.label} alt menüsünü aç`}
                    >
                      <Icon name="chevronDown" size={16} />
                    </button>
                  </div>
                ) : (
                  <a href={item.href} class="header__nav-link" class:list={{ 'is-active': itemActive }}>
                    {item.label}
                  </a>
                )}
                {item.children && (
                  <ul class="header__dropdown" id={`dropdown-${i}`}>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class:list={{ 'is-active': isPathActive(child.href) }}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
        <li class="header__nav-item header__nav-cta-item">
          <a href="/iletisim#quote-form" class="header__nav-link header__nav-cta-link">Teklif Al</a>
        </li>
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__cta" href="/iletisim#quote-form">Teklif Al</a>
      <button class="header__hamburger" id="menuButton" aria-expanded="false" aria-controls="mainMenu" aria-label="Menüyü aç">
        <Icon name="menu" class="header__hamburger-icon header__hamburger-icon--open" />
        <Icon name="close" class="header__hamburger-icon header__hamburger-icon--close" />
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(19, 21, 74, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    transition:
      background 300ms,
      box-shadow 300ms;
  }

  .header.is-scrolled {
    background: rgba(19, 21, 74, 0.55);
    box-shadow: 0 2px 24px rgba(0, 0, 0, 0.15);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-m);
    height: 84px;
    width: 100%;
    padding-inline: var(--edge);
  }


  .header__logo {
    display: flex;
    align-items: center;
  }

  .header__logo img {
    display: block;
    height: 34px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav > ul {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }

  .header__nav-item {
    position: relative;
  }

  .header__nav-cta-item {
    display: none;
  }

  .header__nav-item-row {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .header__nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-size: var(--fs-small);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.88);
    transition: color var(--transition);
  }

  .header__nav-link--label {
    background: none;
    border: none;
    padding: 0;
  }

  .header__nav-link:hover {
    color: #fff;
  }

  .header__nav-link.is-active {
    color: #fff;
  }

  .header__nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -9px;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.25));
  }

  .header__dropdown li a.is-active {
    color: var(--color-navy);
    font-weight: 700;
    background: var(--color-bg-light);
  }

  .header__dropdown-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 4px;
    color: rgba(255, 255, 255, 0.88);
    transition: transform var(--transition);
  }

  .header__nav-item.is-open .header__dropdown-toggle {
    transform: rotate(180deg);
  }

  .header__dropdown {
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    min-width: 240px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: var(--space-xs);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition:
      opacity var(--transition),
      transform var(--transition),
      visibility var(--transition);
  }

  .header__dropdown li a {
    display: block;
    padding: 10px 12px;
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--color-text);
    transition:
      background var(--transition),
      color var(--transition);
  }

  .header__dropdown li a:hover {
    background: var(--color-bg-light);
    color: var(--color-navy);
  }

  @media (min-width: 1281px) {
    .header__nav-item.is-open .header__dropdown,
    .header__nav-item:focus-within .header__dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
  }

  @media (hover: hover) and (min-width: 1281px) {
    .header__nav-item:hover .header__dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .header__nav-item:hover .header__dropdown-toggle {
      transform: rotate(180deg);
    }
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .header__cta {
    background: var(--color-navy);
    color: #fff;
    padding: 12px 24px;
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 700;
    white-space: nowrap;
    transition: background var(--transition);
  }

  .header__cta:hover {
    background: var(--color-navy-dark);
  }

  .header__hamburger {
    display: none;
    background: none;
    border: none;
    padding: 4px;
    color: #fff;
  }

  @media (max-width: 1280px) {
    .header {
      position: sticky;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: #13154a;
    }

    :global(body.menu-open) .header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
    }

    .header.is-scrolled {
      background: #13154a;
    }

    .header__inner {
      height: var(--header-h-compact);
      padding-inline: var(--edge-mobile);
    }

    .header__logo,
    .header__actions {
      position: relative;
      z-index: 2;
    }

    .header__nav {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      z-index: 1;
      margin-left: 0;
      overflow-y: auto;
      background: #13154a;
      padding: calc(var(--header-h-compact) + var(--space-l)) var(--edge-mobile) var(--space-l);
      transform: translateX(100%);
      visibility: hidden;
      pointer-events: none;
      transition:
        transform var(--transition),
        visibility var(--transition);
    }

    .header__nav.is-open {
      transform: translateX(0);
      visibility: visible;
      pointer-events: auto;
    }

    .header__nav > ul {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-m);
    }

    .header__nav-link {
      font-size: 1.125rem;
    }

    .header__nav-item-row {
      justify-content: space-between;
    }

    .header__dropdown {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
      max-height: none;
      box-shadow: none;
      border: none;
      background: none;
      margin-top: var(--space-s);
      padding: 0 0 0 var(--space-s);
      transition: none;
    }

    .header__dropdown li a {
      color: rgba(255, 255, 255, 0.7);
    }

    .header__dropdown li a:hover {
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
    }

    .header__nav-item.is-open .header__dropdown {
      display: block;
    }

    .header__cta {
      padding: 10px 16px;
    }

    .header__hamburger {
      display: block;
    }

    .header__actions {
      margin-left: auto;
    }
  }

  @media (max-width: 470px) {
    .header__cta {
      display: none;
    }

    .header__nav-cta-item {
      display: block;
      margin-top: var(--space-s);
    }

    .header__nav-cta-link {
      display: flex;
      justify-content: center;
      background: var(--color-navy);
      color: #fff;
      padding: 12px 24px;
      border-radius: var(--radius);
      font-weight: 700;
      transition: background var(--transition);
    }

    .header__nav-cta-link:hover {
      background: var(--color-navy-dark);
      color: #fff;
    }
  }

</style>

<script>
  const els = () => ({
    header: document.querySelector('.header'),
    button: document.getElementById('menuButton'),
    menu: document.getElementById('mainMenu'),
  });

  const closeDropdowns = () => {
    document.querySelectorAll('.header__nav-item.is-open').forEach((openItem) => {
      openItem.classList.remove('is-open');
      openItem
        .querySelectorAll('.header__dropdown-toggle, .header__nav-link--label')
        .forEach((el) => el.setAttribute('aria-expanded', 'false'));
    });
  };

  const isCompactNav = () => window.matchMedia('(max-width: 1280px)').matches;

  const setMenuOpen = (open: boolean) => {
    const { button, menu } = els();
    menu?.classList.toggle('is-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
    document.body.classList.toggle('menu-open', open);
    if (isCompactNav()) {
      menu?.setAttribute('aria-hidden', String(!open));
    } else {
      menu?.removeAttribute('aria-hidden');
    }
    if (!open) closeDropdowns();
  };

  const updateHeaderBackground = () => {
    els().header?.classList.toggle('is-scrolled', window.scrollY > 40);
  };

  const normalizePath = (path: string) => (path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path);

  const updateActiveNav = () => {
    const current = normalizePath(window.location.pathname);
    const isPathActive = (href: string | null) => {
      if (!href) return false;
      const h = normalizePath(href);
      if (h === '/') return current === '/';
      return current === h || current.startsWith(`${h}/`);
    };

    document.querySelectorAll<HTMLElement>('.header__nav-item').forEach((item) => {
      let childActive = false;
      item.querySelectorAll<HTMLAnchorElement>('.header__dropdown a').forEach((child) => {
        const active = isPathActive(child.getAttribute('href'));
        child.classList.toggle('is-active', active);
        if (active) childActive = true;
      });

      const topLink = item.querySelector<HTMLElement>(
        '.header__nav-item-row > .header__nav-link, :scope > a.header__nav-link'
      );
      if (topLink) {
        topLink.classList.toggle('is-active', childActive || isPathActive(topLink.getAttribute('href')));
      }
    });
  };

  const toggleDropdown = (toggle: Element) => {
    const item = toggle.closest('.header__nav-item');
    if (!item) return;
    const isOpen = item.classList.contains('is-open');

    document.querySelectorAll('.header__nav-item.is-open').forEach((openItem) => {
      if (openItem !== item) {
        openItem.classList.remove('is-open');
        openItem
          .querySelectorAll('.header__dropdown-toggle, .header__nav-link--label')
          .forEach((el) => el.setAttribute('aria-expanded', 'false'));
      }
    });

    item.classList.toggle('is-open', !isOpen);
    item
      .querySelectorAll('.header__dropdown-toggle, .header__nav-link--label')
      .forEach((el) => el.setAttribute('aria-expanded', String(!isOpen)));
  };

  const onDocumentClick = (event: Event) => {
    const target = event.target as Element | null;
    if (!target) return;

    if (target.closest('#menuButton')) {
      const { menu } = els();
      setMenuOpen(!menu?.classList.contains('is-open'));
      return;
    }

    const dropdownToggle = target.closest('.header__dropdown-toggle, .header__nav-link--label');
    if (dropdownToggle) {
      toggleDropdown(dropdownToggle);
      return;
    }

    if (target.closest('#mainMenu a')) {
      return;
    }

    const { menu, button } = els();
    if (menu?.contains(target) || button?.contains(target)) return;
    closeDropdowns();
  };

  const resetMenu = () => {
    setMenuOpen(false);
    updateHeaderBackground();
    updateActiveNav();
  };

  const win = window as Window & { __saydaHeaderNavV2?: boolean };

  if (!win.__saydaHeaderNavV2) {
    win.__saydaHeaderNavV2 = true;

    window.addEventListener('click', onDocumentClick, true);
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenuOpen(false);
    });
    window.addEventListener('scroll', updateHeaderBackground, { passive: true });
    window.matchMedia('(min-width: 1281px)').addEventListener('change', (event) => {
      if (event.matches) setMenuOpen(false);
    });
    document.addEventListener('astro:before-preparation', resetMenu);
    document.addEventListener('astro:after-swap', resetMenu);
    document.addEventListener('astro:page-load', resetMenu);
  }

  resetMenu();
</script>

