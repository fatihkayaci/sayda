---
import Icon from './Icon.astro';
import site from '../data/site.json';

const navLinks = [
  { label: 'Kentsel Dönüşüm', href: '/kentsel-donusum' },
  { label: 'Hizmetler', href: '/hizmetler' },
  { label: 'Projeler', href: '/projeler' },
  { label: 'Hakkımızda', href: '/hakkimizda' },
];
---

<header class="header">
  <div class="header__inner container">
    <a href="/" class="header__logo">
      <img src={site.logo} alt="Sayda İnşaat" width="128" height="34" />
    </a>

    <nav class="header__nav" id="mainMenu">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={site.phoneHref}>
        <Icon name="phone" size={18} />
        {site.phone}
      </a>
      <a class="header__cta" href="#quote-form">Teklif Al</a>
      <button class="header__hamburger" id="menuButton" aria-expanded="false" aria-controls="mainMenu" aria-label="Menüyü aç">
        <Icon name="menu" class="header__hamburger-icon header__hamburger-icon--open" />
        <Icon name="close" class="header__hamburger-icon header__hamburger-icon--close" />
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    height: 84px;
  }

  .header__logo {
    display: flex;
    align-items: center;
  }

  .header__logo img {
    display: block;
    height: 34px;
    width: auto;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-l);
  }

  .header__nav a {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-text);
    transition: color var(--transition);
  }

  .header__nav a:hover {
    color: var(--color-navy);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .header__phone {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
  }

  .header__cta {
    background: var(--color-navy);
    color: #fff;
    padding: 12px 24px;
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 700;
    white-space: nowrap;
    transition: background var(--transition);
  }

  .header__cta:hover {
    background: var(--color-navy-dark);
  }

  .header__hamburger {
    display: none;
    background: none;
    border: none;
    padding: 4px;
    color: var(--color-text);
  }

  @media (max-width: 1024px) {
    .header__phone {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .header {
      position: sticky;
    }

    .header__inner {
      height: 64px;
    }

    .header__nav {
      position: fixed;
      inset: 64px 0 0 0;
      background: var(--color-bg);
      padding: var(--space-l) var(--edge-mobile);
      transform: translateX(100%);
      transition: transform var(--transition);
    }

    .header__nav.is-open {
      transform: translateX(0);
    }

    .header__nav ul {
      flex-direction: column;
      gap: var(--space-m);
    }

    .header__nav a {
      font-size: 1.125rem;
    }

    .header__cta {
      padding: 10px 16px;
    }

    .header__hamburger {
      display: block;
    }
  }
</style>

<script>
  const button = document.getElementById('menuButton');
  const menu = document.getElementById('mainMenu');

  button?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('is-open');
    button.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.remove('is-open');
      button?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
