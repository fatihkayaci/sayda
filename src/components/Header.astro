---
import Icon from './Icon.astro';

const navLinks = [
  { label: 'Ana Sayfa', href: '/' },
  {
    label: 'Kurumsal',
    href: '/kurumsal',
    children: [
      { label: 'Hakkımızda', href: '/hakkimizda' },
      { label: 'Vizyon & Misyon', href: '/hakkimizda/vizyon-misyon' },
      { label: 'Belgelerimiz', href: '/belgeler' },
      { label: 'Haberler', href: '/haberler' },
      { label: 'Rehber', href: '/rehber' },
    ],
  },
  {
    label: 'Hizmetler',
    href: '/hizmetler',
    children: [
      { label: 'Alt Müteahhitlik', href: '/hizmetler/alt-muteahhitlik' },
      { label: 'Anahtar Teslim Müteahhitlik', href: '/hizmetler/anahtar-teslim-muteahhitlik' },
      { label: 'Kat Karşılığı İnşaat', href: '/hizmetler/kat-karsiligi-insaat' },
      { label: 'Proje Yönetimi & Danışmanlık', href: '/hizmetler/proje-yonetimi-danismanlik' },
      { label: 'Tesis Renovasyonu', href: '/hizmetler/otel-renovasyonu' },
      { label: 'Kentsel Dönüşüm', href: '/kentsel-donusum' },
    ],
  },
  {
    label: 'Projeler',
    href: '/projeler',
    children: [
      { label: 'Devam Eden', href: '/projeler/devam-eden' },
      { label: 'Tamamlanan', href: '/projeler/tamamlanan' },
    ],
  },
  { label: 'E-Katalog', href: '/katalog.pdf' },
  {
    label: 'İK',
    href: '/kariyer',
    children: [
      { label: 'Beyaz Yaka', href: '/kariyer' },
      { label: 'Kalfa (Ekipli)', href: '/kariyer#kalfa-ekipli' },
    ],
  },
];

const normalizePath = (path: string) => (path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path);
const currentPath = normalizePath(Astro.url.pathname);

const isPathActive = (href?: string) => {
  if (!href) return false;
  const h = normalizePath(href);
  if (h === '/') return currentPath === '/';
  return currentPath === h || currentPath.startsWith(`${h}/`);
};
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <img src="/img/legacy/logo-2.png" alt="Sayda İnşaat" />
    </a>

    <button class="header__toggle" id="menuButton" aria-expanded="false" aria-controls="mainMenu" aria-label="Menüyü aç">
      <Icon name="menu" size={22} />
    </button>

    <nav class="header__nav" id="mainMenu" aria-label="Ana menü">
      <ul class="header__list">
        {
          navLinks.map((item) => {
            const active = isPathActive(item.href) || (item.children?.some((c) => isPathActive(c.href)) ?? false);
            return (
              <li class:list={['header__item', { 'has-sub': item.children, current: active }]}>
                <a href={item.href}>{item.label}</a>
                {item.children && (
                  <ul class="header__sub">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
        <li class="header__item"><a href="/iletisim">İletişim</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menuButton');
  const nav = document.getElementById('mainMenu');
  btn?.addEventListener('click', () => {
    const open = nav!.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
  });
  nav?.querySelectorAll<HTMLElement>('.has-sub > a').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (window.innerWidth > 991) return;
      const li = a.parentElement!;
      if (!li.classList.contains('is-open')) {
        e.preventDefault();
        li.classList.add('is-open');
      }
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    overflow: visible;
    background: #1d1d1d url('/img/legacy/header-v5-bg.png') no-repeat 0 0;
    background-size: cover;
    font-family: var(--font-body);
  }

  .header__inner {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    max-width: 1170px;
    padding-inline: 15px;
  }

  .header__logo {
    position: relative;
    display: block;
    padding: 18px 30px 18px 0;
  }

  .header__logo::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 2000px;
    height: 100%;
    background: #fff url('/img/legacy/header-v5-bg.png') no-repeat 0 0;
    background-size: cover;
    transform: skewX(-45deg);
    z-index: 1;
  }

  .header__logo img {
    position: relative;
    z-index: 2;
    width: 270px;
    height: auto;
  }

  .header__nav {
    display: flex;
    align-items: center;
  }

  .header__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .header__item {
    position: relative;
  }

  .header__item > a {
    display: inline-block;
    padding: 0 18px;
    font-size: 14px;
    font-weight: 400;
    line-height: 85px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #fff;
    transition: color 0.3s ease;
  }

  .header__item.has-sub > a::after {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin: 0 0 3px 8px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
  }

  .header__item > a:hover,
  .header__item.current > a {
    color: #eea010;
  }

  .header__sub {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 100;
    display: none;
    width: 260px;
    background: #191919;
    border-top: 2px solid #f69c00;
    box-shadow: 0 1px 5px 1px rgba(0, 0, 0, 0.2);
  }

  .header__item:hover > .header__sub,
  .header__item:focus-within > .header__sub {
    display: block;
  }

  .header__sub a {
    display: block;
    padding: 0 25px;
    font-size: 13px;
    font-weight: 600;
    line-height: 40px;
    text-transform: uppercase;
    color: #767474;
    border-bottom: 1px solid #2a2a2a;
    transition: color 0.3s ease;
  }

  .header__sub li:last-child a {
    border: none;
  }

  .header__sub a:hover {
    color: #f69c00;
  }

  .header__toggle {
    display: none;
    align-self: center;
    padding: 8px 12px;
    border: 1px solid #f69c00;
    background: transparent;
    color: #fff;
  }

  @media (max-width: 1199px) {
    .header__item > a {
      padding: 0 9px;
      font-size: 13px;
    }

    .header__logo img {
      width: 220px;
    }
  }

  @media (max-width: 991px) {
    .header {
      position: relative;
    }

    .header__toggle {
      display: block;
      position: relative;
      z-index: 3;
    }

    .header__inner {
      flex-wrap: wrap;
    }

    .header__nav {
      display: none;
      flex-basis: 100%;
      background: #1d1d1d;
    }

    .header__nav.is-open {
      display: block;
    }

    .header__list {
      display: block;
    }

    .header__item > a {
      display: block;
      line-height: 44px;
      border-top: 1px solid #2a2a2a;
    }

    .header__sub {
      position: static;
      width: auto;
      box-shadow: none;
    }

    .header__item:hover > .header__sub {
      display: none;
    }

    .header__item.is-open > .header__sub {
      display: block;
    }
  }
</style>
