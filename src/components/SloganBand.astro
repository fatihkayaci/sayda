---
// Full-bleed photo band with an oversized uppercase slogan; the highlighted tail renders in orange.
interface Props {
  text: string;
  highlight: string;
  sub?: string;
  image?: string;
}

const { text, highlight, sub, image = '/img/sayda-insaat-hero01.webp' } = Astro.props;
---

<section class="slogan-band">
  <img src={image} alt="" loading="lazy" />
  <div class="container slogan-band__inner">
    <p class="slogan-band__text">{text} <span>{highlight}</span></p>
    {sub && <p class="slogan-band__sub">{sub}</p>}
  </div>
</section>

<style>
  .slogan-band {
    position: relative;
    overflow: hidden;
    color: #fff;
  }

  .slogan-band > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slogan-band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(28, 29, 46, 0.92) 0%, rgba(28, 29, 46, 0.55) 60%, rgba(28, 29, 46, 0.3) 100%);
  }

  .slogan-band__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(96px, 12vw, 180px);
  }

  .slogan-band__text {
    max-width: 14ch;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(2.5rem, 5vw + 0.5rem, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .slogan-band__text span {
    color: var(--color-orange);
  }

  .slogan-band__sub {
    margin-top: 28px;
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 480px) {
    .slogan-band__text {
      font-stretch: 100%;
      font-size: clamp(2.25rem, 10vw, 2.75rem);
    }
  }
</style>
