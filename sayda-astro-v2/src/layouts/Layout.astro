---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Sayda İnşaat | İstanbul Müteahhitlik ve Kentsel Dönüşüm' ? title : title + ' | Sayda İnşaat'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet" />
    <style is:global>
      *{box-sizing:border-box}
      html,body{margin:0;padding:0;background:#fff}
      body{font-family:'Archivo',system-ui,sans-serif;color:#15182B;-webkit-font-smoothing:antialiased}
      a{color:inherit;text-decoration:none}
      a:hover{color:#2F3091}
      img{max-width:100%}
    </style>
  </head>
  <body><slot /></body>
</html>
