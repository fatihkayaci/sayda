---
import site from "../data/site.json";

interface Props {
  title: string;
  description: string;
  /** Yalnızca gerektiğinde ver. Boşsa sayfanın kendi adresi kullanılır. */
  canonical?: string;
  /** Paylaşım görseli — /public altındaki yol. */
  gorsel?: string;
  /** Arama sonuçlarından çıkarılacak sayfalar için. */
  noindex?: boolean;
  /** Kurum işaretlemesi — sadece ana sayfada true olacak. */
  kurumSemasi?: boolean;
}

const {
  title,
  description,
  canonical,
  gorsel = "/img/og-varsayilan.jpg",
  noindex = false,
  kurumSemasi = false,
} = Astro.props;

const adres = new URL(Astro.url.pathname, Astro.site);
const kanonik = canonical ?? adres.href;
const gorselTam = new URL(gorsel, Astro.site).href;

const sema = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  name: site.ad,
  legalName: site.unvan,
  url: site.domain,
  logo: new URL("/img/logo.svg", Astro.site).href,
  foundingDate: String(site.kurulus),
  telephone: site.telefon,
  email: site.mail,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.adres.sokak,
    addressLocality: site.adres.ilce,
    postalCode: site.adres.postaKodu,
    addressRegion: site.adres.il,
    addressCountry: site.adres.ulke,
  },
  sameAs: Object.values(site.sosyal).filter(Boolean),
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={kanonik} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.ad} />
<meta property="og:locale" content="tr_TR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={kanonik} />
<meta property="og:image" content={gorselTam} />

<meta name="twitter:card" content="summary_large_image" />

{
  kurumSemasi && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(sema)}
    />
  )
}
