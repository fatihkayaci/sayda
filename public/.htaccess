# Sayda İnşaat - Apache (cPanel) yapılandırması
Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS + www zorunlu (tek adımda)
# (Yalnızca sayda.com.tr alan adlarında çalışır; geçici test adresinde yönlendirme yapmaz)
RewriteCond %{HTTP_HOST} ^(www\.)?sayda\.com\.tr$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^sayda\.com\.tr$ [NC]
RewriteRule ^(.*)$ https://www.sayda.com.tr/$1 [R=301,L]

# Eski blog yolu
RewriteRule ^rehber/?$ /blog [R=301,L]
RewriteRule ^rehber/(.*)$ /blog/$1 [R=301,L]
RewriteRule ^kentsel-donusum/?$ /hizmetler/kentsel-donusum [R=301,L]

# Eski ASP.NET sitesi (query string'li adresler)
